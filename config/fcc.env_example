# Operator FCC secrets — copy to ~/.fcc/.env (NOT services/*/.env).
# Mounted read-only into orion-fcc container at /root/.fcc/.env.
# Service operator surface (port, mount path, container LLAMACPP override): services/orion-fcc/.env_example
# Used by Hub Agent Claude AND Orion unified-turn harness (same file, two paths):
#   Hub:     HUB_FCC_ENV_PATH      → /root/.fcc/.env in hub container
#   Harness: HARNESS_FCC_ENV_PATH  → /root/.fcc/.env in harness-governor container
#
# Enable flags live in service .env (synced from .env_example):
#   Agent Claude mode: HUB_AGENT_CLAUDE_MCP_ENABLED + HUB_AITOWN_ENABLED (orion-hub)
#   Orion mode:        HARNESS_FCC_MCP_ENABLED + HARNESS_AITOWN_ENABLED (orion-harness-governor)
#
# Hub AI Town panel/proxy uses HUB_AITOWN_* in services/orion-hub/.env — NOT this file.
# AITOWN_* here is for embodiment + harness MCP only (Orion's in-world body).

# --- LLM gateway / FCC ---
# Hub container uses host networking — 127.0.0.1:8210 reaches orion-llm-gateway on the host.
LLAMACPP_BASE_URL=http://127.0.0.1:8210/v1
ANTHROPIC_AUTH_TOKEN=
# MODEL/MODEL_SONNET/MODEL_OPUS point at the `harness` route (PR #1761, 2026-08-20), not
# `chat` -- confirmed live 2026-08-19 (see services/orion-harness-governor/tests/
# test_harness_governor_rpc.py) that these three keys share one route value across BOTH FCC
# consumers of this one file: Hub's "Agent Claude" mode AND Orion's own harness motor. That is
# by design -- the split isolates {Hub Agent Claude + Orion harness motor} together, away from
# plain Hub chat conversations, which still uses `chat` and is NOT read from this file.
# MODEL_HAIKU is intentionally left alone (whatever backend it already points at).
MODEL=harness
MODEL_SONNET=harness
MODEL_HAIKU=chat
MODEL_OPUS=harness

# --- MCP secrets (required when MCP enabled) ---
GITHUB_PAT=
FIRECRAWL_API_KEY=
# github-mcp-server toolset scope — lean default keeps the tool schema small enough
# for the llamacpp context window. Widen (e.g. repos,pull_requests,issues,actions) as needed.
# Read-only by default; set GITHUB_READ_ONLY=0 to enable write tools (create_pull_request, etc).
GITHUB_TOOLSETS=repos,pull_requests
GITHUB_READ_ONLY=1

# --- AI Town gameplay MCP (optional; needs mesh bootstrap) ---
# Use mesh-reachable URL (not 127.0.0.1) if read from bridge-network containers.
# Harness override: HARNESS_AITOWN_CONVEX_URL in orion-harness-governor .env
# Live deploy on Circe (2026-08-29 Atlas cutover). Hub panel URL is separate (HUB_AITOWN_*).
AITOWN_CONVEX_URL=http://100.112.254.99:3210
AITOWN_ADMIN_KEY=
AITOWN_WORLD_ID=
AITOWN_ORION_PLAYER_ID=
AITOWN_ORION_AGENT_ID=
