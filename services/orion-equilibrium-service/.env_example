# ──────────────────────────────────────────────────────────────
# Orion Equilibrium Service
# Watches system.health + emits equilibrium snapshots / signals
# ──────────────────────────────────────────────────────────────

# Compose naming / network
#PROJECT=orion-athena
#NET=app-net

# Service identity
SERVICE_NAME=orion-equilibrium-service
SERVICE_VERSION=0.1.0
NODE_NAME=athena
INSTANCE_ID=eq-1

# Orion bus
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
ORION_BUS_URL=${ORION_BUS_URL}
ORION_HEALTH_CHANNEL=orion:system:health

# --- Metacognition tick  ---
CHANNEL_METACOGNITION_TICK=orion:metacognition:tick
METACOGNITION_TICK_KIND=metacognition.tick.v1
CHANNEL_EQUILIBRIUM_METACOG_TRIGGER=orion:equilibrium:metacog:trigger

# Titanium-ish channels
CHANNEL_EQUILIBRIUM_SNAPSHOT=orion:equilibrium:snapshot
CHANNEL_SPARK_SIGNAL=orion:spark:signal
CHANNEL_COGNITION_TRACE_PUB=orion:cognition:trace

# Historical downtime persistence (2026-07-24, docs/superpowers/specs/
# 2026-07-24-service-heartbeat-node-telemetry-design.md). Separate channel
# from CHANNEL_EQUILIBRIUM_SNAPSHOT on purpose -- see that channel's own
# comment in orion/bus/channels.yaml. orion-sql-writer consumes this channel
# and persists each real status transition to the equilibrium_service_transitions
# table. Enabled by default; the flag is a kill switch, not a staged rollout.
CHANNEL_EQUILIBRIUM_TRANSITION=orion:equilibrium:transition
EQUILIBRIUM_TRANSITION_PUBLISH_ENABLE=true

# Runtime / heartbeat cadence (settings supports this; add to compose for provenance)
HEARTBEAT_INTERVAL_SEC=10

# Equilibrium logic
# Comma-separated list OR JSON list; your settings supports both.
EQUILIBRIUM_EXPECTED_SERVICES=recall,state-journaler,sql-writer,vector-writer,agent-council,biometrics,collapse-mirror,cortex-exec,cortex-orch,landing-pad,llm-gateway,meta-tags,orion-chat-memory,orion-memory-consolidation,orion-memory-crystallizer,orion-signal-gateway,orion-vector-host,spark-introspector,state-service,substrate-telemetry
EQUILIBRIUM_METACOG_PUBLISH_VERB_REQUEST=false

# Optional: path inside container to YAML file with { services: [...] }
EQUILIBRIUM_EXPECTED_SERVICES_PATH=

EQUILIBRIUM_GRACE_MULTIPLIER=3.0
EQUILIBRIUM_PUBLISH_INTERVAL_SEC=15
EQUILIBRIUM_COLLAPSE_MIRROR_INTERVAL_SEC=10
EQUILIBRIUM_WINDOWS_SEC=[60,300,3600]

# Redis state key
EQUILIBRIUM_STATE_KEY=equilibrium:state
EQUILIBRIUM_STATE_RETENTION_SEC=3600

# Metacognition / collapse channels (settings defaults; override when wiring collapse)
CHANNEL_COLLAPSE_MIRROR_USER_EVENT=orion:collapse:intake
CHANNEL_REPAIR_PRESSURE_APPRAISAL=orion:repair_pressure:appraisal
EQUILIBRIUM_METACOG_RECALL_ENABLED=false

# Metacognition Logging
# Ticks (orion:metacognition:tick) are telemetry only. Metacog rows come only from
# event-driven triggers on CHANNEL_EQUILIBRIUM_METACOG_TRIGGER (the scheduled
# baseline heartbeat and the substrate dense/pulse gate were retired 2026-09-29).
EQUILIBRIUM_METACOG_ENABLE=true
EQUILIBRIUM_METACOG_COOLDOWN_SEC=30

# Relational metacog trigger: reuses repair_pressure_v2 (orion-hub's live
# pre_turn_appraisal wiring), published on CHANNEL_REPAIR_PRESSURE_APPRAISAL
# whenever the repair_pressure paradigm actually runs. Replaced the retired
# turn_change_classify SHIFT gate as of 2026-07-18 -- see
# docs/superpowers/design/2026-07-18-collapse-mirror-metacog-redesign.md.
#
# Confidence threshold lowered 0.7 -> 0.65 on 2026-08-11: live data pulled
# from repair_pressure_appraisal_log (pre-outage, so genuinely representative)
# showed confidence pinned at exactly 0.65 on every real appraisal row --
# that's the "confidently calm" text-fallback constant documented in
# reduce_repair_level(), not a value this gate could ever clear at 0.7. This
# trigger had never fired even before the 11-day mesh outage below; the old
# 0.7 threshold was unreachable by construction, not merely rare.
EQUILIBRIUM_METACOG_RELATIONAL_TRIGGER_ENABLE=true
EQUILIBRIUM_METACOG_RELATIONAL_CONFIDENCE_THRESHOLD=0.65
EQUILIBRIUM_METACOG_RELATIONAL_LEVEL_THRESHOLD=0.5

# repair_pressure_trend metacog trigger (2026-07-30, hop 0 of the
# stream-of-consciousness hop-chain design): folds every real (confidence-
# gated) repair_pressure_v2 appraisal into a persisted EWMA baseline
# (orion/metacog/trend_reducer.py) and fires only on a sustained multi-
# appraisal elevated run, distinct from the single-appraisal relational
# trigger above.
#
# Flipped ON 2026-08-11, alongside insight/flow below: this service's mesh
# dependency was down for 11 days (last real repair_pressure_appraisal_log
# row: 2026-07-31), so there was no live window to judge "does it fire
# sensibly" against until now. Same watch-the-first-fire discipline as
# insight/flow -- this is a decision to start collecting real post-outage
# data, not a claim it's already been validated.
EQUILIBRIUM_METACOG_REPAIR_PRESSURE_TREND_TRIGGER_ENABLE=true
EQUILIBRIUM_METACOG_REPAIR_PRESSURE_TREND_CONFIDENCE_FLOOR=0.3
EQUILIBRIUM_METACOG_REPAIR_PRESSURE_TREND_MIN_SAMPLES=20
EQUILIBRIUM_METACOG_REPAIR_PRESSURE_TREND_ELEVATED_ZSCORE=1.0
EQUILIBRIUM_METACOG_REPAIR_PRESSURE_TREND_SUSTAINED_HITS=3
EQUILIBRIUM_METACOG_REPAIR_PRESSURE_TREND_STATE_KEY=equilibrium:metacog_trend_state:repair_pressure
EQUILIBRIUM_METACOG_REPAIR_PRESSURE_TREND_COOLDOWN_SEC=1800.0

# Telemetry-anomaly metacog trigger: reuses field_channel_corpus.v1's
# reconstruction-loss anomaly score, published on
# CHANNEL_FIELD_CHANNEL_ANOMALY_SCORE by orion-field-digester's periodic
# anomaly-scoring loop whenever FIELD_CHANNEL_ANOMALY_ENABLED is on there.
# 2026-07-21 -- see docs/superpowers/design/2026-07-18-collapse-mirror-
# metacog-redesign.md's trigger taxonomy.
CHANNEL_FIELD_CHANNEL_ANOMALY_SCORE=orion:field_channel:anomaly_score
EQUILIBRIUM_METACOG_TELEMETRY_ANOMALY_TRIGGER_ENABLE=true
EQUILIBRIUM_METACOG_TELEMETRY_ANOMALY_THRESHOLD_MULTIPLIER=3.0

# chat_turn metacog trigger: correlates ThoughtEventV1 (CHANNEL_THOUGHT_ARTIFACT)
# + HarnessRunV1 (CHANNEL_HARNESS_RUN_ARTIFACT) + an optional governor-timeout
# GrammarEventV1 (CHANNEL_GRAMMAR_EVENT, semantic_role == "exec_turn_timeout",
# Patch B / PR #1287) by correlation_id and fires on real gate conditions read
# off those schemas -- deferred/refused turns, boundary hits, misaligned/
# unresolved reflection, high surprise, incomplete compliance, non-zero exit,
# degraded finalize, or a governor timeout. Enabled 2026-07-23 (was ships-off
# in PR #1291) -- see acceptance checks in docs/superpowers/design/
# 2026-07-18-collapse-mirror-metacog-redesign.md; live-data verification
# (real orion_metacog rows, non-degenerate upstream) still needs to happen
# post-deploy, not yet run.
CHANNEL_THOUGHT_ARTIFACT=orion:thought:artifact
CHANNEL_HARNESS_RUN_ARTIFACT=orion:harness:run:artifact
CHANNEL_GRAMMAR_EVENT=orion:grammar:event
EQUILIBRIUM_METACOG_CHAT_TURN_TRIGGER_ENABLE=true
EQUILIBRIUM_METACOG_CHAT_TURN_CORRELATOR_TTL_SEC=600
EQUILIBRIUM_METACOG_CHAT_TURN_SURPRISE_THRESHOLD=0.7
# Separate cooldown lane from EQUILIBRIUM_METACOG_COOLDOWN_SEC above -- chat_turn
# fires on essentially every remarkable turn, so sharing the global cooldown
# would let it starve the other trigger kinds' own fires.
EQUILIBRIUM_METACOG_CHAT_TURN_COOLDOWN_SEC=30

# transport metacog trigger (docs/superpowers/specs/2026-07-24-transport-metacog-
# trigger-design.md). Two independent evidence sources, both feeding trigger_kind
# "transport": (A) real RpcHealthSnapshotV1 windows from orion:rpc_health:snapshot
# (timeout_count>0 only; the p95 latency branch was removed 2026-09-24); (C) any real orion:grammar:event with
# semantic_role=="rpc_transport_timeout" (orion/core/bus/async_service.py::
# _emit_rpc_timeout_grammar), a per-call RPC timeout across all 37+ real
# rpc_request() call sites, not just harness/thought. Ships disabled; needs the
# same live-verification standard as every other trigger in this family before
# flipping on.
CHANNEL_RPC_HEALTH_SNAPSHOT=orion:rpc_health:snapshot
EQUILIBRIUM_METACOG_TRANSPORT_TRIGGER_ENABLE=true
# Separate cooldown lane, from day one -- see chat_turn's own comment above for why.
EQUILIBRIUM_METACOG_TRANSPORT_COOLDOWN_SEC=30
# (EQUILIBRIUM_METACOG_TRANSPORT_LATENCY_P95_THRESHOLD_MS removed 2026-09-24: the
# pooled-p95 latency branch was metacog measuring its own background LLM call, a
# self-loop worth ~2,000 junk rows/day. Delete it from your local .env too.)

# --- transport baseline gate (2026-09-24 spec, app/transport_baseline_gate.py) ---
# Per-hop log-latency EWMA over RpcHealthSnapshotV1.channel_latency. Learns each
# hop's own normal and cannot quietly learn "busy" as normal.
# ENABLE: fold + persist + log per-key z / ratio / calls (log-only, publishes nothing).
EQUILIBRIUM_TRANSPORT_BASELINE_ENABLE=true
# EMIT: publish open/escalate/close episode triggers. Needs ENABLE and
# EQUILIBRIUM_METACOG_TRANSPORT_TRIGGER_ENABLE. While on, every rpc_request()
# timeout the gate saw in a snapshot is owned by its timeout/zero_success episode,
# and the per-call rpc_transport_timeout atom for it is dropped; atoms from services
# that do not publish rpc_health still fire. While off, the atom is the only owner of
# timeouts (the pooled rpc_health legacy timeout branch was removed 2026-09-29).
# On since 2026-10-01: first graded night (scripts/analysis/grade_transport_baseline.py,
# judged by the gate's own decisions) passed 11 of 11 hops that can alert, and every
# would-emit row matched a real timeout. Keep grading; set false to fall back to atoms only.
EQUILIBRIUM_TRANSPORT_BASELINE_EMIT=true
# Comma-separated labels (hop "#label", "verb:<name>", or whole hop key) that are
# baselined and logged but never trigger. Default breaks metacog's self-loop,
# drops GPU queue wait, and cortex-exec's fail-open 3 s current-turn probe.
EQUILIBRIUM_TRANSPORT_EXCLUDE_LABELS=log_orion_metacognition,gpu_pool_wait,current_turn_probe
EQUILIBRIUM_TRANSPORT_BASELINE_STATE_KEY=equilibrium:transport_baseline_state:v1
# Proposals, to be set from the log-only week. Changing any of them changes the
# state fingerprint, so the next boot cold-starts the baselines (logged).
EQUILIBRIUM_TRANSPORT_BASELINE_MIN_CALLS=5
EQUILIBRIUM_TRANSPORT_BASELINE_N_WARM=10
EQUILIBRIUM_TRANSPORT_BASELINE_SPIKE_Z=3.0
# Materiality: spike/saturation also need this many ms of absolute excess (a 10 ms
# poll reading 14 ms is z-huge but meaningless).
EQUILIBRIUM_TRANSPORT_BASELINE_MIN_EXCESS_MS=250
EQUILIBRIUM_TRANSPORT_BASELINE_SATURATION_RATIO=2.0
EQUILIBRIUM_TRANSPORT_BASELINE_REGIME_AFTER_SEC=21600
# Hourly publish budget for baseline triggers (they bypass the 30s transport
# cooldown lane). Over budget is logged as transport_baseline_suppressed. 0 = no cap.
EQUILIBRIUM_TRANSPORT_BASELINE_MAX_TRIGGERS_PER_HOUR=30
# EMIT only: seconds an rpc_transport_timeout atom waits for a snapshot window that
# saw the same timeout before it fires on its own (> one 30 s rpc_health interval).
EQUILIBRIUM_TRANSPORT_TIMEOUT_ATOM_GRACE_SEC=75
# Durable readings for the log-only week: one hourly summary per hop on
# CHANNEL_TRANSPORT_BASELINE_HOURLY -> orion-sql-writer -> transport_baseline_hourly.
# Deploy order: orion-sql-writer first (it must route transport_baseline.hourly.v1),
# then this service. Until sql-writer has the route, rows land in its fallback log.
EQUILIBRIUM_TRANSPORT_BASELINE_HOURLY_PUBLISH_ENABLE=true
CHANNEL_TRANSPORT_BASELINE_HOURLY=orion:equilibrium:transport_baseline:hourly
# The third transport evidence source (a FalkorDB poll of
# node:substrate.bus_synaptic's prediction_error, keys
# EQUILIBRIUM_METACOG_TRANSPORT_BUS_SYNAPTIC_* and FALKORDB_*) was RETIRED
# 2026-09-30 after failing its metric quality gate on live data. See
# docs/superpowers/pr-reports/2026-09-30-retire-bus-synaptic-transport-trigger-pr.md.

# Generative (non-rupture) metacog trigger: insight.
# docs/superpowers/specs/2026-07-28-collapse-mirror-generative-triggers-design.md
#
# Fires on a positive/neutral state instead of a rupture. Reads one already-live
# field, AttentionSelfModelV1.prediction_error_confidence, out of the
# substrate_attention_self_model table (written every ~30s by
# orion-substrate-runtime's _attention_self_model_tick, PR #1459):
#   insight = a sustained low->high confidence recovery (a surprise resolved)
#
# The sibling "flow" trigger (a sustained high-confidence plateau) was RETIRED
# 2026-10-10 and every EQUILIBRIUM_METACOG_FLOW_* key removed: on live data
# its plateau was the field's idle rest state (93% of the calmest windows had
# no chat/execution/route activity at all), so it fired ~30x/day, capped only
# by its cooldown. See docs/superpowers/pr-reports/2026-10-10-metacog-flow-
# trigger-calibration-pr.md.
#
# Flipped ON 2026-08-11: shipped disabled pending a post-merge live-data
# check, same standard as the (since retired) bus_synaptic transport poll.
# That check never happened -- this service's mesh dependency
# was down for 11 days right after these shipped, so there was no live
# window to watch. Watch the first real fire (an orion_metacog row with
# trigger_kind=insight and upstream.evidence_source=
# attention_self_model_prediction_error_confidence) now that the mesh is
# back, same as if this were a fresh flip.
EQUILIBRIUM_METACOG_INSIGHT_TRIGGER_ENABLE=true
# One poll per interval, one read of the trailing row window.
# Matches the ~30s cadence of the tick that writes the rows.
EQUILIBRIUM_METACOG_GENERATIVE_POLL_INTERVAL_SEC=30
EQUILIBRIUM_METACOG_GENERATIVE_POSTGRES_URI=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
# Trailing rows read per poll. The service takes the max of this and what each
# detector needs, so setting it too low cannot silently disable a gate.
EQUILIBRIUM_METACOG_GENERATIVE_WINDOW_TICKS=20
# Staleness guard: reject a window whose newest row is older than this. The tick
# that writes these rows is itself flag-gated and can stop, and a frozen window
# can keep satisfying a gate condition forever (reproduced pre-fix: 20 rows all
# 3 days old fired the since-retired flow gate).
EQUILIBRIUM_METACOG_GENERATIVE_MAX_AGE_SEC=120
# Real cadence of the writing tick, used to turn the detector's tick windows
# into wall-clock bounds. Row adjacency is NOT tick adjacency -- rows with a
# missing/non-finite confidence are dropped, so 20 "consecutive" rows can span
# hours (reproduced pre-fix: a 20-row window covering 6.08h fired the
# since-retired flow gate as though it were 10 minutes of calm).
EQUILIBRIUM_METACOG_GENERATIVE_EXPECTED_TICK_SEC=30
# Slack multiplier on those derived bounds; absorbs normal tick jitter without
# letting a genuinely gappy window through.
EQUILIBRIUM_METACOG_GENERATIVE_SPAN_TOLERANCE=2.0
# Own cooldown lane from day one -- see chat_turn's comment above for the
# shared-lane bug this avoids.
EQUILIBRIUM_METACOG_INSIGHT_COOLDOWN_SEC=300
# PROVISIONAL thresholds, pending the longer-window re-run scheduled 2026-08-02.
# Matched to this metric's real observed range (the design doc's original 0.5/0.8
# anchors fired zero events because prediction_error_confidence never dropped to
# 0.5). Re-measured 2026-07-30 over 20.6h/2265 real ticks: range 0.597-0.977,
# mean 0.893, 14 ticks at/below 0.70 and 1544 at/above 0.90 -- both bands real
# and reachable, neither degenerate.
EQUILIBRIUM_METACOG_INSIGHT_LOW_THRESHOLD=0.70
EQUILIBRIUM_METACOG_INSIGHT_HIGH_THRESHOLD=0.90
# Observed ticks-to-cross were 1, 3 and 12 -- 15 covers the measured max with
# headroom while still rejecting an hours-old low as a "recovery".
EQUILIBRIUM_METACOG_INSIGHT_MAX_TICKS_TO_CROSS=15
# Consecutive newest ticks that must hold the high band before a climb counts as
# resolved. Recoveries are a median 3-tick gradual climb, so a single-tick check
# would fire partway up -- this is the one gate in this service that is
# deliberately not a single-tick threshold crossing.
EQUILIBRIUM_METACOG_INSIGHT_CONFIRM_TICKS=2

# Spark heartbeat (idle keepalive)
EQUILIBRIUM_SPARK_HEARTBEAT_ENABLE=false
EQUILIBRIUM_SPARK_HEARTBEAT_INTERVAL_SEC=30
