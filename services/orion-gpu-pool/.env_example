# orion-gpu-pool — one lease queue for every GPU on circe.
# Spec: docs/superpowers/specs/2026-09-24-gpu-pool-design.md
# Rules (cards, roles, borrowing, priorities, grace) live in config/gpu_pool.yaml, not here.
PROJECT=orion-athena
SERVICE_NAME=orion-gpu-pool
SERVICE_VERSION=0.1.0
NODE_NAME=athena
LOG_LEVEL=INFO
GPU_POOL_PORT=8127

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10
RPC_HEALTH_PUBLISH_ENABLED=true
RPC_HEALTH_PUBLISH_INTERVAL_SEC=30

# Same database as durable-runs; apply services/orion-sql-db/manual_migration_gpu_pool_v1.sql first.
POSTGRES_URI=

# Stage 5.7: enforce (the end state). Both modes load/unload every swap seat that has a `launch:` block
# in config/gpu_pool.yaml. There is no list of seats to arm (stage 5.7 deleted it); config decides.
#   enforce: at boot (and on resume) the pool asks the actuator what each seat's cards hold and adopts
#            it; operator holds are allowed for seats that can load.
#   observe: the ROLLBACK. No boot/resume reconcile and operator holds are refused. Its liveness
#            adoption only covers a seat the pool has never acted on (none today: agent-gpu2 has), so
#            for gpu2 observe adopts nothing changed by hand. Anything else fails the boot.
# Emergency stop is NOT a mode: Hub GPU pool panel -> "Emergency stop", or control verb pause_actuation
# (runbook docs/runbooks/2026-09-30-gpu-pool-stage5-7-enforce.md).
GPU_POOL_MODE=enforce
GPU_POOL_TICK_SEC=1.0
GPU_POOL_PROBE_INTERVAL_SEC=15.0
GPU_POOL_PROBE_TIMEOUT_SEC=3.0
# A worker announces every 30s; after this long without one its port reads "silent" (no grants).
GPU_POOL_ANNOUNCE_STALE_SEC=120.0
GPU_POOL_STATE_PUBLISH_SEC=5.0
GPU_POOL_REPLAY_PAYLOAD_MAX_BYTES=262144
# A lease that ended (released or unavailable) is forgotten after this long: its checkpoint
# history (~30 KB) and its row in gpu_pool_leases. Tens of thousands of leases a day. Backfill
# replay and the Hub walker reach back this far; dead letters are kept for operator replay.
# The Hub's historical traffic views read gpu_pool_events (30-day retention), not these.
GPU_POOL_LEASE_RETENTION_HOURS=168

# Swap-load guards (config/gpu_pool.yaml swap.guards), read every GPU_POOL_GUARD_REFRESH_SEC outside
# the lease lock. A guard that cannot be read blocks loads (swap_requested reason=guard:<name>).
GPU_POOL_CABINET_URL=http://100.92.216.81:8080/api/cabinet/sensors/latest
GPU_POOL_GUARD_REFRESH_SEC=30
# U4 shed lever kill switch. true = the pool stops NEW background/system grants while a shed reason
# is active (today only cooling_incident, from orion-hardware-watch's open AC incident + warm cabinet).
# false = signals still shown in /health and the state, nothing blocked. Code default true (2026-10-10,
# aligned to this file and production so a missing key cannot silently disarm the lever).
GPU_POOL_SHED_ENABLED=true
# Orion's learned shed action (attend-to-act loop A1, docs/superpowers/specs/2026-09-29-attend-to-act-loop-design.md).
# Lets Orion itself set the lower-precedence reason orion_self_shed: no NEW background grants for <= 15 min
# (running work finishes, nothing recalled, never system/interactive/urgent). Turned on by Juniper
# (live since 2026-10-01; code default on since 2026-10-10). false refuses every request and cancels an active
# Orion shed at boot. Never touches cooling_incident (the reflex) or GPU_POOL_SHED_ENABLED.
GPU_POOL_ORION_SHED_ENABLED=true
# Caps, enforced in the pool: max TTL per shed, max Orion-shed seconds per rolling 24 h, min gap
# from the end of one shed to the start of the next.
GPU_POOL_ORION_SHED_MAX_TTL_SEC=900
GPU_POOL_ORION_SHED_MAX_SEC_PER_DAY=3600
GPU_POOL_ORION_SHED_MIN_GAP_SEC=900
