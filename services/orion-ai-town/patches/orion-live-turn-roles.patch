+// Chat models need the last turn to be the partner's. If the history ends on
+// our own line (or is empty), add a neutral cue instead of a "Name to Name:" one.
+function replyCue(messages: LLMMessage[], otherName: string): LLMMessage[] {
+  if (messages.length > 0 && messages[messages.length - 1].role === 'user') {
+    return [];
+  }
+  return [{ role: 'user', content: `(${otherName} is waiting for your reply.)` }];
+}
