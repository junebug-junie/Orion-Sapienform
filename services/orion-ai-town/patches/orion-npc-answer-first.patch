+function isTownFarewell(text: string): boolean {
+  const words = text
+    .toLowerCase()
+    .replace(/[^a-z\s']/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim()
+    .split(' ')
+    .filter(Boolean);
+  if (words.length === 0 || words.length > 6) {
+    return false;
+  }
+  const last = words[words.length - 1];
+  return last === 'bye' || last === 'goodbye' || last === 'later' || last === 'byebye';
+}
