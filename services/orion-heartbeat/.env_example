SERVICE_NAME=orion-heartbeat
SERVICE_VERSION=0.1.0
NODE_NAME=athena
INSTANCE_ID=

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
ORION_HEALTH_CHANNEL=orion:system:health
HEARTBEAT_INTERVAL_SEC=10.0

# Existing, already-registered channel (orion/bus/channels.yaml) -- the
# heartbeat is a second, additive, read-only consumer. It publishes its own
# H1 summary atoms back onto it, and its seat rollup on
# orion:heartbeat:seat:rollup (below).
CHANNEL_GRAMMAR_EVENT=orion:grammar:event

# How often the H1 (boundary/bulk entanglement) result is recomputed from the
# live substrate. Computation itself is cheap (~6ms); this just controls how
# fresh the debug HTTP surface's /h1 response is.
HEARTBEAT_H1_INTERVAL_SEC=30.0

# Fixed BASE seed for the N-trajectory ensemble's initial random MPS states
# (trajectory i uses HEARTBEAT_SUBSTRATE_SEED + i). v0 has no crash-safe
# snapshot/restore (see docs/superpowers/specs/2026-07-24-spark-field-
# holographic-lattice-design.md's "Explicit deferrals") -- a restart
# reinitializes from these same seeds rather than resuming prior state.
HEARTBEAT_SUBSTRATE_SEED=42

HEARTBEAT_HTTP_PORT=7251

# --- N-trajectory dissipation ensemble (2026-07-28) ---
# docs/superpowers/specs/2026-07-28-precision-weighted-attention-organ-and-
# heartbeat-discrimination-design.md. Defaults are sweep-derived
# (scripts/analysis/measure_heartbeat_ensemble_calibration.py), confirmed
# against both synthetic and real historical grammar_events replay.

# Number of independent trajectories in the dissipation ensemble. 8 measured
# at ~118ms/tick compute cost, comfortably under this system's real average
# tick interval with headroom for bursts -- not yet re-validated for how the
# estimate stabilizes as N increases (a starting default, not a converged
# optimum).
HEARTBEAT_N_TRAJECTORIES=8

# Fraction each relaxation-gate application contracts a site toward this
# trajectory's own seed-derived target.
HEARTBEAT_DECAY_GAMMA=0.2

# Base per-site decay probability before spread-gating scales it down when
# trajectories disagree (something still unresolved).
HEARTBEAT_BASE_DECAY_PROB=0.15

# How sharply cross-trajectory disagreement suppresses decay.
HEARTBEAT_DECAY_SPREAD_SENSITIVITY=4.0

# Wall-clock cadence (seconds) for the decay dissipation loop -- deliberately
# separate from message consumption so dissipation keeps running even when
# organs go quiet. (The bus_synaptic "reheat" and its HEARTBEAT_REHEAT_* and
# FALKORDB_* keys were removed 2026-11-24, #3838: the driver sat below its own
# calm floor and did not move with bus activity.)
HEARTBEAT_DECAY_INTERVAL_SEC=2.0

# Bound on the message-intake -> absorb queue -- decouples cheap message
# intake from the N-trajectory absorb() cost so a burst degrades to
# dropped-and-counted events rather than blocking the bus consumer loop.
HEARTBEAT_ABSORB_QUEUE_MAXSIZE=10000

# Wall-clock window (seconds) for organ occupancy: dark_seats,
# organ_fire_counts, organ_distinctness on /h1. Replaces the old 64-event
# count window. Empty window reads unknown, not all-dark.
HEARTBEAT_ORGAN_FIRE_WINDOW_SEC=300.0

# H1 summary atom on orion:grammar:event (trace prefix heartbeat.h1:), one
# per HEARTBEAT_VERDICT_SUMMARY_INTERVAL_SEC (always sent, also when no H1
# tick completed). It is labelled with the 2026-11-08 replay's reading: the
# verdict class is noise, mean_ratio is a last-3-events sequence meter. The
# settled-transition atom (and HEARTBEAT_VERDICT_SETTLE_TICKS /
# HEARTBEAT_VERDICT_MAX_TRANSITIONS_PER_HOUR) was retired 2026-11-24, #3838.
# Ledger-only: no reducer or field channel reads it.
HEARTBEAT_VERDICT_ATOMS_ENABLED=true
HEARTBEAT_VERDICT_SUMMARY_INTERVAL_SEC=3600.0

# Five-minute seat rollup (issue #3886, app/seat_rollup.py). One
# HeartbeatSeatRollupV1 per seat per closed 5-minute bucket on
# orion:heartbeat:seat:rollup -> orion-sql-writer -> heartbeat_seat_rollup_5m.
# Durable seat history for scripts/demon_network_replay.py: grammar_events
# keeps only ~3 days. A silence on orion:grammar:event longer than the gap
# (seconds) marks the buckets it spans partial (read as missing, not zero);
# so does every resubscribe. A bucket is published the grace (seconds) after
# it ends; an atom arriving later is dropped and counted on /health.
HEARTBEAT_SEAT_ROLLUP_ENABLED=true
HEARTBEAT_SEAT_ROLLUP_SILENCE_GAP_SEC=60.0
HEARTBEAT_SEAT_ROLLUP_FLUSH_GRACE_SEC=120.0
