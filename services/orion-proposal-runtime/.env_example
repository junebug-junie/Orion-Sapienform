PROJECT=orion-athena
SERVICE_NAME=orion-proposal-runtime
SERVICE_VERSION=0.1.0
NODE_NAME=athena

# Bus-native SystemHealthV1 heartbeat (orion:system:health). This is proposal-runtime's only
# bus connection -- the rest of the service polls Postgres directly.
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10

POSTGRES_URI=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
PROPOSAL_POLICY_PATH=/app/config/proposals/proposal_policy.v1.yaml
PROPOSAL_POLL_INTERVAL_SEC=2.0
ENABLE_PROPOSAL_RUNTIME=true
# Transport M7: allow transport inspect proposals; read_only prevents destructive bus actions (default off)
ENABLE_TRANSPORT_PROPOSALS=true
TRANSPORT_PROPOSAL_MODE=read_only
LOG_LEVEL=INFO

# Phase B: incorporate spontaneous-thought (reverie) proposals (default-off,
# operator_review-gated, never auto-dispatch).
ORION_REVERIE_PROPOSE_ENABLED=true
# Phase B dispatch gate ("sends email"). Default-off. Only records an inspectable
# posture on the candidate; never lowers the operator_review gate — a human still
# approves any reverie action.
ORION_REVERIE_AUTOACTION_ENABLED=false

# Attend-to-act loop (docs/superpowers/specs/2026-09-29-attend-to-act-loop-design.md): build world
# candidates bound to the WORKSPACE broadcast winner (today: shed_background_gpu, emitted only when
# the winner is biometrics/cabinet AND the cabinet is elevated + rising AND hardware-watch is idle AND
# background GPU work exists). Record-only on its own: execution dispatch blocks every such candidate
# `world_actions_disabled` until ORION_WORLD_ACTIONS_ENABLED is set there (Juniper's flip).
ORION_WORKSPACE_WINNER_PROPOSALS_ENABLED=true
# hardware-watch /health (compose service key). Unreachable/stale/disabled = reflex not known idle =
# the action is ineligible.
ORION_HARDWARE_WATCH_HEALTH_URL=http://hardware-watch:8131/health
# The learned action's "rising" threshold (C per 15 min; the reflex uses 1.0 via the same function).
ORION_SHED_RISE_THRESHOLD_C=0.5

# Temporal Self rev 4, R3 reader 4: while Orion's arousal (Redis orion:regulation:latest, written
# by orion-durable-runs) reads `strained`, a due visual-reverie baseline image is deferred by the
# policy's retry_sec (frame warning arousal_strained). Missing / stale / unknown / Redis down /
# false = today's behaviour. Read once per due image, not per tick.
ORION_VISUAL_BASELINE_AROUSAL_ENABLED=true
# A regulation state older than this (3 regulate steps) reads as unknown.
ORION_REGULATION_READER_MAX_AGE_SEC=360
