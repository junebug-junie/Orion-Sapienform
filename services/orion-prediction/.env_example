# orion-prediction -- forecasting, evaluation, and cause-and-effect estimates over Orion's telemetry.
# Spec: docs/superpowers/specs/2026-10-15-orion-prediction-service-design.md
# Apply services/orion-sql-db/manual_migration_prediction_v1.sql BEFORE the first start.
PROJECT=orion-athena
SERVICE_NAME=orion-prediction
SERVICE_VERSION=0.1.0
NODE_NAME=athena
LOG_LEVEL=INFO
PREDICTION_PORT=8132

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10

# Same database as the telemetry it reads (orion_biometrics_summary, home_cooling_sample).
POSTGRES_URI=

# Series registry baked into the image from config/prediction/.
PREDICTION_SERIES_PATH=/app/config/prediction/series.v1.yaml

# --- kill switches ---
# Run the select -> issue -> score -> monitor loop. false = HTTP only (causal endpoints still answer).
PREDICTION_ENABLED=true
# Publish orion:prediction:forecast. false = store only.
PREDICTION_PUBLISH_ENABLED=true

PREDICTION_TICK_SEC=30
# A grain bucket counts as complete this long after it ends.
PREDICTION_SETTLE_SEC=60
# Re-run the backtest + per-horizon gate this often (~6-7 min of CPU for 40 windows x 6 models).
PREDICTION_SELECT_INTERVAL_SEC=21600
PREDICTION_BACKTEST_WINDOWS=40
PREDICTION_BACKTEST_STEP_MIN=180
# Forecast every contender model in the shadow and grade it live; the gate uses those live verdicts.
# false = backtest-only gate and no worse_than_baseline alert (it reads the live verdicts).
PREDICTION_SHADOW_ENABLED=true
# Champion ranges: calibrated on the last 3 days of live scores, scaled by the last hour's
# miss size (app/adaptive.py). Also family A's per-reading ranges (#3310). false = one-width backtest
# ranges for single series (the pre-2026-11-10 behavior) and validation ranges for family A.
PREDICTION_ADAPTIVE_INTERVALS_ENABLED=true
# Publish prediction.surprise.v1 (orion:prediction:surprise) for each scored forecast that passes the
# issue-time gate: champion, issued by a non-baseline model, adaptive range (5/15 min), real actual.
# substrate-runtime folds it into node:prediction.room / node:prediction.body. false = kill switch.
PREDICTION_SURPRISE_EVENTS_ENABLED=true

# --- world-model shadow for action bets (scored and graded, never served) ---
PREDICTION_WORLD_MODEL_SHADOW_ENABLED=true
# Path inside the container, and the host directory mounted read-only at /models.
PREDICTION_WORLD_MODEL_WEIGHTS=/models/transition.npz
PREDICTION_WORLD_MODEL_DIR=/mnt/storage-warm/orion-dojo/models

# --- turn self-bets (app/turn_self_bets.py; unified-turn self-prediction spec, A3) ---
# Settle stance's private bets about its own turn (thought_decision.self_prediction) against the turn's
# record (harness_turn_trace) and grade them: GET /turn-self-bets/live. false = no settle loop.
PREDICTION_TURN_SELF_BETS_ENABLED=true
PREDICTION_TURN_SELF_BETS_SETTLE_SEC=60
# Publish prediction.turn_surprise.v1 (orion:prediction:turn_surprise) for each settled chat turn: how much
# the turn surprised stance's own bets (asks a question, more steps than usual; app/turn_surprise.py).
# substrate-runtime folds it into node:prediction.chat_turn. false = kill switch (the node goes stale).
PREDICTION_TURN_SURPRISE_EVENTS_ENABLED=true
# Street rhythm surprise (app/street_rhythm.py): read the walkway rhythm expectations orion-sql-writer scored
# (vision_percept_expectation, read-only) and publish prediction.street_rhythm_surprise.v1
# (orion:prediction:street_rhythm_surprise) per scored outcome: how surprised the rhythm forecast was by who
# did or didn't appear. substrate-runtime folds it into node:prediction.street_rhythm (shadow until the 7-day
# calm check, evals/run_street_rhythm_calm_eval.py). false = kill switch (the node ages to absent).
PREDICTION_STREET_RHYTHM_EVENTS_ENABLED=true
PREDICTION_STREET_RHYTHM_TICK_SEC=60

# --- Juniper reachable (app/reachable.py): hourly "message in the next hour?" forecast, settled from
# chat_message, graded vs a base rate overall and for cold hours. GET /reachable. false = no loop.
PREDICTION_REACHABLE_ENABLED=true

# --- act chain (app/act_chain.py, family B): every 15 min, "which act does Orion do next?" forecast,
# settled from grammar_acts, graded vs marginal / clock baselines. GET /act-chain. false = no loop.
PREDICTION_ACT_CHAIN_ENABLED=true

# --- power-bill bet (app/bill_forecast.py): once a day, Orion's own projection of the current RMP bill
# (period-end kWh and pre-tax $, 80 % range), settled against energy_bill_actual. GET /bill-forecast.
# Past days are backfilled once per boot as origin=replay (never graded). false = no loop.
PREDICTION_BILL_FORECAST_ENABLED=true
PREDICTION_BILL_FORECAST_TICK_SEC=900
# Same values as services/orion-energy/.env_example (the tariff file is baked into this image too).
ENERGY_TARIFF_PATH=/app/config/energy/tariff.rmp_ut_sch1.2026-08-10.r3.yaml
ENERGY_TIMEZONE=America/Denver
ENERGY_BILLING_CYCLE_START_DAY=18
ENERGY_USAGE_POINT_ID=

# --- family A (app/family_a_live.py): every raw body and room reading at once, 5 and 15 min ahead ---
# Hygiene gate on every issue (refuses, never degrades), per-reading forecasts in prediction_forecast
# (series_id family_a:<reading>), one joint surprise per bucket in prediction_joint_surprise.
# Apply services/orion-sql-db/manual_migration_prediction_joint_surprise_v1.sql first. false = no loop.
PREDICTION_FAMILY_A_ENABLED=true
# Inputs and fixed hygiene thresholds, baked into the image from config/prediction/.
PREDICTION_FAMILY_A_CONFIG_PATH=/app/config/prediction/family_a.v1.yaml
# Publish prediction.joint_surprise.v1 (orion:prediction:joint_surprise) for each scored joint-group row
# (body / room, with the adaptive p, target <= 30 min old). substrate-runtime folds it into
# node:prediction.body_joint / node:prediction.room_joint (successor of node:substrate.biometrics).
# false = rows still stored, nothing published (both nodes go stale = absent, never calm).
PREDICTION_JOINT_SURPRISE_EVENTS_ENABLED=true

# --- weather covariates (shared Open-Meteo client, orion/weather/openmeteo.py) ---
PREDICTION_WEATHER_ENABLED=true
PREDICTION_WEATHER_REFRESH_SEC=3600
# Same keys as the situation layer (orion-hub's .env). Copy the values from there; empty = weather off.
ORION_SITUATION_WEATHER_LAT=
ORION_SITUATION_WEATHER_LON=

# --- switchback experiment runner (POST /experiments/run; app/experiment_runner.py) ---
# Performs vision.focus:<stream_id> experiments: holds Redis key orion:vision:experiment:<stream_id>=on
# on the bus Redis (ORION_BUS_URL) during ON blocks; the vision frame router forces that stream's
# triggered tier. Never starts on boot. false = POST /experiments/run answers 503.
PREDICTION_EXPERIMENT_RUNNER_ENABLED=true
# Frame router /healthz on app-net (per-stream dispatch tier counts = the manipulation check).
PREDICTION_VISION_ROUTER_URL=http://orion-vision-frame-router:8010
# TTL on the override key (refreshed every tick): a dead runner leaves focus on at most this long.
PREDICTION_EXPERIMENT_OVERRIDE_TTL_SEC=90
PREDICTION_EXPERIMENT_TICK_SEC=30
# Re-check GET /experiments/guard this often during a run (and before every ON block).
PREDICTION_EXPERIMENT_GUARD_EVERY_SEC=300
# --- Family C Experiment 1: town-hold runner (POST /experiments/town-hold/run; app/town_hold.py) ---
# Randomly holds Orion's AI Town session STARTS for 40 min (Redis orion:physiology:run_cap:aitown.session,
# TTL = PREDICTION_EXPERIMENT_OVERRIDE_TTL_SEC). Never starts on its own: an operator starts a run; a
# scheduled run resumes after a restart from its next night. false = 503 and no resume.
PREDICTION_TOWN_HOLD_ENABLED=true
# orion-embodiment /health on app-net (the town's own start gate: start_eligible_at, start_in_flight).
PREDICTION_EMBODIMENT_URL=http://orion-athena-embodiment:8130
