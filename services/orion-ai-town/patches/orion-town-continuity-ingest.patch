+const TOWN_PARTICIPANT_SLUGS: Record<string, string> = {
+  'Mara Vale': 'mara-vale',
+  'Nico Sable': 'nico-sable',
+  'Sofia Bell': 'sofia-bell',
+  'Cam Lin': 'cam-lin',
+  'Juniper Feld': 'juniper-feld',
+  'Orion': 'orion',
+};
+
+function townSlug(name: string): string | null {
+  return TOWN_PARTICIPANT_SLUGS[name] ?? null;
+}
+
+function townThreadId(a: string, b: string): string | null {
+  const left = townSlug(a);
+  const right = townSlug(b);
+  if (!left || !right) return null;
+  return [left, right].sort().join('--');
+}
+
+function isOrionName(name: string): boolean {
+  const configured = (process.env.AITOWN_ORION_NAME || 'Orion').trim();
+  return name.trim() === configured;
+}
+
+function townLastOtherPrompt(messages: LLMMessage[], otherName: string): string {
+  const marker = `${otherName} to `;
+  for (let i = messages.length - 1; i >= 0; i--) {
+    const content = String(messages[i]?.content || '');
+    if (!content.startsWith(marker)) {
+      continue;
+    }
+    const sep = content.indexOf(': ');
+    if (sep >= 0) {
+      return content.slice(sep + 2).trim();
+    }
+  }
+  return '';
+}
+
+async function fetchTownContinuity(speakerName: string, otherName: string): Promise<string> {
+  try {
+    const speakerId = townSlug(speakerName);
+    const threadId = townThreadId(speakerName, otherName);
+    const base = (process.env.SOCIAL_MEMORY_URL || '').trim().replace(/\/+$/, '');
+    if (!speakerId || !threadId || !base) {
+      return '';
+    }
+    const params = new URLSearchParams({
+      platform: 'aitown',
+      room_id: 'aitown-town',
+      thread_id: threadId,
+      speaker_id: speakerId,
+    });
+    const res = await fetch(`${base}/town-continuity?${params.toString()}`, {
+      signal: AbortSignal.timeout(3000),
+    });
+    if (!res.ok) {
+      return '';
+    }
+    const data = await res.json();
+    return formatTownContinuity(data);
+  } catch {
+    return '';
+  }
+}
+
+function formatTownContinuity(data: unknown): string {
+  const body = data && typeof data === 'object' ? (data as Record<string, unknown>) : {};
+  const pair = Array.isArray(body.pair_turns) ? body.pair_turns : [];
+  const town = Array.isArray(body.town_turns) ? body.town_turns : [];
+  const lines: string[] = [];
+  const render = (rows: unknown[]) => {
+    const out: string[] = [];
+    for (const row of rows) {
+      if (!row || typeof row !== 'object') continue;
+      const speaker = String((row as { speaker?: unknown }).speaker || '').trim();
+      const text = String((row as { text?: unknown }).text || '').trim();
+      if (speaker && text) out.push(`${speaker}: ${text}`);
+    }
+    return out;
+  };
+  const pairLines = render(pair);
+  const townLines = render(town);
+  if (pairLines.length) {
+    lines.push('Earlier with them:', ...pairLines);
+  }
+  if (townLines.length) {
+    lines.push('From your other conversations:', ...townLines);
+  }
+  return lines.join('\n');
+}
+
+async function ingestTownTurn(args: {
+  speaker: string;
+  other: string;
+  prompt: string;
+  response: string;
+  conversationId: string;
+}): Promise<void> {
+  try {
+    if (isOrionName(args.other)) {
+      return;
+    }
+    const speakerSlug = townSlug(args.speaker);
+    const otherSlug = townSlug(args.other);
+    if (!speakerSlug || !otherSlug) {
+      return;
+    }
+    const threadId = townThreadId(args.speaker, args.other);
+    const base = (process.env.SOCIAL_MEMORY_URL || '').trim().replace(/\/+$/, '');
+    const token = (process.env.SOCIAL_MEMORY_INGEST_TOKEN || '').trim();
+    if (!threadId || !base) {
+      return;
+    }
+    await fetch(`${base}/ingest-turn`, {
+      method: 'POST',
+      signal: AbortSignal.timeout(3000),
+      headers: {
+        'Content-Type': 'application/json',
+        Authorization: `Bearer ${token}`,
+      },
+      body: JSON.stringify({
+        source: 'orion-ai-town',
+        prompt: args.prompt,
+        response: args.response,
+        text: `${args.other}: ${args.prompt}\n${args.speaker}: ${args.response}`,
+        session_id: `aitown:${args.conversationId}`,
+        tags: ['aitown'],
+        client_meta: {
+          external_room: {
+            platform: 'aitown',
+            room_id: 'aitown-town',
+            thread_id: threadId,
+          },
+          external_participant: {
+            participant_id: speakerSlug,
+            participant_name: args.speaker,
+            participant_kind: 'npc',
+          },
+        },
+      }),
+    });
+  } catch {
+    // Fail-open: never block NPC speech.
+  }
+}
