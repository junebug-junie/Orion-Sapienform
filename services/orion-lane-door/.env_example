# Lane door (leased-evals design Phase 2): a thin proxy in front of each model server.
# Spec: docs/superpowers/specs/2026-11-12-leased-evals-and-server-refusal-design.md
# Runbook (deploy, verify, roll back): docs/runbooks/2026-11-14-lane-door.md
#
# Runs on circe (chat, agent, agent-gpu2, fast) and hecate (agent-deep). Each door listens on its lane's
# published port and forwards to the engine on the docker network. The engine then publishes only on
# 127.0.0.1 (services/orion-llamacpp-host/.env_example *_ENGINE_PUBLISH).

PROJECT=orion

# SECRET: the same value as LLM_GATEWAY_LANE_DOOR_KEY in services/orion-llm-gateway/.env (athena).
# Generate once: openssl rand -hex 32. Empty = every gateway call reads "bad" in the door's log.
LANE_DOOR_KEY=

# off = pure pass-through (no counting, no log); shadow = log and count, refuse nothing.
# Ships shadow.
LANE_DOOR_MODE=shadow

# Per-call JSON lines, one file per lane per UTC day: <dir>/<lane>-YYYY-MM-DD.jsonl. No prompt text.
LANE_DOOR_LOG_HOST_DIR=/mnt/telemetry/lane-door
LANE_DOOR_LOG_RETENTION_DAYS=30
LANE_DOOR_SUMMARY_INTERVAL_SEC=600
LANE_DOOR_CONNECT_TIMEOUT_SEC=5

# Published ports: the lane ports the GPU pool already knows (config/gpu_pool.yaml roles). Unchanged.
LANE_DOOR_CHAT_PORT=8011
LANE_DOOR_AGENT_PORT=8015
LANE_DOOR_AGENT_GPU2_PORT=8016
LANE_DOOR_FAST_PORT=8013
LANE_DOOR_AGENT_DEEP_PORT=8021

# Engines on the docker network (container name:internal port). Chat on its llama.cpp rollback:
# LANE_DOOR_CHAT_UPSTREAM=orion-atlas-llamacpp-chat:8080. Same for the agent lane.
LANE_DOOR_CHAT_UPSTREAM=orion-atlas-strata-chat:8080
LANE_DOOR_AGENT_UPSTREAM=orion-atlas-strata-agent:8080
LANE_DOOR_AGENT_GPU2_UPSTREAM=orion-atlas-llamacpp-agent-burst:8080
LANE_DOOR_FAST_UPSTREAM=orion-atlas-llamacpp-fast:8080
LANE_DOOR_AGENT_DEEP_UPSTREAM=orion-hecate-vllm-host:8000
