# orion-docker-door: filtering proxy in front of the Docker socket for Orion's turns.
# Design: docs/superpowers/specs/2026-11-24-orion-safe-autonomy-in-place-design.md
PROJECT=orion-athena
# Container names allowed to call the door (comma list). Everyone else on app-net is refused.
DOCKER_DOOR_ALLOWED_CALLERS=orion-athena-harness-governor
DOCKER_DOOR_PORT=2375
# Host folder for the append-only record (docker-YYYY-MM-DD.jsonl).
DOCKER_DOOR_RECORD_HOST_DIR=/mnt/storage-warm/orion-record
DOCKER_SOCK_PATH=/var/run/docker.sock
