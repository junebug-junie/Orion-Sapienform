SERVICE_NAME=room-companion
SERVICE_VERSION=0.1.0
# See root .env's own NODE_NAME value -- set explicitly, do not rely on a
# shell placeholder like "$(hostname)" (docker-compose does not shell-evaluate
# .env values).
ROOM_COMPANION_NODE_NAME=athena

# Root .env already has PROJECT, NODE_NAME, ORION_BUS_URL -- leave
# ORION_BUS_URL commented out here to inherit it. If you must override:
# ALWAYS use redis://<tailscale-node-ip>:6379/0, per root CLAUDE.md.
#ORION_BUS_URL=redis://<tailscale-node-ip>:6379/0
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
HEARTBEAT_INTERVAL_SEC=10

CHANNEL_ROOM_CLAUDE_REQUEST=orion:room:claude:request
CHANNEL_ROOM_CLAUDE_UTTERANCE=orion:room:claude:utterance

# ── Real Claude Code session credential -- NOT a separate Anthropic API key.
# This service authenticates its `claude -p` subprocess as the operator's
# already-logged-in Claude Code CLI session (the same subscription login this
# repo's dev sessions run under), never via ANTHROPIC_API_KEY -- a rejected
# design that would open a second, pay-per-token billing relationship.
#
# WHY THIS SERVICE EXISTS AT ALL: the credential deliberately does not live in
# orion-hub. Hub runs as root with readable /root/.ssh, /root/.config/gh,
# /var/run/docker.sock and the repo mount, and Orion's own FCC turns run in
# that container with full Bash -- so a credential there is one Orion can read
# and use to spawn Claude outside the room's meter. In v2, when Orion can
# invite Claude itself, that difference is what makes a spend cap enforceable
# rather than advisory. Do not "simplify" this back into Hub.
#
# CLAUDE_CONFIG_DIR is Claude Code's own env var for relocating where it looks
# for `.credentials.json` (default `~/.claude`). docker-compose.yml bind-mounts
# ONLY the host's `.credentials.json` file (read-only, 600 perms) into this
# directory -- not the whole `~/.claude` dir, which also holds session
# transcripts, history.jsonl and caches. This service never writes to, logs, or
# echoes any part of that file.
#
# Host path is operator-specific and has NO default baked into code (compose
# uses `:?` so a missing value fails loudly rather than silently mounting
# nothing). The container-side path is generic: the container runs as root
# with no USER directive, so /root/.claude is its real HOME-relative default,
# NOT the host operator's home.
ROOM_COMPANION_CLAUDE_CREDENTIALS_HOST_PATH=/home/athena/.claude/.credentials.json
ROOM_COMPANION_CLAUDE_CONFIG_DIR=/root/.claude
ROOM_COMPANION_CLAUDE_BIN=claude
ROOM_COMPANION_MODEL=claude-sonnet-5
ROOM_COMPANION_EFFORT=medium
ROOM_COMPANION_TIMEOUT_SEC=180
# `user` only -- deliberately NOT `user,local`. A room conversation must not
# inherit this repo's own development contract (AGENTS.md/CLAUDE.md) or its
# project hooks as if they were room context. Claude is a participant here,
# not a coding agent working this repo.
ROOM_COMPANION_SETTING_SOURCES=user

# Neutral cwd for the subprocess. Tools are off, so nothing is read from here
# -- it exists so Claude Code's CLAUDE.md/settings discovery has nowhere
# interesting to look.
ROOM_COMPANION_WORKSPACE=/data/workspace

# How Claude appears in the room.
ROOM_COMPANION_PARTICIPANT_ID=claude
ROOM_COMPANION_PARTICIPANT_NAME=Claude

# room -> Claude session uuid, so Claude remembers the conversation across
# turns via `--resume` instead of the transcript being re-sent every time.
# On this service's own writable volume.
ROOM_COMPANION_SESSION_STATE_PATH=/data/state/room_companion_sessions.json
