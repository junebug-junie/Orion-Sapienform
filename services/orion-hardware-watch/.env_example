# orion-hardware-watch -- AC failure and CPU/GPU heat -> critical alert, urgent investigation,
# GPU pool shedding. Plan: docs/superpowers/plans/2026-09-29-urgent-curiosity-plan-4-5-hardware-watch-and-shedding.md
# Apply services/orion-sql-db/manual_migration_hardware_watch_v1.sql BEFORE the first start.
PROJECT=orion-athena
SERVICE_NAME=orion-hardware-watch
SERVICE_VERSION=0.1.0
NODE_NAME=athena
LOG_LEVEL=INFO
HARDWARE_WATCH_PORT=8131

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10

# Same database as the telemetry tables it reads (home_cooling_sample, orion_biometrics_summary).
POSTGRES_URI=
NOTIFY_BASE_URL=http://orion-athena-notify:7140
NOTIFY_API_TOKEN=

# --- kill switches (all default false in code) ---
# Evaluate the rules at all. false = the service answers HTTP and does nothing else.
HARDWARE_WATCH_ENABLED=true
# Ask the GPU pool to shed new background/system work while an AC incident is open and the cabinet
# is warm. The pool has its own switch (GPU_POOL_SHED_ENABLED); either one off = no shedding.
HARDWARE_WATCH_SHED_ENABLED=true
# Start an urgent curiosity investigation for each incident (orion:curiosity:urgent:request).
# false = AC incidents still send the critical alert; heat incidents then notify nobody.
HARDWARE_WATCH_URGENT_ENABLED=true
# POST /incidents/simulate opens a SIMULATED AC incident (real alert, real urgent run, real shed).
# Only for the live smoke; leave false.
HARDWARE_WATCH_TEST_HOOK_ENABLED=false

HARDWARE_WATCH_TICK_SEC=30
# Every open incident is re-published this often; the pool's shed signal lasts SHED_VALID_SEC.
HARDWARE_WATCH_REFRESH_SEC=60
HARDWARE_WATCH_SHED_VALID_SEC=300
# After Juniper resolves an incident by hand, the same rule+subject does not re-open for this long.
HARDWARE_WATCH_OPERATOR_SNOOZE_SEC=3600
# A refused AC alert is retried once per tick up to this many times (~30 min at 30 s).
HARDWARE_WATCH_ALERT_MAX_ATTEMPTS=60

# --- AC rule (subject cabinet_ac) ---
# home_cooling_sample.role of the AC plug (one plug today).
HARDWARE_WATCH_AC_ROLE=cabinet_cooling
HARDWARE_WATCH_AC_LOW_W=150
HARDWARE_WATCH_AC_LOW_SEC=180
HARDWARE_WATCH_AC_STALE_SEC=300
HARDWARE_WATCH_AC_FROZEN_SEC=3600
HARDWARE_WATCH_AC_RESOLVE_W=500
HARDWARE_WATCH_AC_RESOLVE_SEC=600

# --- shed: cabinet_temp_c on this node's biometrics summary; also sheds at thermal_gate's
# elevated 29.5 C and when the sensor is unreadable ---
HARDWARE_WATCH_CABINET_NODE=athena
HARDWARE_WATCH_SHED_RISE_C=1.0
HARDWARE_WATCH_SHED_RISE_WINDOW_SEC=900

# --- heat: own trailing p95 sustained, resolve below p75 ---
HARDWARE_WATCH_HEAT_NODES=athena,circe
HARDWARE_WATCH_GPU_NODES=athena,circe
HARDWARE_WATCH_HEAT_SUSTAIN_SEC=600
HARDWARE_WATCH_HEAT_BASELINE_DAYS=7
HARDWARE_WATCH_HEAT_BASELINE_REFRESH_SEC=3600
HARDWARE_WATCH_CPU_MIN_HISTORY_SEC=86400
# GPU p95 arms only after 3 days of gpu{N}_temp_c history; the ceiling is always armed.
HARDWARE_WATCH_GPU_MIN_HISTORY_SEC=259200
HARDWARE_WATCH_GPU_CEILING_C=85
HARDWARE_WATCH_GPU_CEILING_SUSTAIN_SEC=120
HARDWARE_WATCH_GPU_CEILING_REARM_C=80
