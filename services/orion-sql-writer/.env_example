# ───────────────────────────────────────────────────────────────
# ✍️  Orion SQL Writer
# ───────────────────────────────────────────────────────────────
#
# Mesh compose (from repo root; root .env supplies ORION_BUS_URL, PROJECT, NET, …):
#   docker compose --env-file .env --env-file services/orion-sql-writer/.env \
#     -f services/orion-sql-writer/docker-compose.yml up -d --build
#

# Identity
SERVICE_NAME=sql-writer
SERVICE_VERSION=0.4.0
#NODE_NAME=athena
PORT=8220
#PROJECT=orion-athena
#NET=app-net

# --- Bus ---
ORION_BUS_ENABLED=true
# ORION_BUS_URL — set in repo root .env (mesh global)
ORION_HEARTBEAT_INTERVAL_SEC=10.0
ORION_ERROR_CHANNEL=orion:system:error
ORION_SHUTDOWN_GRACE_SEC=10.0

# --- Routing ---
# Wrap the JSON list in single quotes (so commas don't break your shell)
# Legacy spark introspection channel is disabled by default. Re-add to subscribe explicitly if needed.
# Grammar atlas ledger: orion:grammar:event (grammar.event.v1) is in the default subscribe list below.
SQL_WRITER_SUBSCRIBE_CHANNELS=["orion:tags:enriched","orion:collapse:sql-write","orion:metacog:sql-write","orion:repair_pressure:appraisal","orion:vision:events:sql-write","orion:chat:history:log","orion:chat:history:turn","orion:chat:social:turn","orion:chat:response:feedback","orion:bridge:social:room:intake","orion:bridge:social:room:delivery","orion:bridge:social:room:skipped","orion:bridge:social:participant","orion:chat:gpt:log","orion:chat:gpt:turn","orion:chat:gpt:message:log","orion:chat:gpt:import:run","orion:chat:gpt:conversation","orion:chat:gpt:example","orion:chat:response:feedback","orion:dream:log","orion:telemetry:biometrics","orion:biometrics:summary","orion:biometrics:induction","orion:spark:telemetry","orion:cognition:trace","orion:thought:artifact","orion:harness:run:artifact","orion:harness:verdict:artifact","orion:substrate:turn_outcome","orion:substrate:post_turn_closure","orion:metacognition:tick","orion:equilibrium:metacog:trigger","orion:metacog:trace","orion:notify:persistence:request","orion:notify:persistence:receipt","orion:journal:write","orion:journal:index","orion:evidence:index:upsert","orion:evidence:markdown:ingest","orion:evidence:parsed:ingest","orion:endogenous:runtime:record","orion:endogenous:runtime:audit","orion:calibration:profile:audit","orion:world_pulse:run:result","orion:world_pulse:digest:created","orion:world_pulse:digest:item","orion:world_pulse:article:emit","orion:world_pulse:cluster:emit","orion:world_pulse:claim:emit","orion:world_pulse:event:emit","orion:world_pulse:entity:emit","orion:world_pulse:situation:brief:upsert","orion:world_pulse:situation:change:emit","orion:world_pulse:learning:emit","orion:world_pulse:worth:reading","orion:world_pulse:worth:watching","orion:world_context:daily_capsule","orion:world_pulse:publish:status","orion:hub:messages:create","orion:mind:artifact","orion:grammar:event","orion:equilibrium:transition","orion:chat:history:spark_meta:patch","orion:autonomy:action:outcome","orion:self:phi_reward","orion:causal_geometry:snapshot","orion:debug:attention:streak_tick","orion:substrate:dev_economics_ledger","orion:substrate:doc_semantic_drift","orion:substrate:juniper_affective_state"]

SQL_WRITER_ENABLE_SPARK_SNAPSHOT_CHANNEL=true
# Set false to skip orion:grammar:event when grammar_events table is degraded.
SQL_WRITER_ENABLE_GRAMMAR_CHANNEL=true
SPARK_LEGACY_MODE=drop

# Concurrent Hunter handlers + bounded DB inflight (grammar is async-isolated).
SQL_WRITER_CONCURRENT_HANDLERS=true
SQL_WRITER_MAX_INFLIGHT=12
SQL_WRITER_DB_POOL_SIZE=10
SQL_WRITER_DB_MAX_OVERFLOW=20

# Grammar lane: isolated pool + trace-id sharded workers (does not share operational write semaphore).
SQL_WRITER_GRAMMAR_WORKERS=4
SQL_WRITER_GRAMMAR_POOL_SIZE=4
SQL_WRITER_GRAMMAR_POOL_MAX_OVERFLOW=4
SQL_WRITER_GRAMMAR_STATEMENT_TIMEOUT_MS=10000
SQL_WRITER_GRAMMAR_LOCK_TIMEOUT_MS=3000
# 2026-08-19: dropped 30->15 days. Previously never actually enforced (missing
# index -> full scan -> statement timeout on every startup); see
# idx_grammar_events_created_at in manual_migration_grammar_atlas.sql and
# services/orion-sql-writer/README.md's "Grammar/substrate table retention" section.
GRAMMAR_EVENTS_RETENTION_DAYS=15
# batch_size 5000->1000, max_batches 20->100 (2026-08-19, live-verified): the DELETE's
# per-row primary-key lookup is real random I/O on grammar_events at this scale (8
# indexes, 16GB) -- a 5000-row batch measured at 20.6s, well past the 10s grammar
# statement timeout. 1000/batch leaves real margin; 100 max batches means
# MAX_ELAPSED_SEC below is what actually stops a run, gracefully, instead of an
# oversized batch dying mid-delete. See settings.py for the full writeup.
GRAMMAR_EVENTS_RETENTION_BATCH_SIZE=1000
GRAMMAR_EVENTS_RETENTION_MAX_BATCHES_PER_STARTUP=100
GRAMMAR_EVENTS_RETENTION_MAX_ELAPSED_SEC=120
# grammar_edges/grammar_atoms/substrate_organ_emissions had no retention at all
# before this patch. Reuse the batch/cap knobs above (same scale, same shape);
# only the retention window is independently configurable per table.
GRAMMAR_EDGES_RETENTION_DAYS=15
GRAMMAR_ATOMS_RETENTION_DAYS=15
SUBSTRATE_ORGAN_EMISSIONS_RETENTION_DAYS=15
# Do not subscribe sql-writer to orion:grammar:accepted-pressure unless explicitly intended.
SQL_WRITER_ALLOW_ACCEPTED_PRESSURE_INGEST=false
SQL_WRITER_GRAMMAR_TRACE_BATCH_MAX=64

# Wrap the JSON map in single quotes.
# Map: envelope.kind -> MODEL_MAP key in services/orion-sql-writer/app/worker.py.
# Omitted kinds merge with DEFAULT_ROUTE_MAP in app/settings.py at startup (env overrides defaults).
# mind.run.artifact.v1 -> MindRunSQL (must subscribe to orion:mind:artifact).
# grammar.event.v1 -> GrammarEventSQL (subscribe to orion:grammar:event).
# equilibrium.service.transition.v1 -> EquilibriumServiceTransitionSQL (historical
# downtime persistence, must subscribe to orion:equilibrium:transition -- a
# separate channel from orion:equilibrium:snapshot on purpose, see that
# channel's own comment in orion/bus/channels.yaml).
SQL_WRITER_ROUTE_MAP_JSON={"collapse.mirror":"CollapseMirror","collapse.mirror.entry.v2":"CollapseMirror","metacog.entry.v1":"MetacogEntry","repair_pressure.appraisal.v1":"RepairPressureAppraisalLog","collapse.enrichment":"CollapseEnrichment","tags.enriched":"CollapseEnrichment","chat.history":"ChatHistoryLogSQL","chat.log":"ChatHistoryLogSQL","chat.history.message.v1":"ChatMessageSQL","chat.response.feedback.v1":"ChatResponseFeedbackSQL","chat.gpt.log.v1":"ChatGptLogSQL","chat.gpt.turn.v1":"ChatGptLogSQL","chat.gpt.message.v1":"ChatGptMessageSQL","chat.gpt.import.run.v1":"ChatGptImportRunSQL","chat.gpt.conversation.v1":"ChatGptConversationSQL","chat.gpt.example.v1":"ChatGptDerivedExampleSQL","dream.log":"Dream","dream.result.v1":"Dream","biometrics.telemetry":"BiometricsTelemetry","biometrics.summary.v1":"BiometricsSummarySQL","biometrics.induction.v1":"BiometricsInductionSQL","causal.geometry.snapshot.v1":"CausalGeometrySnapshotSQL","spark.telemetry":"SparkTelemetrySQL","spark.state.snapshot.v1":"SparkTelemetrySQL","cognition.trace":"CognitionTraceSQL","thought.event.v1":"ThoughtDecisionSQL","harness.run.v1":"HarnessTurnTraceSQL","harness.verdict.molecule.v1":"HarnessTurnTraceSQL","harness.turn.outcome.v1":"HarnessTurnTraceSQL","harness.post_turn.closure.v1":"HarnessTurnTraceSQL","metacognition.tick.v1":"MetacognitionTickSQL","orion.metacog.trigger.v1":"MetacogTriggerSQL","metacognitive.trace.v1":"MetacognitiveTraceSQL","notify.notification.request.v1":"NotificationRequestDB","notify.notification.receipt.v1":"NotificationReceiptDB","notify.recipient.update.v1":"RecipientProfileDB","notify.preference.update.v1":"NotificationPreferenceDB","journal.entry.write.v1":"JournalEntrySQL","journal.entry.index.v1":"JournalEntryIndexSQL","evidence.unit.v1":"EvidenceUnitSQL","social.turn.v1":"SocialRoomTurnSQL","external.room.message.v1":"ExternalRoomMessageSQL","external.room.post.result.v1":"ExternalRoomMessageSQL","external.room.turn.skipped.v1":"ExternalRoomMessageSQL","external.room.participant.v1":"ExternalRoomParticipantSQL","endogenous.runtime.record.v1":"EndogenousRuntimeRecordSQL","endogenous.runtime.audit.v1":"EndogenousRuntimeAuditSQL","calibration.profile.audit.v1":"CalibrationProfileAuditSQL","world.pulse.run.result.v1":"WorldPulseRunSQL","world.pulse.digest.created.v1":"WorldPulseDigestSQL","world.pulse.digest.item.v1":"WorldPulseDigestItemSQL","world.pulse.article.emit.v1":"WorldPulseArticleSQL","world.pulse.cluster.emit.v1":"WorldPulseArticleClusterSQL","world.pulse.claim.emit.v1":"WorldPulseClaimSQL","world.pulse.event.emit.v1":"WorldPulseEventSQL","world.pulse.entity.emit.v1":"WorldPulseEntitySQL","world.pulse.situation.brief.upsert.v1":"WorldPulseSituationBriefSQL","world.pulse.situation.change.emit.v1":"WorldPulseSituationChangeSQL","world.pulse.learning.emit.v1":"WorldPulseLearningDeltaSQL","world.pulse.worth.reading.v1":"WorldPulseWorthReadingSQL","world.pulse.worth.watching.v1":"WorldPulseWorthWatchingSQL","world.context.daily.capsule.v1":"WorldPulseContextCapsuleSQL","world.pulse.publish.status.v1":"WorldPulsePublishStatusSQL","hub.messages.create.v1":"WorldPulseHubMessageSQL","mind.run.artifact.v1":"MindRunSQL","grammar.event.v1":"GrammarEventSQL","chat.history.spark_meta.patch.v1":"__patch_chat_history__","vision.event.v1":"VisionEventSQL","action.outcome.emit.v1":"ActionOutcomeSQL","debug.attention.streak_tick.v1":"DominanceStreakTickSQL","substrate.dev_economics_ledger.v1":"DevEconomicsLedgerSQL","substrate.doc_semantic_drift.v1":"DocSemanticDriftSQL","juniper.affective_state.v1":"JuniperAffectiveStateSQL","self.phi_reward.v1":"PhiRewardSQL","equilibrium.service.transition.v1":"EquilibriumServiceTransitionSQL"}

# --- DB ---
DATABASE_URL=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
POSTGRES_URI=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
ORION_HEALTH_CHANNEL=orion:system:health

SQL_WRITER_EMIT_JOURNAL_CREATED=true
SQL_WRITER_JOURNAL_CREATED_CHANNEL=orion:journal:created
SQL_WRITER_EMIT_SOCIAL_TURN_STORED=true
SQL_WRITER_SOCIAL_TURN_STORED_CHANNEL=orion:chat:social:stored
SQL_WRITER_EMIT_MEMORY_TURN_PERSISTED=true
CHANNEL_MEMORY_TURN_PERSISTED=orion:memory:turn:persisted
CHANNEL_CHAT_HISTORY_SPARK_META_PATCH=orion:chat:history:spark_meta:patch
METACOG_TRACE_RETENTION_DAYS=14
# DRIVE_AUDITS_RETENTION_DAYS removed 2026-08-13: drive_audits table and its
# whole orion-sql-writer write path were fully removed that day. See
# docs/superpowers/pr-reports/2026-08-13-untangle-drive-audit-sql-writer-pr.md.

# goal_provenance_streak_ticks startup prune window; 0 disables. Unlike the
# now-removed drive_audits above, this table has a real, live producer (orion-attention-runtime, ~1 row per real field
# tick) and defaults ON -- see orion/schemas/field_goal.py's DominanceStreakTickV1 docstring
# and orion/bus/channels.yaml's orion:debug:attention:streak_tick entry.
GOAL_PROVENANCE_STREAK_TICKS_RETENTION_DAYS=14

# Postgres statement_timeout (ms) on every sql-writer connection; 0 disables.
SQL_WRITER_DB_STATEMENT_TIMEOUT_MS=30000
# Postgres lock_timeout (ms) on every sql-writer connection; 0 disables.
SQL_WRITER_DB_LOCK_TIMEOUT_MS=10000
# Max seconds to wait for grammar_events ledger persist before cancel + fallback + next message.
SQL_WRITER_GRAMMAR_PERSIST_TIMEOUT_SEC=15

# --- bus_fallback_log backlog watcher (app/fallback_watch.py) ---
# Alerts (Hub in_app + email) when unrouted events pile up in bus_fallback_log.
# Nothing watched this table until 2026-08-14, which is how two separate routing
# failures each ran for hours while every surface reported healthy. ON by
# default -- a monitor that ships disabled is a monitor that is off in prod.
SQL_WRITER_FALLBACK_WATCH_ENABLED=true
SQL_WRITER_FALLBACK_WATCH_INTERVAL_SEC=300
# Trailing window the count is taken over. 24h, not minutes: the real incidents
# dribbled a few events per hour, and a short window never accumulates enough to
# cross a threshold before someone notices by hand anyway.
SQL_WRITER_FALLBACK_WATCH_WINDOW_SEC=86400
# One alert per multiple crossed: 5, then 10, then 15, ... The high-water mark
# is persisted in bus_fallback_alert_state and ratchets back down as the backlog
# drains, so recovery re-arms the lower levels.
SQL_WRITER_FALLBACK_WATCH_THRESHOLD_STEP=5

# Notify service, used ONLY by the watcher above. This service already persists
# notify records (models/notify_models.py); it had never sent one until now.
#
# Host is the compose SERVICE name "notify", not the container name
# "orion-athena-notify" and not the directory name "orion-notify". Both of those
# have already broken this exact URL in other services -- see the comment block
# in services/orion-notify-digest/.env_example. Verified live 2026-08-14 from
# inside orion-athena-sql-writer: `notify` resolves and /health returns ok.
NOTIFY_SERVICE_URL=http://notify:7140
NOTIFY_API_TOKEN=
