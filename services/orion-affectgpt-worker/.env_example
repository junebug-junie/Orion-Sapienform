# Copy to .env and tune for your node. See README.md for operator checklist.
# This service runs on circe (GPU1, Tesla V100-SXM2-32GB as of 2026-08-25 --
# moved off GPU2/PG500, see docker-compose.yml deploy.resources comment) --
# NOT athena. NODE_NAME below must stay
# "circe" even though .env is a local, gitignored file on that host.

LOG_LEVEL=INFO
NODE_NAME=circe

ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
# Central bus, reachable from any node via tailscale -- CLAUDE.md mandate:
# always the tailscale node IP, never bus-core/redis/localhost.
ORION_BUS_URL=redis://100.92.216.81:6379/0
HEARTBEAT_INTERVAL_SEC=10

HOST_PORT=32798

CHANNEL_AFFECTGPT_INTAKE=orion:exec:request:AffectGptWorkerService
CHANNEL_AFFECTGPT_REPLY_PREFIX=orion:affectgpt:reply

# See docker-compose.yml volumes -- must match the host bind-mount target.
AFFECTGPT_SRC_ROOT=/opt/affectgpt-src/AffectGPT
AFFECTGPT_MODEL_ROOT=/opt/affectgpt-src/AffectGPT/models
AFFECTGPT_CKPT_ROOT=/opt/affectgpt-src/AffectGPT/models/AffectGPT-ckpt/emercoarse_highlevelfilter4_outputhybird_bestsetup_bestfusion_lz_20250110100
AFFECTGPT_CFG_PATH=train_configs/emercoarse_highlevelfilter4_outputhybird_bestsetup_bestfusion_lz.yaml
# Fixed, not "last available" -- a future checkpoint drop can't silently
# change which weights serve without an explicit .env change.
AFFECTGPT_CKPT_EPOCH=60

# The ONLY mode with a real released checkpoint -- see README "Face crops".
AFFECTGPT_FACE_OR_FRAME=multiface_audio_face_text
AFFECTGPT_DEFAULT_USER_MESSAGE=Please infer the person's emotional state and provide your reasoning process.

AFFECTGPT_DEVICE=cuda:0
AFFECTGPT_MAX_NEW_TOKENS=1200
AFFECTGPT_MAX_LENGTH=2000

AFFECTGPT_FACE_MARGIN=0.25
AFFECTGPT_FACE_MIN_SIZE_PX=60

AFFECTGPT_REQUEST_TIMEOUT_S=120

# Whisper subtitle transcription (2026-08-22) -- see app/transcribe.py
AFFECTGPT_TRANSCRIBE_ENABLED=true
AFFECTGPT_WHISPER_MODEL=base
AFFECTGPT_TRANSCRIBE_NEAR_SILENT_PEAK_INT16=50
AFFECTGPT_WHISPER_LANGUAGE=en

# Compose-level only (no corresponding Settings() field -- this service never
# reads the env var itself, it only receives video_path/audio_path already
# resolved on disk). Controls the docker-compose.yml bind-mount target.
# MUST match orion-juniper-affective-state's AFFECTGPT_SCRATCH_DIR exactly --
# that service writes fetched capture bytes here; a mismatch means this
# worker can't see what the other service just wrote (review finding,
# 2026-08-22).
AFFECTGPT_SCRATCH_DIR=/mnt/scripts/orion-affectgpt-scratch
# Reject segments Whisper itself judged to be silence (its per-segment
# no_speech_prob). The peak gate above is a cheap amplitude pre-filter; this
# is the model's own judgement. Added 2026-08-26 after peak=50 passed a
# clip at peak=114/rms=8.68 and Whisper invented a whole sentence from it.
AFFECTGPT_TRANSCRIBE_MAX_NO_SPEECH_PROB=0.6
