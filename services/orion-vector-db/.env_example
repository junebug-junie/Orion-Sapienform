# ───────────────────────────────────────────────────────────────
# 📦 Orion Vector DB — Environment Configuration
# ───────────────────────────────────────────────────────────────

# --- Service Identity & Port ---
SERVICE_NAME=vector-db
PORT=8500

# --- Persistence ---
# The path on the host machine where the vector database files will be stored.
# Lives on the graph DB drive (ORION_DATA_ROOT=/mnt/graphdb in the root .env),
# alongside FalkorDB. Moved off
# ${STORAGE_ROOT}/collapse-mirrors/chroma (the Postgres drive) 2026-10-11.
CHROMA_DATA_PATH=${ORION_DATA_ROOT}/chroma
ORION_BUS_ENFORCE_CATALOG=true
