SERVICE_NAME=cocreation-signals
SERVICE_VERSION=0.1.0
# Must be an explicit real value (e.g. matching root .env's own NODE_NAME) --
# confirmed live 2026-07-30, two real failure modes to not repeat:
# 1. A literal "$(hostname)" placeholder here (copied uncritically from
#    orion-power-guard's .env_example, an existing anti-pattern in this
#    repo) does NOT get shell-evaluated by docker-compose or
#    pydantic-settings -- it's read verbatim as the string "$(hostname)".
# 2. Leaving this unset/empty does NOT fall back to a sensible default
#    either: app/settings.py's os.uname().nodename fallback resolves to the
#    *container's* hostname (a random container ID Docker assigns), not the
#    real physical host -- worse than unhelpful in bus envelopes'
#    source.node field. An empty env var also silently wins over that code
#    default rather than triggering it (pydantic-settings only falls back
#    to default_factory when the env var is fully absent, not merely empty).
# Set this to the real deployment host's name explicitly, matching root
# .env's own NODE_NAME value.
COCREATION_SIGNALS_NODE_NAME=athena

# Root .env already has PROJECT, NODE_NAME, STORAGE_ROOT, ORION_BUS_URL --
# leave ORION_BUS_URL commented out here to inherit it, same convention as
# every other service's .env_example. If you must override for this
# service specifically: ALWAYS use redis://<tailscale-node-ip>:6379/0, per
# root CLAUDE.md -- never bus-core, never localhost, never a guess.
#ORION_BUS_URL=redis://<tailscale-node-ip>:6379/0
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
HEARTBEAT_INTERVAL_SEC=10

# Read-only mount of this repo's own real working tree -- git_delta.py and
# graph_delta.py both need a live .git directory + graphify-out/, not a
# stale copy baked into the image at build time. Host path is operator-
# specific (varies per deployment node); the in-container path defaults to
# /repo and normally does not need overriding.
COCREATION_SIGNALS_REPO_HOST_PATH=/mnt/scripts/Orion-Sapienform
COCREATION_SIGNALS_REPO_PATH=/repo

# pr_lifecycle.py's `gh pr list --repo owner/repo`.
COCREATION_SIGNALS_GITHUB_OWNER=junebug-junie
COCREATION_SIGNALS_GITHUB_REPO=Orion-Sapienform

CHANNEL_CODEBASE_DELTA=orion:substrate:codebase_delta

# Each producer independently toggleable -- a GitHub API/rate-limit problem
# for pr_lifecycle must never block git_delta or graph_delta.
COCREATION_SIGNALS_GIT_DELTA_ENABLED=true
COCREATION_SIGNALS_PR_LIFECYCLE_ENABLED=true
COCREATION_SIGNALS_GRAPH_DELTA_ENABLED=true

# One interval per real cadence -- see docs/superpowers/specs/2026-07-30-
# codebase-mass-signal-design.md's "Producer scheduling" section for why
# these three differ (git: cheap and frequent; PR lifecycle: coarser,
# rate-limit-aware; graph: event-triggered off graphify updates, polled
# here since there's no push-based "graphify just ran" signal yet).
COCREATION_SIGNALS_GIT_DELTA_POLL_INTERVAL_SEC=60.0
COCREATION_SIGNALS_PR_LIFECYCLE_POLL_INTERVAL_SEC=900.0
COCREATION_SIGNALS_GRAPH_DELTA_POLL_INTERVAL_SEC=300.0

# How far back pr_lifecycle looks on its very first tick after a (re)start --
# deliberately more generous than the steady-state poll interval above,
# since a PR event entirely inside a downtime window longer than this is
# genuinely lost (unlike git_delta/graph_delta, which self-heal across a
# restart by diffing a bigger real range). See pr_lifecycle_loop()'s own
# docstring in app/producers/pr_lifecycle.py.
COCREATION_SIGNALS_PR_LIFECYCLE_COLD_START_LOOKBACK_SEC=3600.0

COCREATION_SIGNALS_PR_FETCH_LIMIT=200

# GitHub CLI auth -- `gh` honors this natively, no `gh auth login` step
# needed. Empty/unset here (secret, never commit a real value); set the real
# token in the actual .env only. A token with read-only `repo`/`pull_request`
# scope is sufficient -- this service never writes to GitHub.
COCREATION_SIGNALS_GH_TOKEN=

# affective_state.py (docs/superpowers/specs/2026-07-30-juniper-affective-
# state-signal-proposal.md) -- read-only mount of Juniper's real local
# ~/.claude/projects tree. Deliberately the whole tree, not scoped to just
# this repo (Juniper's explicit call, 2026-08-11) -- see
# docs/superpowers/pr-reports/2026-08-11-juniper-affective-state-signal-
# replay.md for the privacy tradeoff this decided.
#
# These two MUST be set to the identical path (operator-specific -- this is
# an example, not a portable default). Confirmed live 2026-08-11: Claude
# Code represents a cross-project subagent transcript as an absolute-path
# symlink back into ~/.claude/projects/<other-project>/... -- remapping the
# in-container path breaks every such symlink (FileNotFoundError, gracefully
# skipped, but real messages behind it never get scored). See
# docker-compose.yml's own comment on this mount for the full story.
COCREATION_SIGNALS_CLAUDE_PROJECTS_HOST_PATH=/home/athena/.claude/projects
COCREATION_SIGNALS_CLAUDE_PROJECTS_PATH=/home/athena/.claude/projects

CHANNEL_JUNIPER_AFFECTIVE_STATE=orion:substrate:juniper_affective_state

# Default OFF -- pure shadow write, no consumer yet (orion/bus/
# channels.yaml). Flip on deliberately once the live stream itself has had
# a sanity pass, not just the offline replay in the PR report above.
COCREATION_SIGNALS_AFFECTIVE_STATE_ENABLED=false
COCREATION_SIGNALS_AFFECTIVE_STATE_POLL_INTERVAL_SEC=900.0

# Same real, acknowledged restart-loss gap as
# COCREATION_SIGNALS_PR_LIFECYCLE_COLD_START_LOOKBACK_SEC above (window-based
# scan, not a diff between two saved states) -- see affective_state_loop()'s
# own docstring in app/producers/affective_state.py.
COCREATION_SIGNALS_AFFECTIVE_STATE_COLD_START_LOOKBACK_SEC=3600.0

# dev_economics.py (docs/superpowers/specs/2026-07-30-dev-economics-signal-
# design.md) -- real Claude Code token/word-count/$-cost ledger. Publishes
# the real DELTA in each transcript's cumulative totals since the last
# check (diff-based, same shape as git_delta -- NOT window-membership
# filtering; see dev_economics_loop()'s own docstring for why that was the
# wrong approach for this cumulative-per-file data shape, caught by code
# review 2026-08-12 before this ever shipped). Shares affective_state's
# same claude_projects mount. Flipped ON 2026-08-12 for a real live sanity
# pass -- still a pure shadow write, no consumer yet (orion/bus/
# channels.yaml). This is the last of the original PR #1491 four-domain
# backlog (structural_mass, affective_state, doc_semantic_drift already
# flipped on) -- all four producers are now live-enabled.
COCREATION_SIGNALS_DEV_ECONOMICS_ENABLED=true
COCREATION_SIGNALS_DEV_ECONOMICS_POLL_INTERVAL_SEC=900.0
CHANNEL_DEV_ECONOMICS_LEDGER=orion:substrate:dev_economics_ledger

# doc_semantic_drift.py (docs/superpowers/specs/2026-07-30-doc-semantic-
# drift-design.md) -- diff-scoped embedding-diff over this repo's own real
# *.md changes. Flipped ON 2026-08-11 for a real live sanity pass -- still a
# pure shadow write, no consumer yet (orion/bus/channels.yaml). Only 3 real
# non-truncated samples existed in the offline calibration replay
# (docs/superpowers/pr-reports/2026-08-11-doc-semantic-drift-diff-scoped-
# embedding.md); this flip is how the live stream accumulates enough real
# samples to decide on a consumer/threshold, not a claim the signal is
# already fully calibrated.
COCREATION_SIGNALS_DOC_SEMANTIC_DRIFT_ENABLED=true
COCREATION_SIGNALS_DOC_SEMANTIC_DRIFT_POLL_INTERVAL_SEC=300.0
CHANNEL_DOC_SEMANTIC_DRIFT=orion:substrate:doc_semantic_drift

# Real, already-registered channel (orion/bus/channels.yaml) --
# orion-vector-host's live embedding-request contract. No new channel
# needed; its producer_services already includes "*".
CHANNEL_EMBEDDING_GENERATE=orion:embedding:generate

# Scoped collection so these hunk-diff embeddings (already-committed doc/
# code text) don't commingle with chat/social memory in the shared vector
# store -- orion-vector-host's real contract persists every embedded text
# unconditionally (confirmed live 2026-08-11, no opt-out exists); Juniper's
# explicit call was to use the real contract as-is, scoped to its own
# collection, rather than build a bypass.
COCREATION_SIGNALS_DOC_SEMANTIC_DRIFT_EMBED_COLLECTION=doc_semantic_drift
COCREATION_SIGNALS_DOC_SEMANTIC_DRIFT_EMBED_TIMEOUT_SEC=30.0

# Chunk window each hunk side is split into before embedding, so a long
# doc diff gets chunked + mean-pooled instead of silently clipped by the
# model. Replaces COCREATION_SIGNALS_DOC_SEMANTIC_DRIFT_TRUNCATION_CHAR_
# THRESHOLD (same 2048 value, different job -- that key only flagged an
# over-long hunk, and fired True on every real event this repo produced).
# ~512 tokens * ~4 chars/token; the 512 is verified real (2026-08-12, read
# from the running orion-vector-host container's own model files for
# BAAI/bge-large-en-v1.5), the chars-per-token ratio is a deliberately
# conservative estimate. See app/settings.py's own comment.
COCREATION_SIGNALS_DOC_SEMANTIC_DRIFT_CHUNK_CHAR_SIZE=2048

# Real Redis key doc_semantic_drift_loop's baseline last_sha is persisted to
# -- fixed live 2026-08-12 after a real doc (PR #1571, then again #1577) got
# silently swallowed by a redeploy landing right after its merge (the
# in-process-only baseline reset to current HEAD on every restart). See
# doc_semantic_drift_loop()'s own docstring.
COCREATION_SIGNALS_DOC_SEMANTIC_DRIFT_STATE_KEY=orion:cocreation_signals:state:doc_semantic_drift:last_sha
