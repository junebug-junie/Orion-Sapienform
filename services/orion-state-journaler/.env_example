# ──────────────────────────────────────────────────────────────
# Orion State Journaler
# ──────────────────────────────────────────────────────────────

# Compose naming / network
PROJECT=orion-athena
NET=app-net

# Service identity
SERVICE_NAME=state-journaler
SERVICE_VERSION=0.1.0
NODE_NAME=athena

# Port mapping (compose maps JOURNALER_PORT -> PORT)
JOURNALER_PORT=8380

# Orion bus
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
ORION_BUS_URL=redis://100.92.216.81:6379/0

# Spark-state rollups retired 2026-10-10 (no producer since 2026-07-28):
# CHANNEL_SPARK_STATE_SNAPSHOT, CHANNEL_EQUILIBRIUM_SNAPSHOT, POSTGRES_URI,
# SPARK_ROLLUP_TABLE and ROLLUP_* were removed. This service now only
# publishes its bus heartbeat; spark_state_rollups is a frozen table.

# Chassis / runtime
HEARTBEAT_INTERVAL_SEC=10
