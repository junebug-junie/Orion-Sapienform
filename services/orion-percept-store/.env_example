# orion-percept-store -- short-lived, content-addressed camera frames.
#
# Exists so a frame can cross from where it was captured to where a model can
# look at it, WITHOUT becoming an archive. Deliberately separate from Hub's
# chat attachment store: different content, different lifetime, and Hub holds
# the docker socket.

LOG_LEVEL=INFO
SERVICE_NAME=percept-store
HOST_PORT=8021

# Its own blob root. Never point this at HUB_CHAT_ATTACHMENT_DIR.
PERCEPT_STORE_DIR=/mnt/orion-percepts

# Retention is the point of this service, not housekeeping. A percept exists to
# be interpreted once; the interpretation is what gets kept. Raise this only
# with a reason you would be happy to read back in six months.
PERCEPT_RETENTION_SECONDS=3600
PERCEPT_SWEEP_INTERVAL_SECONDS=300

PERCEPT_MAX_BYTES=8388608
# audio/wav, video/mp4 added 2026-08-22 for AffectGPT's short capture clips.
PERCEPT_ALLOWED_MIMES=image/jpeg,image/png,image/webp,audio/wav,video/mp4

# Shared secret for POST/GET. Empty disables the check, which is only
# acceptable on a closed tailnet. Set it if this port is reachable more widely.
PERCEPT_STORE_TOKEN=
