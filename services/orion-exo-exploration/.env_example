SERVICE_NAME=orion-exo-exploration
SERVICE_VERSION=0.1.0
NODE_NAME=athena
LOG_LEVEL=INFO
PORT=8622
HOST_PORT=8622

EXO_EXPLORATION_PG_DSN=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney

# Once a day, per the design doc -- this is a daily-cadence crawl, not a
# polling service.
EXO_EXPLORATION_CRAWL_INTERVAL_SECONDS=86400
# How often the retention sweep loop runs. Deliberately much shorter than the
# crawl interval so an expired listing does not sit around for up to a day.
EXO_EXPLORATION_RETENTION_SWEEP_INTERVAL_SECONDS=3600
EXO_EXPLORATION_RETENTION_DAYS=14
EXO_EXPLORATION_DAEMON_ENABLED=true
EXO_EXPLORATION_CRAWL_RUN_AT_STARTUP=true

EXO_EXPLORATION_CATEGORIES=https://classifieds.ksl.com/search/cat/Electronics,https://classifieds.ksl.com/search/cat/Computers,https://classifieds.ksl.com/search/cat/FREE
# Honest identifying User-Agent -- checked against classifieds.ksl.com/robots.txt
# on 2026-09-04: no generic disallow, and ksl-crawler is explicitly allowed.
EXO_EXPLORATION_USER_AGENT=orion-exo-exploration/0.1 (+operator-contact-tbd)
EXO_EXPLORATION_FETCH_TIMEOUT_SECONDS=20
# Polite-crawl floor between consecutive requests to classifieds.ksl.com.
EXO_EXPLORATION_REQUEST_DELAY_SECONDS=1.5
EXO_EXPLORATION_MAX_DETAIL_FETCHES_PER_RUN=60
