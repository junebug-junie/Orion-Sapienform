ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENFORCE_CATALOG=false

CHANNEL_RETINA_PUB=orion:vision:frames
CHANNEL_RETINA_ERROR=orion:vision:retina:error
CHANNEL_SYSTEM_HEALTH=orion:system:health

RETINA_SOURCE_TYPE=folder
RETINA_SOURCE=/mnt/telemetry/vision/intake
RETINA_CAMERA_ID=retina-cam-01
RETINA_STREAM_ID=retina-stream-01
RETINA_FPS=1.0

FRAME_STORAGE_DIR=/mnt/telemetry/vision/frames
FRAME_RETENTION_SECONDS=300
JPEG_QUALITY=90

HEALTH_INTERVAL_SECONDS=10.0
# Publisher watchdog. Nothing published for this long (outside the RTSP quiet
# wait and Ring between events) -> health status "degraded", capture_stalled.
# capture_loop hung, or the RTSP reader still delivering frames while nothing
# is published -> exit; the container restart policy brings the eye back.
# Must exceed RETINA_RTSP_STALL_SECONDS, HEALTH_INTERVAL_SECONDS, 2/RETINA_FPS
# and (clip enabled) RETINA_CLIP_TIMEOUT_SEC. 0 disables.
RETINA_PUBLISH_STALL_SECONDS=120.0
SOURCE_RECONNECT_SECONDS=5.0

# --- RTSP cameras (ignored by webcam/folder/mock) ----------------------------
# tcp carries RTP inside the RTSP connection: no UDP packet loss/reordering
# (the walkway's smeared lower frame + `RTP: bad cseq` log lines, 2026-10-15).
RETINA_RTSP_TRANSPORT=tcp
# FFmpeg socket timeout + OpenCV read timeout: a quiet stream returns from
# cap.read() after this many seconds instead of blocking forever.
RETINA_RTSP_IO_TIMEOUT_SECONDS=5.0
# No frame for this long -> WARNING log, abandon the reader thread, open a
# fresh capture. Counted as source_stall_restarts in system health. 0 disables.
RETINA_RTSP_STALL_SECONDS=30.0
# No RTSP (re)connect until this many seconds after the last camera session
# ended -- every path: reader reconnect, watchdog replacement, pause/resume,
# corruption heal, process start. A Reolink keeps a dropped session alive and
# muxes it into a fast reconnect: `bad cseq` + every frame smeared for hours
# (2026-10-15, 2026-10-16). Live 2026-10-16: stop, wait 180 s, start = clean.
# 90 s clears RFC 2326's 60 s default session timeout. 0 disables.
RETINA_RTSP_RECONNECT_QUIET_SECONDS=90.0
# Persisted last-session time (one file per stream id) so a container
# restart or deploy also waits. Missing/unreadable at boot -> one full quiet
# period (a ~90 s frame gap after a deploy is expected). Empty disables
# persistence (every boot waits the full period).
RETINA_RTSP_SESSION_STATE_DIR=/var/lib/orion-vision-retina
# Live self-heal: every HEAL_CHECK_EVERY served frames, score smear/decoder
# gray (same math as evals/frame_smear.py). When >= HEAL_MIN_SHARE of the
# checks over HEAL_WINDOW_SECONDS are corrupt: WARNING, drop the session,
# wait the quiet period (doubling per heal in a row, max 8x), reconnect.
# Counted as source_corruption_heals in system health. Never reboots the camera.
RETINA_RTSP_HEAL_ENABLED=true
RETINA_RTSP_HEAL_CHECK_EVERY=10
RETINA_RTSP_HEAL_WINDOW_SECONDS=120.0
RETINA_RTSP_HEAL_MIN_SHARE=0.8

# --- Frame addressing --------------------------------------------------------
# local         write to FRAME_STORAGE_DIR, publish image_path. Correct ONLY
#               when the vision host shares this filesystem (athena).
# percept_store encode in memory, POST to orion-percept-store, publish sha256.
#               The only option for a node with no shared disk. Writes NOTHING
#               locally on purpose -- a capture agent on a personal laptop must
#               not accumulate a spool of webcam frames.
RETINA_FRAME_MODE=local
RETINA_PERCEPT_STORE_URL=
RETINA_PERCEPT_STORE_TOKEN=
RETINA_PERCEPT_TIMEOUT_SEC=10.0

# Webcam device passthrough. /dev/null on a host with no camera keeps the
# container startable; set /dev/video0 on a node that has one.
RETINA_VIDEO_DEVICE=/dev/null

# --- On-demand video+audio clip capture (AffectGPT) --------------------------
# UNVERIFIED against real hardware -- see app/clip_capture.py module
# docstring. Defaults are a starting point for carbon, not confirmed-correct.
# Off by default; POST /capture/clip returns 503 until explicitly enabled.
RETINA_CLIP_ENABLED=false
# Shared-secret gate for POST /capture/clip (header X-Orion-Retina-Token),
# same convention as orion-percept-store's PERCEPT_STORE_TOKEN. Empty
# disables the check -- strongly set this one given the endpoint triggers a
# live recording, unlike every other route on this service.
RETINA_CLIP_TOKEN=
RETINA_CLIP_FFMPEG_BIN=ffmpeg
RETINA_CLIP_VIDEO_DEVICE=/dev/video0
# PipeWire's pulse-compatible socket accepts "default" as the default
# source, same as plain PulseAudio -- override if carbon's audio backend
# names sources differently (check with `pactl list sources short` or
# `pw-cli list-objects` on carbon).
RETINA_CLIP_AUDIO_INPUT=default
RETINA_CLIP_DURATION_SEC=8.0
RETINA_CLIP_FRAMERATE=15
RETINA_CLIP_WIDTH=
RETINA_CLIP_HEIGHT=
RETINA_CLIP_TIMEOUT_SEC=30.0
# Minimum seconds between the end of one capture and the start of the next,
# regardless of caller/path (HTTP or bus RPC). The bus RPC path has no auth
# beyond bus reachability -- this bounds how often ANY bus-connected caller
# can trigger a live recording, closing off de facto continuous recording.
RETINA_CLIP_MIN_INTERVAL_SEC=30.0
# Bus-reachable twin of POST /capture/clip, for callers with no network path
# to this node at all (e.g. Hub, via orion-juniper-affective-state) --
# carbon accepts no inbound HTTP per docs/operations/carbon-webcam.md. Must
# match that service's own CHANNEL_RETINA_CLIP_INTAKE /
# CHANNEL_RETINA_CLIP_REPLY_PREFIX. Also gated by RETINA_CLIP_ENABLED above.
CHANNEL_RETINA_CLIP_INTAKE=orion:exec:request:RetinaClipCaptureService
CHANNEL_RETINA_CLIP_REPLY_PREFIX=orion:retina:clip:reply
# uid whose /run/user/<uid>/pulse socket the container mounts (docker-compose.yml)
# and PULSE_SERVER points at -- run `id -u` on carbon if not the default 1000.
PULSE_SERVER_UID=1000
# Host port for POST /capture/clip (bus-only otherwise, no port needed before).
# NOT 8022 -- confirmed live 2026-08-22: orion-athena-cortex-gateway already
# owns 8022 on athena (a multi-service host retina can also be deployed to,
# for the room camera / cam0, alongside carbon's own instance). carbon's
# separate venv/systemd deployment (docs/operations/carbon-webcam.md) still
# hardcodes 8022 for its own uvicorn process -- that's fine there (a
# dedicated laptop, no cortex-gateway), unrelated to this Docker-path
# setting, and intentionally left alone. Re-check for collisions with
# `ss -tln` before reusing this default on any other shared host.
RETINA_HTTP_PORT=8027

# Walkway camera instance (compose service `orion-vision-retina-walkway`,
# profile `walkway`). Outdoor Reolink facing the community walkway with a
# partial patio view. Use the camera's full-resolution MAIN stream
# (.../h264Preview_01_main, 2560x1920) so people across the street are big
# enough to tell apart. Real rtsp://USER:PASSWORD@CAMERA_IP:554/... in the
# local .env only; empty is refused at boot. Never synced from this template.
WALKWAY_RTSP_URL=
# Frames saved and published per second. The router only sends some of them to
# the GPU host; 2/s at full resolution writes about as much as cam0 does today.
WALKWAY_RETINA_FPS=2.0
WALKWAY_RETINA_JPEG_QUALITY=88
# Host port for this instance's HTTP (health only; clip capture is off here).
WALKWAY_RETINA_HTTP_PORT=8028

# Ring doorbell instance (orion-vision-retina-doorbell, no profile: plain `up` starts it).
# Battery doorbell, no Ring Protect: each Ring motion/ding push opens a short
# live view, sampled at DOORBELL_RETINA_FPS. Never continuous video. Login
# once: docker exec -it orion-vision-retina-doorbell python -m app.ring_login
# Name of the doorbell in the Ring app, or its device id (empty = first camera).
DOORBELL_RING_DEVICE=
DOORBELL_RETINA_FPS=2.0
DOORBELL_RETINA_JPEG_QUALITY=88
# Ring push kinds that open a live view (motion, ding).
DOORBELL_RING_EVENT_KINDS=motion,ding
# Seconds per live view, and from the end of one to the next start. Each live
# view wakes the battery camera; shorten the burst or lengthen the cooldown if
# the battery drains too fast.
DOORBELL_RING_BURST_SECONDS=15.0
DOORBELL_RING_COOLDOWN_SECONDS=30.0
# Every Ring push is recorded (vision_events doorbell_ring / doorbell_motion,
# plus a StreetEventV1 per ring). A ring during an open live view extends it;
# a ring in the cooldown opens a new one.
# Active looking: when the handoff reducer sets Redis key
# orion:vision:look:doorbell (it expects someone at the door), open a live view
# on our own. Capped per UTC day, and spaced; each one wakes the battery camera.
DOORBELL_RING_SELF_LOOK_ENABLED=true
DOORBELL_RING_SELF_LOOK_MAX_PER_DAY=8
DOORBELL_RING_SELF_LOOK_MIN_SPACING_SECONDS=300
# Settings-only defaults (settings.py), not wired in compose:
#   RETINA_RING_SELF_LOOK_KEY=orion:vision:look:doorbell
#   RETINA_RING_SELF_LOOK_POLL_SECONDS=2.0
# Compose-wired channel defaults: CHANNEL_VISION_EVENTS_PUB=orion:vision:events,
# CHANNEL_STREET_EVENTS_PUB=orion:vision:street:events
DOORBELL_RETINA_HTTP_PORT=8029
