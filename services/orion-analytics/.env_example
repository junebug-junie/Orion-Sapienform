# Orion analytics: dbt transformer (write only in the dedicated analytics schema)
ORION_HOST_REPO_ROOT=/mnt/scripts/Orion-Sapienform
ORION_ANALYTICS_HOST=orion-sql-db
ORION_ANALYTICS_PORT=5432
ORION_ANALYTICS_DATABASE=conjourney
ORION_ANALYTICS_DBT_PASSWORD=
ORION_ANALYTICS_DBT_THREADS=2

# Lightdash warehouse connection: enter these in the Lightdash project setup UI.
# This role has SELECT on analytics views and no access to public source tables.
ORION_ANALYTICS_READER_PASSWORD=

# Lightdash OSS 2.184.6 application and its isolated metadata/object stores
LIGHTDASH_BIND_ADDRESS=127.0.0.1
LIGHTDASH_PORT=8265
LIGHTDASH_SITE_URL=http://localhost:8265
LIGHTDASH_SECRET=
LIGHTDASH_METADATA_USER=lightdash
LIGHTDASH_METADATA_PASSWORD=
LIGHTDASH_METADATA_DATABASE=lightdash
LIGHTDASH_S3_PORT=8266
LIGHTDASH_S3_PUBLIC_ENDPOINT=http://localhost:8266
LIGHTDASH_S3_REGION=us-east-1
LIGHTDASH_S3_BUCKET=lightdash
LIGHTDASH_S3_ACCESS_KEY=lightdash
LIGHTDASH_S3_SECRET_KEY=
LIGHTDASH_QUERY_MAX_LIMIT=5000
