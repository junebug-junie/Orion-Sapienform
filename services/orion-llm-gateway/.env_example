# ────────────────────────────────────────────────
# LLM Gateway defaults
# ────────────────────────────────────────────────
PROJECT=orion
SERVICE_NAME_LLM_GATEWAY=llm-gateway
SERVICE_VERSION_LLM_GATEWAY=0.1.1

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true

CHANNEL_LLM_INTAKE=orion:exec:request:LLMGatewayService
CHANNEL_SPARK_INTROSPECT_CANDIDATE=orion:spark:introspect:candidate
CHANNEL_LLM_REPLY_PREFIX=orion:llm:reply
CHANNEL_VECTOR_LATENT_UPSERT=orion:vector:latent:upsert
# This is the fire-and-forget channel the gateway publishes assistant responses to for semantic embeddings.
CHANNEL_EMBEDDING_GENERATE=orion:embedding:generate

ORION_LLM_DEFAULT_BACKEND=llama-cola
ORION_DEFAULT_LLM_MODEL=Active-GGUF-Model
LLM_DEFAULT_PROFILE_NAME=
LLM_PROFILES_CONFIG_PATH=/app/config/llm_profiles.yaml

# 2026-07-28: these three were http://orion-vllm-host:8000 / orion-ollama-host:11434 /
# orion-llama-cola-host:8004 -- directory-name-style hostnames that only resolve by
# accident, if at all, depending on whether PROJECT has a host suffix at deploy time.
# The compose service key (vllm-host / ollama-host / llama-cola-host) is the only
# hostname Docker's default network guarantees regardless of PROJECT.
ORION_LLM_VLLM_URL=http://vllm-host:8000
ORION_LLM_OLLAMA_URL=http://ollama-host:11434
ORION_LLM_OLLAMA_USE_OPENAI=false

# Legacy fallback only (route-table mode is primary now).
# ORION_LLM_LLAMACPP_URL=http://100.121.214.30:7005

ORION_LLM_LLAMA_COLA_URL=http://llama-cola-host:8004
ORION_LLM_INCLUDE_EMBEDDINGS=false
ORION_VECTOR_LATENT_COLLECTION=orion_latent_store

# Atlas metacog lane contract
ATLAS_METACOG_SERVICE_NAME=atlas-worker-2
ATLAS_METACOG_PROFILE_NAME=qwen3-8b-q5km-v100-16gb-atlas-metacog-16k
ATLAS_METACOG_CUDA_VISIBLE_DEVICES=0
ATLAS_METACOG_HOST_PORT=8012

# LLM Gateway routing (single-subscriber; explicit route table preferred)
# `agent` split off from `chat` 2026-08-14: it used to alias circe-worker-1 (the
# same backend as `chat`, merged-mode) because no distinct agent-lane model
# existed yet. A distinct agent-lane model has been live on Circe's
# dedicated agent-lane worker (port 8015, moved from 8014 2026-09-02 --
# see below) since then; `agent` points there instead of aliasing `chat`.
# UPDATED 2026-09-02: that worker now serves
# qwen3.8-27b-udq4kxl-v100-32gb-circe-agent-flex
# (config/llm_profiles.yaml), replacing the earlier Muse Glimmer profile
# (muse-glimmer-30b-udq4kxl-v100-32gb-agent-vision, still defined in that
# file, just no longer wired to ATLAS_AGENT_PROFILE_NAME by default) --
# this comment's model reference is config, not gospel; if you re-merge
# `agent` and `chat` (e.g. no agent-lane model deployed yet on your box),
# point `agent`'s url/served_by back at the same values as `chat`.
# CORRECTED 2026-08-14 (same day): an earlier version of this comment/table
# pointed `agent` at 100.121.214.30:8014 (Atlas's IP), served_by
# "atlas-worker-agent-1" -- wrong. The `ATLAS_AGENT_*` env var names and the
# docker-compose `atlas-agent` service/container name are a fixed naming
# convention for this worker *pattern*, not a statement of which physical
# host it runs on -- the exact same way `orion-atlas-llamacpp-chat` (see
# `chat` below) already runs on Circe hardware despite its "atlas" name.
# Muse Glimmer was deployed with that same pattern directly on Circe; nothing
# was ever listening on Atlas's IP at :8014, which is why the gateway
# reported "agent" as down after the first (wrong) fix. served_by is now
# "circe-worker-agent-1" to make the actual host explicit and avoid this
# exact confusion again -- do not infer physical host from the `atlas-*`
# service/env-var naming anywhere in this file.
# Deployment note: worker URLs are Tailscale/LAN-specific; adjust IPs when
# copying this file to match your own node topology.
#
# `harness` split off `chat` 2026-08-20 (PR #1761), same reasoning as the
# `agent` split above: `chat` carries live Hub chat traffic with zero
# admission throttling and a single-slot worker, so a long-running FCC/
# Claude Code CLI turn sharing that route could stall a real chat reply, or
# vice versa. It is a SYSTEM route (see orion/llm/routes.py's
# SYSTEM_LLM_ROUTES) -- never offered to a human as a Hub Compute choice, and
# `normalize_llm_route()` rejects it as a general-caller override, but unlike
# `quick_background` it dispatches immediately rather than waiting for
# /slots slack ("priority":"system", not "background"). As shipped, it is
# still an INTERIM ALIAS of `chat`'s own worker (same url/served_by) -- a
# labeling/observability seam, not yet physical isolation. See this
# service's README "Background-priority routes" / harness section before
# assuming this buys latency isolation on its own.
#
# 2026-08-21: Atlas is retired for good (Juniper moved its disks into a
# different chassis; the Atlas Tailscale node itself is offline for good --
# confirmed live: `metacog`/`quick`/`quick_background` were timing out for up
# to 700s per call against the dead 100.121.214.30, hanging every harness
# turn that touched the finalize/background lane). Repointed to Circe and
# confirmed live via GET /routes (all six routes report status "up"):
# `quick`/`quick_background` -> circe-worker-fast-1 (port 8013, GPU 4, Qwen3-8B
# Q4_K_M, config/llm_profiles.yaml's qwen3-8b-q4km-v100-16gb-balanced).
# `metacog` -> circe-worker-2 (port 8012, GPU 3, Qwen3-8B Q5_K_M,
# qwen3-8b-q5km-v100-16gb-atlas-metacog-16k -- single GPU, not the 2xGPU
# qwen3-30b profile of the same "atlas-metacog" name family; do not confuse
# the two). Both deployed and confirmed by Juniper.
#
# CORRECTED 2026-08-29: the "GPU 3" above is stale. Live on Circe,
# `orion-atlas-llamacpp-metacog`'s `CUDA_VISIBLE_DEVICES_OVERRIDE=5`
# (`nvidia-smi` index 5, Tesla V100-16GB) -- physically separate from
# diffusion-host's GPU2 (PG500-216), so no VRAM/compute contention between
# reverie's visual and text chains. Not touching the URL/port, only the
# physical-GPU claim in this comment.
LLM_ROUTE_DEFAULT=quick
LLM_GATEWAY_ROUTE_TABLE_JSON='{"chat":{"url":"http://100.112.254.99:8011","served_by":"circe-worker-1","backend":"llamacpp"},"agent":{"url":"http://100.112.254.99:8015","served_by":"circe-worker-agent-1","backend":"llamacpp"},"metacog":{"url":"http://100.112.254.99:8012","served_by":"circe-worker-2","backend":"llamacpp"},"metacog_background":{"url":"http://100.112.254.99:8012","served_by":"circe-worker-2","backend":"llamacpp","priority":"background","reserved_free_slots":1},"quick":{"url":"http://100.112.254.99:8013","served_by":"circe-worker-fast-1","backend":"llamacpp"},"quick_background":{"url":"http://100.112.254.99:8013","served_by":"circe-worker-fast-1","backend":"llamacpp","priority":"background","reserved_free_slots":2},"harness":{"url":"http://100.112.254.99:8011","served_by":"circe-worker-1","backend":"llamacpp","priority":"system"}}'
# KNOWN FRAGILE POINT, confirmed live 2026-09-04: `stance_react` (the stance
# step every unified Hub turn runs, regardless of Mode/Compute picked in the
# UI) is hardcoded to the "chat" route (services/orion-cortex-exec/app/
# executor.py's _default_llm_route_for_step) with no fallback. If circe:8011
# is down for any reason -- e.g. its GPUs got evicted for a live model test --
# every single Hub turn fails with "stance_react exec result missing thought
# payload" ("Turn deferred" in the UI), not just turns that asked for chat.
# Operator workaround used during the Qwen3.8-Flash-Next IQ4_XS test: point
# "chat" and "harness" above at whatever DOES have a live worker (that day,
# circe:8015, the same URL "agent" already used) so stance_react gets an
# answer -- a real reply from a different model, not a fix for the missing
# route-health check. Revert both to :8011 once circe:8011 is back up.
# Legacy per-route aliases remain available for backward compatibility, but are
# not primary. Note that `agent` does not have a legacy alias env var, so the
# JSON route table is required for the current Atlas chat/metacog/agent layout.
# `agent` moved 8014 -> 8015 2026-09-02: circe's ATLAS_AGENT_HOST_PORT default
# (8014) collides with orion-circe-diffusion-host's own port mapping
# (0.0.0.0:8014 -> its internal 6700) -- coincidental host-port collision
# between two unrelated services, confirmed live when the new
# orion-gpu-lane-controller service tried to bring the agent worker up on
# 8014 and got "port is already allocated". Not diffusion-host's fault or
# anything to fix there -- circe's agent worker just needed a free port.

# Background-priority routes: a route entry with "priority":"background"
# shares its upstream with a normal route (same url/served_by) but waits for
# llama.cpp /slots slack before dispatching, so it never competes evenly with
# foreground traffic on the same GPU process. See README.md's
# "Background-priority routes" section. `quick_background` above is the pilot
# instance (AI Town's NPC dialogue, sharing atlas-worker-fast-1 with
# orion-mind/orion-hub/orion-embodiment's own `quick` traffic) -- any other
# lane can adopt the same pattern by adding a `_background` route pointed at
# the same url/served_by. `metacog_background` (2026-08-29) is the second such
# lane, sharing circe-worker-2/GPU5 with `metacog` -- live-checked 2026-08-29:
# 4 llama.cpp slots, ~1 completion/22s average, mostly idle when polled, so
# this is a tail-latency guard for the occasional slow completion (an 8.9s
# outlier was observed against a ~1.7-2.3s norm), not a rescue for a
# saturated lane the way `quick_background` is. `reserved_free_slots:1`
# (vs. `quick_background`'s 2) reflects that lower contention. Nothing routes
# onto it yet -- see ORION_REVERIE_METACOG_BACKGROUND_ENABLED in
# services/orion-thought/.env_example (default off, so reverie's real
# unmitigated timeout/failure rate under load can be observed first).
LLM_GATEWAY_BACKGROUND_MAX_WAIT_SEC=30
LLM_GATEWAY_BACKGROUND_POLL_INTERVAL_SEC=0.5
LLM_GATEWAY_BACKGROUND_CONCURRENCY=1
# Per-upstream in-flight cap on the bus chat path (app/upstream_admission.py).
# Each distinct route-table URL may hold at most this many gateway threads at
# once; the thread pool is sized to (distinct upstreams x this) + headroom so a
# flood on one lane (2026-09-05: topic-foundry + memory-consolidation on `quick`)
# can never take the threads an unrelated lane's request needs (`chat`'s
# stance_react waited 18 min behind them; `metacog` calls 19 min, both bound for
# idle workers). A request that cannot get its lane's permit inside its own
# read-timeout budget is shed with raw.error=gateway_overloaded instead of being
# generated for a caller that already timed out. Live depth: GET /admission
# -> "upstreams". Sizing: llama.cpp queues past its slot count anyway, so this
# is "how deep may the gateway-side queue for one worker get before shedding",
# not a slot count; 8 = 4 slots running + 4 queued at the worker.
LLM_GATEWAY_UPSTREAM_MAX_INFLIGHT=8
LLM_ROUTE_CHAT_URL=
LLM_ROUTE_METACOG_URL=
LLM_ROUTE_LATENTS_URL=
LLM_ROUTE_SPECIALIST_URL=
LLM_ROUTE_CHAT_SERVED_BY=
LLM_ROUTE_METACOG_SERVED_BY=
LLM_ROUTE_LATENTS_SERVED_BY=
LLM_ROUTE_SPECIALIST_SERVED_BY=
LLM_ROUTE_HEALTH_TIMEOUT_SEC=1.5
LLM_GATEWAY_HEALTH_PORT=8210
LLM_GATEWAY_CONCURRENT_HANDLERS=true

# Vision / chat attachments.
# Capability is read from each worker's own /props (modalities.vision), never from
# the profile registry — a profile can claim vision while the worker was started
# without --mmproj, and on 2026-08-14 the chat lane did exactly that.
LLM_GATEWAY_VISION_ENABLED=true
LLM_GATEWAY_VISION_PROPS_CACHE_TTL_SEC=300
LLM_GATEWAY_VISION_PROPS_TIMEOUT_SEC=5
# Trusted base the gateway builds attachment fetch URLs from, as <base>/<sha256>.
# The attachment ref's own source_url round-trips through the browser and is
# therefore client-controlled in full — scheme, host, port AND path — so it is
# deliberately not used. Only a regex-validated 64-char hex sha is appended here.
# EMPTY MEANS REFUSE TO FETCH ATTACHMENTS AT ALL.
LLM_GATEWAY_ATTACHMENT_BASE_URL=http://100.92.216.81:8080/api/chat/attachments
# Defence in depth over the base above, not the primary control: hosts the derived
# URL may resolve to. Host only — no scheme, no port. Empty refuses everything.
LLM_GATEWAY_ATTACHMENT_ALLOWED_HOSTS=100.92.216.81,orion-athena-percept-store
LLM_GATEWAY_ATTACHMENT_MAX_BYTES=8388608
LLM_GATEWAY_ATTACHMENT_FETCH_TIMEOUT_SEC=10

# Anthropic Messages passthrough for Claude Code / free-claude-code (FCC)
# FCC: LLAMACPP_BASE_URL=http://127.0.0.1:8210/v1
LLM_GATEWAY_ANTHROPIC_PASSTHROUGH_ENABLED=true
LLM_GATEWAY_ANTHROPIC_PASSTHROUGH_TIMEOUT_SEC=900

# OpenAI-compatible passthrough for AI Town / external OpenAI clients
# AI Town: LLM_API_URL=http://<mesh-ip>:8210  LLM_MODEL=quick
LLM_GATEWAY_OPENAI_PASSTHROUGH_ENABLED=true
# OpenAI /v1/embeddings → orion-vector-host POST /embedding
ORION_VECTOR_HOST_URL=http://orion-athena-vector-host:8320

# Phase 3 — LLM / GPU lane isolation (optional; default off preserves legacy routing)
LLM_LANE_ROUTING_ENABLED=false
LLM_LANE_DEFAULT=quick
LLM_ROUTE_SPARK_SERVED_BY=
LLM_ROUTE_BACKGROUND_SERVED_BY=
LLM_ROUTE_AGENT_SERVED_BY=
LLM_ALLOW_BACKGROUND_TO_CHAT_FALLBACK=false

CONNECT_TIMEOUT_SEC=10
READ_TIMEOUT_SEC=700
HEARTBEAT_INTERVAL_SEC=10

# Default llama.cpp structured-output method (see probe_structured_output.py); hub may override per route
LLM_STRUCTURED_OUTPUT_METHOD=none

# Logprob summary (language surface stability; opt-in per request via return_logprobs)
LLM_LOGPROB_SUMMARY_ENABLED=true
LLM_LOGPROB_TOP_K_DEFAULT=5
LLM_LOGPROB_LOW_MARGIN_THRESHOLD=0.5
LLM_LOGPROB_LOW_LOGPROB_THRESHOLD=-2.0
LLM_LOGPROB_UNSTABLE_SPAN_MIN_LEN=3
# Set true + per-request logprob_probe_mode=native_completion for aligned llama.cpp /completion path
LLM_LOGPROB_NATIVE_COMPLETION_ENABLED=true
LLM_LOGPROB_NATIVE_COMPLETION_MAX_TOKENS=256

# Camera frames (AttachmentRefV1.kind="percept") resolve from orion-percept-store,
# NOT from Hub's chat attachment store. Different content, different retention,
# and Hub is the process holding the docker socket. Unset means percepts are
# refused -- it deliberately does not fall back to the chat base.
LLM_GATEWAY_PERCEPT_BASE_URL=http://orion-athena-percept-store:8000/percepts
