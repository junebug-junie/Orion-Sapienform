#!/bin/sh
# orion-git-safety-guard (post-commit)
#
# Advisory-only nudge: after every commit (in ANY worktree), sends a
# heartbeat to the host-local agent workspace board (scripts/agent_board.py)
# with the just-made commit's subject line as the thread summary.
#
# Why a git hook and not a reminder to run `agent_board.py heartbeat` by
# hand: a live session found that a passive stop-hook banner ("no open
# board items are recorded for this worktree") got ignored across ~20
# consecutive turns even though the agent read it every time -- a reminder
# with no cost to skipping it doesn't change behavior. Committing, by
# contrast, is a step this repo's own AGENTS.md already makes universal
# ("commit as you go at logical checkpoints"), so riding the heartbeat on
# top of it means board hygiene no longer depends on an agent noticing a
# banner -- it depends on a habit that's already load-bearing. This
# matters most when multiple concurrent agents are actually working the
# same repo (real collisions reported, not hypothetical); the board's
# checkin/checkout flow exists specifically to surface that.
#
# Never blocks anything and never fails the commit it fires on -- if
# python3 isn't reachable, or the script errors, this hook silently does
# nothing.
#
# POSIX sh only -- no bashisms.

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$REPO_ROOT/scripts/agent_board.py" ] || exit 0

command -v python3 >/dev/null 2>&1 || exit 0

SUBJECT=$(git log -1 --pretty=%s 2>/dev/null) || exit 0
[ -n "$SUBJECT" ] || exit 0

# Tag the heartbeat with the Claude Code session id when this commit ran
# inside a Claude Code Bash tool call (the env var is inherited down to
# this hook's subprocess same as any other). This lets the SessionStart/Stop
# hooks -- which run with a process cwd fixed to the session's original
# project directory, not wherever an agent `cd`d into mid-session -- look up
# "the worktree this session most recently heartbeated" instead of
# resolving cwd themselves, which resolves to the wrong path (confirmed
# live: see resolve_current_identity()'s docstring in agent_board_lib.py).
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
    python3 "$REPO_ROOT/scripts/agent_board.py" heartbeat --summary "$SUBJECT" --session-id "$CLAUDE_CODE_SESSION_ID" >/dev/null 2>&1 || true
else
    python3 "$REPO_ROOT/scripts/agent_board.py" heartbeat --summary "$SUBJECT" >/dev/null 2>&1 || true
fi

# orion-self-study-enrichment trigger (advisory-only, ships ON by default)
#
# After a real commit, check whether anything self-study-relevant
# structurally changed (services/, orion/bus/channels.yaml, orion/schemas/,
# orion/cognition/verbs/) and, if so, publish a
# orion:self_study:enrichment:requested event so
# services/orion-self-study-enrichment can run a real evidence-grounded
# `claude -p` enrichment pass. All the actual logic (qualifying-change
# check, delta computation, rate-limit belt-check, one-shot publish) lives
# in scripts/self_study_enrichment_hook.py -- kept out of this POSIX-sh
# hook body per this repo's own "no regex swamp" / deterministic-script
# convention, and so it's independently unit-testable.
#
# Own subshell + `|| true` so this fragment can never be killed by an
# `exit` in an earlier or later fragment in this same concatenated hook
# file (see graphify's own post-commit fragment, which calls `exit 0` for
# commits made from a linked worktree -- a bare `exit` here would otherwise
# terminate the whole file), and can never fail or block the commit itself.
(
    [ -f "$REPO_ROOT/scripts/self_study_enrichment_hook.py" ] || exit 0

    # Needs `redis` importable (for the one-shot bus publish in
    # publish_enrichment_request()) -- not guaranteed on whatever bare
    # `python3` resolves to on PATH at commit time. Confirmed live
    # 2026-08-12: this host's own default (non-interactive-shell) PATH
    # resolves python3 to a system interpreter with no redis installed,
    # so the script's own `import redis` silently failed on every real
    # commit -- swallowed by main()'s outer except, same invisible-failure
    # shape as the sys.path/orion import bug fixed in the same patch.
    #
    # Probe both REPO_ROOT (this commit's checkout) AND the shared/primary
    # checkout derived from --git-common-dir. This repo's own convention
    # (AGENTS.md sec 2) is committing from a LINKED WORKTREE, not the
    # primary checkout -- confirmed live that a REPO_ROOT-only probe finds
    # NOTHING there: .venv/orion_dev are untracked/gitignored, so a linked
    # worktree only has the tracked files, never its own copy of either
    # venv. Without the shared-root fallback this "fix" would silently
    # keep failing for the dominant real case (worktree commits) while
    # only working for the rare primary-checkout commit. Mirrors graphify's
    # own post-commit fragment's linked-worktree detection (_GFY_COMMONDIR
    # above) for how to resolve the shared root from any worktree.
    _SSEH_COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null)
    _SSEH_SHARED_ROOT=""
    if [ -n "$_SSEH_COMMON_DIR" ]; then
        _SSEH_SHARED_ROOT=$(cd "$(dirname "$_SSEH_COMMON_DIR")" 2>/dev/null && pwd)
    fi

    _SSEH_PYTHON=""
    for _sseh_cand in \
        "$REPO_ROOT/.venv/bin/python3" "$REPO_ROOT/orion_dev/bin/python3" \
        "$_SSEH_SHARED_ROOT/.venv/bin/python3" "$_SSEH_SHARED_ROOT/orion_dev/bin/python3"; do
        if [ -n "$_sseh_cand" ] && [ -x "$_sseh_cand" ] && "$_sseh_cand" -c "import redis" >/dev/null 2>&1; then
            _SSEH_PYTHON="$_sseh_cand"
            break
        fi
    done
    if [ -z "$_SSEH_PYTHON" ]; then
        _SSEH_PYTHON=$(command -v python3 2>/dev/null) || exit 0
    fi

    cd "$REPO_ROOT" && "$_SSEH_PYTHON" "$REPO_ROOT/scripts/self_study_enrichment_hook.py" >/dev/null 2>&1
) || true
