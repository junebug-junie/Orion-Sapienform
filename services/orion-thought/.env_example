SERVICE_NAME=orion-thought
SERVICE_VERSION=0.1.0
NODE_NAME=athena
THOUGHT_PORT=7155

ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=false
ORION_BUS_URL=redis://100.92.216.81:6379/0
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health).
HEARTBEAT_INTERVAL_SEC=10
# RPC-health snapshot publish (orion:rpc_health:snapshot) with per-hop channel_latency
# (exec RPC, vision-host RPC, http:<mind>/v1/mind/run). See README "RPC-health publish".
# Consumer-first: RpcHealthSnapshotV1 is extra="forbid" -- rebuild orion-signal-gateway and
# orion-equilibrium-service on PR #2312's build BEFORE deploying this service with
# RPC_HEALTH_CHANNEL_LATENCY_ENABLED=true.
# ALSO a hard prerequisite: orion-equilibrium-service must run PR #2310's build first. On any
# older build its legacy transport-metacog trigger reads EVERY service's pooled timeouts/p95
# (>=5s), and this service's calls are LLM-bound by design, so it would fire every cooldown.
RPC_HEALTH_PUBLISH_ENABLED=true
RPC_HEALTH_PUBLISH_INTERVAL_SEC=30
RPC_HEALTH_CHANNEL_LATENCY_ENABLED=true

CHANNEL_THOUGHT_REQUEST=orion:thought:request
CHANNEL_THOUGHT_ARTIFACT=orion:thought:artifact
CHANNEL_THOUGHT_RESULT_PREFIX=orion:thought:result:
CHANNEL_CORTEX_EXEC_REQUEST=orion:cortex:exec:request
CHANNEL_CORTEX_EXEC_RESULT_PREFIX=orion:exec:result
# Tripled 120 -> 360 (2026-08-26) after a real timeout, measured to the second.
#
# `stance_react` runs on the `chat` lane by design -- Qwen3.6-35B-A3B on
# circe-worker-1, a THINKING model -- and that placement is deliberate: a stance
# is a judgement about whether to engage at all, and it is worth the good model.
# The cost of that choice is that its latency scales with input, and 120s left
# no headroom for a large one.
#
# The incident: an unsolicited curiosity turn (an ~11 KB self-addressed prompt,
# ~47x the 101-token median stance completion) took 90s in the model and 32s in
# cortex-exec post-processing. Thought gave up at 120.006s; cortex-exec
# published the finished, correct answer 1.9s later. The turn surfaced to Hub as
# `turn_deferred` -- indistinguishable, at that layer, from Orion genuinely
# judging the moment wrong.
#
# 360 is chosen against the chain, not picked round: Hub's own outer wait on
# Thought is TIMEOUT_SEC=400 (services/orion-hub/.env_example), so this must
# stay UNDER 400 or Hub gives up first and the extra budget is unreachable.
# 360 leaves 40s of margin for the reply hop.
#
# NEXT CEILING, not fixed here: cortex-exec's own RPC to LLMGatewayService is
# capped at 120s, and the model leg above measured 90s. If a stance prompt ever
# pushes the model past 120s, that inner cap binds first and this key cannot
# help. Raise that one when it actually fires -- not pre-emptively.
STANCE_REACT_TIMEOUT_SEC=360
# Unified-turn latency L4: build the stance context in cortex-exec while
# orion-mind runs (stance_context_prepare RPC), instead of after it.
ORION_THOUGHT_STANCE_PREPARE_PARALLEL=true


# Reveries that ask (docs/superpowers/specs/2026-11-18-reverie-questions-design.md, Patch 1). ON.
# A reverie starts only in a quiet stretch: Orion's arousal reads `idle` AND the attention broadcast has
# had no winner for QUIET_MIN_CALM_SEC. It starts from ONE piece of real material picked by code (a named
# person's routine that did not happen, a self-bet calibration gap, an old memory beside the newest) and
# leaves one question for curiosity, or a reason there is none (one reverie_question row). The worker
# polls the gate every INTERVAL_SEC. One reverie per quiet stretch; a refused agent lane writes nothing
# and the stretch is given up after 3 refusals (log reverie_skipped reason=lane_refused_stretch).
# Requires services/orion-sql-db/manual_migration_reverie_question.sql.
ORION_REVERIE_ENABLED=true
ORION_REVERIE_INTERVAL_SEC=60
ORION_REVERIE_QUIET_MIN_CALM_SEC=600
# Rolling 24 h. 0 = reverie writes nothing (off switch).
ORION_REVERIE_MAX_PER_DAY=8
# Rolling 24 h cap on questions sent to the curiosity focus slot (origin self, never replacing a pending
# focus). 0 = questions stay recorded but never reach curiosity. orion-hub enforces the same key again.
ORION_REVERIE_FOCUS_MAX_PER_DAY=3
# Far-memory seed: partner taken from these centered-cosine ranks of the lived-memory index
# (from:to inclusive, rank 1 = nearest; Patch 0 measured 5:25).
ORION_REVERIE_FAR_MEMORY_BAND=5:25
# A seed ref a reverie used in the last N days is spent; questions on one thread inside it share a thread.
ORION_REVERIE_THREAD_LAPSE_DAYS=14
# Chroma holding orion_lived_memory (orion-recall indexes it; same URL as RECALL_LIVED_MEMORY_CHROMA_URL).
ORION_REVERIE_FAR_MEMORY_CHROMA_URL=http://orion-athena-vector-db:8000
# Local time for the absence seed's words ("usually passes between 07:00 and 08:00").
ORION_REVERIE_TIMEZONE=America/Denver
# The quiet gate reads arousal from Redis orion:regulation:latest; older than this reads unknown (gate shut).
ORION_REGULATION_READER_MAX_AGE_SEC=360

# orion-notify (the visual chain's painting-gap and attempt-streak checks page through it).
NOTIFY_BASE_URL=http://orion-athena-notify:7140
NOTIFY_API_TOKEN=

# Reverie: direct read of attention broadcast + reverie-table persistence
POSTGRES_URI=postgresql://postgres:postgres@${PROJECT}-sql-db:5432/conjourney

# Reverie VISUAL chain (Patch 2 of docs/superpowers/specs/2026-08-20-reverie-
# visual-chain-design.md). A second, parallel reverie chain: generate an
# image via orion-diffusion-host (circe), re-observe it via
# orion-vision-host's existing caption_frame task, persist both, and carry
# the caption forward as prior_description for the next run's prompt.
# Requires manual_migration_reverie_visual_chain.sql applied,
# orion-diffusion-host live on circe (services/orion-diffusion-host README),
# and this service's own docker-compose.yml volume mount for
# ORION_VISUAL_CHAIN_STORAGE_DIR (fixed alongside this flip -- without it,
# generated images silently vanish into the container's ephemeral
# filesystem instead of landing on the real host disk).
# Enabled 2026-08-25 (Juniper direction, live-verified: real file on disk,
# real reverie_visual_chain/reverie_visual_artifact rows, correct FK, honest
# null description rather than a fabricated caption on the placeholder seed
# prompt's abstract first images -- see visual_chain.py's DEFAULT_SEED_PROMPT
# for the known follow-up: sdxl-turbo's output for that seed prompt has not
# yet cleared orion-vision-host's caption sanitizer in 3/3 live ticks).
# 2026-08-30: OFF. This flag drove the 600s cron, and a cron is not a decision --
# it spent real GPU watts on circe at a fixed cadence whether or not making an
# image was the best use of them, and nothing weighed it against alternatives.
# The same work is now reachable as `skills.imagination.render_scene.v1` via the
# `express` dispatch route, where it must win motor-seconds on expected
# information per second and can be refused by the ambient thermal gate.
# Set back to true to restore the timer if the chosen path is ever stood down.
ORION_VISUAL_CHAIN_ENABLED=false
ORION_VISUAL_CHAIN_INTERVAL_SEC=600
# Act ledger (rung 2): each durable painting run publishes a `make` act (open on prepare,
# close on produced / terminal / abandon) that orion-sql-writer persists and grades.
THOUGHT_ACT_LEDGER_ENABLED=true
# Body economy Patch C3b: the painting / dream-hop generate step places a SHADOW bid with the
# body economy (durable-runs POST /physiology/bid; the client's default URL resolves on app-net)
# and logs `physiology_shadow_bid ... real=...` beside the step's real outcome. Never obeyed.
THOUGHT_PHYSIOLOGY_SHADOW_BID_ENABLED=true
# Ladder retirement PR 2 (2026-11-05): Orion starts its own waking paintings (app/painting_self_start.py).
# Every TICK_SEC: the visual-baseline schedule (config/reverie/visual_baseline.v1.yaml: due 5400 s after
# the last painting, retry 600 s), arousal deferral, the self-monitor act gate, a SHADOW hunger bid on
# thought.painting, then one reverie.visual durable run (POST <DURABLE_RUNS_URL>/runs). The diffusion hold,
# the thermal gate and the act ledger are unchanged. This is the ONLY trigger: the render_scene proposal
# template and proposal-runtime's baseline read are removed. About 9 paintings a day (replay in the PR).
ORION_PAINTING_SELF_START_ENABLED=true
ORION_PAINTING_SELF_START_TICK_SEC=60
ORION_PAINTING_SELF_START_DURABLE_RUNS_URL=http://orion-athena-durable-runs:8121
# R3 reader 4 (moved from orion-proposal-runtime with the schedule): arousal `strained` defers a due painting.
ORION_VISUAL_BASELINE_AROUSAL_ENABLED=true
# Self-monitor E1 (orion/self_monitor/gate.py), moved with the act from execution-dispatch: a painting
# faculty held broken/unreliable is refused, except one re-test probe per window.
SELF_MONITOR_ACT_GATE_ENABLED=true
SELF_MONITOR_PROBE_INTERVAL_SEC=21600
ORION_DIFFUSION_HOST_BASE_URL=http://100.112.254.99:8014
# GPU2 mutex with orion-world-model, via orion-gpu-pool (stage 5.4). A durable
# reverie-visual run's generate attaches under its diffusion hold (no second
# wait); a generate with no hold (run-once route / legacy worker) takes a
# diffusion lease and waits at most this long before deferring
# (resource_deferred). Must fit inside ORION_VISUAL_CHAIN_RUN_DEADLINE_SEC with
# the diffusion timeout. See settings.py.
ORION_VISUAL_CHAIN_GPU_LEASE_DEADLINE_SEC=90
# 120, not 30 -- real bug, caught live 2026-08-28 the same day
# orion-diffusion-host swapped to FLUX.1-schnell: FLUX's real generation
# (4 steps, CPU offload) measured 49-56s on the actual deployed hardware,
# well over the 30s this value was tuned to for sdxl-turbo's near-instant
# single step. Every tick timed out until this was raised.
ORION_VISUAL_CHAIN_DIFFUSION_TIMEOUT_SEC=120
# Total deadline for one whole visual-chain run, enforced around the single-flight
# lock. Not redundant with the per-hop timeouts: those sum rather than bound, and a
# urllib socket timeout is reset by every chunk received. Sized above the 220s hop
# budget so it fires only on a genuine hang -- and above the caller's 150s timeout,
# so a caller giving up never abandons a run mid-generation.
ORION_VISUAL_CHAIN_RUN_DEADLINE_SEC=300
# Deadline for one durable reverie.visual generate step (permit wait + diffusion +
# disk write). Floored at GPU2 capacity budget + diffusion timeout + 10s; keep it
# under the run brief's 360s per-step RPC budget. A generate still marked in flight
# within 2x this window refuses a second diffusion call (generate_in_flight).
ORION_VISUAL_CHAIN_STEP_GENERATE_DEADLINE_SEC=330

# Backstop for a visual attempt nothing ever closed (lost abandon, process death):
# the next claim (durable prepare or legacy run-once) releases an active/unknown
# attempt claimed longer ago than this (reason attempt_expired), unless a production
# receipt reconciles it to produced. Keep above the durable 5400s retry window.
ORION_VISUAL_CHAIN_ATTEMPT_MAX_AGE_SEC=7200

# Watchdog for the failure mode the run-deadline above cannot catch: the worker's
# own asyncio task wedged before ever reaching the single-flight lock (confirmed
# live 2026-09-04, 24+ hours silent, zero errors). Runs independently of the
# worker itself, so it can still fire an orion-notify attention request (email +
# Hub attention item) even when the worker is fully stuck. ~4.5x the 600s tick
# cadence -- enough slack for a couple of legitimate thermal_refused cycles.
ORION_VISUAL_CHAIN_STALENESS_THRESHOLD_MIN=45
# Painting-gap check: alert (orion-notify severity=error, emails if unacked)
# when no real painting (production receipt) has landed in this many hours.
# Runs in its own loop, NOT gated on ORION_VISUAL_CHAIN_ENABLED -- the staleness
# watchdog above is gated on that legacy flag (off in production), so it never
# ran during the 27.6 h GPU-lane-controller outage of 2026-10-09/10. Threshold
# picked in-sample on 2026-09-14..10-10: no gap fell between 7.6 h and 14.7 h.
ORION_VISUAL_PAINTING_GAP_CHECK_ENABLED=true
ORION_VISUAL_PAINTING_GAP_THRESHOLD_HOURS=12
ORION_VISUAL_PAINTING_GAP_CHECK_INTERVAL_SEC=600
# N painting attempts in a row that produced nothing -> CRITICAL card (emailed at once). 6 = one more
# than the longest ordinary streak 2026-09-14..10-19; 10-16 -> 10-20 had 35 in a row, told nobody.
ORION_VISUAL_ATTEMPT_STREAK_CHECK_ENABLED=true
ORION_VISUAL_ATTEMPT_FAILURE_STREAK_THRESHOLD=6
ORION_VISUAL_CHAIN_WATCHDOG_CHECK_INTERVAL_SEC=600


# Patch 8 (visual_chain.py module docstring): LLM interpretation step between the selected
# context-seed and the diffusion prompt -- turns raw abstract text into a concrete visual
# metaphor instead of letting the diffusion model fall back to generic clouds/nebulas when
# the source text has no concrete nouns of its own. Default ON: this is the fix for the
# reported bug, not an experiment. Always plain `metacog`, never `metacog_background` --
# this call must never wait under lane contention (see orion/llm/routes.py).
ORION_VISUAL_CHAIN_INTERPRETATION_ENABLED=true
ORION_VISUAL_CHAIN_INTERPRETATION_TIMEOUT_SEC=30

ORION_VISUAL_CHAIN_STORAGE_DIR=/mnt/storage-lukewarm/orion/reverie-visual
# MUST match services/orion-hub/.env_example's REVERIE_VISUAL_STORAGE_DIR
# exactly -- Hub bind-mounts this same path read-only to serve these images
# in its Reverie tab. Nothing enforces the two staying in sync; if this path
# ever changes (disk migration, storage reorg), update both .env_example
# files and both live .envs in the same change, or Hub's image endpoint
# starts 404ing with "artifact file missing on disk" despite the DB rows
# and files still existing at the new path.
# Same literal athena-network hostname orion-vision-host's own
# VISION_PERCEPT_STORE_URL resolves -- both are athena-side services.
ORION_VISUAL_CHAIN_PERCEPT_STORE_URL=http://orion-athena-percept-store:8000/percepts
ORION_VISUAL_CHAIN_PERCEPT_STORE_TOKEN=
ORION_VISUAL_CHAIN_PERCEPT_UPLOAD_TIMEOUT_SEC=10
# Points at circe's dedicated Qwen2-VL lane (services/orion-vision-host/
# docker-compose.circe-qwen.yml), not the shared bare channel -- live-
# confirmed 2026-08-26 that athena's shared BLIP-base instance cannot
# produce a caption sanitize_caption accepts for a generated image (3/3
# real ticks came back uncaptioned before this move; described=true and a
# real, detailed caption on the first tick after).
CHANNEL_VISION_HOST_REQUEST=orion:exec:request:VisionHostService:circe-vl
CHANNEL_VISION_REPLY_PREFIX=orion:vision:reply
ORION_VISUAL_CHAIN_CAPTION_TIMEOUT_SEC=60
# Patch 3 context-seed tunables (store.py::load_latest_reverie_
# interpretation) -- were a bare module constant / unbounded before this.
# See app/settings.py's field comment for the full staleness/900s reasoning
# (canonical source -- don't restate it here, just point at it).
ORION_REVERIE_CONTEXT_CHAR_LIMIT=240
ORION_REVERIE_CONTEXT_MAX_AGE_SEC=900
# Patch 4 (design doc §15): live-caught 2026-08-27 -- prior_description
# continuity locked onto one visual attractor ("ancient Roman aqueduct")
# across 10+ runs / 100+ minutes, unmoved by Patch 3's context-seeding (a
# short abstract clause has nowhere near the prompt weight of a long,
# concrete continuity description). After this many CONSECUTIVE runs
# carrying continuity forward, the next run forces a reset -- drops
# prior_description from that run's prompt only, then continuity resumes
# normally. No off switch by design: 0 means reset every run.
ORION_VISUAL_CHAIN_CONTINUITY_MAX_RUNS=3
# Self-study context-seed. Since 2026-11-07 (ladder retirement PR 6) its source is
# curiosity's self-inquiry answers (self_concept_history, ~6 a day; a 6h window
# holds a fresh one ~79% of the time). The text below is the history of the old
# source, whose only trigger was the retired dispatch rung.
# Patch 5 (design doc §16): a second, richer context-seed -- self_study_
# analysis.py's four deterministic window-contrast analyses (concept
# induction, vision events, affective state, co-creation signals), real
# quantified self-observation rather than a bare narration sentence.
# store.py's _SAFE_SELF_STUDY_SOURCE_PREFIXES is the actual privacy
# boundary (an allowlist of only those four producers -- see that
# constant's own docstring for the real incident: a sibling
# source_kind='self_study' producer was confirmed live to quote sensitive
# personal content, and is deliberately excluded). 21600s (6h), not the
# reverie context-seed's 900s: these analyses fire on their own 6-72h
# window-contrast cadence, not a fast per-tick producer.
# 150, not 400 (Patch 5's original value) -- real bug, caught live
# 2026-08-28 (design doc §18): SDXL-turbo's text encoder truncates at 77
# tokens, silently. Self-study's dense, hyphen/underscore-heavy jargon
# alone at 400 chars tokenizes to 104 tokens with its framing prefix --
# over budget by itself, before prior_description or any other clause is
# even added. 150 chars keeps this clause around 47 tokens.
ORION_SELF_STUDY_CONTEXT_CHAR_LIMIT=150
ORION_SELF_STUDY_CONTEXT_MAX_AGE_SEC=21600
# Stage 2 PR G: validated episode memories are the default visual-memory
# source. Set crystallization only as a bounded rollback while the legacy
# reader remains present; Stage 2 PR H removes that reader at cutover.
REVERIE_VISUAL_MEMORY_SEED_SOURCE=episode_memory
# The historical env names remain stable during cutover. Under the default
# episode_memory source they cap eligible statements to 180 chars and may
# narrow creation age below the hard seven-day policy ceiling (they cannot
# widen it). They remain fully configurable for the legacy rollback reader.
ORION_MEMORY_CRYSTALLIZATION_CONTEXT_CHAR_LIMIT=180
ORION_MEMORY_CRYSTALLIZATION_CONTEXT_MAX_AGE_SEC=604800

# --- Mind stance enrichment (unified turn; enabled) ---
# Run orion-mind before stance_react and inject an advisory self/attention
# coloring into the verb context. Fail-open, flag-gated.
# NOTE: This is a silent no-op unless orion-mind has MIND_LLM_SYNTHESIS_ENABLED=true
# (that key lives on the orion-mind service, not here) AND orion-thought can reach
# ORION_MIND_BASE_URL. Verify both operationally at rollout.
ORION_THOUGHT_MIND_ENRICHMENT_ENABLED=true
# 2026-07-28: use the compose service key ("mind"), not a directory/container-name
# guess -- see orion-cortex-orch/.env_example's ORION_MIND_BASE_URL comment for why.
ORION_MIND_BASE_URL=http://mind:6611
# Budget: orion-mind runs 3 sequential LLM phases (semantic → appraisal → stance),
# each capped by MIND_LLM_TIMEOUT_SEC (default 60s, on the orion-mind service).
# WALL_MS must stay >= ~3× that (180000) or synthesis is cut off mid-pipeline and
# Mind degrades to contract_only. TIMEOUT_SEC (HTTP read) must exceed WALL_MS/1000
# so Mind's own fail-open result is returned instead of the client aborting.
ORION_THOUGHT_MIND_TIMEOUT_SEC=210
ORION_THOUGHT_MIND_WALL_MS=180000
ORION_THOUGHT_MIND_ROUTER_PROFILE=default
ORION_THOUGHT_MIND_MAX_RESPONSE_BYTES=2000000
ORION_THOUGHT_MIND_ARTIFACT_PUBLISH_ENABLED=true
ORION_THOUGHT_MIND_COLORING_MAX_ITEMS=3
CHANNEL_MIND_ARTIFACT=orion:mind:artifact

# --- Temporal Self patch 4: "my day" cue for stance_react (unified turn; enabled) ---
# One short paragraph (<= 400 chars) rendered by a fixed template from orion-durable-runs'
# GET /temporal-self/frame: what Orion is on, what it came from, open threads, last sleep. Every
# clause cites [arc:<id>]; arc ids the stance cites are checked (thought_decision.day_citations).
# A frame older than MAX_AGE_SEC, for another local day, or not fetched within FETCH_TIMEOUT_SEC
# renders nothing. Kill switch: false = stance_react exactly as before.
TEMPORAL_SELF_STANCE_CUE_ENABLED=true
# Compose service key on app-net (container port 8121; the host port is 8124).
TEMPORAL_SELF_FRAME_URL=http://durable-runs:8121
TEMPORAL_SELF_CUE_MAX_AGE_SEC=900
TEMPORAL_SELF_CUE_FETCH_TIMEOUT_SEC=0.5

# --- Personality graph read-back for stance_react (enabled) ---
# What Orion keeps coming back to, in Orion's own words, rendered by a fixed template (no LLM,
# <= 600 chars) from orion-durable-runs' GET /personality/frame; a record, not an instruction.
# Missing, stale (older than MAX_AGE_SEC), or empty frame, or no reply within TIMEOUT_SEC, renders
# nothing.
# Kill switch: false = the stance prompt exactly as before.
# OFF since 2026-11-13 (personality design rev 3, R0): the frame held job boilerplate, not personality.
# Rev 3 replaces this reader with a Prime block line; do not turn it back on.
PERSONALITY_CUE_ENABLED=false
# Same durable-runs base as TEMPORAL_SELF_FRAME_URL (compose service key on app-net).
PERSONALITY_FRAME_URL=http://durable-runs:8121
PERSONALITY_CUE_TIMEOUT_SEC=0.5
PERSONALITY_CUE_MAX_AGE_SEC=3600
PERSONALITY_CUE_TOP_K=5

# --- Self-monitor track record for stance_react and reverie (spec 2026-10-20 step 3, enabled) ---
# What Orion is failing at or misjudging right now, from their own settled bets: held broken /
# unreliable / miscalibrated faculties only, <= 300 chars, fixed template (no LLM). Read from Redis
# orion:self_monitor:latest on ORION_BUS_URL (published hourly by orion-durable-runs) every 5 min in
# the background; absent, stale (> 3 h) or unparseable state renders nothing.
# Kill switch: false = both prompts exactly as before.
SELF_TRACK_RECORD_CUE_ENABLED=true

# --- Intention ledger D3: open promises for stance_react (app/open_promises_cue.py) ---
# Up to 3 of Orion's open promises on Juniper's own turns, read from the act ledger (hub.promise acts)
# and the promising turn's record. SHIPS OFF on purpose (an explicit exception to "flags ship on"):
# the promise acts are shadow until #3531 posts the finder's live precision; a false promise shown to
# stance would push Orion to follow up on something Orion never said. #3531 decides when this is true.
THOUGHT_OPEN_PROMISES_CUE_ENABLED=false

# --- Unified-turn self-prediction (spec 2026-10-23-unified-turn-self-prediction-design, A1) ---
# Stance also writes a private bet about this turn's own behaviour: will I ask a question, fetch
# an outside source, how many steps, how long a reply (ThoughtEventV1.self_prediction ->
# thought_decision.self_prediction). Never shown to the motor or the finalize judge. Adds ~60-120
# output tokens to the stance call. Kill switch: false = the stance prompt exactly as before.
STANCE_SELF_PREDICTION_ENABLED=true

# --- Self-readings: body signals against their own 7 days (self-calibration spec section C) ---
# A fixed template (no LLM) over substrate_node_prediction_error_history, calibrated by the
# attention seam's own rule (orion/attention/self_readings.py). Only signals that are high or
# unusual for themselves render (max 3 lines, 600 chars), each citing [pe:<node>@<observed_at>];
# a calm body renders nothing. Which signals: glossary prompt_sites. Kill switches: false = that
# prompt exactly as before. Read+render not done within FETCH_TIMEOUT_SEC renders nothing.
SELF_READINGS_STANCE_ENABLED=true
SELF_READINGS_FETCH_TIMEOUT_SEC=0.5
# Continuous body signals must last (spec 2026-10-16-attention-continuous-signal-quota).
# true: a body node the glossary marks as read every tick (biometrics, bus_synaptic) is
# high for itself ~10% of the time by construction, so it competes / reads as unusual only
# when it has been hot for more than 300 s of the last 600 s (its own readings) and is hot
# now. Perception and event-written signals are unaffected. false: today's verdict exactly.
ATTENTION_SUSTAINED_BODY_ENABLED=true
# What each body signal tends to lead to (spec section E): an unusual reading's line gets
# "; when this is high, my next hour had <a failed turn | a reply I had to repair | an RPC timeout>
# Nx as often at equal activity (...) [assoc:<id>]" from orion-equilibrium-service's hourly
# self_signal_outcome_association rows, only when both sides have enough hours and the 95%
# interval excludes 1. Kill switch: false = the block is byte-identical to before.
SELF_SIGNAL_OUTCOME_ASSOCIATION_ENABLED=true
# Repeated looks: a clause renders only after its verdict (same direction) held on each of the last
# N consecutive hourly computations; a gap or a different verdict resets the run. Same default as
# orion-equilibrium-service's EQUILIBRIUM_SELF_SIGNAL_OUTCOME_CONSECUTIVE_HOLDS. 1 = newest row only.
SELF_SIGNAL_OUTCOME_CONSECUTIVE_HOLDS=6

# --- Integration patch 3: reverie reads Orion's now (enabled) ---
# Each reverie reads GET /temporal-self/now?organ=reverie on TEMPORAL_SELF_FRAME_URL (the few most salient
# experiences of OTHER organs since reverie last looked) and posts its question's cites (at most 3 shown
# experience ids) to POST /temporal-self/now/use at its close (#3499). The now off on the server (404),
# unreachable, or slower than FETCH_TIMEOUT_SEC (<= 5) -> the reverie runs on its seed alone, logged
# reverie_now_unavailable. Kill switch: false = the seed alone.
ORION_REVERIE_NOW_ENABLED=true
ORION_REVERIE_NOW_FETCH_TIMEOUT_SEC=2.0
# ORION_THOUGHT_MIND_DRIVE_STATE_FETCH_TIMEOUT_SEC removed 2026-07-30: the
# drive_audits-backed drive_state_compact facet it bounded was retired --
# write-never once DriveEngine (the table's only producer) was deleted.

# --- Reasoning activity projection (always-on consumer; harmless when idle) ---
# Consume per-call ReasoningCallV1 telemetry off the bus and materialize a
# rolling-window ReasoningActivityV1 for φ to read via
# GET /projections/reasoning_activity. MAX_CALLS caps the in-memory buffer so
# memory stays bounded regardless of producer rate.
CHANNEL_REASONING_CALL=orion:cognition:reasoning_call
REASONING_ACTIVITY_WINDOW_SEC=120
REASONING_ACTIVITY_MAX_CALLS=2000

# --- Ambient thermal gate -------------------------------------------------
# GPU work heats the room Juniper sits in. This is the one budget here whose
# referent is outside Orion: the reading comes from the cabinet BME680 via
# orion-hub (same host as this worker), so the gate lives at the REQUESTER --
# declining to ask is cheaper and more honest than asking and being refused.
# A refusal is persisted as a visual chain with terminal_reason
# "thermal_refused", never a silent skip.
ORION_THERMAL_GATE_ENABLED=true
# hub is network_mode:host and this worker is bridge-networked, so 127.0.0.1 is
# the container's own loopback. Tailnet address, same convention as ORION_BUS_URL.
ORION_CABINET_SENSORS_BASE_URL=http://100.92.216.81:8080
ORION_CABINET_SENSORS_TIMEOUT_SEC=3.0
# The trip / re-arm lines (32.0 / 30.5 C) are not env keys: they are owned by
# orion/autonomy/thermal_gate.py (body economy Patch B). Retune them there.
