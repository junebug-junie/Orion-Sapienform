# ────────────────────────────────────────────────
# LLM Gateway defaults
# ────────────────────────────────────────────────
PROJECT=orion
SERVICE_NAME_LLM_GATEWAY=llm-gateway
SERVICE_VERSION_LLM_GATEWAY=0.1.1

# Durable-run lease validation (admission token only, until durable-runs moves to pool leases in
# stage 4). Placement is always a GPU pool lease; see GPU_POOL_CONFIG_PATH below.
LLM_GATEWAY_LEASE_VALIDATION_ENABLED=true
LLM_GATEWAY_LEASE_VALIDATION_URL=http://durable-runs:8121/leases/validate
LLM_GATEWAY_LEASE_VALIDATION_TIMEOUT_SEC=2
LLM_GATEWAY_LEASE_CHECK_INTERVAL_SEC=5

# GPU pool placement (docs/superpowers/specs/2026-09-24-gpu-pool-design.md, stage 3).
# Every LLM call takes a lease from orion-gpu-pool and goes to the URL the pool granted.
# config/gpu_pool.yaml `routes:` maps each route name to a pool class + priority; a route not
# listed there is refused (route_not_in_gpu_pool), never guessed. Copied into the image.
GPU_POOL_CONFIG_PATH=/app/config/gpu_pool.yaml
# How long one call may wait in the pool queue for a grant; never longer than the caller's own
# gateway_read_timeout_sec. Timeout -> raw.error=gpu_pool_unavailable, reason=deadline.
LLM_GATEWAY_POOL_WAIT_SEC=300
LLM_GATEWAY_POOL_BACKGROUND_WAIT_SEC=900
# HTTP passthroughs (/v1/messages, /v1/chat/completions) wait at most this for a grant; the queued
# acquire is withdrawn if the HTTP client disconnects first.
LLM_GATEWAY_POOL_PASSTHROUGH_WAIT_SEC=60
# Threads per granted role URL (one executor per GPU role; the pool bounds real concurrency).
LLM_GATEWAY_EXECUTOR_WORKERS_PER_ROLE=8

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true

CHANNEL_LLM_INTAKE=orion:exec:request:LLMGatewayService
CHANNEL_SPARK_INTROSPECT_CANDIDATE=orion:spark:introspect:candidate
CHANNEL_LLM_REPLY_PREFIX=orion:llm:reply
CHANNEL_VECTOR_LATENT_UPSERT=orion:vector:latent:upsert
# This is the fire-and-forget channel the gateway publishes assistant responses to for semantic embeddings.
CHANNEL_EMBEDDING_GENERATE=orion:embedding:generate

ORION_LLM_DEFAULT_BACKEND=llama-cola
ORION_DEFAULT_LLM_MODEL=Active-GGUF-Model
LLM_DEFAULT_PROFILE_NAME=
LLM_PROFILES_CONFIG_PATH=/app/config/llm_profiles.yaml

# No LLM backend URLs here any more: the GPU pool grant supplies the URL for every call
# (ORION_LLM_VLLM_URL / OLLAMA_URL / LLAMACPP_URL / LLAMA_COLA_URL removed 2026-09-24).
ORION_LLM_OLLAMA_USE_OPENAI=false
ORION_LLM_INCLUDE_EMBEDDINGS=false
ORION_VECTOR_LATENT_COLLECTION=orion_latent_store

# Atlas metacog lane contract (profile pin for metacog routes when a caller names none)
ATLAS_METACOG_PROFILE_NAME=qwen3-8b-q5km-v100-16gb-atlas-metacog-16k
ATLAS_METACOG_CUDA_VISIBLE_DEVICES=0
ATLAS_METACOG_HOST_PORT=8012

# Route names. There is no route table any more (LLM_GATEWAY_ROUTE_TABLE_JSON removed
# 2026-09-24): config/gpu_pool.yaml `routes:` is the list of routes, and the pool's grant is
# the URL/served_by for each call. `chat-burst`'s old operator gate is the pool's gpu0 lend
# flag; `quick_background`/`metacog_background` yield by pool priority, not /slots polling.
# `quick`, not `chat`: a request that names no route must never land on Juniper's reserved lane.
LLM_ROUTE_DEFAULT=quick
LLM_GATEWAY_HEALTH_PORT=8210
LLM_GATEWAY_CONCURRENT_HANDLERS=true

# Vision / chat attachments.
# Capability is read from each worker's own /props (modalities.vision), never from
# the profile registry — a profile can claim vision while the worker was started
# without --mmproj, and on 2026-08-14 the chat lane did exactly that.
LLM_GATEWAY_VISION_ENABLED=true
LLM_GATEWAY_VISION_PROPS_CACHE_TTL_SEC=300
LLM_GATEWAY_VISION_PROPS_TIMEOUT_SEC=5
# Trusted base the gateway builds attachment fetch URLs from, as <base>/<sha256>.
# The attachment ref's own source_url round-trips through the browser and is
# therefore client-controlled in full — scheme, host, port AND path — so it is
# deliberately not used. Only a regex-validated 64-char hex sha is appended here.
# EMPTY MEANS REFUSE TO FETCH ATTACHMENTS AT ALL.
LLM_GATEWAY_ATTACHMENT_BASE_URL=http://100.92.216.81:8080/api/chat/attachments
# Defence in depth over the base above, not the primary control: hosts the derived
# URL may resolve to. Host only — no scheme, no port. Empty refuses everything.
LLM_GATEWAY_ATTACHMENT_ALLOWED_HOSTS=100.92.216.81,orion-athena-percept-store
LLM_GATEWAY_ATTACHMENT_MAX_BYTES=8388608
LLM_GATEWAY_ATTACHMENT_FETCH_TIMEOUT_SEC=10

# Anthropic Messages passthrough for Claude Code / free-claude-code (FCC)
# FCC: LLAMACPP_BASE_URL=http://127.0.0.1:8210/v1
LLM_GATEWAY_ANTHROPIC_PASSTHROUGH_ENABLED=true
LLM_GATEWAY_ANTHROPIC_PASSTHROUGH_TIMEOUT_SEC=900

# OpenAI-compatible passthrough for AI Town / external OpenAI clients
# AI Town: LLM_API_URL=http://<mesh-ip>:8210  LLM_MODEL=quick
LLM_GATEWAY_OPENAI_PASSTHROUGH_ENABLED=true
# OpenAI /v1/embeddings → orion-vector-host POST /embedding
ORION_VECTOR_HOST_URL=http://orion-athena-vector-host:8320

# Phase 3 — LLM / GPU lane isolation. Default on so explicit agent/background
# metadata cannot silently fall through to the reserved chat worker. Set false
# only as a rollback to legacy body-route-only behavior.
LLM_LANE_ROUTING_ENABLED=true
LLM_LANE_DEFAULT=chat

CONNECT_TIMEOUT_SEC=10
READ_TIMEOUT_SEC=700
HEARTBEAT_INTERVAL_SEC=10

# Default llama.cpp structured-output method (see probe_structured_output.py); hub may override per route
LLM_STRUCTURED_OUTPUT_METHOD=none

# Logprob summary (language surface stability; opt-in per request via return_logprobs)
LLM_LOGPROB_SUMMARY_ENABLED=true
LLM_LOGPROB_TOP_K_DEFAULT=5
LLM_LOGPROB_LOW_MARGIN_THRESHOLD=0.5
LLM_LOGPROB_LOW_LOGPROB_THRESHOLD=-2.0
LLM_LOGPROB_UNSTABLE_SPAN_MIN_LEN=3
# Set true + per-request logprob_probe_mode=native_completion for aligned llama.cpp /completion path
LLM_LOGPROB_NATIVE_COMPLETION_ENABLED=true
LLM_LOGPROB_NATIVE_COMPLETION_MAX_TOKENS=256

# Camera frames (AttachmentRefV1.kind="percept") resolve from orion-percept-store,
# NOT from Hub's chat attachment store. Different content, different retention,
# and Hub is the process holding the docker socket. Unset means percepts are
# refused -- it deliberately does not fall back to the chat base.
LLM_GATEWAY_PERCEPT_BASE_URL=http://orion-athena-percept-store:8000/percepts
