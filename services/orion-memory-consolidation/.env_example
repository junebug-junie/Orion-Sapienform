# Orion Memory Consolidation — per-turn classify, window closure, suggest drafts

SERVICE_NAME=orion-memory-consolidation
SERVICE_VERSION=0.1.0
NODE_NAME=athena
LOG_LEVEL=INFO
PORT=8635

ORION_BUS_URL=${ORION_BUS_URL}
ORION_BUS_ENABLED=true
ORION_HEALTH_CHANNEL=orion:system:health
ERROR_CHANNEL=orion:system:error
HEARTBEAT_INTERVAL_SEC=30

POSTGRES_URI=${POSTGRES_URI}

CHANNEL_MEMORY_TURN_PERSISTED=orion:memory:turn:persisted
CHANNEL_CHAT_HISTORY_SPARK_META_PATCH=orion:chat:history:spark_meta:patch
CHANNEL_LLM_INTAKE=orion:exec:request:LLMGatewayService
CHANNEL_CORTEX_REQUEST=orion:cortex:request
CHANNEL_CORTEX_RESULT_PREFIX=orion:cortex:result

MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CLASSIFY_TIMEOUT_SEC=8.0
MEMORY_CLASSIFY_RETRY_INTERVAL_SEC=120
# Gateway route for turn-change classify (metacog = llama-3-8b-instruct; avoid thinking lanes)
# metacog_background (2026-09-07): background classification should yield to
# Mind's now-live metacog traffic, not compete evenly with it.
TURN_CHANGE_CLASSIFY_ROUTE=metacog_background
TURN_CHANGE_CONFIDENCE_MARGIN=0.15
TURN_CHANGE_SUBSTRATE_THRESHOLD=0.65
TURN_CHANGE_WINDOW_TURNS=3
CHANNEL_SIGNALS_PREFIX=orion:signals
MEMORY_BOUNDARY_SCORE_THRESHOLD=0.70
MEMORY_BOUNDARY_LLM_ONLY_THRESHOLD=0.85
MEMORY_BOUNDARY_OVERRIDE_THRESHOLD=0.92
MEMORY_SUGGEST_TIMEOUT_SEC=180.0
# Suggest completion budget (ctx-aware; align ctx with config/llm_profiles.yaml quick/atlas-fast ctx_size)
MEMORY_GRAPH_SUGGEST_CTX_TOKENS=4096
MEMORY_GRAPH_SUGGEST_PROMPT_OVERHEAD_TOKENS=1800
MEMORY_GRAPH_SUGGEST_MIN_COMPLETION_TOKENS=768
MEMORY_GRAPH_SUGGEST_MAX_TOKENS=4096
MEMORY_GRAPH_SUGGEST_CHARS_PER_TOKEN=3
MEMORY_GRAPH_SUGGEST_MIN_PROMPT_TOKENS_ESTIMATE=400
MEMORY_WINDOW_FALLBACK_GAP_SEC=5400

# Memory episode redesign Stage 1 (2026-10-02). Boundary Rule 3 runs in SHADOW
# beside the live windows: writes memory_episode_shadow and publishes
# memory.episode.closed.v1 on CHANNEL_MEMORY_EPISODE_CLOSED. Kill switch: false
# stops both. Needs services/orion-sql-db/manual_migration_memory_episode_v1.sql.
MEMORY_EPISODE_SHADOW_ENABLED=true
CHANNEL_MEMORY_EPISODE_CLOSED=orion:memory:episode:closed
# Whether the LIVE window rule and the classify prompt see the Hub's new
# conversation_phase stamp. false = live window closing unchanged (Rule 3 shadow
# still reads the stamp). true changes live windows (~98 -> ~34 per 30 days on
# the replay); read the Stage 1 PR report first.
MEMORY_LEGACY_BOUNDARY_USE_PHASE=false
# Daily old-vs-new memory report (markdown on the memory-episode-reports volume; read-only,
# no notification). It quotes Juniper's conversation: it lives on the host, never in git.
MEMORY_EPISODE_REPORT_ENABLED=true
MEMORY_EPISODE_REPORT_DIR=/data/memory-episode-reports
MEMORY_EPISODE_REPORT_TZ=America/Denver
# Memory Stage 2 referent projector (2026-10-06): writes referent nodes, memory evidence nodes,
# observed_in provenance edges and accepted co_occurs_with assertions into the substrate graph
# (producer memory.referents) from referent_alias + substrate_graph_journal. Apply
# manual_migration_substrate_graph_journal_v1.sql and manual_migration_referent_alias_v1.sql
# first. Safe to enable before the readers are redeployed: the projector waits (see below).
MEMORY_REFERENT_PROJECTOR_ENABLED=true
MEMORY_REFERENT_PROJECTOR_TICK_SEC=30
FALKORDB_URI=redis://orion-athena-falkordb:6379
FALKORDB_SUBSTRATE_GRAPH=orion_substrate
# The projector writes NOTHING until every reader below advertises the assertion-core
# capability (orion/substrate/reader_capability.py); /health shows which are missing.
SUBSTRATE_ASSERTION_REQUIRED_READERS=orion-substrate-runtime,hub,recall,cortex-exec,cortex-orch,spark-concept-induction,orion-field-digester,orion-world-pulse,meta-tags
# Memory confirmation loop (2026-10-06, Stage 3 pulled forward). A high-stakes shadow memory
# gets one "Orion is asking" card in the Hub (orion_ask, source_kind=memory_confirmation; at most
# 5 open, unanswered cards expire after 7 days and the memory becomes "unconfirmed"). Juniper's
# Confirm/Revise/Reject arrives on CHANNEL_ATTENTION_LOOP_OUTCOME and, as a backstop, from the
# attention_loop_outcome table every tick. Changes only the shadow episode_memory rows.
# Kill switch: false stops opening, expiring and applying. Needs
# services/orion-sql-db/manual_migration_memory_confirmation_v1.sql.
MEMORY_CONFIRMATION_LOOP_ENABLED=true
MEMORY_CONFIRMATION_TICK_SEC=60
# New cards per local day (Juniper's timezone), on top of the 5-open cap: answering promptly frees
# slots, and this keeps the panel from refilling all day. 0 = open no new cards.
MEMORY_CONFIRMATION_DAILY_CAP=3
MEMORY_CONFIRMATION_TZ=America/Denver
CHANNEL_ATTENTION_LOOP_OUTCOME=orion:attention:loop_outcome
MEMORY_FAILED_RETRY_INTERVAL_SEC=1800

# Consolidation gate output mode:
#   crystallization_propose — run gate; skip low-signal windows or propose crystallization (default)
#   graph_draft — legacy path: LLM suggest + graph draft insert (pre-gate behavior)
#   skip_only — run gate skip branch only; never propose crystallization or insert graph drafts
MEMORY_CONSOLIDATION_OUTPUT=crystallization_propose
# Gate thresholds (0-1) on turn novelty and significance scores
MEMORY_CONSOLIDATION_MIN_NOVELTY=0.35
MEMORY_CONSOLIDATION_MIN_SIGNIFICANCE=0.40
# Fetch read-only grammar event refs to inform gate decisions
MEMORY_CONSOLIDATION_FETCH_GRAMMAR_EVIDENCE=true
# Grammar DB DSN override; empty uses POSTGRES_URI consolidation pool
MEMORY_CONSOLIDATION_GRAMMAR_DSN=

# Formation intake: auto-activate eligible crystallizations (operator-on after smoke)
MEMORY_FORMATION_AUTO_ACTIVATE_ENABLED=true
# Encode activation ratio when auto-activate is enabled (0-1)
MEMORY_FORMATION_AUTO_ENCODE_ACTIVATION_RATIO=0.4
# Comma-separated external platforms (chat_history_log client_meta.external_room.platform)
# whose consolidation windows never become a crystallization -- no governor queue, no
# auto-activation, no graph/vector projection. Raw chat turns are unaffected (they are
# already durably in chat_history_log via orion-sql-writer). A window counts as external
# only when EVERY turn in it names the same platform, so a window mixing ai-town turns
# with a real conversation still goes to the queue for review. Empty string disables
# the gate.
MEMORY_FORMATION_DISCARD_PLATFORMS=aitown

# Cross-window concept-relation resolution: vector-similarity candidate retrieval +
# bounded LLM judgment dispatching same/refines/contradicts into typed crystallization
# links. Off by default pending review -- see
# orion/memory/crystallization/concept_relation.py. Empty embed/chroma hosts below are
# deliberate: even if CONCEPT_RELATION_RESOLUTION_ENABLED is flipped true without also
# configuring these, the feature degrades to a no-op.
CRYSTALLIZER_VECTOR_COLLECTION=orion_memory_crystallizations
CRYSTALLIZER_EMBED_HOST_URL=
CRYSTALLIZER_EMBED_TIMEOUT_MS=8000
CHROMA_HOST=
CHROMA_PORT=8000

CONCEPT_RELATION_RESOLUTION_ENABLED=false
CONCEPT_RELATION_CONFIDENCE_FLOOR=0.6
CONCEPT_RELATION_CANDIDATE_LIMIT=5
CONCEPT_RELATION_TIMEOUT_SEC=8.0
