# -----------------------------
# Orion Vision Window
# -----------------------------
# Mesh bring-up (`mesh-utilities/common/up_all_services.sh`) runs:
#   docker compose --env-file <repo>/.env --env-file services/orion-vision-window/.env -f ...
#
# ORION_BUS_URL — required when running compose from this directory alone.
ORION_BUS_URL=redis://100.92.216.81:6379/0

# Optional (normally from root `.env` / compose defaults)
# LOG_LEVEL=INFO
# ORION_BUS_ENABLED=true
NODE_NAME=athena

ORION_BUS_ENFORCE_CATALOG=true
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health).
HEARTBEAT_INTERVAL_SEC=10

# Host port -> container :8000 (compose default 8019; 8010 is used by orion-vector-writer)
# VISION_WINDOW_HTTP_PORT=8019

# Bus channels (defaults match `app/settings.py`)
CHANNEL_WINDOW_INTAKE=orion:vision:artifacts
CHANNEL_WINDOW_PUB=orion:vision:windows
CHANNEL_WINDOW_REQUEST=orion:exec:request:VisionWindowService

# Rolling window / flush
WINDOW_SIZE_SEC=30.0
FLUSH_INTERVAL_MS=5000
MAX_ARTIFACTS_PER_WINDOW=64
MAX_WINDOW_AGE_MS=60000
STALE_AFTER_MS=120000

# Scene belief habituation (observed → believed tier in summary.evidence)
# enter=3: label must appear in all N flushes (blocks intermittent false positives like package)
# exit=0: remove only when absent from all N raw observations (prevents belief ping-pong)
WINDOW_BELIEF_ENABLED=true
WINDOW_BELIEF_VOTE_N=3
WINDOW_BELIEF_ENTER_VOTES=3
WINDOW_BELIEF_EXIT_VOTES=0

# HTTP (in-container listen; host mapping is VISION_WINDOW_HTTP_PORT above)
# HTTP_HOST=0.0.0.0
# HTTP_PORT=8000

# Bounded Redis recovery (empty VISION_WINDOW_RECOVERY_REDIS_URL → use ORION_BUS_URL)
VISION_WINDOW_RECOVERY_ENABLED=true
VISION_WINDOW_RECOVERY_REDIS_URL=
VISION_WINDOW_RECOVERY_TTL_SEC=3600
VISION_WINDOW_RECOVERY_MAX_N=50
VISION_WINDOW_HTTP_MAX_LIMIT=50
VISION_WINDOW_READY_REQUIRES_RECOVERY=false

# --- Scene inventory (object permanence substrate) --------------------------
# One census row per window -> orion:vision:inventory:sql-write -> sql-writer
# -> vision_scene_inventory. Unconditional by design: the council only emits a
# vision_event when the observed label SET changes, so a count change (two
# boxes become one) and a departure are both invisible in the event stream.
WINDOW_SCENE_INVENTORY_ENABLED=true
CHANNEL_SCENE_INVENTORY_PUB=orion:vision:inventory:sql-write

# --- Embodied presence -------------------------------------------------------
# "Is someone at the camera, and for how long" -- substrate_embodied_presence,
# a single-row upsert per stream, same shape as Hub's own hub_presence.
# Layered on the believed_labels above (already vote-smoothed), not on raw
# per-window detections.
WINDOW_PRESENCE_ENABLED=true
WINDOW_PRESENCE_GRACE_SEC=120.0
WINDOW_PRESENCE_WRITE_MIN_INTERVAL_SEC=5.0
# No POSTGRES_URI here: this pulls the root .env's already-correct value
# through docker-compose.yml's `environment:` list (compose interpolation),
# not from this file's own env_file load. This is the first time
# orion-vision-window writes to Postgres directly -- every other write in
# this service goes out over the bus to orion-sql-writer.

# --- Identity hypothesis intake ----------------------------------------------
# 2026-08-26. Separate channel and separate consumer loop from
# CHANNEL_WINDOW_INTAKE above -- identity_face is deliberately excluded from
# the general orion:vision:artifacts broadcast for privacy (orion-vision-
# host's should_broadcast_artifact); this is its own narrow, single-producer
# (orion-vision-host)/single-consumer (this service) lane. Value must match
# orion-vision-host's CHANNEL_VISIONHOST_IDENTITY_PUB.
CHANNEL_WINDOW_IDENTITY_INTAKE=orion:vision:artifacts:identity
WINDOW_IDENTITY_ENABLED=true
# A hypothesis older than this is not evidence of who is there NOW -- same
# staleness discipline as orion/situational/context.py's percept gate.
# Identity dispatch is rate-limited to roughly once per
# min_seconds_between_dispatch (config/vision_frame_router.yaml's
# identity_dispatch block, live default 30s) per camera, so this must
# comfortably exceed that cadence or a hypothesis would read as stale
# between its own refreshes.
WINDOW_IDENTITY_MAX_AGE_SEC=90.0
