# Orion Power Guard
SERVICE_NAME=power-guard
SERVICE_VERSION=0.1.0

ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
#ORION_BUS_URL=redis://localhost:6379/0
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health).
HEARTBEAT_INTERVAL_SEC=10

POWER_GUARD_NODE_NAME=$(hostname)
POWER_GUARD_UPS_NAME=apc_ups

# if using USB
POWER_GUARD_UPS_HOST=host.docker.internal
# if using SNMP Networking
#POWER_GUARD_UPS_HOST=192.168.0.50

POWER_GUARD_SNMP_PORT=161
POWER_GUARD_SNMP_COMMUNITY=public

POWER_GUARD_POLL_INTERVAL_SEC=5.0
# How long the UPS can sit on battery before power-guard shuts the host down
# (only takes effect if POWER_GUARD_ENABLE_SHUTDOWN=true below). 300s = 5min.
POWER_GUARD_ONBATTERY_GRACE_SEC=300.0

CHANNEL_POWER_EVENTS=orion:power:events

# Shutdown wiring: power-guard runs in a container, so it cannot shut the
# host down directly -- it SSHes out to the host over the docker bridge
# using the key mounted at /etc/powerguard/ssh_key (see docker-compose.yml
# and README.md "Shutdown wiring" for how that key is provisioned).
# POWER_GUARD_ENABLE_SHUTDOWN defaults to false here on purpose: arming a
# real host shutdown is a deliberate per-deployment decision, not something
# a template should turn on for you.
POWER_GUARD_ENABLE_SHUTDOWN=false
POWER_GUARD_SHUTDOWN_CMD=ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 -o BatchMode=yes -i /etc/powerguard/ssh_key root@host.docker.internal 'shutdown -h now "Orion PowerGuard: UPS on battery beyond grace period"'
