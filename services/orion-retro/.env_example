# P1 operator-only service. No bus/cognition or browser surface.
RETRO_ENABLED=false
RETRO_UID=1000
RETRO_GID=1000
# Set absolute host paths during local operator setup; never commit ROMs/tokens.
RETRO_CATALOG_DIR=
RETRO_EVIDENCE_DIR=
RETRO_SOCKET_DIR=
RETRO_TOKEN_FILE=

# Distinct Hub service credential created by install_catalog.py
RETRO_HUB_TOKEN_FILE=

# Explicit per-session handoff is also required; no memory export.
RETRO_COGNITION_ENABLED=false
