# Copy to .env and tune for your node.
# See README.md for skeleton status -- this service does not load a model in
# this patch. Every key below exists so the runtime shape (port, cache path,
# node identity) is settled now, not so anything downstream reads it yet.

LOG_LEVEL=INFO
NODE_NAME=athena

HOST_PORT=6612

# Bus is declared but NOT consumed in this patch (see README.md "does not
# exist in this patch"). Kept false here so an operator who copies this file
# does not accidentally expect a live intake channel.
ORION_BUS_ENABLED=false
ORION_BUS_ENFORCE_CATALOG=true
ORION_BUS_URL=redis://100.92.216.81:6379/0
HEARTBEAT_INTERVAL_SEC=10

# Model cache dir convention: storage-warm, not vision-host's telemetry
# convention -- see README.md "Model cache dir convention" for why.
MODEL_CACHE_DIR=/mnt/storage-warm/models/diffusion
HF_HOME=/mnt/storage-warm/models/diffusion/hf
TRANSFORMERS_CACHE=/mnt/storage-warm/models/diffusion/hf/transformers

CUDA_VISIBLE_DEVICES=
