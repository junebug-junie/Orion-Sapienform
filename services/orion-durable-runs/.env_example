# orion-durable-runs -- durable, resumable cognition runs kicked off from cortex.
# Design: docs/superpowers/specs/2026-09-06-durable-cognition-runs-from-cortex-design.md
PROJECT=orion-athena
SERVICE_NAME=orion-durable-runs
SERVICE_VERSION=0.1.0
NODE_NAME=athena
# ALWAYS the Tailscale bus address (AGENTS.md sec 0, item 10).
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10
# RPC-health snapshot publish (orion:rpc_health:snapshot) of the long-lived rpc_bus:
# runner rpc_request calls + the GPU pool lease RPCs (gpu_pool_lease). Stage 4.5 removed every
# outbound HTTP hop (gateway /routes, lane /slots, cabinet, thought, gpu2 controller).
# Consumer-first: rebuild orion-signal-gateway + orion-equilibrium-service on PR #2312's
# build BEFORE this service publishes channel_latency (RpcHealthSnapshotV1 is extra="forbid").
# ALSO a hard prerequisite: orion-equilibrium-service must run PR #2310's build first. On any
# older build its legacy transport-metacog trigger reads EVERY service's pooled timeouts/p95
# (>=5s), and this service's calls are LLM-bound by design, so it would fire every cooldown.
RPC_HEALTH_PUBLISH_ENABLED=true
RPC_HEALTH_PUBLISH_INTERVAL_SEC=30
RPC_HEALTH_CHANNEL_LATENCY_ENABLED=true
# Checkpoints live in the shared conjourney database, in LangGraph's own
# tables (checkpoints, checkpoint_blobs, checkpoint_writes, checkpoint_migrations),
# created by the saver's setup() on boot. The runner is their only writer.
POSTGRES_URI=
LOG_LEVEL=INFO
# Host port (container listens on 8121; 8121 on the host is orion-execution-dispatch-runtime).
DURABLE_RUNS_PORT=8124
# Off = heartbeat + /health only; kickoffs sit unanswered on the request channel.
DURABLE_RUNS_ENABLED=true
# Pick every unfinished thread back up at boot (the whole point), and again
# every sweep for threads whose last node attempt failed (Hub away mid-turn).
DURABLE_RUNS_RESUME_ON_BOOT=true
DURABLE_RUNS_RESUME_SWEEP_SEC=120.0
# A checkpoint older than this is abandoned, never resumed into a different
# day's material (design doc MQ2/MQ3).
DURABLE_RUNS_MAX_AGE_HOURS=24.0
# The harness-turn RPC to Hub. Above HUB_CURIOSITY_INVESTIGATION_TIMEOUT_SEC (8840s)
# so the runner never gives up on a turn Hub is still running.
DURABLE_RUNS_TURN_RPC_TIMEOUT_SEC=8940.0
# Orion's own graph for read_turn_result -- same values as HUB_CURIOSITY_GRAPH_HOST/PORT/OWN.
# Blank host = the graph half is off (rows say graph_unreadable), same as Hub.
DURABLE_RUNS_GRAPH_HOST=
DURABLE_RUNS_GRAPH_PORT=6379
DURABLE_RUNS_GRAPH_OWN=orion_worldview

# Admitted runs run on GPU pool holds (stage 4.5, docs/superpowers/specs/2026-09-25-gpu-pool-
# stage4-durable-runs-and-actuation.md): the pool is the only scheduler. The broker, lane policy,
# widening and gpu2 elastic keys were deleted with the broker (see the 4.5 cutover runbook).
DURABLE_RUNS_ADMISSION_ENABLED=true
DURABLE_RUNS_ADMISSION_TICK_SEC=5.0
# Body economy Patch A5 (docs/superpowers/specs/2026-10-23-organism-body-economy-design.md): every
# durable run Orion starts for itself writes an act to grammar_acts -- opened at the run's first GPU
# pool grant, closed at its terminal (completed=1, failed/cancelled=0). Families: curiosity
# investigate (infer), self-inquiry (ask), self-sense eval (sense), journal compose (make). Urgent
# incident runs and upkeep workflows are excluded. false -> no act events (app/run_acts.py).
ORION_DURABLE_ACT_EMIT_ENABLED=true
# A working run heartbeats its pool hold this often (at most half of hold_lease_ttl_sec; checked
# at boot). Also how often a Door-A outreach hold is kept alive for Hub.
DURABLE_RUNS_LEASE_HEARTBEAT_SEC=15.0
# A queued run wakes on the pool's "granted" event for its holder; this is only the missed-event
# fallback -- one pool status read per waiting run per interval (no polling storm).
DURABLE_RUNS_HOLD_STATUS_POLL_SEC=60.0
# Door-A: how long a completed run's hold is kept for Hub's outreach composition before
# durable-runs releases it itself (Hub normally releases it within minutes).
DURABLE_RUNS_OUTREACH_HOLD_MAX_SEC=1800.0
# A hold request the GPU pool could not take -- unreachable, or a refusal about the pool rather
# than the run (version skew "invalid:*", a config roll's "unknown_class") -- keeps the run
# waiting_resource and retries after BASE * 2^(n-1) s, capped at MAX; each refusal is a visible
# run.waiting_resource event with the reason (incident 2026-09-26: such refusals failed 11 runs).
DURABLE_RUNS_POOL_RETRY_BASE_SEC=15.0
DURABLE_RUNS_POOL_RETRY_MAX_SEC=300.0
DURABLE_RUNS_RETRY_MAX_ATTEMPTS=3
# How many times the GPU pool may take one run's hold back mid-step (a recall that runs out its
# 600 s grace: gpu2's max_hold seat limit, chat reclaiming lent gpu0; a lost heartbeat) before the
# run fails with hold_takeback_limit. A take-back never spends a RETRY attempt: the run waits for
# the same hold and replays the step. This only stops a step that never fits from replaying
# forever. 0 = unbounded.
DURABLE_RUNS_HOLD_MAX_TAKEBACKS=12
DURABLE_RUNS_RETRY_BASE_SEC=30.0
DURABLE_RUNS_RETRY_MAX_SEC=300.0
# Admitted runs: a resume that keeps failing is failed terminally (run.failed, error
# "checkpoint_resume_failed: ...") once it has at least RESUME_MAX_FAILURES failures since its
# last real node progress AND the first of them is RESUME_MIN_FAILURE_SPAN_SEC old -- instead of
# being re-driven every admission tick forever (live 2026-09-22..25: 53k retries of one run).
DURABLE_RUNS_RESUME_MAX_FAILURES=10
DURABLE_RUNS_RESUME_MIN_FAILURE_SPAN_SEC=600

# cortex-orch's public request channel (compactor digest and other verb calls the runner
# makes). Must name the same channel as cortex-exec's CORTEX_REQUEST_CHANNEL.
CORTEX_REQUEST_CHANNEL=orion:cortex:request
# reverie.visual: per-stage RPC wait on orion-thought (prepare runs interpret, caption runs the
# vision caption). generate waits max(this, brief.timeout_sec). A timeout is a retry (backoff,
# no attempt spent); the run's deadline is the only bound.
DURABLE_RUNS_REVERIE_VISUAL_STEP_TIMEOUT_SEC=600.0
# dream.carry (2026-10-10): after the carry's deadline, the finish step (orion-dream writes the
# dream with the hops made so far) keeps retrying this many seconds more, so a partial carry is
# still written. Past it the run fails with the last finish error.
DREAM_CARRY_FINISH_GRACE_SEC=1800
# dream.carry image hops: a child painting that ends without a picture for a retryable reason (its
# window ran out deferring to heat/busy/resource) is replaced by a fresh child for the same hop, at
# most this many children per hop, and only while at least DREAM_CARRY_CHILD_MIN_WINDOW_SEC of the
# carry is left. Otherwise the carry finishes partial.
DREAM_CARRY_CHILD_MAX_ATTEMPTS=3
DREAM_CARRY_CHILD_MIN_WINDOW_SEC=900
# One dream child's own window (capped at 6600), and the least wait before a replacement child
# (orion-thought's 600 s painting cooldown + a baseline tick): a hot cabinet must not keep thought's
# single painting slot on dream pictures for hours, and waking paintings get the slot in between.
DREAM_CARRY_CHILD_WINDOW_SEC=2400
DREAM_CARRY_CHILD_RETRY_GAP_SEC=900

# Memory episode distiller (2026-10-02, SHADOW; spec 2026-09-30-memory-episode-redesign-design.md).
# Subscribes orion:memory:episode:closed and runs one admitted memory.episode_distill per closed
# episode: the 27B agent lane at system priority (route memory_distill), writing only the
# episode_memory* shadow tables (apply services/orion-sql-db/manual_migration_episode_memory_v1.sql
# first). Kill switch: MEMORY_EPISODE_WRITER_ENABLED=false stops new submissions. Needs
# DURABLE_RUNS_ADMISSION_ENABLED=true. Timeout is capped at 900 s (the gateway's own cap).
MEMORY_EPISODE_WRITER_ENABLED=true
CHANNEL_MEMORY_EPISODE_CLOSED=orion:memory:episode:closed
MEMORY_EPISODE_DISTILL_ROUTE=memory_distill
MEMORY_EPISODE_DISTILL_TIMEOUT_SEC=600.0
MEMORY_EPISODE_DISTILL_MAX_TOKENS=4096
MEMORY_EPISODE_DISTILL_DEADLINE_HOURS=20.0
CHANNEL_LLM_INTAKE=orion:exec:request:LLMGatewayService
# Reconciler for lost close events / failed distill runs (new durable attempt each time).
MEMORY_EPISODE_RECONCILE_INTERVAL_SEC=900.0
MEMORY_EPISODE_DISTILL_MAX_ATTEMPTS=3
# Memory Stage 2 referents (2026-10-06): after each distill, resolve every referent key to a
# substrate node id and keep Juniper's names for it (referent_alias; apply
# services/orion-sql-db/manual_migration_referent_alias_v1.sql and
# manual_migration_substrate_graph_journal_v1.sql first). Runs in a savepoint: a fault never
# loses the memories. Each acceptance rule has its own kill switch:
#   MEMORY_ALIAS_GROUNDING_AUTO_ACCEPT  alias_grounding_v1: a name found in Juniper's verified
#                                       prompt quote is usable (provisional). false = all proposed.
#   MEMORY_COOCCURRENCE_AUTO_ACCEPT     source_cooccurrence_v1: two things named in one verified
#                                       prompt quote become a walkable co_occurs_with. false = proposals only.
MEMORY_REFERENTS_ENABLED=true
MEMORY_ALIAS_GROUNDING_AUTO_ACCEPT=true
MEMORY_COOCCURRENCE_AUTO_ACCEPT=true

# Situation graph step 2 (spec docs/superpowers/specs/2026-10-07-situation-graph-design.md, SHADOW).
# A self-driven LangGraph thread per UTC day (situation:juniper:<date>) keeps Orion's running
# situation from episode_memory and projects it to Redis orion:situation:latest + bus
# orion:situation:state. Inputs: orion:chat:history:turn, finished memory.episode_distill runs,
# and a clock tick. No GPU, no LLM. Nothing reads it until step 3. Kill switch: false.
SITUATION_GRAPH_ENABLED=true
SITUATION_TICK_SEC=900.0
# A `happened` memory with no stated end counts as current this long after it happened ("as of").
SITUATION_DEFAULT_TTL_HOURS=48.0
SITUATION_PRIME_TIMEOUT_SEC=0.4
SITUATION_RETENTION_DAYS=2
SITUATION_REDIS_TTL_SEC=604800
CHANNEL_CHAT_HISTORY_TURN=orion:chat:history:turn
# Home-camera face match (orion-vision-window, IdentitySightingV1) -> Juniper's whereabouts for this long (short: she can leave unannounced).
SITUATION_SIGHTING_HOLD_HOURS=2.0
CHANNEL_IDENTITY_SIGHTING=orion:vision:identity:sighting

# Temporal Self rev 4, order 3 "R2/R3 core" (PR #2369 spec, section R3). A second self-driven
# LangGraph thread per LOCAL day (temporal_self:orion:<date>) runs a `regulate` node every
# TEMPORAL_SELF_TICK_SEC and on each Juniper chat turn: arousal = engaged / idle / strained /
# unknown, written to Redis orion:regulation:latest (TTL) and GET /regulation/state; each new level
# episode (level change, or restart after a gap) is one `arousal_transition` row in temporal_self_event
# (services/orion-sql-db/manual_migration_temporal_self_event_v1.sql). No dial reads it yet.
TEMPORAL_SELF_ENABLED=true
TEMPORAL_SELF_TICK_SEC=120.0
TEMPORAL_SELF_RETENTION_DAYS=2
ORION_SITUATION_TIMEZONE=America/Denver
# false -> arousal reads `unknown` ("disabled"); readers then keep their pre-arousal behaviour.
ORION_REGULATION_AROUSAL_ENABLED=true
# Engaged/idle boundary. Owner: services/orion-dream/.env_example (gate: check_env_key_single_source.py).
DREAM_IDLE_MINUTES=45
# Strain from compute: summed GPU pool queue depth >= MIN for SEC (from gpu_pool_state_history).
ORION_REGULATION_STRAINED_GPU_QUEUE_MIN=2
ORION_REGULATION_STRAINED_GPU_QUEUE_SEC=300.0
ORION_REGULATION_STRAINED_CLEAR_SEC=600.0
ORION_REGULATION_REDIS_TTL_SEC=360

# Temporal Self patch 3 (PR #2369 rev 4): the `chronicle` node on the same thread runs the
# chronology reducer (orion/temporal_self) live: arcs, closed days, the current-day frame and
# per-source cursors in temporal_self_* (services/orion-sql-db/manual_migration_temporal_self_v1.sql).
# GET /temporal-self/{frame,arcs,threads,cursors,day/<id>}. No consumer reads it yet (patch 4).
# false -> no chronology; regulation keeps running.
TEMPORAL_SELF_CHRONICLE_ENABLED=true
# Strain loop part 1 (docs/superpowers/specs/2026-10-20-strain-loop-design.md): one `strain` arc per
# strained episode (opens on strained, causes join it, closes on idle/engaged/unknown), shown in the
# chat stance cue, the Day letter and reverie. Also writes a regulation row when a strain cause joins
# an episode. false -> no cause rows, no strain arcs; arousal itself is unchanged.
TEMPORAL_SELF_STRAIN_ARCS_ENABLED=true
# Orion plays Zelda (spec 2026-10-22 section F): read orion-hub's retro_play_sessions as Temporal Self
# source `retro_play` (one `play` arc per finished Retro session, shown in the chat stance cue).
# false -> not read; Hub still writes the rows and the memory cards.
TEMPORAL_SELF_RETRO_PLAY_ENABLED=true
# Episodes from the street (walkway follow-ups spec PR #2763 item 1): read notable outside events as
# Temporal Self source `street_event` -- published motion stories that passed Juniper's spot-check gate,
# doorbell rings, graded handoffs with p < 0.05 -- one `street` arc each, labelled "Outside (<camera>)".
# false -> not read; episodes are room-only again. PER_DAY caps street arcs per local day (0 = none).
TEMPORAL_SELF_STREET_EPISODES_ENABLED=true
TEMPORAL_SELF_STREET_EPISODES_PER_DAY=12
# K (ticks to open/resume an attention arc) and R (return window), from PR #2597's 10-09 sweep.
TEMPORAL_SELF_ARC_MIN_TICKS=3
TEMPORAL_SELF_RETURN_WINDOW_MIN=30.0
TEMPORAL_SELF_CONVERSATION_RETURN_WINDOW_MIN=180.0
# Read rows up to now minus this (late writers: chat row after its trace <=141 s, metacog <=532 s).
TEMPORAL_SELF_READ_LAG_SEC=300.0
# First boot starts at local midnight this many days ago (1 = yesterday closes on the first step).
TEMPORAL_SELF_BACKFILL_DAYS=1
# Retention (also covers the regulate node's arousal_transition rows in temporal_self_event).
TEMPORAL_SELF_EVENT_RETENTION_DAYS=30
TEMPORAL_SELF_ARC_RETENTION_DAYS=90
TEMPORAL_SELF_DAY_RETENTION_DAYS=365

# R4 runtime immune sweep (PR #2369 rev 4): an `immune` node after `regulate` checks 24 h of the
# glossary's semantic field channels (substrate_field_state, one sample/min) for gauges that stopped
# telling the truth (constant / floor-locked / replayed / decayed-to-zero). Runs only while arousal
# is idle, at most once per interval; each finding is one `immune_finding` row in temporal_self_event
# and RegulationStateV1.immune_findings_open counts them. It never fixes anything.
# Constant / floor-locked / replayed need semantics.rest_range in the glossary (absent until a parallel
# patch lands: until then only decayed-to-zero is live). Never runs while arousal is not idle.
# false -> no sweep; regulation and chronicle keep running.
TEMPORAL_SELF_IMMUNE_ENABLED=true
TEMPORAL_SELF_IMMUNE_INTERVAL_SEC=21600

# Body economy Patch A3 (docs/superpowers/specs/2026-10-23-organism-body-economy-design.md, Organ 1
# Body): a `physiology` node after `regulate` writes one PhysiologyStateV1 per tick (at most once per
# ORION_PHYSIOLOGY_MIN_INTERVAL_SEC; chat-turn steps in between are skipped): heat (cabinet C vs the
# soft line), energy (Orion's month-to-date USD vs the envelope), lane:<role> (GPU slot-seconds held
# in the last window vs slots x window), attention:juniper (outreach sent today vs the Hub's daily
# cap), claude (ClaudeLimitObservationV1 state, not dollars). A missing or stale source is an explicit
# no_reading, never 0. Redis orion:physiology:latest (TTL) + bus orion:physiology:state ->
# sql-writer table physiology_state. Nothing decides from it yet. false -> no node.
ORION_PHYSIOLOGY_ENABLED=true
ORION_PHYSIOLOGY_MIN_INTERVAL_SEC=100.0
ORION_PHYSIOLOGY_REDIS_TTL_SEC=360
CHANNEL_PHYSIOLOGY_STATE=orion:physiology:state
ORION_PHYSIOLOGY_HEAT_SOFT_LINE_C=31.0
# Juniper sets this (empty = a level with no line).
# Juniper set $100/month on 2026-10-23. Measured Orion cost 09-23..10-22 was $197, ~79% of it always-on
# draw, so this line binds from day one: the energy reading shows Orion over its envelope until
# structural changes (what stays powered) bring it down. Thinking less cannot reach it.
ORION_PHYSIOLOGY_ENERGY_MONTHLY_ENVELOPE_USD=100
ORION_PHYSIOLOGY_LANE_WINDOW_SEC=3600.0
# Body economy Patch B2 (Organ 2 Budget + the Felt strain dial), SHADOW: one price per constraint per
# tick on PhysiologyStateV1 (value, ceiling, bind state, why) plus `strain` = the largest live price /
# its ceiling. Published to the same Redis key / bus channel / physiology_state row; read by nothing
# that decides. Debug: GET /physiology/state. false -> Body readings only.
ORION_PHYSIOLOGY_PRICES_ENABLED=true
# Heat sensitivities as data: written by scripts/analysis/fit_heat_sensitivity.py --write-config, baked
# into the image. Missing/malformed/older than 30 days -> the heat price is no_reading (never 0).
ORION_PHYSIOLOGY_HEAT_SENSITIVITY_PATH=/app/config/physiology/heat_sensitivity.yaml
# The attention:juniper line. Owner: services/orion-hub/.env_example (keep equal).
HUB_ENDOGENOUS_OUTREACH_DAILY_CAP=4
CHANNEL_CLAUDE_LIMIT=orion:substrate:claude_limit
# Body economy Patch C1 (Organ 3 Appetite + Organ 4 Choice), SHADOW: POST /physiology/bid takes a WantV1,
# returns a WantDecisionV1 (funded/deferred, lane, prices seen, net, binding constraint, displaced,
# retry_after, shadow=true) and publishes it on CHANNEL_PHYSIOLOGY_WANT_DECISION -> sql-writer want_ledger.
# Nobody obeys the decision yet (Patch D cuts over one reader per PR). false -> the route answers 503 and
# orion.physiology.client.bid returns None, so callers keep their own gates.
ORION_PHYSIOLOGY_BID_ENABLED=true
CHANNEL_PHYSIOLOGY_WANT_DECISION=orion:physiology:want:decision
# Want families (tier, prior weight, deferrable window, lanes), baked into the image from
# config/physiology/families.yaml. Missing/malformed -> every bid answers physiology_unavailable.
ORION_PHYSIOLOGY_FAMILIES_PATH=/app/config/physiology/families.yaml
# grammar_acts + act_downstream_use are re-read at most this often (weights move <= 0.1/day).
ORION_PHYSIOLOGY_BID_HISTORY_TTL_SEC=300.0
# A physiology state older than this is stale: the bid answers physiology_unavailable, never funded.
ORION_PHYSIOLOGY_BID_STALE_AFTER_SEC=360.0
# Body economy Patch C3a, SHADOW: want-family durable runs (curiosity investigate, self-inquiry, self-sense
# eval, journal compose) bid in-process when admission accepts them; the reservation is re-anchored at the
# first grant and released at the run's terminal. Decisions land in want_ledger; nothing obeys them.
# Needs ORION_PHYSIOLOGY_BID_ENABLED=true (the market). false -> no admission bids.
ORION_PHYSIOLOGY_SHADOW_BIDS_ENABLED=true
# Body economy Patch D (2026-10-30): curiosity investigate runs OBEY their bid. on -> bid before asking the
# GPU pool: funded, or a capacity deferral worth its price, asks the pool (the pool's queue is the queue); a
# price / sated / net<=0 deferral holds the run (event run.economy_held, with the market's reason) and re-bids,
# at most the family's deferrable window (6 h), never dropped; no market answer asks the pool as before.
# shadow -> back to the C3a shadow bid at submit (admission unchanged). Instant rollback: set shadow, restart.
ORION_PHYSIOLOGY_BID_CURIOSITY_INVESTIGATE=on
# Orion Prime step 3 (2026-10-30): Prime's "slow down" / "quicken" signals become bounded, temporary charges
# (or credits) on the bids of a family that declares receptors in config/physiology/families.yaml (today
# only durable.curiosity_investigate). At most half the family's weight: a hungry, valuable want still
# outbids it. Every bid that meets one records what it did, for Prime to read. false -> the market ignores
# Prime's signals entirely (instant rollback: set false, restart).
ORION_PHYSIOLOGY_PRIME_REGULATION=true
# Body-economy report (2026-10-29): GET /physiology/report returns one PhysiologyReportV1 (limits hour by
# hour, wants funded vs deferred, heavy-work rhythm, money, unit costs, waste, queue wait, decisions, claude,
# vram, value per cost, services down). Read-only. Readers: the Hub #body-economy page and the skill
# skills.physiology.state.v1 (Orion reads its own body in chat turns and curiosity runs). false -> 503,
# and the skill tells Orion the report is switched off.
ORION_PHYSIOLOGY_REPORT_ENABLED=true
ORION_PHYSIOLOGY_REPORT_CACHE_SEC=60.0
ORION_PHYSIOLOGY_REPORT_CONCURRENCY=3
ORION_PHYSIOLOGY_REPORT_GPU_POOL_PATH=/app/config/gpu_pool.yaml

# Personality graph loop (spec 2026-10-16-orion-dynamic-personality-graph-design.md, rev 2). A
# periodic reducer folds Orion's own output from today on (no backfill) -- dream hypotheses,
# journal, reverie, reading summaries, day letters, chat and outreach replies, curiosity picks and
# self-inquiry seeds -- into weighted dispositions in personality_* tables
# (services/orion-sql-db/manual_migration_personality_graph_v1.sql; apply it first, without it every
# tick logs personality_tick_failed and writes nothing). GET /personality/{frame,dispositions,evidence}.
# false -> no reducer, the frame route answers 503 and every reader falls open.
PERSONALITY_ENABLED=true
PERSONALITY_TICK_SEC=600
# Self-naming (spec 2026-10-17-personality-orion-names-dispositions-design.md; needs
# services/orion-sql-db/manual_migration_personality_naming_v1.sql). true -> every tick applies Orion's
# name / reject / merge answers from orion_disposition_naming, and GET /personality/naming/next hands
# Hub the next naming packet. false -> answers wait unapplied and /personality/naming/next answers 204.
PERSONALITY_NAMING_APPLY_ENABLED=true
# vector-host /embedding (bge-large-en-v1.5, compute only); same URL shape as DREAM_SEARCH_EMBED_URL.
PERSONALITY_EMBED_URL=http://${PROJECT}-vector-host:8320/embedding
