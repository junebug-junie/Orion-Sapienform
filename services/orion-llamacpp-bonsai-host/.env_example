# services/orion-llamacpp-bonsai-host/.env
#
# Ternary-Bonsai-2-27B bake-off worker on Circe (PrismML llama.cpp fork).
# Separate from orion-llamacpp-host so chat/agent/fast/metacog never pick up
# the fork's binaries or image tag.

SERVICE_NAME=orion-llamacpp-bonsai-host
SERVICE_VERSION=0.1.0

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENFORCE_CATALOG=true

LLM_PROFILES_CONFIG_PATH=/app/config/llm_profiles.yaml
LLM_CACHE_DIR=/mnt/telemetry/llm-cache

# Optional: HuggingFace token (prism-ml/Ternary-Bonsai-2-27B-gguf is public)
HF_TOKEN=
hf_token=

# Built by services/orion-llamacpp-bonsai-host/scripts/build-bonsai-volta.sh
# (PrismML-Eng/llama.cpp prism @ 88c4bc6, sm_70 / CUDA 12.8).
# Do NOT put this tag in orion-llamacpp-host's LLAMACPP_IMAGE_TAG.
BONSAI_LLAMACPP_IMAGE=llamacpp-bonsai-prism:server-local-volta
BONSAI_PROFILE_NAME=ternary-bonsai2-27b-pq2-v100-32gb-circe-np4
# gpu1 or gpu2 only. NEVER 0: gpu0 is chat's card (Juniper, 2026-09-30).
# Required (compose has no default). gpu2 is pool-lent to agent-gpu2/diffusion:
# only bring Bonsai up while that seat is idle or pool actuation is paused (README).
BONSAI_CUDA_VISIBLE_DEVICES=2
BONSAI_HOST_PORT=8017
