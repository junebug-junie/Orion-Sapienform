# orion-execution-dispatch-runtime — Layer 9 execution dispatch (docker compose)
# Apply migration: services/orion-sql-db/manual_migration_policy_dispatch_pending_marker.sql
#   ^ REQUIRED. Without it every tick raises UndefinedColumn on dispatch_pending,
#     which the poll loop swallows -- /health stays green and nothing dispatches.
# Requires: substrate_policy_decision_frames + substrate_proposal_frames
# Apply migrations:
#   services/orion-sql-db/manual_migration_execution_dispatch_frame_v1.sql
#   services/orion-sql-db/manual_migration_execution_dispatch_frame_v2_drop_self_state.sql
#   services/orion-sql-db/manual_migration_substrate_dispatch_results_v1.sql
PROJECT=orion-athena
SERVICE_NAME=orion-execution-dispatch-runtime
SERVICE_VERSION=0.1.0
NODE_NAME=athena
POSTGRES_URI=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
EXECUTION_DISPATCH_POLICY_PATH=/app/config/execution_dispatch/execution_dispatch_policy.v1.yaml
# 2026-08-12: was dry_run, which had drifted away from the real live value on
# this host (dispatch_read_only, set by hand and running that way). The
# template is the operator contract, so it has to state the value actually
# intended -- a `sync_local_env_from_example.py --force` against the old
# template would have silently reverted live dispatch to dry_run.
EXECUTION_DISPATCH_MODE=dispatch_read_only
EXECUTION_DISPATCH_POLL_INTERVAL_SEC=2.0

# --- Pending-marker reconciler (ROADMAP D2, 2026-08-19) --------------------------------------
# Re-queues policy frames whose `dispatch_pending` marker was cleared without a dispatch frame
# existing. Only ever ADDS work back. Runs the expensive anti-join the marker exists to avoid,
# so it is rate-limited. 0 means "every tick", which reinstates the original problem.
DISPATCH_RECONCILE_INTERVAL_SEC=900
ENABLE_EXECUTION_DISPATCH_RUNTIME=true
# Real sends only happen when EXECUTION_DISPATCH_MODE=dispatch_read_only AND the
# policy's mode.allow_dispatch_read_only is also true (config/execution_dispatch/
# execution_dispatch_policy.v1.yaml) -- both gates must open.
#
# Mutating dispatch (currently only `maintain` ->
# skills.runtime.builder_prune.v1) needs a THIRD gate: that policy file's
# mode.allow_mutating_dispatch, turned on 2026-08-12 by explicit operator
# decision. With all three open the skill receives mode=execute, and then
# still applies its own measured disk>=75% AND reclaimable>=40GB gate before
# it prunes anything. Set this key back to dry_run to stand the whole path
# down without editing policy: every candidate then goes out as
# mode=preview.
CORTEX_EXEC_CHANNEL=orion:cortex:exec:request:background
CORTEX_EXEC_RESULT_PREFIX=orion:exec:result
# ALWAYS the tailscale bus node, per repo mandate -- not bus-core, not localhost.
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health), independent bus
# connection from the RPC dispatch client above.
HEARTBEAT_INTERVAL_SEC=10
EXECUTION_DISPATCH_RPC_TIMEOUT_SEC=120
# 2026-07-30: a real dispatch is a synchronous cortex-exec RPC, ~7-11s
# measured live -- this single-threaded FIFO consumer cannot keep pace with
# real production of new policy_decision_frames (~16/min produced vs ~6.8/
# min consumed, measured live 2026-07-30), so the oldest-undispatched-first
# queue grows without bound (46,617 backlogged, oldest 37h old, at the time
# this was found). A policy frame older than a randomized [min, max]
# threshold gets discarded (materialized as a real "stale_discard" frame,
# never silently dropped) instead of dispatched, so real cortex actions
# never describe hours-old field state as current.
EXECUTION_DISPATCH_STALENESS_MIN_SEC=120.0
EXECUTION_DISPATCH_STALENESS_MAX_SEC=300.0
# Explicit operator override: when set, bypasses the randomized window
# entirely and uses this fixed value every tick instead -- same "explicit
# override, don't touch the derived machinery" shape as
# ORION_DISPATCH_RISK_CAP_ADVISORY_ONLY below. Commented out (default) means
# "use the randomized window" -- unlike NOTIFY_API_TOKEN below, this is a
# float|None setting: an uncommented-but-empty value fails float parsing
# rather than degrading to None, so "unset" here means the line is absent,
# not present-and-blank. Uncomment and set very high if a deliberate
# deep-backlog catch-up ever becomes desirable again (e.g. Orion's own
# attention/dispatch cadence changes later) instead of reverting this patch.
# EXECUTION_DISPATCH_STALENESS_OVERRIDE_SEC=600.0
# 2026-07-29: no longer the primary mechanism -- app/worker.py's
# _derive_daily_risk_cap now computes a real, self-calibrating EWMA ceiling
# over uncapped daily demand (see app/settings.py's own comment on this key
# for the full sequence). This value is only the last-resort fallback for a
# truly first-ever tick with zero dispatch-frame history at all; it never
# actually triggers against this repo's real Postgres history (2026-07-28
# already has real closed-day data). Kept at its old value for continuity of
# a fresh/empty deployment's first tick, not because 10.0 means anything
# about real risk demand -- it never did.
ORION_DISPATCH_MAX_RISK_PER_DAY=10.0
# Daily dispatch budget in MOTOR-SECONDS (wall-clock an action occupies on the
# dispatch path). Exogenous by design -- an allowance derived from usage cannot
# bind. 129600 = 36 motor-hours, ~10% below the ~40 motor-hours/day measured
# 2026-08-21, so the ceiling is exercised rather than hypothetical.
ORION_DISPATCH_MOTOR_BUDGET_SEC_PER_DAY=129600.0
# Advisory until a day of would-refuse counts has been inspected. See
# settings.py for the exit criterion -- this is a measurement stage, not a
# permanent hedge.
ORION_DISPATCH_MOTOR_BUDGET_ENFORCE=false
# Assumed cost of a not-yet-run action, for the advisory would-refuse count
# only. 5.0 = the live p50 measured 2026-08-21. A real allocator will use each
# action's own measured history.
ORION_DISPATCH_MOTOR_TYPICAL_COST_SEC=5.0
# The absolute bar: expected nats per motor-second below which an action is not
# worth running, however much allowance remains. 0.02 sits in the gap between a
# cold action (0.198 at 5s) and a thoroughly-measured one (0.0025 at 5s).
ORION_DISPATCH_MIN_NATS_PER_SEC=0.02
# Fraction of ACTING ticks deliberately withheld, to buy a genuinely randomized
# control arm -- the only one that licenses a causal claim. Per TICK, not per
# candidate: the field delta is frame-wide, so withholding one candidate while
# its siblings run gives a contaminated control, which is what made the
# capacity-blocked arm unusable. 0.0 = off. At 0.05 one acting tick in twenty
# does nothing; that is a real, bounded capability cost, taken on purpose.
ORION_DISPATCH_HOLDBACK_FRACTION=0.0
# --- Theater tripwire recovery (2026-08-25) ---------------------------------
# The tripwire pauses dispatch when >5 of the trailing 10 dispatches come back
# unproductive. Until 2026-08-25 it was a ONE-WAY latch: nothing in the code
# could clear it, so recovery needed a human to notice and restart the
# container. On 2026-08-23 that turned ordinary post-redeploy startup wobble
# (six plan_status=fail in a row while cortex-exec was still cold) into 45
# hours of zero autonomous actions, with one warning at the start and total
# silence after.
#
# Set false to restore restart-only recovery. The per-tick logging, the frame
# warning and the hourly re-notification are NOT gated by this flag.
ORION_DISPATCH_TRIPWIRE_PROBE_ENABLED=true
# Wait before the first single-action recovery probe, and after each failed
# one. Doubles per failure up to the max, so a genuinely dead motor costs one
# action per hour instead of a retry storm against a broken dependency.
ORION_DISPATCH_TRIPWIRE_PROBE_COOLDOWN_SEC=300.0
ORION_DISPATCH_TRIPWIRE_PROBE_MAX_COOLDOWN_SEC=3600.0
# Consecutive successful probes needed to resume. Any single failure resets the
# run to zero. At 1 this would genuinely be "resume on a coincidentally-good
# sample", which the original manual-re-arm design objected to and which is
# why the default is not 1.
ORION_DISPATCH_TRIPWIRE_REARM_SUCCESSES=3
# 2026-07-29: enforcement back ON (default flipped true -> false). The old
# fixed 10.0 constant was ENFORCED 2026-07-26/27 and clamped real
# dispatched-risk at exactly 10.00/day both days -- looked like a working
# cap, wasn't. advisory_only=true shipped 2026-07-28 specifically to observe
# real *uncapped* demand: it was 817.65/day (15,099 candidates) and
# climbing, ~80x the old enforced number. That one real day is exactly what
# now seeds the EWMA baseline the derived cap is built from (orion/bus/
# ewma.py::compute_ewma_update, same mechanism as PR #1433/#1434) -- so
# re-enforcing now closes the loop advisory-only was opened for, on a
# derived ceiling instead of a guessed multiplier. Explicit operator
# override: set back to true to return to log-only behavior.
ORION_DISPATCH_RISK_CAP_ADVISORY_ONLY=false
# Real-send outcomes publish here so load_action_outcomes() (chat-stance,
# reducer) sees them the same way it already sees curiosity-fetch outcomes --
# same channel orion-spark-concept-induction already produces onto.
BUS_ACTION_OUTCOME_OUT=orion:autonomy:action:outcome
# 2026-07-28: was http://orion-notify:7140 -- never resolves once PROJECT has a host
# suffix (container_name: ${PROJECT}-notify). The compose service key ("notify") is
# the portable hostname.
NOTIFY_URL=http://notify:7140
NOTIFY_API_TOKEN=
LOG_LEVEL=INFO
EXECUTION_DISPATCH_RUNTIME_PORT=8121
