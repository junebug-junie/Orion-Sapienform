SERVICE_NAME=orion-self-experiments
SERVICE_VERSION=0.2.0
NODE_NAME=athena
LOG_LEVEL=INFO
PORT=7172

# SQLite-backed experiment registry
EXPERIMENTS_STORE_PATH=/tmp/orion-self-experiments/experiments.sqlite3

# Keep v1 safe-by-default: reject non-read-only skills
EXPERIMENTS_ALLOW_NON_READ_ONLY=false

# Bus (carries the SystemHealthV1 heartbeat below)
ORION_BUS_URL=${ORION_BUS_URL}
ORION_BUS_ENABLED=true
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health).
HEARTBEAT_INTERVAL_SEC=10
