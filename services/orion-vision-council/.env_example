LOG_LEVEL=INFO
NODE_NAME=athena

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENFORCE_CATALOG=true
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health).
HEARTBEAT_INTERVAL_SEC=10

CHANNEL_COUNCIL_INTAKE=orion:vision:windows
CHANNEL_COUNCIL_PUB=orion:vision:events
CHANNEL_COUNCIL_REQUEST=orion:exec:request:VisionCouncilService

CHANNEL_LLM_REQUEST=orion:exec:request:LLMGatewayService
CHANNEL_LLM_REPLY_PREFIX=orion:council:reply

# Use the Atlas metacog lane model id (not an OpenAI alias).
COUNCIL_MODEL=llama-3-8b-instruct-q4_k_m
COUNCIL_LLM_ROUTE=metacog
COUNCIL_LLM_MAX_TOKENS=1024
COUNCIL_LLM_TIMEOUT_SEC=90
COUNCIL_STRUCTURED_OUTPUT_METHOD=json_object_schema

# Host-pipe transition gate: metacog only on hard_labels / person-presence changes.
COUNCIL_TRANSITION_GATE_ENABLED=true
# Force refresh at least every N seconds when labels are stable (0 = disable force; contract A).
# Was 0 (never force) -- caused a 44+ hour silent orion:vision:events outage,
# 2026-08-23/25: a home-office scene's coarse hard_labels legitimately never
# changed turn to turn, so the gate correctly read "stable_scene" forever with
# no ceiling and no error anywhere in the pipeline. See README.md.
COUNCIL_TRANSITION_REFRESH_SEC=600
# Legacy aliases (still read): COUNCIL_EVIDENCE_SKIP_ENABLED, COUNCIL_EVIDENCE_SKIP_MAX_SEC

VISION_COUNCIL_HTTP_PORT=8025

# Foveal probe (POST /debug/foveal-probe) -- manual trigger for a real VLM
# caption/VQA. 2026-08-25: originally RPC'd a dedicated, isolated vision-host
# channel; live-tested and found it returned an EMPTY caption (config/
# vision_profiles.yaml's vlm_caption model_id was still the unfilled
# REPLACE_ME placeholder). Replaced with a call through orion-llm-gateway's
# `chat` route (CHANNEL_LLM_REQUEST above -- already used for the council's
# own metacog calls; no separate channel needed) -- see app/foveal_probe.py's
# module docstring for the full incident and the existing-mechanism check
# that motivated the change.
FOVEAL_LLM_ROUTE=chat
FOVEAL_HOST_TIMEOUT_SEC=45
FOVEAL_FRAMES_DIR=/mnt/telemetry/vision/frames
# Athena's own percept-store, reachable via the docker network by container
# name (council runs on athena, unlike carbon/circe which need the tailscale
# IP -- see docs/operations/carbon-webcam.md for that contrast).
FOVEAL_PERCEPT_STORE_URL=http://orion-athena-percept-store:8000/percepts
FOVEAL_PERCEPT_STORE_TOKEN=
FOVEAL_PERCEPT_UPLOAD_TIMEOUT_SEC=10
