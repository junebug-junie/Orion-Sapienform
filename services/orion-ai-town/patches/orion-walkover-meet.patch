+// A tile beside `target` that is on the map, not a wall and not occupied
+// (other than by `playerId`), nearest to `target` first.
+function freeTileNextTo(
+  game: Game,
+  now: number,
+  target: { x: number; y: number },
+  playerId: GameId<'players'>,
+) {
+  const x = Math.floor(target.x);
+  const y = Math.floor(target.y);
+  for (const tile of [
+    { x: x + 1, y },
+    { x: x - 1, y },
+    { x, y: y + 1 },
+    { x, y: y - 1 },
+  ]) {
+    if (blocked(game, now, tile, playerId) === null) {
+      return tile;
+    }
+  }
+  return null;
