# orion-prediction -- forecasting, evaluation, and cause-and-effect estimates over Orion's telemetry.
# Spec: docs/superpowers/specs/2026-10-15-orion-prediction-service-design.md
# Apply services/orion-sql-db/manual_migration_prediction_v1.sql BEFORE the first start.
PROJECT=orion-athena
SERVICE_NAME=orion-prediction
SERVICE_VERSION=0.1.0
NODE_NAME=athena
LOG_LEVEL=INFO
PREDICTION_PORT=8132

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10

# Same database as the telemetry it reads (orion_biometrics_summary, home_cooling_sample).
POSTGRES_URI=

# Series registry baked into the image from config/prediction/.
PREDICTION_SERIES_PATH=/app/config/prediction/series.v1.yaml

# --- kill switches ---
# Run the select -> issue -> score -> monitor loop. false = HTTP only (causal endpoints still answer).
PREDICTION_ENABLED=true
# Publish orion:prediction:forecast. false = store only.
PREDICTION_PUBLISH_ENABLED=true

PREDICTION_TICK_SEC=30
# A grain bucket counts as complete this long after it ends.
PREDICTION_SETTLE_SEC=60
# Re-run the backtest + per-horizon gate this often (~6-7 min of CPU for 40 windows x 6 models).
PREDICTION_SELECT_INTERVAL_SEC=21600
PREDICTION_BACKTEST_WINDOWS=40
PREDICTION_BACKTEST_STEP_MIN=180
# Forecast every contender model in the shadow and grade it live; the gate uses those live verdicts.
# false = backtest-only gate and no worse_than_baseline alert (it reads the live verdicts).
PREDICTION_SHADOW_ENABLED=true

# --- world-model shadow for action bets (scored and graded, never served) ---
PREDICTION_WORLD_MODEL_SHADOW_ENABLED=true
# Path inside the container, and the host directory mounted read-only at /models.
PREDICTION_WORLD_MODEL_WEIGHTS=/models/transition.npz
PREDICTION_WORLD_MODEL_DIR=/mnt/storage-warm/orion-dojo/models

# --- turn self-bets (app/turn_self_bets.py; unified-turn self-prediction spec, A3) ---
# Settle stance's private bets about its own turn (thought_decision.self_prediction) against the turn's
# record (harness_turn_trace) and grade them: GET /turn-self-bets/live. false = no settle loop.
PREDICTION_TURN_SELF_BETS_ENABLED=true
PREDICTION_TURN_SELF_BETS_SETTLE_SEC=60

# --- weather covariates (shared Open-Meteo client, orion/weather/openmeteo.py) ---
PREDICTION_WEATHER_ENABLED=true
PREDICTION_WEATHER_REFRESH_SEC=3600
# Same keys as the situation layer (orion-hub's .env). Copy the values from there; empty = weather off.
ORION_SITUATION_WEATHER_LAT=
ORION_SITUATION_WEATHER_LON=

# --- switchback experiment runner (POST /experiments/run; app/experiment_runner.py) ---
# Performs vision.focus:<stream_id> experiments: holds Redis key orion:vision:experiment:<stream_id>=on
# on the bus Redis (ORION_BUS_URL) during ON blocks; the vision frame router forces that stream's
# triggered tier. Never starts on boot. false = POST /experiments/run answers 503.
PREDICTION_EXPERIMENT_RUNNER_ENABLED=true
# Frame router /healthz on app-net (per-stream dispatch tier counts = the manipulation check).
PREDICTION_VISION_ROUTER_URL=http://orion-vision-frame-router:8010
# TTL on the override key (refreshed every tick): a dead runner leaves focus on at most this long.
PREDICTION_EXPERIMENT_OVERRIDE_TTL_SEC=90
PREDICTION_EXPERIMENT_TICK_SEC=30
# Re-check GET /experiments/guard this often during a run (and before every ON block).
PREDICTION_EXPERIMENT_GUARD_EVERY_SEC=300
