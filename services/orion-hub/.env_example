# ───────────────────────────────────────────────────────────────
# 🎧 Orion Hub — Voice + Web Gateway
# ───────────────────────────────────────────────────────────────
#
# Docker Compose: hub `docker-compose.yml` uses optional `env_file: .env` and passes
# variables through the `environment:` block. For `${VAR}` substitution in that block,
# either run `docker compose` from `services/orion-hub/`, or from the repo root use:
#   docker compose --env-file services/orion-hub/.env -f services/orion-hub/docker-compose.yml ...
#

# --- Service Identity ---
PROJECT=orion-athena
SERVICE_NAME=hub
# Must match the deploying node's identity used by every OTHER service's
# NODE_NAME (e.g. services/orion-harness-governor/.env_example's NODE_NAME).
# Hub's chat_turn_trace_routes.py derives the harness-motor trace_id it joins
# against (cortex_exec_trace_id(settings.NODE_NAME, correlation_id,
# lane="harness_motor")) from THIS value -- if it ever diverges from the real
# NODE_NAME a multi-node deploy sets, grammar_trace/execution_run silently
# stop resolving for every unified-turn chat (no error, just a permanent
# no_grammar_trace/no_execution_run_pressure_signal gap). Both default to
# "athena" today, which is why this has never surfaced live.
ORION_NODE_NAME=athena
SERVICE_VERSION=0.4.0
HUB_PORT=8080
HUB_API_BASE_OVERRIDE=
HUB_WS_BASE_OVERRIDE=
# Mounted repo root in Docker (config/memory_graph, ontology shapes). Default in compose: /repo
ORION_REPO_ROOT=/repo

# --- Bus Configuration ---
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
ORION_BUS_URL=redis://100.92.216.81:6379/0
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health).
HEARTBEAT_INTERVAL_SEC=10

# --- Topic Foundry ---
TOPIC_FOUNDRY_BASE_URL=http://127.0.0.1:8615
# World Pulse is not intended to be directly exposed.
# In Tailscale deployments, expose it only through the Hub/proxy path.
# Browser clients should use relative Hub routes (/api/world-pulse/*) or a path proxy (/world-pulse/*).
# Host-network dev (default hub docker-compose): use 127.0.0.1 + world-pulse published port (8628 in orion-world-pulse compose).
WORLD_PULSE_BASE_URL=http://127.0.0.1:8628
# Docker bridge/service DNS (only when hub is not using host network mode):
# WORLD_PULSE_BASE_URL=http://orion-world-pulse:8628
WORLD_PULSE_PROXY_TIMEOUT_SEC=10
WORLD_PULSE_UI_FIXTURE_RUN_ENABLED=true

# --- Proposal review API (Pending Decisions panel) ---
# When enabled, Hub lists pending_review proposals from context-exec and supports approve/reject.
# Host-network dev: http://127.0.0.1:8096 — Docker bridge: http://orion-context-exec:8096
HUB_PROPOSAL_REVIEW_ENABLED=true
HUB_PROPOSAL_REVIEW_API_URL=http://127.0.0.1:8096
HUB_PROPOSAL_REVIEW_TIMEOUT_SEC=10

# LLM gateway route catalog (Hub route selector; compute override separate from chat mode)
# Host-network dev: http://127.0.0.1:8210 — Docker bridge: http://orion-llm-gateway:8210
HUB_LLM_GATEWAY_URL=http://127.0.0.1:8210
HUB_LLM_GATEWAY_TIMEOUT_SEC=5

# Chat attachments (images Juniper attaches to a turn).
# Bytes live on disk here; only a content-addressed ref rides the chat payload.
HUB_CHAT_ATTACHMENT_DIR=/mnt/orion-chat-attachments
HUB_CHAT_ATTACHMENT_MAX_BYTES=8388608
HUB_CHAT_ATTACHMENT_ALLOWED_MIMES=image/png,image/jpeg,image/webp,image/gif
# Base URL the LLM GATEWAY uses to fetch the bytes — not necessarily the base the
# browser uploaded through. Baked into AttachmentRefV1.source_url at upload time.
# Must be the Tailscale node IP, not 127.0.0.1: the Hub runs network_mode host but
# orion-llm-gateway runs on the bridge network, so the gateway's own localhost is
# not the Hub. Same reason ORION_BUS_URL above uses the node IP.
HUB_CHAT_ATTACHMENT_PUBLIC_BASE=http://100.92.216.81:8080
HUB_CHAT_ATTACHMENT_MAX_PER_TURN=4

# Hub Agent mode uses context-exec (read-only / proposal-gated) instead of legacy AgentChain
HUB_AGENT_CONTEXT_EXEC_ENABLED=true
HUB_CONTEXT_EXEC_API_URL=http://127.0.0.1:8096
HUB_CONTEXT_EXEC_TIMEOUT_SEC=600
HUB_AGENT_REPL_ENABLED=true
# Hub Agent Claude — FCC harness in chat (host-network dev; disabled in Docker by default)
HUB_AGENT_CLAUDE_ENABLED=true
HUB_FCC_ENV_PATH=/root/.fcc/.env
HUB_FCC_SERVER_URL=http://127.0.0.1:8082
HUB_FCC_AUTH_TOKEN=
HUB_AGENT_CLAUDE_BIN=claude
# Orion's disposable FCC sandbox checkout -- a standalone git clone (not a worktree,
# no shared .git object store with the primary checkout), mounted rw at this same
# path. See orion/fcc/sandbox_sync.py: Hub refreshes it to origin/main once per
# browser session. The only path back to the real repo is `git push` to a non-main
# branch, gated by GitHub branch protection. Override via HUB_ORION_FCC_SANDBOX_HOST
# in docker-compose.yml if the sandbox lives somewhere other than /mnt/orion-fcc.
HUB_AGENT_CLAUDE_WORKSPACE=/mnt/orion-fcc/repo
# Host path of the sandbox above, bind-mounted rw into the hub-app container at the
# same path (docker-compose.yml). Only needs to change if the sandbox disk isn't
# mounted at /mnt/orion-fcc on this host.
HUB_ORION_FCC_SANDBOX_HOST=/mnt/orion-fcc
# Host `gh` binary bind-mounted read-only into the container (same pattern as the
# claude binary above) so Orion's sandbox can push branches / open PRs using the
# operator's existing host-level gh/git auth -- no credentials stored in this repo.
HUB_AGENT_GH_BIN_HOST=
# Isolated CLAUDE_CONFIG_DIR for the FCC claude subprocess -- keeps Orion's
# cognition turns from reading the operator's personal ~/.claude/CLAUDE.md,
# hooks, or settings.json. Set via orion.fcc.context_budget.extend_fcc_subprocess_env.
# Do NOT point this under ~/.fcc -- that dir is bind-mounted read-only
# (${HOME}/.fcc:/root/.fcc:ro) for operator secrets; claude can't write
# session state there from inside the container.
HUB_AGENT_CLAUDE_CONFIG_DIR=~/.claude-fcc
# --setting-sources passed to the FCC claude subprocess. Default (user,local)
# skips the repo's own project-level CLAUDE.md/AGENTS.md + project-level
# hooks/permissions (.claude/settings.json) -- that file is a coding-agent
# development contract, not instructions for a headless cognition turn, and
# dropping it is not a safety regression here: the repo is bind-mounted
# read-only in this container, so the destructive_git_guard hook this also
# drops has nothing left to protect that the mount doesn't already block.
# MCP tool access is unaffected either way (pre-approved via --mcp-config/
# --allowedTools argv, not settings.json). Set empty to fall back to Claude
# Code's normal default (all three scopes: user, project, local).
HUB_AGENT_CLAUDE_SETTING_SOURCES=user,local
HUB_AGENT_CLAUDE_TIMEOUT_SEC=900
HUB_AGENT_CLAUDE_MAX_CONCURRENT=1
# Max bytes for one claude stream-json stdout line (tool/file payloads can be large)
HUB_AGENT_CLAUDE_STREAM_READ_LIMIT=8388608
# Match llamacpp chat profile ctx_size; passed into claude subprocess env
HUB_AGENT_CLAUDE_MAX_CONTEXT_TOKENS=65536
# Cap single Read tool payload so multi-step repo sweeps stay under ctx
HUB_AGENT_CLAUDE_FILE_READ_MAX_TOKENS=8192
# Compact earlier than Claude Code default (~83%%); 0 = omit CLAUDE_AUTOCOMPACT_PCT_OVERRIDE
HUB_AGENT_CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=70
# Emit context-pressure nudge in harness when fill exceeds this percent (default 70).
HUB_AGENT_CLAUDE_CONTEXT_PRESSURE_PCT=70
# MCP proxy truncates oversized GitHub MCP tool payloads (shared with harness).
ORION_FCC_MCP_TOOL_RESULT_MAX_CHARS=12000
# fcc-claude MCP (GitHub + Firecrawl + AI Town when enabled)
# Secrets ONLY in ~/.fcc/.env — see config/fcc.env_example (never put GITHUB_PAT / FIRECRAWL / AITOWN_* here)
# Agent Claude mode: flags below. Orion unified turn: HARNESS_FCC_MCP_ENABLED + HARNESS_AITOWN_ENABLED on harness-governor.
HUB_AGENT_CLAUDE_MCP_ENABLED=true
# FCC Claude spawns set ENABLE_TOOL_SEARCH=true via orion.fcc.context_budget.extend_fcc_subprocess_env
# (defers MCP schema load on custom ANTHROPIC_BASE_URL). Override only for debug: false | auto | auto:N
HUB_AITOWN_ENABLED=true
HUB_AITOWN_UI_URL=http://127.0.0.1:5173
# Secrets live in ~/.fcc/.env: GITHUB_PAT, FIRECRAWL_API_KEY, AITOWN_* (template: config/fcc.env_example)
HUB_CONTEXT_EXEC_EVENT_CHANNEL=orion:context_exec:event
# Profile-derived investigation_v2 path (Hub Agent lane). Must match context-exec.
CONTEXT_EXEC_INVESTIGATION_V2_ENABLED=false

# --- Self-observability (Self tab + presence + curiosity hint) ---
# Presence writer mirrors chat liveness to substrate_hub_presence (needs POSTGRES_URI;
# apply services/orion-sql-db/manual_migration_hub_presence_v1.sql first).
HUB_PRESENCE_WRITER_ENABLED=true
# Agent lane prepends one bounded curiosity focus line when fresh endogenous
# candidates exist (needs manual_migration_endogenous_curiosity_candidates_v1.sql
# + ORION_ENDOGENOUS_CURIOSITY_ENABLED on substrate-runtime). Advisory only.
HUB_AGENT_CURIOSITY_HINT_ENABLED=true

# --- Substrate tier telemetry (Hub → orion-substrate-telemetry HTTP only; not the Redis bus) ---
# Base URL of the telemetry read API, e.g. http://orion-athena-substrate-telemetry:8395 (compose service DNS).
SUBSTRATE_TELEMETRY_BASE_URL=
# Optional shared secret: only if you set SUBSTRATE_TELEMETRY_READ_API_TOKEN on the telemetry service.
# Leave empty on internal Docker networks — Hub will not send X-Telemetry-Token and telemetry accepts unsigned reads.
SUBSTRATE_TELEMETRY_READ_TOKEN=

# --- Social Memory ---
SOCIAL_MEMORY_BASE_URL=http://127.0.0.1:8765
SELF_EXPERIMENTS_BASE_URL=http://127.0.0.1:7172
SELF_EXPERIMENTS_TIMEOUT_SEC=6

# orion-juniper-affective-state -- deployed on circe (see that service's
# app/settings.py NODE_NAME comment), HOST_PORT 32799 by its own
# .env_example. Empty disables both the Vision panel's "Check now" button
# AND its ambient toggle below (503 on either). Long timeout on purpose:
# the call is synchronous through a live carbon capture + GPU inference.
JUNIPER_AFFECTIVE_STATE_BASE_URL=http://100.112.254.99:32799
# 240, not 120: the backend's own worst-case sequential sum (retina RPC 60s +
# percept fetch 15s + worker RPC 120s) is ~195s -- see app/settings.py.
JUNIPER_AFFECTIVE_STATE_TIMEOUT_SEC=240

# Ambient (recurring) AffectGPT capture -- see scripts/vision_affect_ambient.py
# module docstring for the full design. AFFECT_AMBIENT_ENABLED is a BOOT-TIME
# switch (whether the loop task gets created at Hub startup at all) -- NOT a
# live kill switch: flipping this to false without restarting Hub does
# nothing to a loop already running. To stop live capture immediately, use
# the Vision panel's own toggle (POST /api/vision/affect-ambient) -- that
# flips runtime state.enabled, which always starts False on a fresh boot
# regardless of this setting (fails closed by construction -- in-memory
# state, no persistence).
AFFECT_AMBIENT_ENABLED=true
# Juniper's explicit choice, 2026-08-22: densest of three offered intervals,
# accepting the tight margin over a single capture's own worst-case duration
# (~195s, see JUNIPER_AFFECTIVE_STATE_TIMEOUT_SEC above) on purpose.
AFFECT_AMBIENT_INTERVAL_SEC=300
# How often the loop checks whether a tick is due -- decoupled from the
# interval above so toggling off takes effect in ~this long, not up to a
# full interval later.
AFFECT_AMBIENT_POLL_SEC=5

# Vision panel camera dropdown -- "Carbon (live)" / "Carbon (affect
# snapshot)" (2026-08-22). scripts/vision_frame_cache.py subscribes to the
# bus to remember the latest frame pointer per stream_id -- no persisted
# "latest frame" lookup exists anywhere else in this repo. Scoped to an
# explicit allowlist, not every stream in the mesh.
VISION_FRAME_CACHE_ENABLED=true
VISION_FRAME_CACHE_STREAM_IDS=carbon
# Matches orion-vision-retina's own CHANNEL_RETINA_PUB default.
VISION_FRAME_CHANNEL=orion:vision:frames

# Where /api/vision/carbon/latest-frame/image fetches JPEG bytes from,
# server-side -- the browser never talks to percept-store directly. Same
# base-URL convention as orion-vision-retina's own RETINA_PERCEPT_STORE_URL
# (includes the /percepts suffix already).
PERCEPT_STORE_BASE_URL=http://100.92.216.81:8021/percepts
PERCEPT_STORE_TIMEOUT_SEC=10
PERCEPT_STORE_TOKEN=

# --- Biometrics Cache (Hub) ---
BIOMETRICS_ENABLED=true
BIOMETRICS_STALE_AFTER_SEC=60
BIOMETRICS_NO_SIGNAL_AFTER_SEC=600
# circe inherited atlas's weight 2026-08-21 (atlas decommissioned, circe is
# now the fleet's dominant GPU node). Exact-match lookup -- a node missing
# from this dict silently gets a 1.0 fallback weight, not 0.0.
BIOMETRICS_ROLE_WEIGHTS_JSON={"circe":0.6,"athena":0.4}
BIOMETRICS_PUSH_INTERVAL_SEC=5

# --- Organ signal inspect (Hub; Phase 2b) ---
# Subscribes to gateway output pattern; latest OrionSignalV1 per organ + optional trace cache.
SIGNALS_INSPECT_ENABLED=true
SIGNALS_INSPECT_SUBSCRIBE_PATTERN=orion:signals:*
SIGNALS_INSPECT_WINDOW_SEC=45
SIGNALS_TRACE_CACHE_ENABLED=true
TRACE_CACHE_MAX_TRACES=200
TRACE_CACHE_TTL_SEC=300
TRACE_CACHE_MAX_SIGNALS_PER_TRACE=64

# --- Cognition trace cache (Runtime Trace Nexus A4) ---
# Subscribes to cortex-exec CognitionTracePayload on orion:cognition:trace.
COGNITION_TRACE_CACHE_ENABLED=true
COGNITION_TRACE_CACHE_MAX=200
COGNITION_TRACE_CACHE_TTL_SEC=300
COGNITION_TRACE_SUBSCRIBE_CHANNEL=orion:cognition:trace
# When true, GET /api/cognition/trace/{id} may return full step payloads (operator-only).
COGNITION_TRACE_API_DEBUG=false

# --- Embodiment outcome trace (mind-to-sprite bridge; default-off, fail-open) ---
# Minimal Hub consumer of orion:embodiment:outcome (bounded ring, log-only; no UI panel).
EMBODIMENT_OUTCOME_TRACE_ENABLED=false
EMBODIMENT_CHANNEL_OUTCOME=orion:embodiment:outcome
EMBODIMENT_OUTCOME_CACHE_MAX=200

# OpenTelemetry / Grafana: Hub deep links to Tempo in Grafana Explore (32-char hex otel_trace_id).
# Example when running services/orion-signal-gateway docker-compose (Grafana on host 3001):
# HUB_OTEL_GRAFANA_BASE_URL=http://127.0.0.1:3001
HUB_OTEL_GRAFANA_BASE_URL=
HUB_OTEL_GRAFANA_DATASOURCE_UID=tempo
HUB_OTEL_GRAFANA_ORG_ID=1

# --- In-app Notifications (Hub) ---
NOTIFY_IN_APP_ENABLED=true
NOTIFY_IN_APP_CHANNEL=orion:notify:in_app
NOTIFY_IN_APP_MAX=200
NOTIFY_TOAST_SECONDS=8
NOTIFY_BASE_URL=http://127.0.0.1:7140
NOTIFY_API_TOKEN=

# --- Endogenous outreach (Orion speaks first) ---
# Stub random trigger until autonomy supplies a real endogenous signal.
# See services/orion-hub/scripts/endogenous_outreach.py. This is the only path
# by which Orion emits chat text nobody asked for. ON in the operator contract
# by Juniper's decision; the settings.py Field default stays False so an absent
# key fails closed rather than silently enabling outreach.
HUB_ENDOGENOUS_OUTREACH_ENABLED=true
# How often the loop wakes to consider reaching out. 300 (original default)
# root-caused live 2026-08-19 as the reason outreach never fired -- a
# qualifying persistence run lasts only ~18-27s wall-clock, so a 300s poll
# almost always misses it. 10 is a real-data-derived middle ground, not the
# floor (5.0) -- see settings.py's own comment on this key for the full
# replay numbers and the disclosed remaining gap.
HUB_ENDOGENOUS_OUTREACH_TICK_SEC=10
# 2026-08-16: HUB_ENDOGENOUS_OUTREACH_PROBABILITY removed -- see
# services/orion-hub/app/settings.py's comment at this key's old location.
# Consecutive same-winner ticks of orion.attention.tension's live Borda
# competition required before the trigger fires. Default is a real replay of
# live history (see scripts/tension_outreach_trigger.py's docstring), not a
# guess -- retune from real post-deploy firing-rate data, not vibes.
HUB_ENDOGENOUS_OUTREACH_MIN_RUN_LENGTH=8
# Minimum gap between two outreaches, regardless of triggers.
HUB_ENDOGENOUS_OUTREACH_MIN_COOLDOWN_SEC=2700
# Max outreaches per local calendar day; -1 disables the cap.
HUB_ENDOGENOUS_OUTREACH_DAILY_CAP=4
# Quiet window [start, end) in HUB_ENDOGENOUS_OUTREACH_TZ; equal or -1 disables.
HUB_ENDOGENOUS_OUTREACH_QUIET_START_HOUR=23
HUB_ENDOGENOUS_OUTREACH_QUIET_END_HOUR=8
# IANA zone for quiet hours and the daily-cap reset. Hub's container sets no TZ,
# so this must name the operator's real zone or the quiet window is UTC hours.
# America/Denver is Juniper's zone; the quiet window above is 23:00-08:00 there.
HUB_ENDOGENOUS_OUTREACH_TZ=America/Denver
# 2026-08-19: HUB_ENDOGENOUS_OUTREACH_LLM_ROUTE removed -- generation now
# goes through the real harness-governed unified-turn pipeline (see
# endogenous_outreach.py), same route selection as real chat. No separate
# route to configure here any more.
# 300s (raised from 60s 2026-08-19): confirmed live the old value was too
# short for this pipeline -- the first real test timed out with just the
# Thought stance-react step still in flight at ~33s, before the harness
# governor's own run had started. See settings.py's own comment on this key
# for the full account and why 300 is a reasoned estimate, not yet derived
# from a real firing-latency distribution.
HUB_ENDOGENOUS_OUTREACH_TIMEOUT_SEC=300
# Chat-history session used when no live socket has reported one.
HUB_ENDOGENOUS_OUTREACH_FALLBACK_SESSION_ID=orion_outreach
# Durable per-decision-cycle log (every tick's outcome, not just sends).
# Apply services/orion-sql-db/manual_migration_endogenous_outreach_decisions_v1.sql
# before expecting rows; without it (or without POSTGRES_URI) this is a
# silent no-op, same fail-open shape as HUB_PRESENCE_WRITER_ENABLED.
HUB_ENDOGENOUS_OUTREACH_DECISION_LOG_ENABLED=true

# --- Cortex Gateway Integration (Titanium) ---
CORTEX_GATEWAY_REQUEST_CHANNEL=orion:cortex:gateway:request
CORTEX_GATEWAY_RESULT_PREFIX=orion:cortex:gateway:result
# Container bring-up (skills.docker.compose_service_bringup.v1 direct dispatch, POST /api/debug/container-bringup).
# Keep >= cortex-exec's SKILLS_DOCKER_COMPOSE_BRINGUP_TIMEOUT_SEC + SKILLS_DOCKER_COMPOSE_BRINGUP_HEALTH_POLL_SEC
# (900 + 60 = 960 by default) so the Hub RPC does not time out before the skill itself finishes.
HUB_CONTAINER_BRINGUP_RPC_TIMEOUT_SEC=960

# --- TTS Integration (Titanium) ---
TTS_REQUEST_CHANNEL=orion:tts:intake
TTS_RESULT_PREFIX=orion:tts:result

# --- STT Integration (Titanium) ---
STT_REQUEST_CHANNEL=orion:stt:intake
STT_RESULT_PREFIX=orion:stt:result

# --- Legacy / Deprecated Channels (Preserved for compatibility) ---
WHISPER_MODEL_SIZE=distil-small.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float32
CHANNEL_VOICE_TRANSCRIPT=orion:voice:transcript
CHANNEL_VOICE_LLM=orion:voice:llm
CHANNEL_VOICE_TTS=orion:voice:tts
CHANNEL_TTS_INTAKE=orion:tts:intake
CHANNEL_COLLAPSE_INTAKE=orion:collapse:intake
CHANNEL_COLLAPSE_TRIAGE=orion:collapse:triage
LLM_GATEWAY_SERVICE_NAME=LLMGatewayService
EXEC_REQUEST_PREFIX=orion:exec:request
CHANNEL_LLM_INTAKE=orion:exec:request:LLMGatewayService
CHANNEL_LLM_REPLY_PREFIX=orion:llm:reply:
CORTEX_REQUEST_CHANNEL=orion:cortex:request
CORTEX_RESULT_PREFIX=orion:cortex:result
CHAT_HISTORY_LOG_CHANNEL=orion:chat:history:log
CHANNEL_CHAT_HISTORY_LOG=orion:chat:history:log
CHANNEL_COUNCIL_INTAKE=orion:agent-council:intake
CHANNEL_COUNCIL_REPLY_PREFIX=orion:agent-council:reply
CHANNEL_RECALL_REQUEST=orion:exec:request:RecallService
CHANNEL_RECALL_DEFAULT_REPLY_PREFIX=orion:exec:result:RecallService
RECALL_DEFAULT_MAX_ITEMS=16
RECALL_DEFAULT_TIME_WINDOW_DAYS=30
RECALL_DEFAULT_MODE=hybrid
HUB_RECALL_SERVICE_URL=http://127.0.0.1:8260
RECALL_SERVICE_URL=http://127.0.0.1:8260
HUB_RECALL_SHADOW_EVAL_TIMEOUT_SEC=45
HUB_RECALL_SHADOW_EVAL_MAX_ROWS_PER_RUN=128
HUB_RECALL_SHADOW_EVAL_DEFAULT_CORPUS_LIMIT=24

# --- Memory cards (Hub Memory tab + /api/memory/*) ---
# Hub startup runs idempotent DDL (includes CREATE EXTENSION IF NOT EXISTS pgcrypto); DB role must allow it.
# If unset or pool creation fails, /api/memory/* returns HTTP 503 with detail "memory_store_unavailable".
# Hub compose defaults to network_mode: host — use 127.0.0.1 and POSTGRES_PORT (55432 in orion-sql-db compose),
# not a Docker DNS name. In bridge-network Hub, use e.g. postgresql://...@orion-athena-sql-db:5432/conjourney
RECALL_PG_DSN=postgresql://postgres:postgres@127.0.0.1:55432/conjourney

# --- Memory crystallization Graphiti/FalkorDB (additive temporal projection; NOT RDF memory_graph) ---
GRAPHITI_ENABLED=true
# Deprecated fallback — prefer GRAPHITI_ADAPTER_URL below
GRAPHITI_URL=
# Shared with the substrate concept graph below (SUBSTRATE_STORE_BACKEND=falkor) --
# one FalkorDB instance, differentiated by graph name (this feature's own internal
# graph vs. FALKORDB_SUBSTRATE_GRAPH). Host-mode: 127.0.0.1 + published port (6380),
# not orion-athena-falkordb:6379 (bridge-network-only Docker DNS).
FALKORDB_URI=redis://127.0.0.1:6380

# --- Bus synaptic graph debug routes (bus_synaptic_graph_routes.py) ---
# Same shared FalkorDB instance as FALKORDB_URI above; graph name written by
# services/orion-bus-mirror (its own FALKORDB_BUS_GRAPH setting, same default).
# Read-only from Hub's side -- these routes never write to this graph.
FALKORDB_BUS_GRAPH=orion_bus_synapse

# --- Attention organ operator tab (attention_organ_routes.py, read-only) ---
# Substrate concept graph, read to surface each Active-Inference domain's live
# node:substrate.<domain> prediction_error. Same env key and default as
# orion/substrate/falkor_store.py::build_falkor_substrate_store_from_env() --
# deliberately not a second name for the same graph.
FALKORDB_SUBSTRATE_GRAPH=orion_substrate
# AI Town's own organically-clustered concept graph -- a second,
# independently-named graph on the same FalkorDB instance, interpretability-
# only (docs/superpowers/specs/2026-08-18-aitown-concept-graph-split-and-
# atlas-readability-design.md). Same env key
# orion/substrate/falkor_store.py::build_aitown_falkor_substrate_store_from_env()
# already uses.
FALKORDB_AITOWN_SUBSTRATE_GRAPH=orion_substrate_aitown
# orion-heartbeat's debug HTTP surface (/h1 + /health). Hub runs on the host
# network in this deployment, so this must be the container's PUBLISHED port,
# not the compose service DNS name: verified live 2026-07-30 that
# `orion-athena-heartbeat` does not resolve from inside the Hub container
# while `http://localhost:7251` does. Leave empty to disable the heartbeat
# half of the tab (the AST/HOT and per-domain panels still work).
HUB_HEARTBEAT_BASE_URL=http://localhost:7251
HUB_ATTENTION_ORGAN_TIMEOUT_SEC=3.0

# --- Memory crystallization projections ---
CRYSTALLIZER_VECTOR_COLLECTION=orion_memory_crystallizations
# Minimum dynamics.activation for recall injection (hub active-packet route + recall collector).
ACTIVATION_RECALL_FLOOR=0.08
# Embedding host for Chroma projection on approve. Empty = no embedding => vector-writer
# skips the upsert (crystallizations never get semantically indexed). Point at orion-vector-host
# /embedding. Hub compose is network_mode: host, so use 127.0.0.1:8320 (not the Docker DNS name).
# In a bridge-network Hub, use http://orion-athena-vector-host:8320/embedding instead.
CRYSTALLIZER_EMBED_HOST_URL=http://127.0.0.1:8320/embedding
CRYSTALLIZER_EMBED_MODE=http
CRYSTALLIZER_EMBED_TIMEOUT_MS=8000
CRYSTALLIZER_AUTO_PROJECT_ON_APPROVE=true

# Chroma query host for active-packet semantic rail (orion-vector-db HTTP)
CHROMA_HOST=
CHROMA_PORT=8000

# Graphiti additive adapter (NOT RDF memory_graph) — required when GRAPHITI_ENABLED=true
GRAPHITI_ADAPTER_URL=http://orion-athena-graphiti-adapter:8000

# --- Global graph / RDF store (Fuseki; Hub memory-graph approve + substrate SPARQL) ---
GRAPH_BACKEND=fuseki
RDF_STORE_BACKEND=fuseki
RDF_STORE_BASE_URL=http://127.0.0.1:3030
RDF_STORE_DATASET=orion
RDF_STORE_QUERY_URL=http://127.0.0.1:3030/orion/query
# Local Fuseki dev auth:
# services/orion-rdf-store/.env sets FUSEKI_ADMIN_PASSWORD=orion.
# Therefore local update credentials are admin/orion, not admin/admin.
# Production should override these with real secrets.
RDF_STORE_USER=admin
RDF_STORE_PASS=orion
# RDF_STORE_UPDATE_URL/RDF_STORE_GRAPH_STORE_URL, MEMORY_GRAPH_APPROVAL_BACKEND,
# GRAPHDB_URL/REPO/USER/PASS, FUSEKI_USER/PASS removed 2026-07-22: Hub's
# memory-graph approve no longer writes to an RDF graph store -- see
# orion/memory_graph/approve.py docstring (the only content ever written
# through it traced to fixture utterance ids, not real approved memory;
# Postgres memory_cards is the durable store, and always was for this data).
# Hub operator goal archive (Autonomy Runtime panel); nightly automation still runs in orion-actions.
AUTONOMY_GRAPH_QUERY_URL=http://orion-athena-fuseki:3030/orion/query
AUTONOMY_GRAPH_UPDATE_URL=http://orion-athena-fuseki:3030/orion/update
AUTONOMY_GRAPH_TIMEOUT_SEC=30
# Default named graph IRI for POST /api/memory/graph/approve when the UI omits named_graph_iri
MEMORY_GRAPH_DEFAULT_NAMED_GRAPH=https://orion.example/ns/memory/ng/session/local

# POST /api/memory/graph/suggest — grounded Quick primary, Brain escalation on hard failures.
# Requires a live Orion bus + cortex gateway client (503 if unavailable), unlike /validate which is local-only.
MEMORY_GRAPH_SUGGEST_PRIMARY_ROUTE=quick
# Retry label only — still uses quick LLM lane (not Hub UI Brain / grounded-small chat mode).
MEMORY_GRAPH_SUGGEST_ESCALATION_ROUTE=brain
MEMORY_GRAPH_SUGGEST_ENABLE_ESCALATION=true
MEMORY_GRAPH_SUGGEST_INCLUDE_GROUNDING=true
# Verb budget (ms); matches orion/cognition/verbs/memory_graph_suggest.yaml timeout_ms.
MEMORY_GRAPH_SUGGEST_VERB_TIMEOUT_MS=180000
# Per-route hub waits (seconds). 0 = derive from verb budget (Quick+Brain share 180s when escalation on).
MEMORY_GRAPH_SUGGEST_BRAIN_TIMEOUT_SEC=0
MEMORY_GRAPH_SUGGEST_QUICK_TIMEOUT_SEC=0
# Hub UI fetch AbortController (ms). 0 = auto (server budget + buffer, typically 205000).
MEMORY_GRAPH_SUGGEST_CLIENT_FETCH_TIMEOUT_MS=0
MEMORY_GRAPH_SUGGEST_CLIENT_FETCH_BUFFER_SEC=25
# After probe_structured_output.py: json_object_schema | json_schema_schema | json_object_only | none
MEMORY_GRAPH_SUGGEST_STRUCTURED_OUTPUT_METHOD=json_object_schema
# Suggest completion budget (ctx-aware; align ctx with config/llm_profiles.yaml quick/atlas-fast ctx_size)
MEMORY_GRAPH_SUGGEST_CTX_TOKENS=4096
MEMORY_GRAPH_SUGGEST_PROMPT_OVERHEAD_TOKENS=1800
MEMORY_GRAPH_SUGGEST_MIN_COMPLETION_TOKENS=768
MEMORY_GRAPH_SUGGEST_MAX_TOKENS=4096
MEMORY_GRAPH_SUGGEST_CHARS_PER_TOKEN=3
MEMORY_GRAPH_SUGGEST_MIN_PROMPT_TOKENS_ESTIMATE=400
# Context turns passed to the LLM for graph extraction — kept low to avoid context-window overflow.
MEMORY_GRAPH_SUGGEST_CONTEXT_TURNS=3
# diagnostic / options.diagnostic on suggest requests returns full raw model text — trusted paths only.
GDB_CLIENT_ENABLED=false

# --- Runtime / Mode ---
MODE=dev
# Bus RPC (Hub→gateway, …); keep ≥ CORTEX_GATEWAY_RPC_TIMEOUT_SEC so multi-step chat verbs can finish.
TIMEOUT_SEC=400
# Voice STT/TTS bus RPC caps (should exceed whisper-tts worker timeouts).
HUB_STT_TIMEOUT_SEC=120
HUB_TTS_TIMEOUT_SEC=180

# --- Hub Prompt Context (UI-side rolling history) ---
# Number of *turns* (user+assistant pairs) to include as inline context
HUB_CONTEXT_TURNS=12
# Rebuild a reconnecting socket's conversation context from chat_history_log.
# Off = the pre-2026-08-14 behaviour, where every Hub restart silently discarded
# the running conversation (history is in-memory, scoped to the websocket).
HUB_HISTORY_REHYDRATE_ENABLED=true
# Age bound so a reused session id does not resurrect a stale conversation.
HUB_HISTORY_REHYDRATE_MAX_AGE_HOURS=48
# Hard cap to avoid runaway prompts when users paste long text
HUB_CONTEXT_MAX_CHARS=12000                                                     

# --- Recall Debugging ---
# When true, allows POST /api/substrate/mutation-runtime/recall-eval-suite/record (still requires SUBSTRATE_MUTATION_OPERATOR_TOKEN).
HUB_RECALL_EVAL_RECORDING_ENABLED=false
HUB_DEBUG_RECALL=false
HUB_DEBUG_COUNCIL=false
HUB_SOCIAL_SKILLS_ENABLED=true
HUB_SOCIAL_SKILLS_ALLOWLIST=social_artifact_dialogue,social_summarize_thread,social_safe_recall,social_self_ground,social_followup_question,social_room_reflection,social_exit_or_pause
HUB_SOCIAL_STYLE_ADAPTATION_ENABLED=true
HUB_SOCIAL_ROOM_RITUALS_ENABLED=true
HUB_SOCIAL_STYLE_CONFIDENCE_FLOOR=0.35
# Default redaction posture for the Hub social_room toggle: "strict" keeps the
# private/secret/password/ssn keyword blocklist active; "relaxed" skips it for
# this trusted 1:1 toggle (email/phone/long-numeric PII regexes stay on either
# way). Per-message UI override (social_redaction_posture) takes precedence.
HUB_SOCIAL_ROOM_REDACTION_POSTURE=strict
ORION_PRESENCE_SESSION_TTL_SECONDS=14400
ORION_PRESENCE_DEFAULT_REQUESTOR=Juniper
ORION_PRESENCE_PERSIST_ALLOWED=false
ORION_SITUATION_ENABLED=true
ORION_SITUATION_TTL_SECONDS=300
ORION_SITUATION_TIMEZONE=America/Denver
ORION_SITUATION_WEATHER_PROVIDER=stub

# --- No-Write Debug Mode ---
HUB_DEFAULT_NO_WRITE=false
HUB_AUTO_DEFAULT_ENABLED=false
# Attach substrate repair contract to cortex chat metadata when behavior changes.
ENABLE_REPAIR_PRESSURE_SPEECH_WIRING=true
# Pre-turn appraisal v2 (logprob repair pressure via cortex-exec RPC).
# Single operator gate on hub; cortex-exec always serves the RPC listener.
# Enabled on Athena after smoke (2026-07-04).
# Unified Orion turn (orion-thought + harness governor). Requires orion-thought + orion-harness-governor + substrate-runtime up.
ORION_UNIFIED_TURN_ENABLED=true
ORION_HARNESS_GOVERNOR_ENABLED=true
# Unified turn harness RPC: should exceed HARNESS_FCC_TIMEOUT_SEC + finalize chain (~60s).
HUB_HARNESS_GOVERNOR_RPC_TIMEOUT_SEC=960
# Hard ceiling for the harness governor RPC wait. Past HUB_HARNESS_GOVERNOR_RPC_TIMEOUT_SEC,
# the wait extends in that same increment as long as the harness governor is still emitting
# steps for this turn (liveness), up to this ceiling. Prevents killing long tool-heavy turns
# while still failing fast on a genuinely stalled governor.
HUB_HARNESS_GOVERNOR_RPC_MAX_WAIT_SEC=3600
# Fixed "still active" recency window for the liveness check above, independent of the RPC
# poll interval. A step must have been seen within this many seconds of now to count as alive.
# Kept generous: a single slow tool call can legitimately go several minutes with no
# intermediate step, and too tight a window kills exactly the turns this feature protects.
HUB_HARNESS_GOVERNOR_LIVENESS_WINDOW_SEC=600
# Safety-net TTL for harness_step_relay's liveness bookkeeping. Entries older than this are
# opportunistically evicted so correlation_ids never explicitly forgotten (e.g. a step observed
# by a hub replica that isn't the one awaiting that turn) can't grow the map unbounded.
HUB_HARNESS_STEP_RELAY_LIVENESS_TTL_SEC=7200
# Hard cap on the same liveness bookkeeping, evicting the least-recently-touched
# correlation_id first — the TTL sweep above only runs every few minutes, so a burst of
# unique correlation_ids within one interval needs a size cap too.
HUB_HARNESS_STEP_RELAY_LIVENESS_MAX_ENTRIES=2000
CHANNEL_THOUGHT_REQUEST=orion:thought:request
CHANNEL_THOUGHT_RESULT_PREFIX=orion:thought:result:
CHANNEL_HARNESS_RUN_REQUEST=orion:harness:run:request
CHANNEL_HARNESS_RESULT_PREFIX=orion:harness:run:result:
CHANNEL_HARNESS_RUN_STEP=orion:harness:run:step
# Fire-and-forget: kill in-flight FCC motor when Hub WS disconnects mid-turn.
CHANNEL_HARNESS_RUN_CANCEL=orion:harness:run:cancel

# Unified turn association: read substrate attention broadcast + felt-state lanes.
ORION_ATTENTION_BROADCAST_ENABLED=true
SUBSTRATE_FELT_STATE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/conjourney
SUBSTRATE_FELT_STATE_MAX_AGE_SEC=120

ENABLE_PRE_TURN_APPRAISAL=true
PRE_TURN_APPRAISAL_PARADIGMS=repair_pressure
PRE_TURN_APPRAISAL_TIMEOUT_MS=60000
CHANNEL_PRE_TURN_APPRAISAL_REQUEST=orion:cortex:pre_turn_appraisal:request
CHANNEL_PRE_TURN_APPRAISAL_RESULT_PREFIX=orion:cortex:pre_turn_appraisal:result
# Published whenever the repair_pressure paradigm actually ran (typed evidence breakdown,
# not just a count) -- feeds orion-equilibrium-service's repair_pressure_metacog_gate.
CHANNEL_REPAIR_PRESSURE_APPRAISAL=orion:repair_pressure:appraisal
# Autonomy compact/debug availability denominator: two (orion+relationship) or three (legacy juniper row)
HUB_AUTONOMY_SUBJECT_DISPLAY=two
# Phase 3 operator goal promote/dismiss/complete routes (default off).
AUTONOMY_GOAL_EXECUTION_ENABLED=true

# --- Hub Docker networking posture ---
# Hub docker-compose uses network_mode: "host" by default.
# In host mode, Docker service DNS names (for example "orion-athena-sql-db") do NOT resolve.
# Use a host-reachable Postgres host instead: 127.0.0.1, LAN IP, Tailscale IP, etc.
HUB_DOCKER_NETWORK_MODE=host

# --- Substrate control-plane SQL source (Phase 20c parity) ---
# Precedence for Hub control-plane reads:
# 1) SUBSTRATE_CONTROL_PLANE_POSTGRES_URL
# 2) SUBSTRATE_POLICY_POSTGRES_URL
# 3) DATABASE_URL
# Prefer shared operational Postgres over local sqlite seams.
# for a host-networked Hub, the right DB URL is:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/conjourney
# Direct Postgres DSN for substrate_* panels (self-brain, observability, lattice). DB: conjourney.
POSTGRES_URI=postgresql://postgres:postgres@127.0.0.1:55432/conjourney
# Grammar Atlas read API (/api/substrate/atlas/*). Optional override; defaults to DATABASE_URL.
GRAMMAR_ATLAS_ENABLED=true
GRAMMAR_ATLAS_POLL_INTERVAL_MS=3000
# GRAMMAR_ATLAS_POSTGRES_URI=

# Substrate Lattice: per-layer freshness threshold in seconds (default 60)
# SUBSTRATE_LATTICE_FRESHNESS_THRESHOLD_SEC=60
SUBSTRATE_CONTROL_PLANE_POSTGRES_URL=
SUBSTRATE_POLICY_POSTGRES_URL=
SUBSTRATE_REVIEW_QUEUE_SQL_DB_PATH=
# Optional sqlite file for review telemetry when Postgres is not used (parity with queue seam).
SUBSTRATE_REVIEW_TELEMETRY_SQL_DB_PATH=
# Seeds the 3 golden concepts (Orion, Juniper, relationship) into SUBSTRATE_SEMANTIC_STORE
# at startup -- see orion/substrate/seed.py. Idempotent, safe to leave enabled.
SUBSTRATE_CONCEPT_SEED_ENABLED=true
# Applies half-life activation decay to every concept-kind node on a fixed
# interval -- see api_routes.py::decay_concept_activations(). Idempotent, safe
# to leave enabled.
SUBSTRATE_DECAY_SCHEDULER_ENABLED=true
SUBSTRATE_DECAY_SCHEDULER_INTERVAL_SEC=120
# Autonomous topic-foundry training + concept ingestion (Gap 5). Each tick:
# ensure a well-known dataset+model exist (idempotent get-or-create by name),
# trigger a training run for a rolling SUBSTRATE_TOPIC_FOUNDRY_WINDOW_DAYS-day
# window, then ingest whatever the latest COMPLETED run currently is. Real
# compute cost (trains a clustering model) -- shipped disabled by default,
# flipped on live 2026-07-17 per operator decision. At most one real training
# run per UTC day at the default interval (see trigger_topic_foundry_training_run()'s
# day-flooring in concept_atlas_routes.py).
SUBSTRATE_TOPIC_FOUNDRY_SCHEDULER_ENABLED=true
# Own kill switch for AI Town's own concept-graph step-group (interpretability-
# only, docs/superpowers/specs/2026-08-18-aitown-concept-graph-split-and-
# atlas-readability-design.md) -- set false to pause it without touching
# Orion's own pipeline above. Rides on the same tick interval, not a
# separate cadence.
SUBSTRATE_TOPIC_FOUNDRY_AITOWN_SCHEDULER_ENABLED=true
SUBSTRATE_TOPIC_FOUNDRY_SCHEDULER_INTERVAL_SEC=86400
SUBSTRATE_TOPIC_FOUNDRY_WINDOW_DAYS=30
SUBSTRATE_TOPIC_FOUNDRY_EMBEDDING_URL=http://orion-athena-vector-host:8320/embedding
# HDBSCAN model_spec for the scheduler's own model (create-only on
# topic-foundry's side -- retuning these requires bumping
# _TOPIC_FOUNDRY_MODEL_NAME in concept_atlas_routes.py to force a fresh
# model, changing these values alone does not affect an already-created
# model). min_cluster_size=15 (this file's value until 2026-08-19) produced
# 0 clusters on the real ~60-160 document AI-Town-filtered corpus; 8 is
# topic-foundry's own live-incident-derived fix (see that service's
# .env_example). metric MUST be "euclidean" -- confirmed live 2026-08-19
# that the installed hdbscan library rejects "cosine" outright
# (ValueError("Unrecognized metric 'cosine'")) despite it being
# orion-topic-foundry's app/models.py::ModelSpec's own field default; see
# services/orion-hub/app/settings.py for the full story.
SUBSTRATE_TOPIC_FOUNDRY_HDBSCAN_MIN_CLUSTER_SIZE=8
SUBSTRATE_TOPIC_FOUNDRY_HDBSCAN_METRIC=euclidean
# Own gate for the scheduler's new enrichment step (2026-07-28): triggers
# POST /runs/{run_id}/enrich for the latest completed run each tick, which
# also generates topic-foundry's typed KG edges as a side effect (see
# services/orion-topic-foundry/README.md's "KG edges" section). Real LLM
# compute cost per un-enriched segment, separate go-ahead from the
# scheduler flag above, same reasoning as
# EQUILIBRIUM_METACOG_TRANSPORT_BUS_SYNAPTIC_POLL_ENABLE (PR #1385/#1387).
# Confirmed live 2026-07-28: 0/22 segments in production had ever been
# enriched -- nothing had ever called this endpoint. Flipped on live
# 2026-07-28 per explicit operator go-ahead, same PR (#1414) -- Python
# code-level default in app/settings.py deliberately stays `False` as the
# safe fallback if this key is ever absent from a real .env, matching the
# established convention (see e.g. that same bus_synaptic PR's
# docker-compose.yml `:-false` fallback note).
SUBSTRATE_TOPIC_FOUNDRY_ENRICH_ENABLE=true
SUBSTRATE_TOPIC_FOUNDRY_ENRICH_LIMIT=200
SUBSTRATE_AUTONOMY_ENABLED=true
SUBSTRATE_AUTONOMY_PROPOSALS_ENABLED=true
SUBSTRATE_AUTONOMY_APPLY_ENABLED=true
SUBSTRATE_AUTONOMY_MONITOR_ENABLED=true
SUBSTRATE_AUTONOMY_ROUTING_PROPOSALS_ENABLED=true
SUBSTRATE_AUTONOMY_COGNITIVE_PROPOSALS_ENABLED=true
SUBSTRATE_AUTONOMY_ROUTING_APPLY_ENABLED=true
SUBSTRATE_AUTONOMY_ROUTING_ROLLBACK_DELTA_THRESHOLD=-0.05
SUBSTRATE_AUTONOMY_INTERVAL_SEC=30
# Self-revision (rung 6): feeds sustained self-model prediction error into the
# cognitive-lane mutation pipeline as signals (never auto-applied). New, more
# invasive than telemetry-derived signals, so it ships opt-in only even though
# the other SUBSTRATE_AUTONOMY_* flags above default true on this deployment.
SUBSTRATE_AUTONOMY_SELF_REVISION_ENABLED=false
SUBSTRATE_AUTONOMY_SELF_REVISION_MIN_ERROR=0.3
SUBSTRATE_AUTONOMY_SELF_REVISION_MAX_AGE_SEC=300
SUBSTRATE_MUTATION_RETENTION_MAX_BLOCKED_APPLIES=500
SUBSTRATE_MUTATION_RETENTION_MAX_ROLLBACKS=500
SUBSTRATE_MUTATION_CONTROL_SQL_DB_PATH=
SUBSTRATE_MUTATION_OPERATOR_TOKEN=

# Causal Geometry v1 (Phase B): sqlite path for the operator-facing
# CAUSAL_GEOMETRY_PROPOSAL_STORE (FieldTopologyLearnedWeightsStore). Empty (default) =
# in-memory only, this process only -- adopting a proposal here will NOT reach
# orion-field-digester's diffusion tick. Must be set to the SAME path as
# orion-field-digester's FIELD_PLASTICITY_SQL_DB_PATH, on a volume mounted into both
# containers, for an adoption to actually take effect.
#
# This is a CONTAINER-internal path, always /mnt/postgres/field_topology/... regardless
# of where the backing host directory actually lives -- do NOT template this with
# ${STORAGE_ROOT}. STORAGE_ROOT is a HOST-side setting (see root .env_example, and this
# file's docker-compose.yml volume mount: "${STORAGE_ROOT:-/mnt/postgres}/field_topology
# :/mnt/postgres/field_topology" -- the container-side target after the ':' is fixed).
# An earlier version of this default templated the app-visible value with
# ${STORAGE_ROOT} too, which happened to work only because the default host and
# container paths are textually identical -- overriding STORAGE_ROOT to a different
# disk would have pointed this env var at a host path that doesn't exist inside either
# container, silently degrading both to disconnected in-memory stores. Fixed to a
# literal container path so it's correct regardless of what STORAGE_ROOT resolves to.
FIELD_PLASTICITY_SQL_DB_PATH=/mnt/postgres/field_topology/learned_weights.sqlite3

# --- Substrate semantic graph (FalkorDB property graph -- see
# docs/superpowers/specs/2026-07-16-falkordb-property-graph-routing-design.md) ---
# 2026-07-17: RDF/Fuseki/SPARQL is explicitly rejected as the target for this seam per
# that doctrine (append-heavy SPARQL UPDATE loops, index amplification, compaction
# downtime -- see the doc's Arsonist summary). FalkorSubstrateStore / RoutedSubstrateGraphStore
# already exist and are wired into build_substrate_store_from_env() (orion/substrate/graphdb_store.py).
# Connects via the shared FALKORDB_URI below (same FalkorDB instance the Graphiti memory-
# crystallization projection uses -- see "Memory crystallization Graphiti/FalkorDB" section --
# differentiated by FALKORDB_SUBSTRATE_GRAPH, not a separate connection).
# Host-mode note (Hub docker-compose defaults to host networking): use 127.0.0.1 + the
# published FalkorDB port (6380 in services/orion-falkordb/docker-compose.yml), not
# Docker service DNS (orion-athena-falkordb:6379 only resolves on the bridge network).
SUBSTRATE_STORE_BACKEND=falkor
FALKORDB_SUBSTRATE_GRAPH=orion_substrate
# AI Town's own concept graph -- second independently-named FalkorDB graph,
# same instance, interpretability-only. See the "Attention organ operator
# tab" section above for the full comment; duplicated here because this is
# the section SUBSTRATE_SEMANTIC_STORE/SUBSTRATE_SEMANTIC_STORE_AITOWN are
# actually built from (services/orion-hub/scripts/api_routes.py).
FALKORDB_AITOWN_SUBSTRATE_GRAPH=orion_substrate_aitown
# The SPARQL/Fuseki keys that used to sit here (SUBSTRATE_GRAPH_QUERY_URL/
# UPDATE_URL/URI/TIMEOUT_SEC/USER/PASS) were removed entirely 2026-07-23,
# reversing the 2026-07-17 cutover's deliberate choice to keep them as a
# fallback path back to Fuseki -- that choice made sense while Fuseki was
# still a live, running store; it no longer does now that Fuseki itself is
# being decommissioned (there will be nothing to fall back to). Zero real
# consumers confirmed in Hub's own code beyond this dead fallback branch of
# the shared orion/substrate/graphdb_store.py module. The one-shot demo
# script that required SUBSTRATE_STORE_BACKEND=graphdb
# (seed_substrate_graphdb.py) was deleted alongside this.
# Real change detection, not a blind timer (2026-07-14 incident: an uncached
# brain-frame tick drove Fuseki to 99.99% memory). Safety-net ceiling for staleness
# from writes made by a DIFFERENT process; same-process writes are caught instantly
# via a write-generation counter. See GraphDBSubstrateStoreConfig.
# snapshot_force_refresh_ceiling_sec in orion/substrate/graphdb_store.py for the full
# design and the 0-value warning (its meaning is NOT the same as the removed
# SUBSTRATE_SNAPSHOT_CACHE_TTL_SEC=0 convention).
SUBSTRATE_SNAPSHOT_FORCE_REFRESH_CEILING_SEC=30.0
# Legacy GraphDB substrate keys (SUBSTRATE_GRAPHDB_ENDPOINT/GRAPH_URI/
# TIMEOUT_SEC/USER/PASS) removed 2026-07-23, same reasoning as the SPARQL
# keys above -- see that comment.

# --- Chat grammar lane (substrate signal bridge V1) ---
# Emit GrammarEventV1 per chat turn → substrate-runtime chat_grammar_consumer → field lattice.
# Apply SQL migration before enabling: services/orion-sql-db/manual_migration_chat_substrate_loop.sql
# Enable substrate-runtime ENABLE_CHAT_GRAMMAR_REDUCER=true first, then flip this on.
# Also gates the unrelated turn-incompletion liveness marker (README's "Turn-incompletion
# liveness marker" section) -- no user content, but currently no separate flag to disable
# one without the other.
PUBLISH_HUB_CHAT_GRAMMAR=true
GRAMMAR_EVENT_CHANNEL=orion:grammar:event

# --- Substrate operator seed (optional) ---
# One-shot demo nodes/edges into the configured graph backend (legacy script name: seed_substrate_graphdb.py).
# In a running hub container with the repo mounted at /repo, use a neutral cwd so Python
# loads orion from the mount (WORKDIR /app shadows orion on PYTHONPATH=/repo:/app):
#   docker exec <hub> sh -c 'cd /tmp && env PYTHONPATH=/repo python3 /repo/services/orion-hub/scripts/seed_substrate_graphdb.py'
# After a new image build, the script also lives under /app/scripts/ when not using /repo.

# --- Pending Attention cognitive-loop cards (default-off) ---
ORION_ATTENTION_PENDING_CARDS_ENABLED=true

# ── Room companion: Claude as a third participant in the social room ──
# Hub publishes an invite and relays the reply. It never spawns `claude` and
# never holds the Claude credential -- that lives in orion-room-companion,
# deliberately, because this container runs as root with SSH keys, a gh token
# and the docker socket, all readable by Orion's own FCC turns. See
# services/orion-room-companion/README.md.
#
# v1 is explicit-invite only: the "Ask Claude" button is the only producer of
# orion:room:claude:request, which is what keeps v1 spend bounded by human
# clicks. Orion inviting Claude itself is v2.
HUB_ROOM_CLAUDE_ENABLED=false
HUB_ROOM_CLAUDE_ROOM_ID=hub-direct
HUB_ROOM_CLAUDE_PARTICIPANT_NAME=Claude
# Turns of conversation sent to seed Claude's FIRST turn of a session. Not the
# memory mechanism -- the companion holds the conversation via --resume.
HUB_ROOM_CLAUDE_TRANSCRIPT_TURNS=12
# Auto-invite Claude after each Orion turn (organic room instead of summoning).
# NOTE: this removes the property that made v1 safe without a spend cap --
# spend was bounded by human clicks. Every Orion turn now costs a Claude call
# even when Claude passes.
HUB_ROOM_CLAUDE_AUTO_RESPOND=false
HUB_ROOM_CLAUDE_AUTO_MIN_GAP_SEC=8
CHANNEL_ROOM_CLAUDE_REQUEST=orion:room:claude:request
CHANNEL_ROOM_CLAUDE_UTTERANCE=orion:room:claude:utterance
