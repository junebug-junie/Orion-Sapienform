REOLINK_USER=
REOLINK_PASS=
REOLINK_HOST=

# Camera (cam0, interior). Placeholder only -- the real URL carries the camera
# password and belongs in the local .env, never here. The URL is used only to
# open the stream; everything published uses STREAM_ID as the camera name.
REOLINK_URL="rtsp://USER:PASSWORD@CAMERA_IP:554/Preview_01_sub"

# Walkway camera (second capture instance, compose service
# `vision-edge-walkway`, profile `walkway`). Outdoor, community walkway with a
# partial patio view; STREAM_ID is fixed to `walkway` in docker-compose.yml and
# matches config/vision_frame_router.yaml `streams.walkway` and
# config/vision_zones.yaml. Leave empty until the camera is mounted; set the
# real rtsp://USER:PASSWORD@CAMERA_IP:554/... in the local .env only.
WALKWAY_RTSP_URL=
# Host port for the walkway instance's UI/health (cam0 uses 7100).
WALKWAY_EDGE_PORT=7101

# Stream config
WIDTH=640
HEIGHT=360
FPS=15
DETECT_EVERY_N_FRAMES=10
DETECTORS=yolo,motion
MOTION_MIN_AREA=2000
FACE_SCALE_FACTOR=1.1
FACE_MIN_NEIGHBORS=5
FACE_MIN_SIZE=30,30

ANNOTATE=1

STREAM_ID=cam0
ENABLE_UI=1
ENABLE_PRESENCE=true
PRESENCE_TIMEOUT=60
PRESENCE_LABEL=Juniper
FACE_CASCADE_PATH=/app/haar/haarcascade_frontalface_default.xml

JPEG_QUALITY=90

# enabled_yolo is gpu device number
ENABLE_YOLO=1
YOLO_MODEL=yolov8n.pt
YOLO_CLASSES=person
YOLO_CONF=0.25
YOLO_DEVICE=0

# orion bus
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
ORION_BUS_URL=redis://100.92.216.81:6379/0

# bus channels
VISION_EVENTS_PUBLISH_RAW=orion:vision:edge:raw
VISION_EVENTS_SUBSCRIBE_RAW=orion:vision:edge:raw
# future:
VISION_EVENTS_PUBLISH_NOTABLE=orion:vision:edge:event:notable

# === TITANIUM MIGRATION ===
CHANNEL_VISION_FRAMES=orion:vision:frames
CHANNEL_VISION_ARTIFACTS=orion:vision:artifacts
CHANNEL_VISION_EDGE_HEALTH=orion:vision:edge:health
CHANNEL_VISION_EDGE_ERROR=orion:vision:edge:error
CHANNEL_VISION_EDGE_ACTIVITY=orion:vision:edge:activity
EDGE_ACTIVITY_MIN_INTERVAL_S=1.0

# Vision Edge Config (New)
YOLO_CONF_THRES=0.25
YOLO_IOU_THRES=0.45
YOLO_IMG_SIZE=640
YOLO_PERSON_RETRY_THRESHOLD=0.15
EDGE_DEBUG_SAVE_FRAMES=False
EDGE_DEBUG_DIR=/mnt/debug
FRAME_STORAGE_DIR=/mnt/telemetry/vision/frames
# When Host+Router semantic path is active, set false so Window ingests Host artifacts only.
EDGE_PUBLISH_ARTIFACTS=false
