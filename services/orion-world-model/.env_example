# Copy to .env and tune for your node.
# See README.md for status (untrained inference-capable scaffolding) and
# operator checklist. Real deployment target for this service is `circe`
# (docs/superpowers/specs/2026-08-20-reverie-visual-chain-design.md §3) --
# circe's physical 4th-GPU provisioning is out of scope for this patch, so
# NODE_NAME below still defaults to athena for local/dev boot.

LOG_LEVEL=INFO
NODE_NAME=athena

ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
ORION_BUS_URL=redis://100.92.216.81:6379/0
HEARTBEAT_INTERVAL_SEC=10

# Port 8014 on circe is already bound to circe-worker-agent-1 (llama.cpp
# Muse Glimmer 30B, services/orion-llm-gateway/.env_example /
# services/orion-llamacpp-host/README.md) -- do not reuse it. Following
# orion-vision-host's pattern instead: fixed internal container port,
# HOST_PORT assigned here so it's operator-set per node. 6613 continues the
# existing orion-mind(6611)/orion-diffusion-host(6612) sequence and was
# confirmed unclaimed by grepping every services/*/.env_example and
# docker-compose.yml in this repo before picking it.
HOST_PORT=6613

CHANNEL_WORLDMODEL_INTAKE=orion:exec:request:WorldModelService
CHANNEL_WORLDMODEL_REPLY_PREFIX=orion:worldmodel:reply
CHANNEL_WORLDMODEL_PUB=orion:worldmodel:predictions

# storage-warm convention (orion-diffusion-host, orion-vllm-host,
# orion-recall) -- single-purpose model checkpoint storage, not
# vision-host's mixed-purpose /mnt/telemetry.
# NOT YET WIRED: no code reads this path in this patch -- weights are always
# randomly initialized in-process (README "Status"). Declared/mounted now so
# the path convention is settled before a future patch adds real checkpoint
# loading.
MODEL_CACHE_DIR=/mnt/storage-warm/models/world-model

# --- Feature group dims (encoder input shape) ---
# ASSUMPTION: exact producer dims were not specified before context was lost
# to compaction (see README.md "Assumptions"). Override to match whatever
# actually produces each feature group in your deployment.
WM_DIM_BIOMETRICS=32
WM_DIM_AFFECT=16
WM_DIM_EXECUTION_CONTEXT=16
WM_DIM_MEMORY_POINTERS=32
WM_DIM_TEMPORAL=8
WM_DIM_VISION_EMBEDDING=512

# --- Model architecture ---
# ASSUMPTION: ~150M total params is a concrete default within the requested
# ~100-350M range, not a spec (README.md "Assumptions"). Real measured count
# with these defaults: 154,661,376 (~154.7M).
WM_FUSION_DIM=512
WM_DYNAMICS_D_MODEL=1024
WM_DYNAMICS_NHEAD=16
WM_DYNAMICS_NUM_LAYERS=12
WM_DYNAMICS_DIM_FEEDFORWARD=4096
WM_DYNAMICS_MAX_WINDOW=32
WM_DYNAMICS_DROPOUT=0.1
WM_STATE_DIM=

# --- Runtime ---
WM_DEVICE_STRATEGY=best_free_vram
WM_DEFAULT_DEVICE=cuda:0
WM_DEVICES=cuda:0
WM_PICK_GPU_METRIC=free_vram_mb
WM_DTYPE=auto
WM_TIMEOUT_S=30
WM_MAX_INFLIGHT=2

# VRAM pressure -- sized so this service caps itself well under circe's
# 32GB 4th V100, leaving headroom for the separately-designed, out-of-scope
# Infinity 2B diffusion process sharing the same card via MPS.
WM_VRAM_RESERVE_MB=4000
# NOT YET WIRED: this synchronous, no-queue scaffold has no queue-vs-reject
# decision for a soft floor to gate (unlike vision-host's async
# VisionScheduler). Only WM_VRAM_RESERVE_MB/WM_VRAM_HARD_FLOOR_MB are read.
WM_VRAM_SOFT_FLOOR_MB=3000
WM_VRAM_HARD_FLOOR_MB=2000
