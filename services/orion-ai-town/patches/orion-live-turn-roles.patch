+// Word-set overlap with the partner's last line. Measured on 9,391 live town
+// turns (2026-10-23): >= 0.7 is a copy or pronoun-swapped copy (192, 2.0%);
+// below that is shared topic. Lines under 4 words ("Take care.") are exempt.
+const PARTNER_ECHO_MIN_OVERLAP = 0.7;
+const PARTNER_ECHO_MIN_WORDS = 4;
+
+function isPartnerEcho(reply: string, partnerLine: string): boolean {
+  const a = new Set(normalizeTownLine(reply).split(' ').filter(Boolean));
+  const b = new Set(normalizeTownLine(partnerLine).split(' ').filter(Boolean));
+  if (a.size < PARTNER_ECHO_MIN_WORDS || b.size === 0) {
+    return false;
+  }
+  let shared = 0;
+  for (const w of a) {
+    if (b.has(w)) {
+      shared++;
+    }
+  }
+  return shared / (a.size + b.size - shared) >= PARTNER_ECHO_MIN_OVERLAP;
+}
