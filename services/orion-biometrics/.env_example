# ───────────────────────────────────────────────────────────────
# 🧬 Orion Biometrics Service — Environment Configuration
# ───────────────────────────────────────────────────────────────

# --- Service Identity & Port ---
SERVICE_NAME=biometrics
SERVICE_VERSION=1.0.0
PORT=8100

# --- Orion Bus Integration ---
# This single channel is used for both publishing and subscribing for self-persistence.
TELEMETRY_PUBLISH_CHANNEL=orion:telemetry:biometrics
BIOMETRICS_SAMPLE_CHANNEL=orion:biometrics:sample
BIOMETRICS_SUMMARY_CHANNEL=orion:biometrics:summary
BIOMETRICS_INDUCTION_CHANNEL=orion:biometrics:induction
BIOMETRICS_CLUSTER_CHANNEL=orion:biometrics:cluster
SPARK_SIGNAL_CHANNEL=orion:spark:signal
PUBLISH_BIOMETRICS_GRAMMAR=true
GRAMMAR_EVENT_CHANNEL=orion:grammar:event
NODE_CATALOG_PATH=/app/config/biometrics/node_catalog.yaml
EXTERNAL_SUBSCRIBE_CHANNEL=

#ORION_BUS_URL=redis://${PROJECT}-bus-core:6379/0
ORION_BUS_ENFORCE_CATALOG=true


# --- Runtime Settings ---
TELEMETRY_INTERVAL=30 # seconds
LOG_LEVEL=INFO
# PER-NODE ROLE. This is one of the few keys whose correct value differs by host,
# so the value below is the safe default for a NEW node, not a fleet-wide setting.
#
#   agent -> measure this host and publish orion:biometrics:summary/:induction.
#            Correct for every node. atlas and circe run this.
#   hub   -> subscribe to those channels fleet-wide, aggregate, and publish
#            orion:biometrics:cluster. EXACTLY ONE node may do this.
#   both  -> athena, which is the hub node and also reports its own telemetry.
#
# Set `both` ONLY on athena. Two hubs means two publishers aggregating the same
# fleet into the same channel at CLUSTER_PUBLISH_INTERVAL, and the consumers
# (orion-hub's biometrics cache, orion-state-service) keep whichever arrived
# last -- silent duplicate aggregation with no error anywhere.
#
# The cluster channel is the ONLY path by which fleet-level totals reach
# cognition: orion-biometrics.publish_cluster -> orion:biometrics:cluster ->
# orion-state-service (main.py:209) -> BiometricsContext.cluster (store.py:207)
# -> orion-cortex-exec._metacog_biometrics_cue. With no node in hub/both mode
# that whole chain is subscribed but starved, and `fleet_watts` never reaches
# the metacog cue no matter what the per-node collectors measure.
BIOMETRICS_MODE=agent
CLUSTER_PUBLISH_INTERVAL=15
# circe inherited atlas's 0.7 weight 2026-08-21: atlas is decommissioned, circe is now the
# fleet's dominant, always-up GPU node (see main.py's publish_cluster role selection).
CLUSTER_ROLE_WEIGHTS={"circe":0.7,"athena":0.3,"other":0.5}
SPARK_SIGNAL_TTL_MS=15000

THERMAL_MIN_C=50.0
THERMAL_MAX_C=85.0
# Denominator for disk_pressure, in MB/s. A per-node ANCHOR, not a measured ceiling: the
# kernel does not report block-device throughput the way it reports link speed, so there is
# nothing to read it from without benchmarking. It is also the wrong SHAPE for a mixed array --
# athena has ten devices spanning a 10k SAS spinner and a Samsung 990 PRO, and no single
# scalar is right for both. When you need the real number, read
# `measurements.disk_bytes_per_sec`, which is now published in bytes/sec and is comparable
# across nodes; the 0-1 band is only for "is this node's storage unusually busy for itself".
DISK_BW_MBPS=200.0
# FALLBACK ONLY, in MB/s. The live denominator for net_pressure is now MEASURED: the summed
# link speed of this node's up physical NICs, read from HOST_SYS_PATH/class/net/*/speed. This
# value applies only if that read fails. It was previously the sole source -- one number for
# three heterogeneous hosts, right for athena's single 1 GbE port by coincidence and never
# verified on atlas or circe.
NET_BW_MBPS=125.0

# Read-only bind mounts of the HOST /proc and /sys (see docker-compose.yml). The collector
# needs these to measure the NODE instead of its own container: /proc/net/dev and /sys are
# per-network-namespace, so from inside a bridged container the network counters show only
# this service's veth. Measured on athena 2026-08-14: 1,357 B/s in-container against the
# host's 159,304 B/s -- which is why net_pressure read 3.2e-05 on athena, 2.2e-05 on atlas and
# 2.1e-05 on circe, degenerate on every node in the fleet.
#
# Set either to empty to disable the host read. The collector then falls back to its own
# namespace and reports `network.scope="container"`, and `measurements.net_bytes_per_sec` is
# withheld rather than published as if it were the node's. /proc/diskstats is NOT namespaced,
# so disk telemetry does not depend on these.
HOST_PROC_PATH=/host_proc
HOST_SYS_PATH=/host_sys
POWER_BAND_ALPHA=0.1

# --- Disk capacity telemetry (piggybacked onto the SystemHealthV1 heartbeat) ---
# Maps a short mount name to the read-only in-container bind-mount path from
# docker-compose.yml. Node-level: each node (athena/atlas/circe) reports its own
# mounts independently once redeployed there. See README.md for the
# details.disk_usage_pct.<mount_name> key convention.
DISK_CAPACITY_MOUNTS={"docker":"/host_mnt/docker","scripts":"/host_mnt/scripts","postgres":"/host_mnt/postgres","graphdb":"/host_mnt/graphdb","telemetry":"/host_mnt/telemetry"}

# --- iLO/BMC out-of-band hardware telemetry (piggybacked onto the same
# heartbeat as disk capacity, above) ---
# Node-level and secret: each node (athena/atlas/circe) has its own BMC IP and
# credentials, set directly in that node's local .env, never here. Empty here
# means iLO telemetry collection is skipped for this node. See
# docs/superpowers/specs/2026-07-24-service-heartbeat-node-telemetry-design.md.
ILO_HOST=
ILO_USERNAME=
ILO_PASSWORD=
ILO_POLL_INTERVAL_SEC=60.0
ILO_REQUEST_TIMEOUT_SEC=8.0

# --- Rack PDU per-outlet power (SNMP, read-only) ---
# PER-NODE, like ILO_HOST above. This is the ONLY source of chassis watts for a node with no
# BMC -- circe has never reported power, and every fleet total has carried
# `measurements_missing: {"chassis_watts": ["circe"]}` because of it.
#
# PDU_OUTLETS is THIS node's own outlets. A multi-PSU server spans several and its chassis
# draw is their SUM, so a single outlet understates it by the number of supplies. The mapping
# is physical cabling; the device's outlet names are generic ("OUTLET19") and not editable on
# this firmware, so it cannot be read from the device. Traced by hand 2026-08-15:
#     circe   PDU_OUTLETS=19,25,31   (3 PSUs, ~419 W)
#     atlas   PDU_OUTLETS=34,35      (2 PSUs, ~266 W)
# athena is not on this PDU. Leave PDU_OUTLETS empty there -- empty disables the poller, and
# `chassis_watts` keeps coming from its iLO.
#
# RE-CABLED 2026-08-21, UN-CABLED 2026-09-02. atlas was decommissioned 2026-08-21 and athena
# inherited its PDU spot, outlets 34,35 (confirmed live at 238 W chassis vs 235 W PDU). circe
# was separately relocated to this PDU's bank B1, outlets 1,7,13 (~669 W), also confirmed live.
#
# Juniper physically pulled athena off this Panduit PDU 2026-09-02. Outlets 34,35 no longer
# carry athena's draw -- athena is back to the pre-2026-08-21 shape: not on this PDU,
# PDU_OUTLETS left empty in athena's local .env, `chassis_watts` exclusively from its iLO (see
# ILO_HOST above). Do not re-set athena's PDU_OUTLETS without confirming a real re-cabling: a
# stale outlet number reads whatever else is now plugged in there, not athena, and it looks
# exactly as valid as a real reading. circe's PDU_PROXY_OUTLETS below is unaffected -- athena
# proxies it over LAN/SNMP reachability to the PDU, which has nothing to do with athena's own
# power source.
#
# ONLY READ-ONLY GETS ARE ISSUED. Do not give this a write community: the device is
# outlet-SWITCHED, so a write community can power off any machine plugged into it -- circe,
# and whoever now sits on atlas's old outlets 34,35 (no longer athena, as of 2026-09-02).
# PDU_HOST is "the PDU THIS node can reach" -- set it on any node that can talk to the PDU,
# including a hub that only proxies for others. What disables SELF-polling is an empty
# PDU_OUTLETS, not an empty PDU_HOST. (athena, as of 2026-09-02: PDU_HOST still set for the
# proxy path, PDU_OUTLETS empty -- self-polling off -- PDU_PROXY_OUTLETS set, polling only on
# circe's behalf.)
PDU_HOST=
PDU_OUTLETS=
PDU_SNMP_COMMUNITY=public
PDU_SNMP_PORT=161
PDU_POLL_INTERVAL_SEC=60.0
PDU_REQUEST_TIMEOUT_SEC=5.0

# Outlets THIS node polls ON BEHALF OF another node, as JSON: {"circe": [19,25,31]}
#
# HUB ONLY, and only for a node that cannot reach the PDU itself. circe's network card is dead:
# it reaches the bus over Tailscale but has no LAN path to the PDU, so its own poller fails
# every 65 s with a UDP timeout. athena can reach it, so athena reads circe's outlets.
#
# Also strictly better than self-polling for circe -- the outlets report its draw whether circe
# is powered or not, so a shut-down circe reads a true ~0 W instead of vanishing from the fleet
# total. Set on athena only:
#     PDU_PROXY_OUTLETS={"circe": [19,25,31]}
#
# A proxied reading is published with provenance (`measurements_proxied` on the cluster) and
# NEVER overwrites a node's own measurement -- it only fills a gap.
PDU_PROXY_OUTLETS=

# --- Cabinet sensor node (Nano ESP32, host-local snapshot) ---
# Read-only bind mount from /run/orion-sensors (see docker-compose.yml).
# Missing file => BiometricsSampleV1.sensors stays absent (not {}).
# Freshness gate: biometrics sets sensors.stale when age exceeds this threshold
# or when the reader reports status stale/error/missing.
CABINET_SENSORS_PATH=/run/orion-sensors/latest.json
# Optional second Nano reader output (MMC5603 + BNO085). Empty = single Nano.
CABINET_SENSORS_B_PATH=/run/orion-sensors/b/latest.json
CABINET_SENSOR_STALE_AFTER_SEC=10.0

# --- Athena ambient audio levels (host-local USB mic snapshot) ---
# Read-only bind mount from /run/orion-audio (see docker-compose.yml).
# Missing file => BiometricsSampleV1.ambient_audio stays absent (not {}).
AMBIENT_AUDIO_PATH=/run/orion-audio/latest.json
AMBIENT_AUDIO_STALE_AFTER_SEC=5.0

# Cabinet ambient audio spike events (activity threshold; no STT clip in v1).
AMBIENT_AUDIO_SPIKE_ENABLED=true
CABINET_AMBIENT_SPIKE_CHANNEL=orion:cabinet:ambient:spike
AMBIENT_AUDIO_SPIKE_ACTIVITY_THRESHOLD=0.30
AMBIENT_AUDIO_SPIKE_CONSECUTIVE_TICKS=2
AMBIENT_AUDIO_SPIKE_COOLDOWN_SEC=300.0

# --- Power intent settlement (stage 2) -------------------------------------------
# The settler runs on the node that physically owns the GPU, so every deployment
# subscribes and ignores intents naming another node. Sampling at 1 Hz only happens
# while an intent window is open -- there is no added steady-state load.
POWER_INTENT_CHANNEL=orion:power:intent
POWER_INTENT_SETTLED_CHANNEL=orion:power:intent:settled
POWER_INTENT_SETTLE_ENABLED=true
POWER_INTENT_SAMPLE_INTERVAL_SEC=1.0
