ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENFORCE_CATALOG=false

CHANNEL_RETINA_PUB=orion:vision:frames
CHANNEL_RETINA_ERROR=orion:vision:retina:error
CHANNEL_SYSTEM_HEALTH=orion:system:health

RETINA_SOURCE_TYPE=folder
RETINA_SOURCE=/mnt/telemetry/vision/intake
RETINA_CAMERA_ID=retina-cam-01
RETINA_STREAM_ID=retina-stream-01
RETINA_FPS=1.0

FRAME_STORAGE_DIR=/mnt/telemetry/vision/frames
FRAME_RETENTION_SECONDS=300
JPEG_QUALITY=90

HEALTH_INTERVAL_SECONDS=10.0
SOURCE_RECONNECT_SECONDS=5.0

# --- Frame addressing --------------------------------------------------------
# local         write to FRAME_STORAGE_DIR, publish image_path. Correct ONLY
#               when the vision host shares this filesystem (athena).
# percept_store encode in memory, POST to orion-percept-store, publish sha256.
#               The only option for a node with no shared disk. Writes NOTHING
#               locally on purpose -- a capture agent on a personal laptop must
#               not accumulate a spool of webcam frames.
RETINA_FRAME_MODE=local
RETINA_PERCEPT_STORE_URL=
RETINA_PERCEPT_STORE_TOKEN=
RETINA_PERCEPT_TIMEOUT_SEC=10.0

# Webcam device passthrough. /dev/null on a host with no camera keeps the
# container startable; set /dev/video0 on a node that has one.
RETINA_VIDEO_DEVICE=/dev/null

# --- On-demand video+audio clip capture (AffectGPT) --------------------------
# UNVERIFIED against real hardware -- see app/clip_capture.py module
# docstring. Defaults are a starting point for carbon, not confirmed-correct.
# Off by default; POST /capture/clip returns 503 until explicitly enabled.
RETINA_CLIP_ENABLED=false
# Shared-secret gate for POST /capture/clip (header X-Orion-Retina-Token),
# same convention as orion-percept-store's PERCEPT_STORE_TOKEN. Empty
# disables the check -- strongly set this one given the endpoint triggers a
# live recording, unlike every other route on this service.
RETINA_CLIP_TOKEN=
RETINA_CLIP_FFMPEG_BIN=ffmpeg
RETINA_CLIP_VIDEO_DEVICE=/dev/video0
# PipeWire's pulse-compatible socket accepts "default" as the default
# source, same as plain PulseAudio -- override if carbon's audio backend
# names sources differently (check with `pactl list sources short` or
# `pw-cli list-objects` on carbon).
RETINA_CLIP_AUDIO_INPUT=default
RETINA_CLIP_DURATION_SEC=8.0
RETINA_CLIP_FRAMERATE=15
RETINA_CLIP_WIDTH=
RETINA_CLIP_HEIGHT=
RETINA_CLIP_TIMEOUT_SEC=30.0
# Minimum seconds between the end of one capture and the start of the next,
# regardless of caller/path (HTTP or bus RPC). The bus RPC path has no auth
# beyond bus reachability -- this bounds how often ANY bus-connected caller
# can trigger a live recording, closing off de facto continuous recording.
RETINA_CLIP_MIN_INTERVAL_SEC=30.0
# Bus-reachable twin of POST /capture/clip, for callers with no network path
# to this node at all (e.g. Hub, via orion-juniper-affective-state) --
# carbon accepts no inbound HTTP per docs/operations/carbon-webcam.md. Must
# match that service's own CHANNEL_RETINA_CLIP_INTAKE /
# CHANNEL_RETINA_CLIP_REPLY_PREFIX. Also gated by RETINA_CLIP_ENABLED above.
CHANNEL_RETINA_CLIP_INTAKE=orion:exec:request:RetinaClipCaptureService
CHANNEL_RETINA_CLIP_REPLY_PREFIX=orion:retina:clip:reply
# uid whose /run/user/<uid>/pulse socket the container mounts (docker-compose.yml)
# and PULSE_SERVER points at -- run `id -u` on carbon if not the default 1000.
PULSE_SERVER_UID=1000
# Host port for POST /capture/clip (bus-only otherwise, no port needed before).
# NOT 8022 -- confirmed live 2026-08-22: orion-athena-cortex-gateway already
# owns 8022 on athena (a multi-service host retina can also be deployed to,
# for the room camera / cam0, alongside carbon's own instance). carbon's
# separate venv/systemd deployment (docs/operations/carbon-webcam.md) still
# hardcodes 8022 for its own uvicorn process -- that's fine there (a
# dedicated laptop, no cortex-gateway), unrelated to this Docker-path
# setting, and intentionally left alone. Re-check for collisions with
# `ss -tln` before reusing this default on any other shared host.
RETINA_HTTP_PORT=8027
