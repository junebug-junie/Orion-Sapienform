# orion-policy-runtime — Layer 8 policy gate (docker compose)
# Requires: substrate_proposal_frames (orion-proposal-runtime)
# Apply migration: services/orion-sql-db/manual_migration_policy_decision_frame_v1.sql
# Apply migration: services/orion-sql-db/manual_migration_policy_decision_frame_v2_drop_self_state.sql
# Apply migration: services/orion-sql-db/manual_migration_substrate_pending_markers.sql
# Apply migration: services/orion-sql-db/manual_migration_substrate_frames_created_at_index.sql
#   ^ REQUIRED. Without the first one every tick raises UndefinedColumn on the
#     *_pending column, which _poll_loop's blanket `except Exception` swallows --
#     /health stays green, the heartbeat keeps publishing, and the pipeline
#     produces nothing at all. Run the VERIFY block at the end of that file.
PROJECT=orion-athena
SERVICE_NAME=orion-policy-runtime
SERVICE_VERSION=0.1.0
NODE_NAME=athena

# Bus-native SystemHealthV1 heartbeat (orion:system:health). This is policy-runtime's only
# bus connection -- the rest of the service polls Postgres directly.
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10

POSTGRES_URI=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
SUBSTRATE_POLICY_PATH=/app/config/policy/substrate_policy.v1.yaml
POLICY_POLL_INTERVAL_SEC=2.0

# --- Pending-marker reconciler (ROADMAP D2, 2026-08-19) --------------------------------------
# Re-queues rows whose `*_pending` marker was cleared without the downstream frame existing.
# Only ever ADDS work back, never removes it. It runs the expensive anti-join the marker exists
# to avoid, so it is rate-limited. 0 means "every poll", which reinstates the original problem.
POLICY_RECONCILE_INTERVAL_SEC=900
# Bounded sweep (2026-09-25): the 15-min sweep above only checks rows generated in the last
# WINDOW seconds (2 h). The unbounded version was the top I/O statement on athena's Postgres
# and never found anything. Each checked row costs a random read, so keep this small.
POLICY_RECONCILE_WINDOW_SEC=7200
# Full-history sweep: one read-only hash anti-join + short batched UPDATEs. 0 disables it.
POLICY_RECONCILE_FULL_SWEEP_INTERVAL_SEC=86400
# UTC hour the full sweep may run in (9 = 03:00 MDT, off-peak for Juniper). -1 = any hour.
POLICY_RECONCILE_FULL_SWEEP_HOUR_UTC=9

ENABLE_POLICY_RUNTIME=true
LOG_LEVEL=INFO
POLICY_RUNTIME_PORT=8120
