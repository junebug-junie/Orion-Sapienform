# services/orion-vllm-host/.env

SERVICE_NAME=orion-vllm
SERVICE_VERSION=0.1.0
NODE_NAME=athena

# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health), published on its own
# independent bus connection. See
# docs/superpowers/specs/2026-07-24-service-heartbeat-node-telemetry-design.md.
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10

# HTTP bind
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_HOST_PORT=7000
# Lane door on hecate (leased-evals Phase 2; runbook docs/runbooks/2026-11-14-lane-door.md): where the
# engine publishes. Empty = each compose file's default: docker-compose.deep.yml (the live agent-deep,
# scripts/hecate-deep.sh) publishes 127.0.0.1:18021 and hecate-deep.sh starts the door that takes 8021;
# docker-compose.yml alone keeps VLLM_HOST_PORT on all interfaces. =8021 puts the deep engine back on its
# lane port (stop the door first).
VLLM_ENGINE_PUBLISH=

HF_TOKEN=TOKEN

# Which llm_profiles.yaml entry this node should run
#VLLM_PROFILE_NAME=llama3-7b-v100-1gpu
VLLM_PROFILE_NAME=mixtral-8x7b-deep

# Optional: override model_id from profile (usually leave blank)
VLLM_MODEL_ID=

# Runtime-only knobs
VLLM_GPU_MEMORY_FRACTION=0.9
VLLM_DOWNLOAD_DIR=/models
VLLM_ENFORCE_EAGER=false

# Path to profiles YAML *inside* the container
LLM_PROFILES_CONFIG_PATH=/app/config/llm_profiles.yaml
ORION_BUS_ENFORCE_CATALOG=true

# Pool discovery: leave role/port empty until deployment is verified.
LLM_ROLE=
LLM_ANNOUNCE_HOST=hecate
LLM_ANNOUNCE_PORT=

# Hecate-only source context for the explicit SM70 compose override.
# Leave empty on Athena. prepare_source.py verifies this dedicated checkout.
VLLM_SOURCE_DIR=
