[Unit]
Description=Orion Athena cabinet sensor serial reader
Documentation=file:///mnt/scripts/Orion-Sapienform/docs/superpowers/specs/2026-08-23-athena-cabinet-sensor-node-design.md
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
RuntimeDirectory=orion-sensors
RuntimeDirectoryMode=0755
# Paths below are rewritten to the installing checkout by
# scripts/setup_athena_cabinet_sensors.sh (@ORION_ROOT@ → real repo root).
WorkingDirectory=@ORION_ROOT@
Environment=PYTHONPATH=@ORION_ROOT@
Environment=ORION_CABINET_SENSORS_PATH=/run/orion-sensors/latest.json
EnvironmentFile=-/etc/default/orion-cabinet-sensors
ExecStart=@ORION_ROOT@/venv/bin/python @ORION_ROOT@/scripts/orion_cabinet_sensor_reader.py
Restart=always
RestartSec=2
# dialout/plugdev membership is granted by udev + setup script; override User in
# /etc/default/orion-cabinet-sensors if the Athena operator account differs.
User=athena
Group=plugdev
SupplementaryGroups=dialout
Nice=5

[Install]
WantedBy=multi-user.target
