[Unit]
Description=Nightly Orion database backups

[Timer]
# 05:00 Mountain time, every day (2026-11-05, Juniper: "push the database backup to
# 5am"). The host clock is UTC; the zone keeps it at 05:00 local through MST and MDT.
# 03:45 UTC was 20:45/21:45 Mountain, in the evening: a running pg_dump defers
# post-pull migrations and holds deploys (scripts/apply_post_pull_migrations.py).
OnCalendar=*-*-* 05:00:00 America/Denver
Persistent=true
Unit=orion-backup-databases.service

[Install]
WantedBy=timers.target
