# Copy to .env and tune. See README.md for operator checklist.
# This service runs on circe ONLY -- it shells out to circe's own docker
# socket to flip GPU1 between orion-affectgpt-worker and the atlas-agent
# llama.cpp worker. It must never be deployed anywhere else: the whole
# point is being co-located with the docker daemon that owns those
# containers.

LOG_LEVEL=INFO
NODE_NAME=circe

ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
# Central bus, reachable from any node via tailscale -- CLAUDE.md mandate:
# always the tailscale node IP, never bus-core/redis/localhost.
ORION_BUS_URL=redis://100.92.216.81:6379/0
HEARTBEAT_INTERVAL_SEC=10

# REQUIRED for the flip endpoint to work at all -- POST /v1/gpu-lane/flip
# fails closed (503) with this unset. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"` and set the
# SAME value on cortex-exec's GPU_LANE_CONTROLLER_TOKEN (athena) so it can
# call this service. Never commit the real value.
GPU_LANE_CONTROLLER_TOKEN=

GPU_LANE_CONTROLLER_HOST_PORT=8090

# circe's own checkout path on the HOST filesystem (used by
# docker-compose.yml's bind mount, NOT read by the app itself) -- confirmed
# live at /mnt/scripts/Orion-Sapienform. Only change this if circe's
# checkout ever moves.
GPU_LANE_HOST_REPO_ROOT=/mnt/scripts/Orion-Sapienform
