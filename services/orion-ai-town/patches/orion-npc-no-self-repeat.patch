+// Returned from continueConversationMessage when an exact self-repeat is exhausted.
+// agentGenerateMessage turns this into leaveConversationMessage + leave.
+// Must not be a normal spoken line (clampTownReply never invents this token).
+export const SELF_REPEAT_LEAVE_SENTINEL = '__orion_self_repeat_leave__';
+
+function normalizeTownLine(text: string): string {
+  return text
+    .toLowerCase()
+    .replace(/[^a-z0-9\s]/g, ' ')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+function ownPriorLines(messages: LLMMessage[], playerName: string): string[] {
+  const prefix = `${playerName} to `;
+  const out: string[] = [];
+  for (const m of messages) {
+    const content = typeof m.content === 'string' ? m.content : '';
+    if (!content.startsWith(prefix)) {
+      continue;
+    }
+    const idx = content.indexOf(': ');
+    if (idx < 0) {
+      continue;
+    }
+    const line = content.slice(idx + 2).trim();
+    if (line) {
+      out.push(line);
+    }
+  }
+  // Only the last few own lines — short tokens like "ok"/"thanks" from early
+  // in a long chat should not force leave forever.
+  return out.slice(-4);
+}
+
+function isSelfRepeat(reply: string, ownLines: string[]): boolean {
+  const norm = normalizeTownLine(reply);
+  if (!norm) {
+    return false;
+  }
+  return ownLines.some((line) => normalizeTownLine(line) === norm);
+}
+
