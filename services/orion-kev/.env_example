# ───────────────────────────────────────────────
# Orion Kev (TypeSafe System One compatible)
# ───────────────────────────────────────────────
# Kev runs on circe (2026-10-15), beside the fast + metacog llama.cpp lanes.
PROJECT=orion-circe
SERVICE_NAME=kev
SERVICE_VERSION=0.1.0

# Host port. orion-substrate-runtime on athena calls it across Tailscale:
# SUBSTRATE_SYSTEM_ONE_BASE_URL=http://100.112.254.99:8009.
KEV_HOST_PORT=8009

# Host nvidia-smi index on circe. 3 = V100-SXM2-32GB, shared with the fast
# (:8013) and metacog (:8012) lanes (~15GB together). Kev uses ~4GB. The GPU
# pool knows this tenant as role `kev` in config/gpu_pool.yaml (gpu3); move
# both together.
KEV_GPU_DEVICE_ID=3

# Hugging Face hub cache on the host (weights persist across rebuilds).
KEV_HF_CACHE_HOST_DIR=/mnt/scripts/kev/.hf-cache

# Hub model id passed to kev.serve --run (image CMD default matches).
KEV_MODEL=jaredpalmer/kev-0.8b
