# ───────────────────────────────────────────────
# 🧠 Orion Whisper, TTS
# ───────────────────────────────────────────────

SERVICE_NAME=whisper-tts
SERVICE_VERSION=0.1.0

# Bus (usually already defined at project root, but safe to override here)
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
ORION_BUS_URL=redis://100.92.216.81:6379/0

# TTS intake (Hub → TTS)
CHANNEL_TTS_INTAKE=orion:tts:intake

# Non-interactive Coqui CPML acceptance (required for XTTS download/load)
COQUI_TOS_AGREED=1

# TTS backend (coqui today; fish_speech_http / f5_tts_http later)
TTS_BACKEND=coqui
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
TTS_USE_GPU=true
TTS_DEFAULT_LANGUAGE=en
# Mode 1 — built-in XTTS speaker (list inside container — see README).
# Superseded by Mode 2 below whenever TTS_DEFAULT_SPEAKER_WAV is set
# (tts.py's resolve order checks speaker_wav first) -- left set as the
# fallback if the reference wav is ever removed from TTS_VOICE_PROFILE_DIR.
TTS_DEFAULT_SPEAKER=Ana Florence
# Mode 2 — reference voice cloning. Points at a .wav file OR a directory of
# .wav files, both under TTS_VOICE_PROFILE_DIR. The target must exist there
# or the FIRST SYNTHESIS REQUEST fails with "TTS speaker_wav not found" --
# the engine is built lazily, so a clean boot and a green healthcheck prove
# nothing about this path.
#
# XTTS-v2 is ZERO-SHOT: no fine-tuning, no checkpoint. The reference audio IS
# the voice, so "retraining Orion's voice" means building a new reference and
# repointing this key. Coqui conditions on at most ~30s per reference file.
#
# Live default since 2026-09-01: the orion_v3_chunks/ directory (7 files,
# 99.1s total, multi-reference -- see below). Rollback targets, both kept
# beside it on the host: orion_reference_v2.wav (the single 27.8s file that
# was the default from 2026-08-29) and orion_reference.wav before that. Point
# this key at either, then RECREATE the container ("docker compose restart"
# does NOT pick up an env_file change).
#
# Full build-and-verify procedure -- window selection, the exact ffmpeg
# chain, loudness matching, and how to prove a voice change actually took
# -- lives in README.md, "Changing the voice". Deliberately not duplicated
# here: this comment and that section had already drifted apart once.
#
# The reference audio is a host asset under TTS_VOICE_PROFILE_HOST_DIR, NOT
# checked into git -- a fresh clone/deployment must either supply its own
# reference .wav (or chunk directory) at this path first, or comment this
# line out to fall back to Mode 1's built-in speaker above.
#
# May point at a DIRECTORY instead of a file, which means MULTI-REFERENCE:
# every *.wav directly inside is passed to XTTS, which means the per-file
# speaker embeddings and concatenates them for the GPT latent. Use this to feed
# more than one clip's worth of a recording -- each reference is independently
# truncated to max_ref_len (30s in the shipped checkpoint), so one long file is
# silently cut to its first 30s while N shorter files are not. The averaging
# also cancels per-clip codec artifacts that a single clip bakes into the
# clone. Files are used in natural sort order (chunk_2 before chunk_10) and
# only the first ~30s of the concatenation reaches the prosody latent, so
# name them in the order you want them heard.
#   single reference:  /models/voices/orion_reference_v2.wav
#   multi-reference:   /models/voices/orion_v3_chunks
TTS_DEFAULT_SPEAKER_WAV=/models/voices/orion_v3_chunks
TTS_SPLIT_SENTENCES=true
TTS_VOICE_PROFILE_DIR=/models/voices
# Host path mounted read-only to TTS_VOICE_PROFILE_DIR in the container
TTS_VOICE_PROFILE_HOST_DIR=/mnt/telemetry/models/coqui/voices

# Which HOST GPU (nvidia-smi index) this container is pinned to, via
# docker-compose.yml's deploy.resources.reservations.devices.device_ids.
#
# athena has exactly one card, so 0 is correct there and is the default.
# circe has SEVEN cards and the P100-PCIE-16GB this service wants is index
# 4 -- set WHISPER_TTS_GPU_DEVICE_ID=4 in circe's own service .env.
#
# This is the host index only. Docker remaps the pinned card to
# container-local index 0, so nothing inside the container should ever be
# set to cuda:4. Verify a pin from the HOST (docker inspect DeviceIDs +
# nvidia-smi), never from a log line inside the container -- a torch device
# index that disagrees with the nvidia-smi slot has silently misreported
# the card in this repo before.
WHISPER_TTS_GPU_DEVICE_ID=0

# GPU avail from nvidia-smi
GPU_INDEX=2

# Timeouts (seconds)
CONNECT_TIMEOUT_SEC=10
READ_TIMEOUT_SEC=60
WHISPER_TTS_STT_TIMEOUT_SEC=90
WHISPER_TTS_SYNTH_TIMEOUT_SEC=120
# int16 peak below this skips Whisper (low-gain mics often peak 40–120)
STT_NEAR_SILENT_PEAK_INT16=50

# CUDA liveness watchdog (app/cuda_watchdog.py). Real incident, 2026-08-26:
# a docker+nvidia-container-toolkit staleness quirk ("Failed to initialize
# NVML: Unknown Error") left torch.cuda.is_available() silently False
# mid-uptime; Coqui TTS hard-crashed on its next real request (no CPU
# fallback) while STT kept working (it has one). A plain container restart
# fixed it. This watchdog detects that transition and restarts the process
# itself so `restart: unless-stopped` recovers automatically. Gated on
# TTS_USE_GPU -- both this and the boot-time _require_cuda_or_die() check
# are skipped entirely in a deliberate CPU-mode deployment.
CUDA_WATCHDOG_ENABLED=true
CUDA_WATCHDOG_POLL_SEC=30
# Consecutive failed checks required before restarting -- absorbs a single
# transient NVML hiccup rather than restarting on one bad poll.
CUDA_WATCHDOG_FAILURE_THRESHOLD=2
# Reject segments Whisper itself judged to be silence (its per-segment
# no_speech_prob). STT_NEAR_SILENT_PEAK_INT16 above is a cheap amplitude
# pre-filter; this is the model's own judgement, and it is what actually
# stops fabricated text reaching a chat turn. Added 2026-08-26.
STT_MAX_NO_SPEECH_PROB=0.6
