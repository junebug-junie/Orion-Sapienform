# orion-gpu-pool — one lease queue for every GPU on circe.
# Spec: docs/superpowers/specs/2026-09-24-gpu-pool-design.md
# Rules (cards, roles, borrowing, priorities, grace) live in config/gpu_pool.yaml, not here.
PROJECT=orion-athena
SERVICE_NAME=orion-gpu-pool
SERVICE_VERSION=0.1.0
NODE_NAME=athena
LOG_LEVEL=INFO
GPU_POOL_PORT=8127

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10
RPC_HEALTH_PUBLISH_ENABLED=true
RPC_HEALTH_PUBLISH_INTERVAL_SEC=30

# Same database as durable-runs; apply services/orion-sql-db/manual_migration_gpu_pool_v1.sql first.
POSTGRES_URI=

# observe = discovers, answers leases, publishes state; swap decisions are published, never actuated.
GPU_POOL_MODE=observe
GPU_POOL_TICK_SEC=1.0
GPU_POOL_PROBE_INTERVAL_SEC=15.0
GPU_POOL_PROBE_TIMEOUT_SEC=3.0
# A worker announces every 30s; after this long without one its port reads "silent" (no grants).
GPU_POOL_ANNOUNCE_STALE_SEC=120.0
GPU_POOL_STATE_PUBLISH_SEC=5.0
GPU_POOL_REPLAY_PAYLOAD_MAX_BYTES=262144
# A lease that ended (released or unavailable) is forgotten after this long: its checkpoint
# history (~30 KB) and its row in gpu_pool_leases. Tens of thousands of leases a day. Backfill
# replay and the Hub walker reach back this far; dead letters are kept for operator replay.
# The Hub's historical traffic views read gpu_pool_events (30-day retention), not these.
GPU_POOL_LEASE_RETENTION_HOURS=168

# Stage 4.3 swap actuation. Comma-separated swap seats (config/gpu_pool.yaml roles with swap +
# launch) the pool loads/unloads itself by sending GpuActuateV1 to the seat's host actuator.
# EMPTY = actuation OFF: every swap decision stays a published swap_requested {actuated: false}.
# Set to agent-gpu2 only at the stage 4.5 cutover, after circe's controller runs GPU2_AUTHORITY=pool.
GPU_POOL_ACTUATE_ROLES=
# Swap-load guards (config/gpu_pool.yaml swap.guards), read every GPU_POOL_GUARD_REFRESH_SEC outside
# the lease lock. A guard that cannot be read blocks loads (swap_requested reason=guard:<name>).
GPU_POOL_CABINET_URL=http://100.92.216.81:8080/api/cabinet/sensors/latest
# Stage-4-only: deleted when the visual chain moves onto diffusion leases (stage 5).
GPU_POOL_VISUAL_ACTIVITY_URL=http://orion-athena-thought:7155/visual-chain/activity
GPU_POOL_GUARD_REFRESH_SEC=30
