# Copy to .env and tune for your node.
# See README.md -- this service now loads a real diffusion model at startup
# (follow-up to Patch 1) and answers POST /generate. Model choice/steps/
# guidance are tuned to the currently-configured model's documented
# operating point (settings.py) -- changing DIFFUSION_MODEL_ID without
# also revisiting DIFFUSION_NUM_INFERENCE_STEPS/DIFFUSION_GUIDANCE_SCALE
# will silently produce degraded output on a different checkpoint.
#
# 2026-08-28: sdxl-turbo REPLACED by FLUX.1-schnell -- real root-cause fix
# for the 77-token CLIP-only text-encoder ceiling (design doc §18/19). See
# settings.py's own extensive comment for the full rationale (gated
# official repo vs. verified-ungated mirror, fp16 not bf16 -- Volta/
# PG500-216 has no Ampere+ bf16 tensor-core support, caught by review --
# CPU offload VRAM math, 4 steps + 1024x1024 as schnell's real operating
# point).

LOG_LEVEL=INFO
NODE_NAME=circe

# Circe's existing "agent lane" GPU worker slot (services/orion-llamacpp-host's
# 4-slot convention: chat 8011 / metacog 8012 / quick 8013 / agent 8014).
# This service claims that slot's port and physical GPU (device index 2) --
# reassigned 2026-08-20 per Juniper. As of 2026-08-25 the llama.cpp
# atlas-agent worker that originally sat here is gone, and a second, later
# collision -- services/orion-affectgpt-worker's compose pinned the SAME
# physical GPU 2026-08-22, two days after this assignment -- has also been
# evicted live on Circe. That service's docker-compose.yml still documents
# GPU 2 as its own designated slot; that comment is now stale and worth
# fixing so the two files stop contradicting each other. Operator must
# confirm nothing else is pinned to physical GPU 2 before bringing this
# service up, or the two will fight over the same card.
HOST_PORT=8014

# The bus IS consumed now: power-intent stage 2 publishes PowerIntentV1 on
# orion:power:intent before every generation, and orion-biometrics settles it
# against real GPU samples. This must be true or the loop is silently dead --
# OrionBusAsync.publish() early-returns when disabled, so the producer logs
# `power_intent_declared` and nothing ever reaches the wire. Found exactly
# that way on Circe, 2026-08-29: power_intent_settled sat at 0 rows while
# both sides logged success. Turning it on also restores this service's
# SystemHealthV1 heartbeat, which had never published either.
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
ORION_BUS_URL=redis://100.92.216.81:6379/0
HEARTBEAT_INTERVAL_SEC=10

# Model cache dir convention: storage-warm, not vision-host's telemetry
# convention -- see README.md "Model cache dir convention" for why.
MODEL_CACHE_DIR=/mnt/storage-warm/models/diffusion
HF_HOME=/mnt/storage-warm/models/diffusion/hf
TRANSFORMERS_CACHE=/mnt/storage-warm/models/diffusion/hf/transformers

CUDA_VISIBLE_DEVICES=2

# FLUX.1-schnell (see settings.py's own comment for the full rationale on
# every value below -- ungated mirror, fp16 not bf16, CPU offload, real
# operating point).
DIFFUSION_MODEL_ID=YuCollection/FLUX.1-schnell-Diffusers
DIFFUSION_DEVICE=cuda:0
DIFFUSION_DTYPE=fp16
DIFFUSION_ENABLE_MODEL_CPU_OFFLOAD=true
DIFFUSION_NUM_INFERENCE_STEPS=4
DIFFUSION_GUIDANCE_SCALE=0.0
DIFFUSION_MAX_SEQUENCE_LENGTH=256
DIFFUSION_DEFAULT_WIDTH=1024
DIFFUSION_DEFAULT_HEIGHT=1024
DIFFUSION_MAX_PROMPT_CHARS=2000

# --- Power intent (stage 2) --------------------------------------------------------
# Declared before every generation so the settler can open a 1 Hz window on the card.
# DIFFUSION_POWER_INTENT_GPU_INDEX is the PHYSICAL nvidia-smi index (matching
# CUDA_VISIBLE_DEVICES above), NOT the container's cuda:N -- the settler runs on the
# host and nvidia-smi only knows physical indices.
DIFFUSION_POWER_INTENT_ENABLED=true
DIFFUSION_POWER_INTENT_GPU_INDEX=2
DIFFUSION_POWER_INTENT_DURATION_SEC=20.0
DIFFUSION_POWER_INTENT_DEADLINE_MARGIN_SEC=40.0
