# ───────────────────────────────────────────────────────────────
# ✍️  Orion SQL Writer
# ───────────────────────────────────────────────────────────────
#
# Mesh compose (from repo root; root .env supplies ORION_BUS_URL, PROJECT, NET, …):
#   docker compose --env-file .env --env-file services/orion-sql-writer/.env \
#     -f services/orion-sql-writer/docker-compose.yml up -d --build
#

# Identity
SERVICE_NAME=sql-writer
SERVICE_VERSION=0.4.0
#NODE_NAME=athena
PORT=8220
#PROJECT=orion-athena
#NET=app-net

# --- Bus ---
ORION_BUS_ENABLED=true
# ORION_BUS_URL — set in repo root .env (mesh global)
ORION_HEARTBEAT_INTERVAL_SEC=10.0
ORION_ERROR_CHANNEL=orion:system:error
ORION_SHUTDOWN_GRACE_SEC=10.0

# --- Routing ---
# Wrap the JSON list in single quotes (so commas don't break your shell)
# Legacy spark introspection channel is disabled by default. Re-add to subscribe explicitly if needed.
# Grammar atlas ledger: orion:grammar:event (grammar.event.v1) is in the default subscribe list below.
SQL_WRITER_SUBSCRIBE_CHANNELS=["orion:tags:enriched","orion:collapse:sql-write","orion:metacog:sql-write","orion:repair_pressure:appraisal","orion:vision:events:sql-write","orion:vision:inventory:sql-write","orion:chat:history:log","orion:chat:history:turn","orion:chat:social:turn","orion:chat:response:feedback","orion:bridge:social:room:intake","orion:bridge:social:room:delivery","orion:bridge:social:room:skipped","orion:bridge:social:participant","orion:chat:gpt:log","orion:chat:gpt:turn","orion:chat:gpt:message:log","orion:chat:gpt:import:run","orion:chat:gpt:conversation","orion:chat:gpt:example","orion:dream:log","orion:telemetry:biometrics","orion:biometrics:summary","orion:biometrics:cluster","orion:power:intent:settled","orion:cabinet:ambient:spike","orion:home:cooling:sample","orion:office:env:sample","orion:biometrics:induction","orion:spark:telemetry","orion:cognition:trace","orion:thought:artifact","orion:harness:run:artifact","orion:harness:verdict:artifact","orion:substrate:turn_outcome","orion:substrate:post_turn_closure","orion:cockpit:hop","orion:metacognition:tick","orion:equilibrium:metacog:trigger","orion:metacog:trace","orion:notify:persistence:request","orion:notify:persistence:receipt","orion:journal:write","orion:self_study:items:write","orion:attention:schema","orion:curiosity:peer:brief","orion:curiosity:supervisor:reading","orion:durable:run:state","orion:gpu_pool:event","orion:gpu_pool:state","orion:physiology:state","orion:physiology:want:decision","orion:equilibrium:transport_baseline:hourly","orion:field_channel:anomaly_score","orion:journal:index","orion:evidence:index:upsert","orion:evidence:markdown:ingest","orion:evidence:parsed:ingest","orion:endogenous:runtime:record","orion:endogenous:runtime:audit","orion:calibration:profile:audit","orion:world_pulse:run:result","orion:world_pulse:digest:created","orion:world_pulse:digest:item","orion:world_pulse:article:emit","orion:world_pulse:cluster:emit","orion:world_pulse:claim:emit","orion:world_pulse:event:emit","orion:world_pulse:entity:emit","orion:world_pulse:situation:brief:upsert","orion:world_pulse:situation:change:emit","orion:world_pulse:learning:emit","orion:world_pulse:worth:reading","orion:world_pulse:worth:watching","orion:world_context:daily_capsule","orion:world_pulse:publish:status","orion:hub:messages:create","orion:mind:artifact","orion:grammar:event","orion:equilibrium:transition","orion:chat:history:spark_meta:patch","orion:autonomy:action:outcome","orion:causal_geometry:snapshot","orion:substrate:dev_economics_ledger","orion:substrate:doc_semantic_drift","orion:substrate:juniper_affective_state","orion:affectgpt:assessment","orion:chat_stance:belief:write","orion:self_concept:history:write","orion:personality:naming","orion:self_sense:eval:write","orion:vision:crops:sql-write","orion:vision:unresolved:sql-write","orion:energy:usage:observed","orion:energy:cost:accrued","orion:energy:run_cost:estimated","orion:energy:importer:status","orion:energy:stakes:snapshot","orion:energy:reconcile","orion:energy:bill:forecast","orion:energy:bill:actual","orion:equilibrium:self_signal:hour","orion:equilibrium:self_signal:outcome_association","orion:llm:call:usage"]

SQL_WRITER_ENABLE_SPARK_SNAPSHOT_CHANNEL=true
# Set false to skip orion:grammar:event when grammar_events table is degraded.
SQL_WRITER_ENABLE_GRAMMAR_CHANNEL=true
SPARK_LEGACY_MODE=drop

# Concurrent Hunter handlers + bounded DB inflight (grammar is async-isolated).
SQL_WRITER_CONCURRENT_HANDLERS=true
SQL_WRITER_MAX_INFLIGHT=12
SQL_WRITER_DB_POOL_SIZE=10
SQL_WRITER_DB_MAX_OVERFLOW=20

# Grammar lane: isolated pool + trace-id sharded workers (does not share operational write semaphore).
SQL_WRITER_GRAMMAR_WORKERS=4
SQL_WRITER_GRAMMAR_POOL_SIZE=4
SQL_WRITER_GRAMMAR_POOL_MAX_OVERFLOW=4
SQL_WRITER_GRAMMAR_STATEMENT_TIMEOUT_MS=10000
SQL_WRITER_GRAMMAR_LOCK_TIMEOUT_MS=3000
# 2026-08-19: dropped 30->15 days. Previously never actually enforced (missing
# index -> full scan -> statement timeout on every startup); see
# idx_grammar_events_created_at in manual_migration_grammar_atlas.sql and
# services/orion-sql-writer/README.md's "Grammar/substrate table retention" section.
GRAMMAR_EVENTS_RETENTION_DAYS=3
# batch_size 5000->1000, max_batches 20->100 (2026-08-19, live-verified): the DELETE's
# per-row primary-key lookup is real random I/O on grammar_events at this scale (8
# indexes, 16GB) -- a 5000-row batch measured at 20.6s, well past the 10s grammar
# statement timeout. 1000/batch leaves real margin; 100 max batches means
# MAX_ELAPSED_SEC below is what actually stops a run, gracefully, instead of an
# oversized batch dying mid-delete. See settings.py for the full writeup.
GRAMMAR_EVENTS_RETENTION_BATCH_SIZE=1000
GRAMMAR_EVENTS_RETENTION_MAX_BATCHES_PER_STARTUP=100
GRAMMAR_EVENTS_RETENTION_MAX_ELAPSED_SEC=120
# grammar_edges/grammar_atoms/substrate_organ_emissions had no retention at all
# before this patch. Reuse the batch/cap knobs above (same scale, same shape);
# only the retention window is independently configurable per table.
GRAMMAR_EDGES_RETENTION_DAYS=3
GRAMMAR_ATOMS_RETENTION_DAYS=3
SUBSTRATE_ORGAN_EMISSIONS_RETENTION_DAYS=3
# grammar_traces is the PARENT row the Grammar Atlas lists and then expands. It was left
# out above, so its children were pruned at 3 days while the trace rows lived forever:
# measured live 2026-08-20, 205,465 of 487,970 traces (42%) already had zero atoms and
# rendered as empty graphs. Keep this equal to the child windows -- a different value
# just re-creates the mismatch in one direction or the other.
GRAMMAR_TRACES_RETENTION_DAYS=3

# substrate_proposal_frames retention (2026-08-20). This table had NO bound at all: 474,230
# rows / 1,758 MB live, oldest 2026-07-23, growing ~27k rows and ~105 MB a day.
#
# 10 days rather than 7 because two live readers reach back further than a week:
# orion/autonomy/evals/run_attention_bound_proposal_eval.py uses a 7-day window, and
# scripts/analysis/measure_proposal_feedback_correlation.py defaults to 200h (8.33 days).
# A 7-day retention window would race both at their oldest edge, and both degrade quietly to
# "insufficient data" rather than failing. Measured live: 10 days keeps 202,276 of 474,861
# rows; 7 days would have kept 113,060. Roughly 105 MB per extra day.
#
# This is a history/inspection choice, not a correctness one -- correctness is held by the
# pipeline's pending markers (policy_pending / dispatch_pending / feedback_pending), which pin
# retention behind any proposal a later stage still owes work on, no matter how old.
#
# NOTE: pruning does not shrink the file on disk. ~84% of this table's bytes are TOAST
# (1,471 MB of 1,760 MB); DELETE returns that space for reuse inside the relation, not to the
# OS. The win here is bounding future growth, not reclaiming what is already allocated.
# 0 disables retention for this table entirely.
SUBSTRATE_PROPOSAL_FRAMES_RETENTION_DAYS=10
# Fleet power history (orion_biometrics_cluster). ~2,880 rows/day at the ~30s cluster
# publish cadence, so 30 days is ~86k small rows. This is the ONLY store of the fleet
# total -- per-node rows cannot substitute, because circe's watts exist only as a
# proxied reading athena takes on its behalf.
ORION_BIOMETRICS_CLUSTER_RETENTION_DAYS=30
# Settled power intents. Small and slow-growing (one row per declared workload run),
# but bounded from day one like every other table here.
POWER_INTENT_SETTLED_RETENTION_DAYS=90
# Attention schema surface (substrate_attention_schema): one row per attention event
# from four producers (substrate tick ~30s, reverie chain, curiosity run, chat turn).
# 90 days, not the self-model table's 7: the design doc's Missing Question 4 found a
# 168h window expires the control windows the blind-rater check needs, and the sparse
# lanes need history to stratify. 0 disables.
SUBSTRATE_ATTENTION_SCHEMA_RETENTION_DAYS=90
# Contractor peer briefs (curiosity_peer_brief): one row per PeerBrief. Sparse;
# 90 days like attention schema. 0 disables.
CURIOSITY_PEER_BRIEF_RETENTION_DAYS=90
# Curiosity supervisor hop readings (curiosity_hop_reading): one row per Hop
# the supervisor has read. 90 days like its curiosity siblings. 0 disables.
CURIOSITY_HOP_READING_RETENTION_DAYS=90
# Durable cognition runs (substrate_durable_run_state): a few rows per curiosity run.
SUBSTRATE_DURABLE_RUN_STATE_RETENTION_DAYS=90
# GPU lease events and minimal state snapshots (one snapshot every 5s).
GPU_POOL_EVENTS_RETENTION_DAYS=30
GPU_POOL_STATE_HISTORY_RETENTION_DAYS=30
# Self-signal -> outcome associations (self_signal_outcome_association): ~21 rows/hour from
# orion-equilibrium-service. Readers use only the last few hours; 30 days of history. 0 disables.
SELF_SIGNAL_OUTCOME_ASSOCIATION_RETENTION_DAYS=30

# Periodic retention (2026-08-20). Retention used to run ONLY at process start, so it
# deleted ~365,000 rows per restart and then nothing, against 1,117,440 rows/day of
# arrival -- it could not converge no matter how the caps above were tuned. These knobs
# run the same bounded pass on a timer. 0 disables the timer -- which as of 2026-08-20 does
# NOT 'revert to startup-only': the startup pass was removed and this is the only retention
# path, so 0 means nothing is ever pruned from any of the six tables.
GRAMMAR_RETENTION_INTERVAL_SEC=60
# Per-table caps. Small on purpose: the old startup pass at full speed was measured driving
# host I/O stall to ~21%, and this service shares a disk with everything else on athena.
# 3,000 rows per cycle per table. The loop sleeps 60s AFTER each cycle, so the real period
# is 60s + cycle duration (~68s measured), giving ~1,329 cycles/day = ~3.99M rows/day of
# capacity per table -- not the 4.32M a naive 1,440-cycle day suggests. Measured arrival is
# ~1.49M rows/day across all six (events 795k, edges ~226k, atoms ~226k, organ ~181k,
# traces ~27k, proposal_frames ~39k).
#
# Measured live 2026-08-20: grammar_events stops on the BATCH cap, using 1.08-3.33s of its
# per-table budget across three consecutive cycles. Net of arrival its 4.13M-row backlog
# drains in ~31 hours (not the ~26h an arrival-free calculation gives). Raising the batch cap
# to 10 would cut that at ~3.3x the delete I/O -- deliberately not done; converging in a day
# is not worth buying with that on this host. Raise it only with an I/O measurement in hand,
# AND raise MAX_CYCLE_SEC with it: at 1.11s/batch, 10 batches needs ~11.1s, which is above
# the 7.5s fair share a 45s budget gives the first of six tables.
GRAMMAR_RETENTION_PERIODIC_MAX_BATCHES=3
GRAMMAR_RETENTION_PERIODIC_MAX_ELAPSED_SEC=20
# Bounds the WHOLE cycle, where the two above bound one table each. Without it, six tables x
# a 20s per-table cap is a 120s cycle on a 60s timer, with nothing saying so. Split as a fair
# share across the tables that still have a window, so whichever table is earliest in the list
# and has debt cannot starve the ones behind it. (Not a hypothetical: substrate_proposal_frames
# is LAST and was measured at 8.21s with 109,585 rows of debt during its own backfill, in a
# cycle where grammar_events took 1.08-3.33s.)
#
# 0 or negative disables the cycle bound -- each table then gets the full per-table cap with
# nothing bounding the cycle. The loop logs a WARNING when this happens. Retention still runs;
# only the cycle bound is off.
GRAMMAR_RETENTION_PERIODIC_MAX_CYCLE_SEC=75
# Do not subscribe sql-writer to orion:grammar:accepted-pressure unless explicitly intended.
SQL_WRITER_ALLOW_ACCEPTED_PRESSURE_INGEST=false
SQL_WRITER_GRAMMAR_TRACE_BATCH_MAX=64
# Per-lane queue depth. Kept small ON PURPOSE: the queue is in memory and lost on restart, so
# overflow goes straight to durable bus_fallback_log and the drain replays it. Don't raise it.
SQL_WRITER_GRAMMAR_QUEUE_MAXSIZE=512
# Act ledger (rung 2 "doing on one track"): materialise act_opened/act_closed grammar events into
# grammar_acts and grade closed acts into substrate_action_outcomes + effect posteriors.
SQL_WRITER_ACT_LEDGER_ENABLED=true
# Horizon resolver cadence (s): closes juniper_replied acts from chat_history_log and expires
# producer-reported acts past their horizon. 0 disables.
SQL_WRITER_ACT_RESOLVER_INTERVAL_SEC=60
# Hourly kWh per Orion power source (nodes + cabinet cooling) into orion_energy_hourly, kept
# after raw cluster watts are pruned; read by the Hub Orion energy tab. 0 disables.
ORION_ENERGY_ROLLUP_INTERVAL_SEC=600
# Body economy weight source (a): per grammar_acts act, was its output cited by a later decision
# (thought_decision.day_citations -> arc evidence_refs) within 72 h -> act_downstream_use. 0 disables.
ACT_DOWNSTREAM_USE_INTERVAL_SEC=900
# Rung 3: stamp an act with the workspace winner it answers (hub.chat_reply <- world:chat) and write
# Orion's own non-final `acted` verdict on that loop when the act closes (attention_loop_outcome,
# actor='orion'). false -> no stamping, no Orion loop verdicts.
SQL_WRITER_ACT_WORKSPACE_BINDING_ENABLED=true
# Seconds between replays of "grammar queue full" rows while lanes are idle. 0 disables.
SQL_WRITER_GRAMMAR_DRAIN_INTERVAL_SEC=30
SQL_WRITER_GRAMMAR_DRAIN_BATCH=200

# Wrap the JSON map in single quotes.
# Map: envelope.kind -> MODEL_MAP key in services/orion-sql-writer/app/worker.py.
# Omitted kinds merge with DEFAULT_ROUTE_MAP in app/settings.py at startup (env overrides defaults).
# mind.run.artifact.v1 -> MindRunSQL (must subscribe to orion:mind:artifact).
# grammar.event.v1 -> GrammarEventSQL (subscribe to orion:grammar:event).
# equilibrium.service.transition.v1 -> EquilibriumServiceTransitionSQL (historical
# downtime persistence, must subscribe to orion:equilibrium:transition -- a
# separate channel from orion:equilibrium:snapshot on purpose, see that
# channel's own comment in orion/bus/channels.yaml).
SQL_WRITER_ROUTE_MAP_JSON={"collapse.mirror":"CollapseMirror","collapse.mirror.entry.v2":"CollapseMirror","metacog.entry.v1":"MetacogEntry","repair_pressure.appraisal.v1":"RepairPressureAppraisalLog","collapse.enrichment":"CollapseEnrichment","tags.enriched":"CollapseEnrichment","chat.history":"ChatHistoryLogSQL","chat.log":"ChatHistoryLogSQL","chat.history.message.v1":"ChatMessageSQL","chat.response.feedback.v1":"ChatResponseFeedbackSQL","chat.gpt.log.v1":"ChatGptLogSQL","chat.gpt.turn.v1":"ChatGptLogSQL","chat.gpt.message.v1":"ChatGptMessageSQL","chat.gpt.import.run.v1":"ChatGptImportRunSQL","chat.gpt.conversation.v1":"ChatGptConversationSQL","chat.gpt.example.v1":"ChatGptDerivedExampleSQL","dream.log":"Dream","dream.result.v1":"Dream","biometrics.telemetry":"BiometricsTelemetry","biometrics.summary.v1":"BiometricsSummarySQL","biometrics.cluster.v1":"BiometricsClusterSQL","power.intent.settled.v1":"PowerIntentSettledSQL","cabinet.ambient.spike.v1":"CabinetAmbientSpikeSQL","home.cooling.sample.v1":"HomeCoolingSampleSQL","office.env.sample.v1":"OfficeEnvSampleSQL","biometrics.induction.v1":"BiometricsInductionSQL","causal.geometry.snapshot.v1":"CausalGeometrySnapshotSQL","spark.telemetry":"SparkTelemetrySQL","spark.state.snapshot.v1":"SparkTelemetrySQL","cognition.trace":"CognitionTraceSQL","thought.event.v1":"ThoughtDecisionSQL","harness.run.v1":"HarnessTurnTraceSQL","harness.verdict.molecule.v1":"HarnessTurnTraceSQL","harness.turn.outcome.v1":"HarnessTurnTraceSQL","harness.post_turn.closure.v1":"HarnessTurnTraceSQL","metacognition.tick.v1":"MetacognitionTickSQL","orion.metacog.trigger.v1":"MetacogTriggerSQL","metacognitive.trace.v1":"MetacognitiveTraceSQL","notify.notification.request.v1":"NotificationRequestDB","notify.notification.receipt.v1":"NotificationReceiptDB","notify.recipient.update.v1":"RecipientProfileDB","notify.preference.update.v1":"NotificationPreferenceDB","journal.entry.write.v1":"JournalEntrySQL","journal.entry.index.v1":"JournalEntryIndexSQL","evidence.unit.v1":"EvidenceUnitSQL","social.turn.v1":"SocialRoomTurnSQL","external.room.message.v1":"ExternalRoomMessageSQL","external.room.post.result.v1":"ExternalRoomMessageSQL","external.room.turn.skipped.v1":"ExternalRoomMessageSQL","external.room.participant.v1":"ExternalRoomParticipantSQL","endogenous.runtime.record.v1":"EndogenousRuntimeRecordSQL","endogenous.runtime.audit.v1":"EndogenousRuntimeAuditSQL","calibration.profile.audit.v1":"CalibrationProfileAuditSQL","world.pulse.run.result.v1":"WorldPulseRunSQL","world.pulse.digest.created.v1":"WorldPulseDigestSQL","world.pulse.digest.item.v1":"WorldPulseDigestItemSQL","world.pulse.article.emit.v1":"WorldPulseArticleSQL","world.pulse.cluster.emit.v1":"WorldPulseArticleClusterSQL","world.pulse.claim.emit.v1":"WorldPulseClaimSQL","world.pulse.event.emit.v1":"WorldPulseEventSQL","world.pulse.entity.emit.v1":"WorldPulseEntitySQL","world.pulse.situation.brief.upsert.v1":"WorldPulseSituationBriefSQL","world.pulse.situation.change.emit.v1":"WorldPulseSituationChangeSQL","world.pulse.learning.emit.v1":"WorldPulseLearningDeltaSQL","world.pulse.worth.reading.v1":"WorldPulseWorthReadingSQL","world.pulse.worth.watching.v1":"WorldPulseWorthWatchingSQL","world.context.daily.capsule.v1":"WorldPulseContextCapsuleSQL","world.pulse.publish.status.v1":"WorldPulsePublishStatusSQL","hub.messages.create.v1":"WorldPulseHubMessageSQL","mind.run.artifact.v1":"MindRunSQL","grammar.event.v1":"GrammarEventSQL","chat.history.spark_meta.patch.v1":"__patch_chat_history__","vision.event.v1":"VisionEventSQL","action.outcome.emit.v1":"ActionOutcomeSQL","substrate.dev_economics_ledger.v1":"DevEconomicsLedgerSQL","substrate.doc_semantic_drift.v1":"DocSemanticDriftSQL","juniper.affective_state.v1":"JuniperAffectiveStateSQL","affectgpt.juniper_multimodal_affect.v1":"JuniperMultimodalAffectSQL","equilibrium.service.transition.v1":"EquilibriumServiceTransitionSQL","vision.scene.inventory.v1":"VisionSceneInventorySQL","self_study.items.write.v1":"SelfKnowledgeItemLogSQL","attention.schema.v1":"AttentionSchemaSQL","curiosity.peer.brief.v1":"CuriosityPeerBriefSQL","curiosity.supervisor.reading.v1":"CuriosityHopReadingSQL","durable.run.state.v1":"DurableRunStateSQL","chat_stance.belief.write.v1":"ChatStanceBeliefLogSQL","self_concept.history.write.v1":"SelfConceptHistorySQL","personality.naming.v1":"DispositionNamingSQL","cockpit.hop.v1":"CockpitTurnSightingSQL","self_sense.eval.write.v1":"SelfSenseEvalLogSQL","vision.crop.observation.v1":"__vision_crop_observation__","vision.unresolved.v1":"VisionUnresolvedSQL","gpu_pool.event.v1":"GpuPoolEventSQL","transport_baseline.hourly.v1":"TransportBaselineHourlySQL","field_channel_anomaly.score.v1":"FieldChannelAnomalyScoreSQL","energy.usage.observed.v1":"EnergyUsageIntervalSQL","energy.cost.accrued.v1":"EnergyCostAccruedSQL","energy.run_cost.estimated.v1":"EnergyRunCostSQL","energy.bill.actual.v1":"EnergyBillActualSQL","energy.bill.forecast.v1":"EnergyBillForecastSQL","energy.reconcile.v1":"EnergyReconcileSQL","energy.stakes.snapshot.v1":"EnergyStakesSnapshotSQL","energy.importer.status.v1":"EnergyImporterStatusSQL","gpu_pool.state.v1":"GpuPoolStateSQL","physiology.state.v1":"PhysiologyStateSQL","self_signal.hour.v1":"SelfSignalHourSQL","self_signal.outcome_association.v1":"SelfSignalOutcomeAssociationSQL","physiology.want.decision.v1":"WantLedgerSQL","llm.call.usage.v1":"LlmCallUsageSQL"}

# --- DB ---
DATABASE_URL=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
POSTGRES_URI=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
ORION_HEALTH_CHANNEL=orion:system:health

SQL_WRITER_EMIT_JOURNAL_CREATED=true
SQL_WRITER_JOURNAL_CREATED_CHANNEL=orion:journal:created
SQL_WRITER_EMIT_SOCIAL_TURN_STORED=true
SQL_WRITER_SOCIAL_TURN_STORED_CHANNEL=orion:chat:social:stored
SQL_WRITER_EMIT_MEMORY_TURN_PERSISTED=true
# One memory turn publish per turn: an assistant message waits this long for the turn envelope.
SQL_WRITER_MEMORY_TURN_ROW_EMIT_DELAY_SEC=5.0
CHANNEL_MEMORY_TURN_PERSISTED=orion:memory:turn:persisted
CHANNEL_CHAT_HISTORY_SPARK_META_PATCH=orion:chat:history:spark_meta:patch
# AI Town chat-history table split (docs/superpowers/specs/
# 2026-08-18-aitown-concept-graph-split-and-atlas-readability-design.md).
# Routes each AI-Town row to aitown_chat_history_log ONLY (never also
# chat_history_log) -- replaced the additive dual-write bridge
# (SQL_WRITER_AITOWN_DUAL_WRITE_ENABLED) the same day it shipped, once AI
# Town's own backend was confirmed dead (zero concurrent-write risk).
# Defaults true. false is a real rollback: every row goes to
# chat_history_log only, pre-split behavior.
SQL_WRITER_AITOWN_ROUTING_ENABLED=true
METACOG_TRACE_RETENTION_DAYS=14
# DRIVE_AUDITS_RETENTION_DAYS removed 2026-08-13: drive_audits table and its
# whole orion-sql-writer write path were fully removed that day. See
# docs/superpowers/pr-reports/2026-08-13-untangle-drive-audit-sql-writer-pr.md.

# Postgres statement_timeout (ms) on every sql-writer connection; 0 disables.
SQL_WRITER_DB_STATEMENT_TIMEOUT_MS=30000
# Postgres lock_timeout (ms) on every sql-writer connection; 0 disables.
SQL_WRITER_DB_LOCK_TIMEOUT_MS=10000
# Max seconds to wait for grammar_events ledger persist before cancel + fallback + next message.
SQL_WRITER_GRAMMAR_PERSIST_TIMEOUT_SEC=15

# --- bus_fallback_log backlog watcher (app/fallback_watch.py) ---
# Alerts (Hub in_app + email) when unrouted events pile up in bus_fallback_log.
# Nothing watched this table until 2026-08-14, which is how two separate routing
# failures each ran for hours while every surface reported healthy. ON by
# default -- a monitor that ships disabled is a monitor that is off in prod.
SQL_WRITER_FALLBACK_WATCH_ENABLED=true
SQL_WRITER_FALLBACK_WATCH_INTERVAL_SEC=300
# Trailing window the count is taken over. 24h, not minutes: the real incidents
# dribbled a few events per hour, and a short window never accumulates enough to
# cross a threshold before someone notices by hand anyway.
SQL_WRITER_FALLBACK_WATCH_WINDOW_SEC=86400
# One alert per multiple crossed: 5, then 10, then 15, ... The high-water mark
# is persisted in bus_fallback_alert_state and ratchets back down as the backlog
# drains, so recovery re-arms the lower levels.
SQL_WRITER_FALLBACK_WATCH_THRESHOLD_STEP=5

# --- storage-write organ (app/write_health.py) ---
# The writer counts its own write outcomes (committed / duplicate / failed by
# class) per target table and publishes one grammar trace per window
# (trace prefix sql_writer.storage:) on orion:grammar:event. substrate-runtime's
# storage_write reducer turns it into write_failure_pressure on
# node:substrate.storage_write -> capability:storage reliability_pressure.
# Counts and class names only, never payloads.
SQL_WRITER_WRITE_HEALTH_ENABLED=true
SQL_WRITER_WRITE_HEALTH_WINDOW_SEC=60

# Notify service, used ONLY by the watcher above. This service already persists
# notify records (models/notify_models.py); it had never sent one until now.
#
# Host is the compose SERVICE name "notify", not the container name
# "orion-athena-notify" and not the directory name "orion-notify". Both of those
# have already broken this exact URL in other services -- see the comment block
# in services/orion-notify-digest/.env_example. Verified live 2026-08-14 from
# inside orion-athena-sql-writer: `notify` resolves and /health returns ok.
NOTIFY_SERVICE_URL=http://notify:7140
NOTIFY_API_TOKEN=

# --- Object permanence sweep -------------------------------------------------
# Timer-driven, separate from the per-frame path -- see
# app/vision_object_permanence.py's module docstring for why a departure
# cannot be event-triggered. Reuses POSTGRES_URI (this service's own primary
# DB connection), no separate key needed.
VISION_PERMANENCE_SWEEP_INTERVAL_SEC=1800
VISION_PERMANENCE_LOOKBACK_CEILING_SEC=3600
VISION_PERMANENCE_ABSENCE_FRACTION=0.1
VISION_PERMANENCE_MIN_ABSENCE_SEC=3600
VISION_PERMANENCE_MAX_ABSENCE_SEC=86400

# --- Walkway camera reducers -------------------------------------------------
# docs/superpowers/specs/2026-09-22-walkway-camera-busy-world-design.md.
# Requires services/orion-sql-db/manual_migration_walkway_camera_v1.sql; until
# it is applied both loops log "migration not applied" and back off (no crash).
# Interval 0 disables a loop. Zones come from config/vision_zones.yaml
# (override path with VISION_ZONES_PATH).
#
# Individuals: crop embeddings -> "the same one again" -> sightings,
# attention score, asks to Juniper, patio presence (count only), retention.
VISION_INDIVIDUALS_INTERVAL_SEC=60
# Re-identification line: body cosine needed to join ANY existing individual
# (after a gap, anywhere). 0.90 since 2026-10-16: a centroid averaged over
# several people scores ~0.84-0.87 against a new person, so a lower line lets
# mixed individuals keep growing (docs/superpowers/specs/2026-10-16-vision-body-match-proposal.md).
VISION_INDIVIDUALS_MATCH_THRESHOLD=0.90
# Continuation lane: a crop within MAX_DISP box heights (centre distance) of an
# individual's last box, seen at most GAP_SEC ago (capped at the merge gap),
# joins the best such individual at body cosine >= THRESHOLD.
# Roll back to the pre-2026-10-16 rule exactly: ENABLED=false and MATCH_THRESHOLD=0.80.
VISION_INDIVIDUALS_CONTINUATION_ENABLED=true
VISION_INDIVIDUALS_CONTINUATION_THRESHOLD=0.88
VISION_INDIVIDUALS_CONTINUATION_GAP_SEC=10
VISION_INDIVIDUALS_CONTINUATION_MAX_DISP=1.5
# Faces (walkway person crops): face cosine similarity at/above this wins
# assignment over appearance. <= 0 disables face matching.
VISION_INDIVIDUALS_FACE_MATCH_THRESHOLD=0.60
# Stationary fixtures: a box that keeps IoU >= VISION_STATIONARY_IOU with its
# first box (gaps <= VISION_STATIONARY_MAX_GAP_SEC) for VISION_STATIONARY_MIN_SEC
# is a prop: no asks, attention, rhythm or head count. <= 0 min disables.
VISION_STATIONARY_MIN_SEC=1800
VISION_STATIONARY_IOU=0.5
VISION_STATIONARY_MAX_GAP_SEC=300
# Observations of one individual this close together are one sighting.
VISION_INDIVIDUALS_MERGE_GAP_SEC=60
VISION_INDIVIDUALS_BATCH_ROWS=5000
VISION_INDIVIDUALS_LOOKBACK_CEILING_SEC=3600
# Crops newer than this wait for the next tick (writes land out of order).
VISION_INDIVIDUALS_SETTLE_SEC=30
# Match candidates: individuals seen in this many days, plus every labeled one.
VISION_INDIVIDUALS_CANDIDATE_DAYS=30
VISION_CROP_RETENTION_DAYS=7
# Crop labels the prune never deletes (person crops are ~250/day, ~1 GB/year). 0 = prune every label.
VISION_CROP_RETENTION_KEEP_LABELS=person
# Person learning: albums from Juniper's answers, learned bars, "probably X" guesses. false = no writes.
VISION_PERSON_MODEL_ENABLED=true
# One record per person (docs/superpowers/specs/2026-10-22-people-one-record-design.md):
# camera names link to person rows, Juniper's answers become person facts, and
# Orion asks her about people ("Who is X to you?", pronouns, gender, ...).
PERSON_RECORD_ENABLED=true
# Person questions per local day, their own budget (0 = Orion asks none).
PERSON_FACT_ASK_DAILY_CAP=3
VISION_PERSON_FALSE_ACCEPT_ALPHA=0.05
VISION_PERSON_TOP_K=3
# Channel when faces are missing on either side: body | osnet.
VISION_PERSON_FALLBACK_CHANNEL=body
VISION_PERSON_MODEL_INTERVAL_SEC=600
VISION_SIGHTING_RETENTION_DAYS=90
# Zone head counts (patio): "present" if a non-stationary box within this many seconds, "recent" within grace.
VISION_PATIO_PRESENT_SEC=120
VISION_PATIO_GRACE_SEC=600
# Sighting score at/above this writes one vision_events attention_worthy row.
VISION_ATTENTION_THRESHOLD=0.70
# Ask Juniper about an unlabeled individual seen this often across this many days.
VISION_ASK_MIN_SIGHTINGS=10
VISION_ASK_MIN_DAYS=5
VISION_ASK_EXPIRY_DAYS=7
# Must equal orion-vision-host's value. 0 = the host keeps crop thumbnails
# forever and an ask may show any of them (Juniper 2026-10-20). A positive
# value must exceed VISION_ASK_EXPIRY_DAYS, or no "who is this?" ask opens at all
# (no picture, no ask).
VISION_CROP_THUMB_RETENTION_DAYS=0
# After an unanswered ask expires, or Juniper presses "I don't know" on a "who is
# this?" card (counted from when she pressed it), do not re-ask about that individual for this long.
VISION_ASK_COOLDOWN_DAYS=30
# The walkway camera's daily ask budget: counts only vision_individual asks in
# orion_ask since local midnight (restart-proof). Memory confirmation cards are
# capped separately (orion-memory-consolidation MEMORY_CONFIRMATION_DAILY_CAP).
ORION_ASK_DAILY_CAP=2
# Visual confirmation asks (faces). A person whose face was seen this many
# times gets "who is this?" the same day; only people with this many faces are
# compared for "are these the same person?". 0 disables both.
VISION_ASK_FACE_MIN_FACES=5
# Ask "are these the same person?" when two face centroids are at least this
# alike (cosine). Live 2026-10-15: known-different faces median 0.27, same face
# seconds apart median 0.65 (10th pct 0.39).
VISION_SAME_ASK_MIN_FACE_COSINE=0.40
# Daily cap for the face asks together (both kinds), since local midnight.
# Separate from ORION_ASK_DAILY_CAP (the 10-sightings rule).
VISION_CONFIRM_ASK_DAILY_CAP=6
# Daily cap for "Is this <name>?" asks (yes/no on an unsure person guess),
# since local midnight. Separate from ORION_ASK_DAILY_CAP: when they shared it,
# the slow rule used both slots every day and none were ever asked.
VISION_PERSON_CONFIRM_ASK_DAILY_CAP=6
# Split an individual on Juniper's "someone else" picture answers: that picture
# (and close FACE matches; body-only crops never follow) becomes a new
# individual; the side she confirmed keeps its id and name. Every split is
# recorded in vision_individual_split; scripts/undo_vision_split.py reverses one.
# false = verdicts are recorded only, nothing moves, no cannot-link in the matcher.
VISION_SPLIT_ON_VERDICT_ENABLED=true
# A member face crop follows when face cosine to the moved picture >= this and
# beats the confirmed picture's face by the margin.
VISION_SPLIT_FOLLOW_MIN_FACE_COSINE=0.60
VISION_SPLIT_FOLLOW_MARGIN=0.10
# Refuse a split that would move more than this fraction of the individual's crops.
VISION_SPLIT_MAX_MOVE_FRACTION=0.5
# Matcher cannot-link: a best face match within this cosine of an individual
# Juniper said is different does not assign by face (falls to the body rule).
VISION_INDIVIDUALS_CANNOT_LINK_MARGIN=0.10
# Local clock for "usually around 07:40", distinct days, weekday/weekend, cap day.
VISION_LOCAL_TZ=America/Denver
#
# Walkway motion stories: one plain sentence per passing thing, from box maths
# (app/vision_motion.py). HUB ONLY until Juniper's spot-check passes (>= 50
# checked, >= 80% fully right, zero wrong names). false = reducer off.
VISION_MOTION_STORIES_ENABLED=true
VISION_MOTION_STORY_INTERVAL_SEC=15
# A passage ends after this many seconds with no linked box.
VISION_MOTION_STORY_CLOSE_GAP_SEC=11
# Fewer detections = a glimpse (stored, never published).
VISION_MOTION_STORY_MIN_DETECTIONS=3
VISION_MOTION_STORY_STREAMS=walkway,doorbell
VISION_MOTION_STORY_SETTLE_SEC=30
VISION_MOTION_STORY_INITIAL_LOOKBACK_SEC=3600
VISION_MOTION_STORY_RETENTION_DAYS=90
# Box pixel space of the walkway retina. Fallback only: since 2026-10-20 each
# crop carries the detector's own frame size (vision_crop_observation.frame_width/height).
VISION_MOTION_FRAME_WIDTH=2560
VISION_MOTION_FRAME_HEIGHT=1920
# Per-stream fallback frame size, "stream=WxH,..." (e.g. doorbell=1920x1440), for
# crops written before the frame size was recorded. Empty: every stream uses the
# global size above (the doorbell's real size is not measured yet).
VISION_MOTION_FRAME_SIZE_BY_STREAM=
# A story's first/last box within this share of the frame from an edge entered/left
# through that edge (entry_edge/exit_edge); farther in it is "inside".
VISION_MOTION_EDGE_ZONE_FRAC=0.05
# Stories starting earlier are clean=false (RTSP smear before the stream fix).
VISION_MOTION_CLEAN_SINCE=2026-10-16T18:59:00Z
# Prop individuals (never a story). Default: the patio skeleton.
VISION_MOTION_PROP_INDIVIDUAL_IDS=fefb24d7e4074e9f827ad711874f6edf
# Caption motion cross-check (app/vision_caption_motion.py): a camera caption on a
# story stream that claims motion ("driving") is tagged motion_contradicted or
# motion_supported by the motion story of its own box (IoU at the frame). Readers
# then say "caption said driving; the vehicle did not move". false = off.
VISION_CAPTION_MOTION_CHECK_ENABLED=true
# Only caption rows from the last N seconds are read (older rows stay untagged).
VISION_CAPTION_MOTION_LOOKBACK_SEC=21600
# A caption box and a detector crop of the same frame are the same thing at this IoU.
VISION_CAPTION_MOTION_MIN_IOU=0.5
#
# Walkway rollups by hour, day, week and month (app/vision_rollup_loop.py):
# deterministic counts into vision_rollup (needs
# services/orion-sql-db/manual_migration_vision_rollup_v1.sql). false = off.
VISION_ROLLUP_ENABLED=true
VISION_ROLLUP_INTERVAL_SEC=300
VISION_ROLLUP_STREAMS=walkway
# A vehicle seen in this many different hours of the last 24 h is parked, not passing.
VISION_ROLLUP_PARKED_MIN_HOURS=4
# Missing hour rows are rebuilt back this far each tick.
VISION_ROLLUP_CATCHUP_HOURS=48
# Pictures of the moment for published stories (app/vision_story_strip.py):
# up to 4 crops + one boxed full frame per story, saved while the frames still
# exist (~60 s). false = no pictures (the Hub card says "no picture saved").
VISION_STORY_STRIPS_ENABLED=true
VISION_STORY_FRAMES_DIR=/mnt/telemetry/vision/frames
VISION_STORY_STRIP_DIR=/mnt/telemetry/vision/story_strips
# 0 = kept forever (Juniper 2026-10-20): a story that has a picture is never
# deleted by VISION_MOTION_STORY_RETENTION_DAYS, and no age rule removes a
# strip. A positive value: kept until this many days after the story ended AND
# it has a verdict ("Can't tell" counts); an unchecked story keeps it until
# the story row is deleted.
VISION_STORY_STRIP_RETENTION_DAYS=0
VISION_STORY_STRIP_PENDING_SEC=3600
# dark = median contrast (std of luma, 0..1) of the story's crops below this
# (measured live 2026-10-17: night crops 0.012-0.075, day and dusk >= 0.134).
VISION_STORY_STRIP_DARK_CONTRAST=0.10
# One full frame per camera per UTC hour (app/vision_hourly_frames.py), with
# index.jsonl per day: frame time, luma, and what the detector saw in the 10 min
# before it. Lets a sunny hour be compared with a grey hour after the shared
# frames dir (~5 min) has pruned them. Frames are read from
# VISION_STORY_FRAMES_DIR. Streams: stream_id=file prefix; a bare stream_id
# means retina naming <stream>_<stream>; cam0's edge names frames frame_*.
# The doorbell only has frames during Ring events, so it is sampled only then.
VISION_HOURLY_FRAMES_ENABLED=true
VISION_HOURLY_FRAMES_INTERVAL_SEC=60
VISION_HOURLY_FRAMES_DIR=/mnt/telemetry/vision/hourly_frames
# Whole days older than this are deleted (~0.3 GB at 14 days; a walkway frame
# is ~0.7 MB). 0 = keep forever.
VISION_HOURLY_FRAMES_RETENTION_DAYS=14
VISION_HOURLY_FRAMES_STREAMS=walkway,cam0=frame,doorbell
#
# Rhythm learner: predicts when things usually happen, grades met/missed/
# unscorable, sets Redis key orion:vision:expect:<stream> (on ORION_BUS_URL)
# while an expected window is open and unmet.
VISION_RHYTHM_INTERVAL_SEC=900
VISION_RHYTHM_MIN_OCCURRENCES=5
VISION_RHYTHM_MIN_DAYS=5
VISION_RHYTHM_HISTORY_DAYS=28
VISION_RHYTHM_BANDWIDTH_MIN=20
VISION_RHYTHM_MIN_CONFIDENCE=0.5
VISION_RHYTHM_MAX_PER_SUBJECT=3
# Grade a window only this long after it closes (lets the individuals reducer catch up).
VISION_RHYTHM_SCORE_LAG_SEC=600
# Watched less than this fraction of a window -> unscorable, not missed.
VISION_RHYTHM_MIN_COVERAGE=0.8
# Scene-inventory labels learned as subjects, and the streams they are read from.
# Arrival = first positive window after this many seconds without one.
VISION_RHYTHM_LABELS=vehicle,package,mail truck
VISION_RHYTHM_LABEL_STREAMS=walkway
VISION_RHYTHM_ARRIVAL_GAP_SEC=300

# Street continuity (app/vision_handoff.py, 2026-10-20): one passage across the
# door and walkway cameras (portals: config/vision_topology.yaml). Opens an
# expectation when a story leaves toward the other camera, grades it met / late /
# missed / unscorable, pairs same-moment stories on the central walk, explains
# misses, and publishes StreetEventV1 on orion:vision:street:events.
# Needs services/orion-sql-db/manual_migration_vision_handoff_v1.sql.
VISION_HANDOFF_ENABLED=true
VISION_HANDOFF_INTERVAL_SEC=15
VISION_HANDOFF_KINDS=person,dog,bicycle,stroller
VISION_HANDOFF_LOOK_KINDS=person,dog
# Learned band replaces the prior after this many arrivals (met, early or late) per portal and kind.
VISION_HANDOFF_MIN_ARRIVALS=10
# Target camera looked at less than this share of the window -> unscorable, never missed.
VISION_HANDOFF_MIN_COVERAGE=0.8
# Strong-appearance bars (cosine of story centroid vectors; body/osnet measured live 2026-10-20).
VISION_HANDOFF_MIN_FACE_COSINE=0.50
VISION_HANDOFF_MIN_BODY_COSINE=0.92
VISION_HANDOFF_MIN_OSNET_COSINE=0.82
# Attention gate: p below this AND (known person OR unusual for the hour).
VISION_HANDOFF_ATTENTION_P=0.05
# "Same person?" asks from strong handoff / overlap pairs per local day (0 = none).
VISION_HANDOFF_SAME_ASK_DAILY_CAP=2
VISION_HANDOFF_INITIAL_LOOKBACK_SEC=3600
# Redis steering: orion:vision:expect:walkway (fast tier) and orion:vision:look:doorbell
# (retina live view, capped by RETINA_RING_SELF_LOOK_MAX_PER_DAY).
VISION_HANDOFF_STEER_ENABLED=true
VISION_HANDOFF_SELF_LOOK_ENABLED=true
VISION_HANDOFF_STREET_EVENTS_ENABLED=true
# Refresh orion:vision:expect:<stream> on its own cheap clock (open-window
# query + SET/DEL only, no fitting), so steering starts within this many
# seconds of a window opening, not up to one rhythm tick late. 0 disables.
VISION_EXPECT_REFRESH_INTERVAL_SEC=60
