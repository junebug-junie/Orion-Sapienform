PROJECT=orion-athena
SERVICE_NAME=orion-substrate-runtime
SERVICE_VERSION=0.1.0
NODE_NAME=athena

# Athena stack: conjourney DB on orion-athena-sql-db (not the legacy orion@postgres DSN).
POSTGRES_URI=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health).
HEARTBEAT_INTERVAL_SEC=10

ENABLE_BIOMETRICS_NODE_REDUCER=true
ENABLE_BIOMETRICS_PRESSURE_ORGAN=true
ENABLE_NODE_PRESSURE_REDUCER=true
BIOMETRICS_NODE_STALE_AFTER_SEC=180
BIOMETRICS_PRESSURE_MIN_CONFIDENCE=0.60
NODE_CATALOG_PATH=/app/config/biometrics/node_catalog.yaml
GRAMMAR_POLL_INTERVAL_SEC=1.0
# Per-reducer batch limits. Biometrics matches transport for catch-up on high-RAM hosts.
BIOMETRICS_GRAMMAR_BATCH_LIMIT=500
EXECUTION_GRAMMAR_BATCH_LIMIT=500
TRANSPORT_GRAMMAR_BATCH_LIMIT=1000
REDUCER_HEARTBEAT_STALE_SEC=120
REDUCER_POISON_MAX_RETRIES=3
GRAMMAR_EVENT_CHANNEL=orion:grammar:event
# Unified turn 5a: substrate finalize appraisal RPC (HarnessDraftMoleculeV1 -> SubstrateFinalizeAppraisalV1)
CHANNEL_FINALIZE_APPRAISAL_REQUEST=orion:substrate:finalize_appraisal:request
CHANNEL_FINALIZE_APPRAISAL_RESULT_PREFIX=orion:substrate:finalize_appraisal:result:
# Unified turn step 7: harness post-turn closure consumer (HarnessPostTurnClosureV1)
CHANNEL_POST_TURN_CLOSURE=orion:substrate:post_turn_closure
ENABLE_POST_TURN_CLOSURE_LISTENER=true
# Voluntary attention (ORION_ATTENTION_TOPDOWN_ENABLED) goal-context feed: always-on
# consumer that populates the in-memory active-goal store from GoalProposalV1 events.
CHANNEL_GOAL_PROPOSAL=orion:memory:goals:proposed
# Accepted pressure candidates publish to a separate channel (not orion:grammar:event).
PUBLISH_ACCEPTED_PRESSURE_GRAMMAR=true
ACCEPTED_PRESSURE_GRAMMAR_CHANNEL=orion:grammar:accepted-pressure
# Default false: do not silently skip history after long outage. Cold-start tail-seed still logs substrate_data_gap.
SUBSTRATE_CURSOR_TAIL_SEED_ON_LAG=false
SUBSTRATE_CURSOR_LAG_RESYNC_HOURS=6
# Required for POST /grammar/cursor/reset and POST /grammar/quarantine/ack (internal operator endpoints; not exposed via hub/Caddy).
SUBSTRATE_CURSOR_RESET_OPERATOR_TOKEN=
ENABLE_EXECUTION_TRAJECTORY_REDUCER=true
# active_execution_trajectory.runs caps (LRU by last_updated_at). Only the freshest
# ~120s of runs are ever consumed downstream (orion-spark-introspector).
EXECUTION_TRAJECTORY_MAX_RUNS=2000
EXECUTION_TRAJECTORY_MAX_AGE_SEC=86400
# Transport M3: set true to enable bus reducer and projection (default off)
ENABLE_TRANSPORT_BUS_REDUCER=true
BUS_STREAM_DEPTH_CRITICAL=100000
# trace_only | m3 | m4 | m5 | full
TRANSPORT_SUBSTRATE_MATURITY=full_observe
# --- Rung 1 bridge: write execution/transport prediction_error onto a durable ---
# substrate node so the dynamics engine can seed pressure from it. Default-off in
# code, fail-open. For cross-process effect the write must target the shared
# semantic store (SUBSTRATE_STORE_BACKEND=sparql + Fuseki URLs below); with the
# in-memory default the node is process-local. The periodic dynamics-engine tick
# that consumes these nodes is SUBSTRATE_DYNAMICS_TICK_ENABLED below.
# Default-off in code; enabled here so rung-1 write + dynamics tick can run on Athena.
SUBSTRATE_WRITE_PREDICTION_ERROR_NODES=true
# Rung-1 consumer (closes PR #766 gap): periodic SubstrateDynamicsEngine.tick()
# against the shared substrate graph store, seeding pressure from
# metadata['prediction_error'] written by SUBSTRATE_WRITE_PREDICTION_ERROR_NODES.
# Default off in code; enabled here to close the rung-1 consumer gap on Athena.
SUBSTRATE_DYNAMICS_TICK_ENABLED=true
SUBSTRATE_DYNAMICS_TICK_INTERVAL_SEC=30.0
# Rung 4: roll each completed clock-aligned receipt window into one
# proposal-marked EpisodeSummaryV1 (substrate_episode_summaries table; apply
# manual_migration_substrate_episodes_v1.sql first). Window + tick interval
# must stay under receipt retention or completed windows are pruned unseen.
SUBSTRATE_EPISODIC_TICK_ENABLED=true
SUBSTRATE_EPISODIC_TICK_INTERVAL_SEC=300.0
SUBSTRATE_EPISODIC_WINDOW_SECONDS=900
SUBSTRATE_EPISODIC_MAX_RECEIPTS=64
SUBSTRATE_EPISODIC_RETENTION_DAYS=14.0
# bus_synaptic_prediction_error: reads the live bus synaptic graph
# (orion_bus_synapse, written by orion-bus-mirror) and writes a sixth
# Active-Inference domain node (node:substrate.bus_synaptic) via the same
# shared writer SUBSTRATE_WRITE_PREDICTION_ERROR_NODES uses. Own explicit
# flag, not piggybacked on that one -- new kind of signal (FalkorDB read, no
# grammar-event batch).
# Enabled 2026-07-25 (Juniper's explicit go-ahead): this is a pure shadow
# write into an isolated node -- confirmed live via repo-wide grep that
# nothing reads node:substrate.bus_synaptic anywhere yet (the only two
# references are this writer's own upsert calls) -- so flipping it on
# cannot propagate a bad signal, and is how the CLAUDE.md metric-quality-gate
# step 4 live-data sanity pass (non-degenerate variance check) actually gets
# its data. Do not wire any consumer to node:substrate.bus_synaptic (e.g.
# folding it into prediction_error_confidence, PR #1329) until that check
# has run against real accumulated history. See
# docs/superpowers/specs/2026-07-23-transport-domain-rpc-health-redesign.md.
SUBSTRATE_BUS_SYNAPTIC_TICK_ENABLED=true
SUBSTRATE_BUS_SYNAPTIC_TICK_INTERVAL_SEC=30.0
SUBSTRATE_BUS_SYNAPTIC_MIN_EDGE_COUNT=5
# Excludes edges not updated within this window from the aggregate, so a
# decommissioned organ/channel's frozen last z-score doesn't drag "right
# now" forever (review finding, 2026-07-25).
SUBSTRATE_BUS_SYNAPTIC_MAX_EDGE_AGE_SEC=3600.0
# Perceptual health, feeding node:substrate.vision -> capability:vision. Before
# this, capability:vision had no inbound edge at all and its live vector was
# fabricated (pressure=0.0, confidence=1.0, available_capacity=1.0, empty
# provenance) -- the self-model asserting perfect vision whether or not a
# camera was running.
#
# A bus-artifact listener feeds a clock-driven tick. Time-triggered on purpose:
# an earlier draft derived this from the bus synaptic graph's gap_zscore, which
# is only recomputed when a message ARRIVES, so silence froze the reading at
# its last healthy value instead of raising it. That approach was deleted
# rather than tuned -- it also z-scored inter-arrival time against a fixed 5s
# scheduler (a metronome), and was blind to a blinded camera: verified by
# probe, a black frame returns ok=True with 0 objects while bus traffic stays
# perfectly regular.
#
# Two channels on the node. perception_staleness (availability) maps to
# capability:vision pressure. perception_yield (mean objects per artifact) is
# recorded only -- a sustained zero is equally consistent with a blinded eye
# and an empty dark room, and separating those needs a day-shape prior that
# does not exist yet.
#
# ON by default: shipping it off would leave the fabricated vector in place,
# which is the defect. Deliberately NOT added to ACTIVE_INFERENCE_DOMAINS or
# worker.py's _PREDICTION_ERROR_DOMAIN_NODE_IDS in this patch -- observe for a
# week first, per CLAUDE.md's metric gate item 6 and the transport retirement's
# measured ~0.09 aggregate shift.
SUBSTRATE_VISION_CHANNEL_TICK_ENABLED=true
SUBSTRATE_VISION_CHANNEL_TICK_INTERVAL_SEC=30.0
# The channel carrying the detector's real output. Not orion:vision:events
# (~11/hour, far too sparse to read as liveness) and not orion:vision:frames
# (0.1s but pre-detector, so it stays healthy while the eye is blind).
SUBSTRATE_VISION_ARTIFACTS_CHANNEL=orion:vision:artifacts
# Rung 3: continuous workspace competition over the substrate graph; winning
# coalition persisted to substrate_attention_broadcast_projection (apply
# manual_migration_attention_broadcast_v1.sql first). Needs the shared sparql
# store (same requirement as the dynamics tick). Never generates questions or
# actions — read-only broadcast.
ORION_ATTENTION_BROADCAST_ENABLED=true
ORION_ATTENTION_BROADCAST_INTERVAL_SEC=30.0
ORION_ATTENTION_BROADCAST_MIN_SALIENCE=0.2
# How long a human resolve/dismiss verdict (attention_loop_outcome) excludes a
# loop from re-competing in the broadcast above before the exclusion lapses
# (orion/substrate/attention/verdicts.py). 48h is a conservative round-up from
# the only two real inter-verdict gaps observed live (~37h22m, ~35h34m) --
# n=2, disclosed as thin in that module's docstring. Read fresh on every call;
# safe to tune without a code change once more verdict data accumulates.
ORION_ATTENTION_VERDICT_EXCLUSION_TTL_HOURS=48.0
# Append-only per-tick history log companion to the singleton projection table
# above (apply manual_migration_attention_broadcast_log_v1.sql first). Lets
# historical voluntary_override replay actually search real ticks instead of
# only the current snapshot. 168h = 7 days.
ORION_ATTENTION_BROADCAST_LOG_RETENTION_HOURS=168.0
# AST/HOT self-model live tick (docs/superpowers/specs/2026-07-29-ast-hot-
# reducer-live-ticking-design.md). Appended to the tail of the attention-
# broadcast tick above (no separate timer); reads the already-live field lane,
# broadcast lane, and FalkorDB prediction-error nodes, writes only to
# substrate_attention_self_model (apply manual_migration_attention_self_model_v1.sql
# first) -- a brand-new table nothing else in the repo touches.
# 2026-07-29: promoted to the active default after a live-data sanity check
# (this repo's bus_synaptic precedent: PR #1385 -> #1387) -- confirmed real,
# continuously-moving, non-degenerate output in substrate_attention_self_model.
# This active default must stay true, not just this one running container's
# .env -- a same-day live incident (an unrelated concurrent session's `docker
# compose up` for this same service, from a different worktree whose .env
# never had this key) silently reverted a manually-flipped-true container back
# to the stale `false` default, killing the tick for over an hour with no
# error, only a missing log line.
SUBSTRATE_ATTENTION_SELF_MODEL_TICK_ENABLED=true
# In-process rolling-window size for prediction_error_trend_by_domain, counted
# in attention-broadcast ticks (~30s cadence each by default). 2026-08-19:
# calibrated via real TRAIN/TEST validation against 7 days of live biometrics
# prediction_error history -- window=2 beat both the old default (10) and the
# offline replay script's own default (30) on held-out TEST, not just TRAIN.
# See app/settings.py's attention_self_model_trend_window_ticks docstring for
# the full numbers and methodology.
SUBSTRATE_ATTENTION_SELF_MODEL_TREND_WINDOW_TICKS=2
SUBSTRATE_ATTENTION_SELF_MODEL_LOG_RETENTION_HOURS=168.0
# orion-heartbeat's /h1 ensemble verdict, fetched once per self-model tick and
# threaded into AttentionSelfModelV1.heartbeat_mean_ratio/heartbeat_verdict.
# 2026-07-29: promoted to the active default (real container-name URL, same
# app-net docker network both services share) after live verification --
# an empty value disables the fetch entirely and is the honest fallback for
# any deployment where orion-heartbeat isn't running, but this deployment
# does run it. Not the same as HEARTBEAT_INTERVAL_SEC above (this service's
# own bus-native SystemHealthV1 heartbeat cadence) -- SUBSTRATE_HEARTBEAT_H1_*
# refers specifically to the orion-heartbeat *service*'s tensor-network
# ensemble.
SUBSTRATE_HEARTBEAT_H1_URL=http://orion-athena-heartbeat:7251/h1
SUBSTRATE_HEARTBEAT_H1_FETCH_TIMEOUT_SEC=2.0
# Operator sign-off granted: lets intrinsic signals seed curiosity candidates.
ORION_ENDOGENOUS_CURIOSITY_ENABLED=true
ORION_ENDOGENOUS_CURIOSITY_KILL_SWITCH=false
ORION_ENDOGENOUS_CURIOSITY_BUDGET=3
# Default 0.6 in code if unset. Athena: 0.25 seeds from moderate chat repair pressure (~0.28 in projection).
ORION_ENDOGENOUS_CURIOSITY_MIN_REPAIR_LEVEL=0.25
ORION_ENDOGENOUS_CURIOSITY_TICK_INTERVAL_SEC=60.0
# Live default as of 2026-07-17: this deployment runs Falkor primary (not
# sparql). docker-compose.yml passes these vars through to the container
# (fixed same day; previously set-in-.env-but-silently-ignored because compose
# only forwarded SUBSTRATE_STORE_BACKEND). Kept active here, not commented out,
# so a from-scratch resync (disk rebuild, sync_local_env_from_example.py on a
# fresh checkout) reproduces the actual running config instead of quietly
# reverting to sparql. Options: falkor|routed|sparql|in_memory.
SUBSTRATE_STORE_BACKEND=falkor
FALKORDB_URI=redis://orion-athena-falkordb:6379
# Same FalkorDB instance as above (FALKORDB_URI), different graph name --
# read-only, used only by the bus_synaptic tick above. Same env var name
# services/orion-bus-mirror and services/orion-recall already use for the
# same graph, not a new name.
FALKORDB_BUS_GRAPH=orion_bus_synapse
FALKORDB_SUBSTRATE_GRAPH=orion_substrate
# SUBSTRATE_STORE_PRIMARY=falkor
# SUBSTRATE_STORE_SHADOW=sparql
# SUBSTRATE_ROUTE_WORKLOAD=substrate.runtime
# GRAPH_PERSISTENCE_ROUTES_JSON=
SUBSTRATE_GRAPH_QUERY_URL=http://orion-athena-fuseki:3030/orion/query
SUBSTRATE_GRAPH_UPDATE_URL=http://orion-athena-fuseki:3030/orion/update
SUBSTRATE_GRAPH_URI=http://conjourney.net/graph/substrate
SUBSTRATE_GRAPH_USER=admin
SUBSTRATE_GRAPH_PASS=orion
# Real change detection, not a blind timer (2026-07-14 incident: an uncached
# brain-frame tick drove Fuseki to 99.99% memory). Safety-net ceiling for staleness
# from writes made by a DIFFERENT process; same-process writes are caught instantly
# via a write-generation counter. See GraphDBSubstrateStoreConfig.
# snapshot_force_refresh_ceiling_sec in orion/substrate/graphdb_store.py for the full
# design and the 0-value warning (its meaning is NOT the same as the removed
# SUBSTRATE_SNAPSHOT_CACHE_TTL_SEC=0 convention).
SUBSTRATE_SNAPSHOT_FORCE_REFRESH_CEILING_SEC=30.0
# Chat grammar reducer (set true after PUBLISH_HUB_CHAT_GRAMMAR=true is set on hub)
ENABLE_CHAT_GRAMMAR_REDUCER=true
CHAT_GRAMMAR_BATCH_LIMIT=100
# Route grammar reducer (orch.route: lane). Default on, matching orion-cortex-orch's
# PUBLISH_CORTEX_ORCH_GRAMMAR=true -- but requires
# manual_migration_route_substrate_loop.sql applied on this service's DB first,
# or the reducer will fail writing substrate_route_arbitration_projection.
ENABLE_ROUTE_GRAMMAR_REDUCER=true
ROUTE_GRAMMAR_BATCH_LIMIT=100
LOG_LEVEL=INFO

# Substrate receipt retention + prune (30-minute success TTL; 5-minute prune loop)
ORION_RECEIPT_RETENTION_SUCCESS_MINUTES=30
ORION_RECEIPT_RETENTION_ERROR_HOURS=6
ORION_RECEIPT_FULL_PAYLOAD_SUCCESS=false
ORION_RECEIPT_FULL_PAYLOAD_SAMPLE_RATE=0
ORION_RECEIPT_MAX_TABLE_GB=25
ORION_RECEIPT_WARN_TABLE_GB=15
ORION_RECEIPT_CRITICAL_TABLE_GB=20
ORION_RECEIPT_EMERGENCY_METADATA_ONLY=true
ORION_RECEIPT_PRUNE_INTERVAL_SEC=300
ORION_RECEIPT_PRUNE_BATCH_SIZE=10000
ORION_RECEIPT_POSTGRES_DATA_PATH=/mnt/postgres
ORION_RECEIPT_DISK_CRITICAL_PCT=85

# Orion embodiment (mind-to-sprite) hooks — default off / empty-safe.
# EMBODIMENT_C_TICK_ENABLED: cache DriveStateV1 and publish one involuntary
# embodiment intent per dynamics tick. EMBODIMENT_PERCEPTION_SUBSTRATE_ENABLED:
# fold town perception into the substrate graph.
EMBODIMENT_C_TICK_ENABLED=false
EMBODIMENT_PERCEPTION_SUBSTRATE_ENABLED=false
EMBODIMENT_CHANNEL_INTENT=orion:embodiment:intent
EMBODIMENT_CHANNEL_PERCEPTION=orion:embodiment:perception
# Still real: cached by the embodiment C producer above. The legacy substrate-graph
# materialization that also listened here (+ DRIVES_AUDIT_CHANNEL,
# DRIVE_STATE_SUBSTRATE_MATERIALIZATION_ENABLED) was removed 2026-07-30 -- write-never
# once DriveEngine (its only producer) was deleted.
EMBODIMENT_DRIVES_STATE_CHANNEL=orion:memory:drives:state
# Consumed for the brain-frame field_anomaly dimension. Producer: orion-field-digester's
# mood-arc reconstruction-error scorer (app/anomaly_scorer.py).
FIELD_CHANNEL_ANOMALY_SCORE_CHANNEL=orion:field_channel:anomaly_score

# Cabinet ambient spike cognition consumer (grammar trace + field bump).
SUBSTRATE_CABINET_AMBIENT_SPIKE_CONSUMER_ENABLED=true
CABINET_AMBIENT_SPIKE_CHANNEL=orion:cabinet:ambient:spike
# codebase_prediction_error consumer (docs/superpowers/specs/2026-07-30-codebase-mass-
# signal-design.md). Producer: orion-cocreation-signals. Promoted to default-on
# 2026-07-31 by direct operator instruction (Juniper), same "flip after the table/
# migration are confirmed live" bar every other tick in this file has followed --
# manual_migration_codebase_mass_baseline_v1.sql confirmed applied against the real
# production Postgres (orion-athena-sql-db) before this flip, not just a local test DB.
# A dedicated live-data replay against real accumulated history (the way bus_synaptic's
# own promotion was preceded by one) has NOT been run yet -- this flip authorizes
# collecting that real history, not a substitute for eventually checking it.
SUBSTRATE_WRITE_CODEBASE_PREDICTION_ERROR_NODE=true
CHANNEL_CODEBASE_DELTA=orion:substrate:codebase_delta
# substrate_codebase_delta_log retention -- raw per-tick payload history for
# a future Hub "cocreation signals" analytics tab (real commit counts/PR
# numbers/graph deltas, not just the running EWMA baseline above). Longer
# than the baseline retention on purpose: this table's whole point is
# accumulated history, not just the latest row.
SUBSTRATE_CODEBASE_DELTA_LOG_RETENTION_DAYS=180.0
SUBSTRATE_CODEBASE_MASS_BASELINE_RETENTION_DAYS=30.0
# Perceptual prediction error (P2, docs/superpowers/specs/2026-08-12-
# perception-frontier-design.md): surprise = 1 - cos(frame_embedding,
# EWMA_embedding) per camera stream. Feeds node:substrate.perception, a
# separate node from node:substrate.vision's P3 channels (that node measures
# arrival timing/object count; this measures the embedding model's own
# content encoding of the frame -- see orion/substrate/prediction_error.py's
# P2 section for the full independence check).
#
# Enabled 2026-08-19 (Juniper direction), matching the SUBSTRATE_BUS_SYNAPTIC_
# TICK_ENABLED/SUBSTRATE_VISION_CHANNEL_TICK_ENABLED precedent: flip the
# shadow write on so real history accumulates -- this is the only way to run
# the live-data sanity check at all. This authorizes the WRITE only. Still do
# not wire any consumer to node:substrate.perception (no consumer exists in
# this patch to wire) until the sanity check documented in
# perception_prediction_error()'s own docstring (orion/substrate/
# prediction_error.py) has actually run against real accumulated history --
# same two-step split bus_synaptic used (tick flip, then a separate later
# go-ahead for a consumer). Requires manual apply of
# manual_migration_perception_embedding_baseline_v1.sql first.
SUBSTRATE_PERCEPTION_PREDICTION_ERROR_TICK_ENABLED=true
SUBSTRATE_PERCEPTION_PREDICTION_ERROR_TICK_INTERVAL_SEC=30.0
SUBSTRATE_PERCEPTION_BASELINE_RETENTION_DAYS=30.0
# --- Attention salience trace publish gate ---
# 2026-07-31: chat-level/open-loop salience is GWT-coalition Borda
# rank-aggregation now (orion/substrate/attention/salience.py) -- there is
# only one formula, this flag no longer selects between two. Its real,
# kept purpose: gates whether orion-thought's reverie tick
# publishes/persists an AttentionSalienceTraceV1 row (orion-substrate-
# runtime itself does not read this key, but keeps it for env parity with
# the other two services). ORION_ATTENTION_HABITUATION_ENABLED and
# ORION_ATTENTION_SALIENCE_WEIGHTS were removed (killed outright alongside
# SEED_WEIGHTS/LinearSalienceCombiner -- no combiner weights left to
# override, and habituation has no replacement).
ORION_ATTENTION_SALIENCE_V2_ENABLED=true
# Voluntary attention override (spec 2026-07-07 Step 2). Lets an active goal
# bias attention against bottom-up salience under a bounded effort budget
# (biased competition, Desimone & Duncan) -- can flip the attention winner
# away from pure bottom-up when a goal's priority x relevance beats it. Off =
# pure bottom-up, byte-identical to pre-flip behavior. Flipped on 2026-07-18
# per orion/sentience_striving_program/README.md's Recurrent Processing
# Theory (Lamme) instrumentation thread -- eval (orion/substrate/attention/
# evals/run_topdown_eval.py) and unit tests (tests/test_top_down.py,
# tests/test_voluntary_attention_wiring.py) verified green before the flip.
ORION_ATTENTION_TOPDOWN_ENABLED=true
ATTENTION_TOPDOWN_GAIN=0.6
ATTENTION_EFFORT_MAX=1.0
ATTENTION_EFFORT_SCALE_BY_AGENCY=true
ATTENTION_TOPDOWN_WEIGHTS_VERSION=seed-v1

# --- Self-tab brain-EKG frame producer ---
SUBSTRATE_BRAIN_FRAME_ENABLED=true
BRAIN_FRAME_INTERVAL_SEC=5.0
BRAIN_FRAME_RETENTION_HOURS=24
BRAIN_FRAME_SAMPLE_NODES=40
BRAIN_FRAME_SAMPLE_EDGES=60
BRAIN_FRAME_FIRING_THRESHOLD=0.5
BRAIN_FRAME_STARVING_THRESHOLD=0.1
BRAIN_FRAME_SELF_STATE_CADENCE_SEC=30.0
BRAIN_FRAME_SPOTLIGHT_CADENCE_SEC=30.0
# Dependent signal producers the brain frame reads are enabled above so regions
# show real motion: SUBSTRATE_DYNAMICS_TICK_ENABLED, ORION_ATTENTION_BROADCAST_ENABLED,
# ENABLE_EXECUTION_TRAJECTORY_REDUCER, ENABLE_TRANSPORT_BUS_REDUCER, ENABLE_CHAT_GRAMMAR_REDUCER.

# Health monitor: edge-triggered check (GET /grammar/truth degraded=true) that
# raises an orion-notify attention request only on a healthy->unhealthy
# transition -- never spams once per health-check tick.
SUBSTRATE_RUNTIME_HEALTH_CHECK_INTERVAL_SEC=900.0
# On a fresh unhealthy transition (no existing open alert), wait this long and
# recheck once before paging -- absorbs single-tick reducer-health blips that
# self-heal on the next poll instead of firing a CRITICAL page for them.
SUBSTRATE_RUNTIME_HEALTH_RECHECK_DELAY_SEC=15.0
NOTIFY_BASE_URL=http://orion-athena-notify:7140
NOTIFY_API_TOKEN=

# --- World-model publish tick ---
# The first real producer for orion:exec:request:WorldModelService
# (services/orion-world-model, PR #1775/#1861) -- previously only a manual
# test-publish CLI issued requests. Default-off: this is a brand-new
# producer wiring an untrained-weights scaffold service, not a decision to
# feed this worker's output into real cognition yet. See
# services/orion-substrate-runtime/README.md "World-model publish tick" for
# the honesty split (biometrics/affect/memory_pointers are always
# zero-filled -- no producer reachable from this process; vision_embedding is
# zero-filled per-tick if no fresh, correctly-dimensioned embedding is
# cached; execution_context and temporal are real).
SUBSTRATE_WORLD_MODEL_PUBLISH_TICK_ENABLED=false
SUBSTRATE_WORLD_MODEL_PUBLISH_TICK_INTERVAL_SEC=30.0
SUBSTRATE_WORLD_MODEL_REQUEST_CHANNEL=orion:exec:request:WorldModelService
# Feature-group dims. Must match services/orion-world-model/app/settings.py's
# own WM_DIM_* values on whatever host runs that service (circe as of this
# patch) -- a mismatch is caught defensively for vision_embedding (zero-fill +
# warning log) but NOT for the other five groups, which orion-world-model's
# own trajectory_steps_to_tensors() rejects outright with a ValueError.
SUBSTRATE_WORLD_MODEL_DIM_BIOMETRICS=32
SUBSTRATE_WORLD_MODEL_DIM_AFFECT=16
SUBSTRATE_WORLD_MODEL_DIM_EXECUTION_CONTEXT=16
SUBSTRATE_WORLD_MODEL_DIM_MEMORY_POINTERS=32
SUBSTRATE_WORLD_MODEL_DIM_TEMPORAL=8
SUBSTRATE_WORLD_MODEL_DIM_VISION_EMBEDDING=512
# Freshness floor for the cached vision embedding -- a P2 listener outage must
# zero-fill vision_embedding, not keep publishing an arbitrarily stale vector
# as if it were current. 120s = 4x SUBSTRATE_PERCEPTION_PREDICTION_ERROR_TICK_
# INTERVAL_SEC's own 30s default.
SUBSTRATE_WORLD_MODEL_VISION_EMBEDDING_MAX_AGE_SEC=120.0
