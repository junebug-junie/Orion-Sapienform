# orion-feedback-runtime — Layer 10 feedback (docker compose)
# Requires: substrate_execution_dispatch_frames + related substrate tables
# Apply migration: services/orion-sql-db/manual_migration_feedback_frame_v1.sql
# Apply migration: services/orion-sql-db/manual_migration_feedback_frame_v2_drop_self_state.sql
PROJECT=orion-athena
SERVICE_NAME=orion-feedback-runtime
SERVICE_VERSION=0.1.0
NODE_NAME=athena
POSTGRES_URI=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
# Orion bus (Redis) — always the real tailscale node address, per repo mandate (never
# bus-core, never localhost). Also feeds the independent SystemHealthV1 heartbeat below.
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
FEEDBACK_BUS_CHANNEL=orion:feedback:frame
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health).
HEARTBEAT_INTERVAL_SEC=10
FEEDBACK_POLICY_PATH=/app/config/feedback/feedback_policy.v1.yaml
FEEDBACK_POLL_INTERVAL_SEC=2.0

# --- Scan bound (ROADMAP D2 follow-through, 2026-08-19) --------------------------------------
# The "oldest dispatch frame without feedback" lookup was an unbounded anti-join over two
# ~420k-row tables: 829 MB read + 465 MB temp spill PER EXECUTION, every FEEDBACK_POLL_INTERVAL_SEC.
# It was the single largest contributor to athena being fully I/O-stalled ~20% of wall time.
# Bounded to a window it becomes two index scans -- 916 blocks, 116x fewer disk reads.
#
# 3600 is ~42x the measured maximum feedback lag (24h: p50 16.0s, p99 77.1s, max 85.6s).
# Set FEEDBACK_SCAN_WINDOW_SEC=0 to disable the bound and restore the old behaviour (rollback).
FEEDBACK_SCAN_WINDOW_SEC=0
# The unbounded query survives as a rate-limited backstop, so a frame older than the window is
# never skipped forever -- it is picked up within this interval and logged as a tripwire.
# WARNING: 0 here means "run the backstop on EVERY poll", not "disable it" --
# i.e. the unbounded query every 2s, the exact behaviour this exists to avoid.
FEEDBACK_SCAN_BACKSTOP_INTERVAL_SEC=300
ENABLE_FEEDBACK_RUNTIME=true
LOG_LEVEL=INFO
FEEDBACK_RUNTIME_PORT=8122
