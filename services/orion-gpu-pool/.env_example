# orion-gpu-pool — one lease queue for every GPU on circe.
# Spec: docs/superpowers/specs/2026-09-24-gpu-pool-design.md
# Rules (cards, roles, borrowing, priorities, grace) live in config/gpu_pool.yaml, not here.
PROJECT=orion-athena
SERVICE_NAME=orion-gpu-pool
SERVICE_VERSION=0.1.0
NODE_NAME=athena
LOG_LEVEL=INFO
GPU_POOL_PORT=8127

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10
RPC_HEALTH_PUBLISH_ENABLED=true
RPC_HEALTH_PUBLISH_INTERVAL_SEC=30

# Same database as durable-runs; apply services/orion-sql-db/manual_migration_gpu_pool_v1.sql first.
POSTGRES_URI=

# observe = discovers, answers leases, publishes state; swap decisions are published, never actuated.
GPU_POOL_MODE=observe
GPU_POOL_TICK_SEC=1.0
GPU_POOL_PROBE_INTERVAL_SEC=15.0
GPU_POOL_PROBE_TIMEOUT_SEC=3.0
# A worker announces every 30s; after this long without one its port reads "silent" (no grants).
GPU_POOL_ANNOUNCE_STALE_SEC=120.0
GPU_POOL_STATE_PUBLISH_SEC=5.0
# Operator verbs (lend, replay, cancel, backfill). Empty = every control verb refused.
GPU_POOL_OPERATOR_TOKEN=
GPU_POOL_REPLAY_PAYLOAD_MAX_BYTES=262144
