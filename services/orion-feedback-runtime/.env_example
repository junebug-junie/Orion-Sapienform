# orion-feedback-runtime — Layer 10 feedback (docker compose)
# Requires: substrate_execution_dispatch_frames + related substrate tables
# Apply migration: services/orion-sql-db/manual_migration_feedback_frame_v1.sql
# Apply migration: services/orion-sql-db/manual_migration_feedback_frame_v2_drop_self_state.sql
# Apply migration: services/orion-sql-db/manual_migration_substrate_pending_markers.sql
# Apply migration: services/orion-sql-db/manual_migration_substrate_frames_created_at_index.sql
#   ^ REQUIRED. Without the first one every tick raises UndefinedColumn on the
#     *_pending column, which _poll_loop's blanket `except Exception` swallows --
#     /health stays green, the heartbeat keeps publishing, and the pipeline
#     produces nothing at all. Run the VERIFY block at the end of that file.
PROJECT=orion-athena
SERVICE_NAME=orion-feedback-runtime
SERVICE_VERSION=0.1.0
NODE_NAME=athena
POSTGRES_URI=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
# Orion bus (Redis) — always the real tailscale node address, per repo mandate (never
# bus-core, never localhost). Also feeds the independent SystemHealthV1 heartbeat below.
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
FEEDBACK_BUS_CHANNEL=orion:feedback:frame
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health).
HEARTBEAT_INTERVAL_SEC=10
FEEDBACK_POLICY_PATH=/app/config/feedback/feedback_policy.v1.yaml
FEEDBACK_POLL_INTERVAL_SEC=2.0

# --- Pending-marker reconciler (ROADMAP D2, 2026-08-19) --------------------------------------
# Re-queues rows whose `*_pending` marker was cleared without the downstream frame existing.
# Only ever ADDS work back, never removes it. It runs the expensive anti-join the marker exists
# to avoid, so it is rate-limited. 0 means "every poll", which reinstates the original problem.
FEEDBACK_RECONCILE_INTERVAL_SEC=900


ENABLE_FEEDBACK_RUNTIME=true
LOG_LEVEL=INFO
FEEDBACK_RUNTIME_PORT=8122

# Seconds to wait after a dispatch before snapshotting the field to score it.
# Must cover send offset + action latency + the digester's fold, or the
# "after" reading is taken before the action can have shown up in a pressure.
# Derived from live measurement: latency p95 5.4s + 2 field ticks ~= 10.4s.
ORION_ACTION_SETTLE_SEC=15.0
# Ceiling on the computed settle (action_settle_sec + the frame's worst measured
# latency). The feedback FIFO is oldest-first and its head is deferred until the
# window closes, and live utilization is ~95%, so a long defer eats the queue's
# headroom. This does NOT cover every configured action -- builder_prune and
# prune_dangling_images allow 720s. When the clamp binds, the frame is NOT
# scored (a window known to be too short yields a confident wrong belief);
# feedback_scoring_window_clamped is logged at WARNING.
ORION_ACTION_SETTLE_MAX_SEC=180.0

