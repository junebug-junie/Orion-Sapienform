SERVICE_NAME=orion-office-env
SERVICE_VERSION=0.1.0
INSTANCE_ID=pan-1
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
ORION_HEALTH_CHANNEL=orion:system:health
HEARTBEAT_INTERVAL_SEC=10
OFFICE_ENV_SAMPLE_CHANNEL=orion:office:env:sample
# Host serial device of the office Nano ESP32 (stable by-id path, not /dev/ttyACM0).
# Find it with: ls /dev/serial/by-id/
OFFICE_SERIAL_DEVICE_HOST=/dev/serial/by-id/CHANGE-ME-usb-Arduino_Nano_ESP32
# Group id that owns the serial device on the host (stat -c %g <device>); usually dialout=20.
OFFICE_SERIAL_GID=20
OFFICE_SERIAL_BAUD=115200
# Bus publish cadence. Matches the cabinet's biometrics TELEMETRY_INTERVAL (30 s).
OFFICE_PUBLISH_INTERVAL_SEC=30
# No valid firmware frame for this long => the sample is stale and carries no readings.
# The firmware sends ~1 frame/s, same as the cabinet Nano.
OFFICE_STALE_AFTER_SEC=10
OFFICE_SENSOR_ID=sht40-office
