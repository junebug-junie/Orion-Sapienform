+  // Producer templates in orion-social-memory synthesizer — topic bags, not facts.
+  if (t.startsWith('Recent room themes:')) {
+    return '';
+  }
+  if (t.includes('recent shared topics include')) {
+    return '';
+  }
+  return t;
