# Copy to .env and tune for your node.
# See README.md for operator checklist.

LOG_LEVEL=INFO
NODE_NAME=athena

ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
ORION_BUS_URL=redis://100.92.216.81:6379/0
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health).
HEARTBEAT_INTERVAL_SEC=10

HOST_PORT=32797

CHANNEL_VISIONHOST_INTAKE=orion:exec:request:VisionHostService
CHANNEL_VISIONHOST_REPLY_PREFIX=orion:vision:reply
CHANNEL_VISIONHOST_PUB=orion:vision:artifacts
# Off-switch for the artifact broadcast above. Set false only for a
# dedicated single-caller instance whose caller already gets its full
# result via the RPC reply and has no consumer for the broadcast at all
# (e.g. docker-compose.circe-qwen.yml) -- giving such a lane its own
# CHANNEL_VISIONHOST_PUB value instead would register a bus channel with
# zero real consumers, the orphan class scripts/check_metric_lineage.py's
# ratchet gate (CLAUDE.md section 0A) catches. Leave true for every normal
# deployment.
VISION_ARTIFACT_BROADCAST_ENABLED=true

# Dedicated, single-consumer lane for identity_face results ONLY --
# identity_face is deliberately excluded from CHANNEL_VISIONHOST_PUB above
# (should_broadcast_artifact in app/main.py), so its one legitimate
# consumer (orion-vision-window, for presence.subject + council's
# identity_hypothesis evidence) gets this narrow channel instead of the
# general broadcast every other subscriber reads. Not gated by
# VISION_ARTIFACT_BROADCAST_ENABLED above -- that flag is scoped to the
# general broadcast only; the real kill switch for this feed is
# identity_face's own `enabled:` flag in config/vision_profiles.yaml (no
# identity_face runs, nothing is ever published here).
CHANNEL_VISIONHOST_IDENTITY_PUB=orion:vision:artifacts:identity

MODEL_CACHE_DIR=/mnt/telemetry/models/vision
HF_HOME=/mnt/telemetry/models/vision/hf
TRANSFORMERS_CACHE=/mnt/telemetry/models/hf/transformers

VISION_PROFILES_PATH=/app/config/vision_profiles.yaml
# vlm_vqa added 2026-08-20: kind=vlm (VQA) execution shipped the same day.
# identity_face added 2026-08-26: kind=identity execution shipped the same
# day (docs/superpowers/specs/2026-08-21-seeing-juniper-identity-and-
# situated-observation-design.md section 4) -- enrolled with real photos
# from a live orion-juniper-affective-state capture the same day (see
# config/vision_profiles.yaml's own identity_face comment for the full
# record). Frame-router's reply-channel wildcard exposure, initially
# shipped as an accepted-not-fixed residual, was narrowed same-day (NOT
# fully closed -- the bus codec still decodes every wildcard reply's raw
# payload before dispatch) -- see
# services/orion-vision-frame-router/app/dispatcher.py and
# services/orion-vision-host/README.md.
# This is the REAL enable gate for direct (non-pipeline) task dispatch, e.g.
# task_type=vqa -- distinct from vision_profiles.yaml's own per-profile
# `enabled:` flag, which is only consulted for pipeline-step filtering and
# the warm-on-start loop, not for a directly-routed task like this one.
VISION_ENABLED_PROFILES=pipeline_retina_fast,retina_detect_open_vocab,embed_image,vlm_caption,vlm_vqa,identity_face

# identity_face gallery -- see app/identity_gallery.py. ONE enrolled
# subject, gallery does not grow at runtime; only
# scripts/enroll_identity_face.py (a human-run CLI, never the running
# service) ever writes here. Reuses the existing /mnt/telemetry/orion-vision-host
# mount below rather than a new volume.
IDENTITY_GALLERY_DIR=/mnt/telemetry/orion-vision-host/identity_gallery
IDENTITY_ENROLLED_SUBJECT=juniper

# Caption/VQA VLM — must fit VRAM. Shared default stays BLIP-base (works on
# a 7.68GB P4 with the other warm profiles already loaded, see athena's live
# .env) -- override per node, NOT here, for a card with real headroom.
#
# model_manager.py's load_vlm_captioner selects the transformers class by
# model_id substring: "blip2" / "blip" / "qwen2-vl" / "qwen2.5-vl", generic
# AutoModelForVision2Seq fallback otherwise. Qwen2-VL/2.5-VL additionally
# route through a chat-template prompt + trimmed-decode path (runner.py's
# _generate_vlm_text, app/vlm_family.py) -- required for correct output,
# not optional for those model_ids.
#
# BLIP-base's quality ceiling is real and evidenced live twice: once against
# orion-vision-council's foveal probe (2026-08-25, real GPU inference,
# sanitize_caption/sanitize_answer correctly rejected it as too-short/empty
# -- see services/orion-vision-council/README.md's Foveal probe section),
# and again against orion-thought's reverie visual chain (2026-08-25/26,
# 3/3 live ticks came back uncaptioned the same way). Athena's P4 has no
# headroom to upgrade this instance in place (2.4GB free measured live;
# Qwen2-VL-2B needs ~4-5GB) -- correction to an earlier version of this
# comment, which claimed a circe instance was "already" running Qwen2-VL:
# that was never actually deployed (no vision-host container existed on
# circe when it was written). It is now, for real, as its own separate
# lane -- see "Circe Qwen2-VL lane" in README.md and
# docker-compose.circe-qwen.yml. This key here still governs the SHARED
# athena instance only, and stays BLIP-base.
VISION_VLM_MODEL_ID=Salesforce/blip-image-captioning-base
VISION_VLM_MAX_TOKENS=128
VISION_VLM_TEMPERATURE=0.2

# Qwen2-VL/2.5-VL only (BLIP/BLIP2's processors don't accept these) -- bounds
# the resolution-scaled visual-token count/VRAM those families' "naive
# dynamic resolution" processor would otherwise apply uncapped to whatever
# size image this service was handed. Qwen team's own documented defaults
# (~0.2-1.0 megapixels). No effect while VISION_VLM_MODEL_ID is BLIP-based.
VISION_VLM_QWEN_MIN_PIXELS=200704
VISION_VLM_QWEN_MAX_PIXELS=1003520

# Fresh-capture resolution (request.use_latest_frame=true, e.g. for VQA) --
# must match orion-vision-edge's FRAME_STORAGE_DIR and this compose file's
# own read-only bind mount of the same host path.
VISION_FRAMES_DIR=/mnt/telemetry/vision/frames

CUDA_VISIBLE_DEVICES=0
VISION_DEVICE_STRATEGY=best_free_vram
VISION_DEFAULT_DEVICE=cuda:0
VISION_DEVICES=cuda:0
VISION_PICK_GPU_METRIC=free_vram_mb

VISION_DTYPE=auto
VISION_TIMEOUT_S=30

VISION_MAX_INFLIGHT=4
VISION_MAX_INFLIGHT_PER_GPU=1
VISION_QUEUE_WHEN_BUSY=true
VISION_MAX_QUEUE=200

# Recalibrated 2026-08-21, live-checked (not guessed): the prior values
# (reserve 3500 + hard_floor 1400 = 4900MB fixed overhead) left almost no
# scheduling headroom on THIS host's P4 (7680MB total) once the 3 warm
# profiles are loaded (~3489-3569MB measured) -- confirmed live it blocked
# every real task via the HTTP endpoint (task_type=vqa AND the pre-existing
# caption_frame), error_code=gpu_hard_floor, unrelated to any specific
# profile's own cost. `.env_example`'s prior comment named the captioner
# default as "P100-safe" -- these thresholds were very plausibly calibrated
# for a larger GPU (a P100 has 16GB) and never re-tuned for this P4's real
# 7.68GB capacity (same class of mistake
# feedback_borrowed_calibrated_constants_dont_transfer_across_domains
# names generally). New values still keep real safety margin (1200MB
# reserved untouched, 800MB minimum headroom before attempting a task) while
# leaving room for the ~4.1GB actually free at time of writing to be used --
# verified live post-change: a real vqa task loaded a second small VLM
# instance and completed successfully with real inference (see the PR
# report this change shipped with for the exact live transcript).
# VISION_VRAM_SOFT_FLOOR_MB is stored on VisionScheduler at construction
# (main.py) but never actually read anywhere in scheduler.py -- confirmed
# dead config, not a functional threshold; changed only for documentation
# consistency with the two values that do gate real dispatch.
VISION_VRAM_RESERVE_MB=1200
VISION_VRAM_SOFT_FLOOR_MB=1000
VISION_VRAM_HARD_FLOOR_MB=800

TORCH_CUDA_ALLOC_CONF=

# --- Liveness alerting ------------------------------------------------------
# Notices a healthy-but-serving-nothing vision host and raises an item in Hub's
# attention queue (GET /api/attention). Exists because on 2026-08-20 this
# service refused every task for ~21 hours while reporting Up and healthy, and
# nothing anywhere noticed. See services/orion-vision-host/app/liveness.py.
#
# Time-to-alert is (time to accumulate MIN_SAMPLES) + SUSTAIN_SEC. At the
# observed ~5s task cadence that is 45 + 180 = 225s.
VISION_LIVENESS_ALERT_ENABLED=true
VISION_LIVENESS_WINDOW_SEC=300
VISION_LIVENESS_MIN_SAMPLES=10
# ARM > CLEAR is required (hysteresis); the watcher refuses to construct
# otherwise rather than ship a flapping alert that looks configured.
VISION_LIVENESS_ARM_FAIL_RATE=0.8
VISION_LIVENESS_CLEAR_FAIL_RATE=0.2
VISION_LIVENESS_SUSTAIN_SEC=180
VISION_LIVENESS_COOLDOWN_SEC=3600
NOTIFY_BASE_URL=http://orion-athena-notify:7140
NOTIFY_API_TOKEN=

# --- Content-addressed frames ------------------------------------------------
# Lets this host interpret frames captured on a node that shares no filesystem
# with it (carbon's webcam, or any future camera). Frames from athena keep
# using image_path -- cheaper, no HTTP hop. Empty disables the capability.
VISION_PERCEPT_STORE_URL=http://orion-athena-percept-store:8000/percepts
VISION_PERCEPT_STORE_TOKEN=
VISION_PERCEPT_TIMEOUT_SEC=10.0

# --- Circe Qwen2-VL lane (docker-compose.circe-qwen.yml) --------------------
# A second, independent instance of this SAME service on circe's dedicated
# P100 (16GB, full-rate fp16) running Qwen2-VL-2B-Instruct instead of the
# shared athena instance's BLIP-base -- see README.md "Circe Qwen2-VL lane".
# These keys are read only by that compose file, never by the main one
# above; all have safe defaults baked into the compose file itself
# (documented here per the operator-contract rule -- CLAUDE.md section 7 --
# not because a value is required to be set).
CIRCE_QWEN_HOST_PORT=6602
# Confirmed live via nvidia-smi on circe, 2026-08-26: index 4 is the
# Tesla P100-PCIE-16GB, essentially idle (3MiB used). Re-verify with
# `nvidia-smi --query-gpu=index,name,memory.free --format=csv` immediately
# before every deploy -- do not trust this comment or an earlier session's
# snapshot; GPU assignments on this host have moved before (see
# reference_circe_gpu_inventory_and_lane_map memory).
CIRCE_QWEN_CUDA_VISIBLE_DEVICES=4
CIRCE_QWEN_VISION_VLM_MAX_TOKENS=128
CIRCE_QWEN_VISION_VLM_TEMPERATURE=0.2
CIRCE_QWEN_VISION_VLM_QWEN_MIN_PIXELS=200704
CIRCE_QWEN_VISION_VLM_QWEN_MAX_PIXELS=1003520
# Every key below is CIRCE_QWEN_-prefixed on purpose, no exceptions --
# including ones whose value happens to match the shared athena instance's
# own default today (CIRCE_QWEN_LOG_LEVEL, CIRCE_QWEN_ORION_BUS_ENABLED,
# CIRCE_QWEN_HEARTBEAT_INTERVAL_SEC). Several of these bare names already
# exist above for the SHARED athena instance with a DIFFERENT value
# (VISION_PERCEPT_STORE_URL, VISION_VRAM_*, ORION_BUS_ENFORCE_CATALOG) --
# real regression, 2026-08-26: this lane's compose file used to read those
# bare names as its own optional-override hook. The moment this file gets
# copied to services/orion-vision-host/.env on a fresh circe checkout --
# which the compose file's own bring-up instructions require as a
# --env-file argument -- the athena-only values silently won, discarding
# this lane's real defaults with no error. VISION_PERCEPT_STORE_URL broke
# functionally (reverie visual chain's tick went image_not_found, athena's
# docker-internal hostname doesn't resolve from circe); the rest stayed
# silently harmless only because the values happened to coincide. Full
# incident writeup: README.md's "Circe Qwen2-VL lane" section and
# docker-compose.circe-qwen.yml's own header comment -- not repeated here
# to avoid the two copies drifting (an earlier draft of this fix already
# had a stale key-count mismatch between two of these comments).
CIRCE_QWEN_VISION_PERCEPT_STORE_URL=http://100.92.216.81:8021/percepts
CIRCE_QWEN_VISION_PERCEPT_STORE_TOKEN=
CIRCE_QWEN_VISION_PERCEPT_TIMEOUT_SEC=10.0
CIRCE_QWEN_VISION_VRAM_RESERVE_MB=512
CIRCE_QWEN_VISION_VRAM_SOFT_FLOOR_MB=1024
CIRCE_QWEN_VISION_VRAM_HARD_FLOOR_MB=512
CIRCE_QWEN_VISION_TIMEOUT_S=30
CIRCE_QWEN_ORION_BUS_ENFORCE_CATALOG=false
CIRCE_QWEN_LOG_LEVEL=INFO
CIRCE_QWEN_ORION_BUS_ENABLED=true
CIRCE_QWEN_HEARTBEAT_INTERVAL_SEC=10
CIRCE_QWEN_TORCH_CUDA_ALLOC_CONF=
