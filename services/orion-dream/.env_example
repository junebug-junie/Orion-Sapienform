# ───────────────────────────────────────────────────────────────
# Orion Dream — Environment Configuration
# ───────────────────────────────────────────────────────────────

PROJECT=orion-athena
NET=app-net
NODE_NAME=athena

# --- Service Metadata ---
SERVICE_NAME=dream
SERVICE_VERSION=1.0.0
PORT=8620

# --- Redis Bus ---
#ORION_BUS_URL=redis://${PROJECT}-bus-core:6379/0
ORION_BUS_ENFORCE_CATALOG=true
ORION_BUS_ENABLED=true

POSTGRES_URI=postgresql://postgres:postgres@${PROJECT}-sql-db:5432/conjourney

CHANNEL_DREAM_TRIGGER=orion:dream:trigger

# --- REM compaction (Phase F, default-off, staged — applies NOTHING) ---
# When true, REM narration reads the Phase-E compaction-request queue + recent
# episodes/motifs and emits a proposal-marked MemoryCompactionDeltaV1. The hub
# previews it as "what sleep would do"; no service applies it. The applier
# (Phase G) is a separate hard gate (ORION_DREAM_COMPACTION_APPLY_ENABLED).
ORION_DREAM_REM_ENABLED=true
CHANNEL_DREAM_COMPACTION_DELTA=orion:dream:compaction-delta
DREAM_REM_MAX_REQUESTS=50

# --- Compaction APPLIER (Phase G — THE HOT GATE, mutates memory, hard-off) ---
# Keep false. Flipping this on lets a policy-APPROVED compaction delta actually
# downscale/prune/consolidate memory. Requires explicit proposal-mode sign-off +
# a live §14 backfill verification first. Reverie proposals carry operator_review,
# so a human must approve before anything applies. Snapshot precedes every apply.
ORION_DREAM_COMPACTION_APPLY_ENABLED=false
# Apply the safer subset (downscale-renormalize) only; prune stays gated until
# downscale is trusted. Keep true.
ORION_DREAM_COMPACTION_DOWNSCALE_ONLY=true
DREAM_COMPACTION_SNAPSHOT_DIR=/tmp/dream-compaction-apply

# --- Dream cycle v2: sleep pressure -> replay -> REM recombination ---
# A background loop checks sleep pressure (weighted count of what the day left
# unprocessed: degraded/critical metacog, reverie compaction asks, resonance
# alerts, touched crystallizations) and sleeps when pressure >= threshold AND no
# chat turn for DREAM_IDLE_MINUTES AND the last sleep ended >= MIN_INTERVAL ago.
# Each sleep replays the top items and asks the LLM to link distant pairs
# (dream arm) plus random pairs (control arm). Hypotheses reach Orion through
# Hub curiosity (HUB_CURIOSITY_DREAM_HYPOTHESES_ENABLED). Writes only
# dream_cycle / dream_replay_item / dream_hypothesis -- apply
# services/orion-sql-db/manual_migration_dream_cycle_v2.sql first.
ORION_DREAM_CYCLE_ENABLED=true
DREAM_CYCLE_CHECK_INTERVAL_SEC=600
DREAM_SLEEP_PRESSURE_THRESHOLD=3.0
DREAM_IDLE_MINUTES=45
DREAM_MIN_INTERVAL_HOURS=6
DREAM_LOOKBACK_HOURS=48
DREAM_REPLAY_MAX=12
DREAM_HYPOTHESES_PER_CYCLE=3
DREAM_CONTROL_PER_CYCLE=1
DREAM_HYPOTHESIS_TTL_HOURS=72
CHANNEL_LLM_INTAKE=orion:exec:request:LLMGatewayService
DREAM_LLM_ROUTE=metacog_background
DREAM_LLM_TIMEOUT_SEC=90
# A completed sleep ends in one story dream (dreams table) about what it replayed.
DREAM_STORY_AFTER_SLEEP_ENABLED=true

# --- Dream carry-through (dream.carry durable run) ---
# On: that dream is carried through words and pictures (text -> picture -> text,
# six hops, run by orion-durable-runs; pictures painted by orion-thought) instead
# of the one-paragraph story. Submitted through cortex-orch's durable ingress
# (needs CORTEX_DURABLE_ADMISSION_ENABLED there). Also answers the run's text and
# finish steps and enables POST /dreams/carry/run. Off: the one-shot story path.
DREAM_CARRY_ENABLED=true
# A carry past this finishes partial, keeping every hop it made (4 h).
DREAM_CARRY_DEADLINE_SEC=14400
CHANNEL_CORTEX_REQUEST=orion:cortex:request
# The finished carry is published here as dream.result.v1 (sql-writer -> dreams).
CHANNEL_DREAM_LOG=orion:dream:log

# --- Introspect responder (orion-introspect `dreams` tool; read-only) ---
# Answers orion:introspect:dream:request from Postgres; query= searches the
# orion_dreams Chroma collection (kept current by a 5-minute index loop).
# Empty search URLs leave recent/one working and make query= answer "unknown".
DREAM_INTROSPECT_ENABLED=true
DREAM_SEARCH_CHROMA_URL=http://${PROJECT}-vector-db:8000
DREAM_SEARCH_EMBED_URL=http://${PROJECT}-vector-host:8320/embedding
DREAM_SEARCH_COLLECTION=orion_dreams
# Calibrated 2026-09-29 (68 docs): related_min 0.733, unrelated_max 0.603,
# gap 0.130, midpoint 0.668. 0.65 sits in the gap, below the midpoint on
# purpose to favor recall: an empty result falsely says "no dream matched",
# a weak hit arrives labeled unsettled. Corpus grows each sleep cycle; re-run
# services/orion-dream/evals/run_dream_search_calibration.py to recalibrate.
DREAM_SEARCH_MIN_SIMILARITY=0.65
DREAM_SEARCH_INDEX_INTERVAL_SEC=300
DREAM_SEARCH_INDEX_BATCH=10

# --- Volumes ---
DREAM_LOG_DIR=/app/logs/dreams

# --- Sys ---
ENVIRONMENT=prod
HEARTBEAT_INTERVAL_SEC=10
ERROR_CHANNEL=orion:system:error
SHUTDOWN_GRACE_SEC=60
