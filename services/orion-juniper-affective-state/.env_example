# Copy to .env and tune for your node. See README.md for operator checklist.
# Deliberately deployed on circe (co-located with orion-affectgpt-worker) --
# see app/settings.py NODE_NAME comment for why this is not athena.

LOG_LEVEL=INFO
NODE_NAME=circe

ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
ORION_BUS_URL=redis://100.92.216.81:6379/0
HEARTBEAT_INTERVAL_SEC=10

HOST_PORT=32799

CHANNEL_AFFECTGPT_INTAKE=orion:exec:request:AffectGptWorkerService
# Must match orion-affectgpt-worker's own CHANNEL_AFFECTGPT_REPLY_PREFIX.
CHANNEL_AFFECTGPT_REPLY_PREFIX=orion:affectgpt:reply
CHANNEL_AFFECTGPT_ASSESSMENT=orion:affectgpt:assessment
AFFECTGPT_RPC_TIMEOUT_S=120

# --- Live capture bridge (POST /v1/juniper/affect/capture_and_assess) -------
# Must match orion-vision-retina's own CHANNEL_RETINA_CLIP_INTAKE /
# CHANNEL_RETINA_CLIP_REPLY_PREFIX on whichever node runs it (carbon).
CHANNEL_RETINA_CLIP_INTAKE=orion:exec:request:RetinaClipCaptureService
CHANNEL_RETINA_CLIP_REPLY_PREFIX=orion:retina:clip:reply
RETINA_CLIP_RPC_TIMEOUT_S=60
# Which physical camera this may trigger -- must equal the responding
# retina instance's own RETINA_STREAM_ID or it refuses (error_code=
# "wrong_camera"). "carbon" matches docs/operations/carbon-webcam.md's own
# RETINA_STREAM_ID=carbon convention -- do not point this at anything else
# without Juniper's explicit say-so.
AFFECT_TARGET_STREAM_ID=carbon
# Where captured video/audio blobs are fetched from -- same URL retina
# itself uploads to (RETINA_PERCEPT_STORE_URL), includes the /percepts
# suffix already.
PERCEPT_STORE_BASE_URL=http://100.92.216.81:8021/percepts
PERCEPT_STORE_TIMEOUT_SEC=15
# Sent as X-Orion-Percept-Token if set -- must match orion-percept-store's
# own PERCEPT_STORE_TOKEN (empty there means auth disabled; leave empty here
# too in that case). Added 2026-08-22 so enabling percept-store's own token
# doesn't silently 401 every capture_and_assess() fetch.
PERCEPT_STORE_TOKEN=
# MUST match the read-write mount in this service's own docker-compose.yml
# AND the read-only mount at the identical path in orion-affectgpt-worker's
# docker-compose.yml -- this is how a container-local fetch becomes visible
# to the separate worker container. Do not point this at /tmp.
AFFECTGPT_SCRATCH_DIR=/mnt/scripts/orion-affectgpt-scratch

# ── Vision backend (2026-08-26) ───────────────────────────────────────────
# Which inference path a capture takes. "vision" reads the clip's own frames
# through orion-llm-gateway's VL route. "affectgpt" is the retired AffectGPT
# worker path, kept ONLY as a rollback for the first days after cutover --
# it produced three reads that misgendered the subject and one that narrated
# a voice from an audio track measured at -49.2 dB peak (silence). Nothing
# falls back to it automatically; only this key selects it.
AFFECT_BACKEND=vision
# Must match orion-llm-gateway's own CHANNEL_LLM_INTAKE.
CHANNEL_LLM_INTAKE=orion:exec:request:LLMGatewayService
# Route name from orion/llm/routes.py. "chat" is circe:8011, confirmed
# multimodal live 2026-08-26. The gateway re-checks this against the live
# worker's /props and refuses rather than sending images at a blind worker.
AFFECT_VISION_LLM_ROUTE=chat
AFFECT_VISION_RPC_TIMEOUT_S=180
# How many stills reach the model. >1 because affect is temporal: a single
# frame cannot tell an expression settling from one tightening.
AFFECT_VISION_MAX_FRAMES=5
AFFECT_VISION_JPEG_QUALITY=85
AFFECT_VISION_MAX_TOKENS=400
# Trust gates on the MIRROR write only -- every read is still published as a
# real event either way. A read below either threshold never reaches the
# Redis key orion/situational/context.py polls, so it cannot colour a chat
# turn; Orion falls back to "no recent capture; do not infer".
# Starting points calibrated on n=2 live captures (detection rates 1.0 and
# 0.052); revisit once real rows accumulate.
AFFECT_MIRROR_MIN_CONFIDENCE=0.35
AFFECT_MIRROR_MIN_DETECTION_RATE=0.15
