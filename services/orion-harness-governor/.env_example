PROJECT=orion-athena
SERVICE_NAME=orion-harness-governor
SERVICE_VERSION=0.1.0
NODE_NAME=athena
HARNESS_GOVERNOR_PORT=7156

ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=false
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_HARNESS_GOVERNOR_ENABLED=true
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health).
HEARTBEAT_INTERVAL_SEC=10

CHANNEL_HARNESS_RUN_REQUEST=orion:harness:run:request
CHANNEL_HARNESS_RUN_ARTIFACT=orion:harness:run:artifact
CHANNEL_HARNESS_RESULT_PREFIX=orion:harness:run:result:
CHANNEL_HARNESS_RUN_STEP=orion:harness:run:step
# Hub publishes here on WS disconnect / turn abort so orphaned FCC claude motors die.
CHANNEL_HARNESS_RUN_CANCEL=orion:harness:run:cancel
CHANNEL_GRAMMAR_EVENT=orion:grammar:event
# Background exec lane — finalize must not queue behind interactive chat on legacy intake.
CHANNEL_CORTEX_EXEC_REQUEST=orion:cortex:exec:request:background
CHANNEL_CORTEX_EXEC_RESULT_PREFIX=orion:exec:result
CHANNEL_FINALIZE_APPRAISAL_REQUEST=orion:substrate:finalize_appraisal:request
CHANNEL_FINALIZE_APPRAISAL_RESULT_PREFIX=orion:substrate:finalize_appraisal:result:
CHANNEL_POST_TURN_CLOSURE=orion:substrate:post_turn_closure

HARNESS_FCC_TIMEOUT_SEC=900
# Max wait for a single stream-json line from `claude -p` before the turn
# fails fast with fcc_stream_stalled instead of hanging up to the full
# HARNESS_FCC_TIMEOUT_SEC. See README "FCC MCP" section.
HARNESS_FCC_STREAM_STALL_TIMEOUT_SEC=180
FINALIZE_REFLECT_TIMEOUT_SEC=180
VOICE_FINALIZE_TIMEOUT_SEC=300
SUBSTRATE_FINALIZE_TIMEOUT_SEC=5
FINALIZE_QUICK_GATE_EPSILON=0.08

# Loop-back tool-recall retry (5b-prime). Default-off -- one bounded retry
# when 5b reflection names a specific, allowlisted tool that would fix a
# misaligned draft (see orion/harness/finalize.py::maybe_run_finalize_tool_retry
# and MAX_FINALIZE_LOOP_RETRIES). Leave false until live-verified.
HARNESS_FINALIZE_TOOL_LOOP_ENABLED=false

HARNESS_FCC_ENV_PATH=/root/.fcc/.env
HARNESS_FCC_AUTH_TOKEN=
HARNESS_FCC_SERVER_URL=http://host.docker.internal:8082
# Orion's disposable FCC sandbox checkout -- same host directory as orion-hub's
# identical mount (services/orion-hub/.env_example: HUB_AGENT_CLAUDE_WORKSPACE).
# One standalone git clone, not a worktree; refreshed to origin/main once per
# browser session by orion-hub's WS connect handler (orion/fcc/sandbox_sync.py).
# The only path back to the real repo is `git push` to a non-main branch, gated
# by GitHub branch protection.
HARNESS_FCC_WORKSPACE=/mnt/orion-fcc/repo
# Host path of the sandbox above, bind-mounted into this container at the same
# path. Only needs to change if the sandbox disk isn't mounted at /mnt/orion-fcc
# on this host.
HARNESS_ORION_FCC_SANDBOX_HOST=/mnt/orion-fcc
# Host-local cache dir for the LadybugDB FTS DuckDB extension used by the
# GitNexus MCP toolchain (see below). The image build COPYs from here instead
# of downloading from extension.ladybugdb.com at build time -- that origin has
# had real sustained outages (Cloudflare 522, observed 2026-08-12) that block
# the build outright. Seed it once per host (and again on a version bump) with:
#   scripts/seed_lbdb_fts_extension_cache.sh
HARNESS_LBDB_EXT_CACHE_DIR=/mnt/telemetry/duckdb-extensions/staging
# Extension version/platform baked into the image at build time (Dockerfile
# ARG LBDB_EXT_VERSION/LBDB_EXT_PLATFORM). Read by both the Dockerfile build
# args below and scripts/seed_lbdb_fts_extension_cache.sh -- change here only,
# on a version bump, then re-run the seed script and rebuild.
LBDB_EXT_VERSION=0.18.1
LBDB_EXT_PLATFORM=linux_amd64
HARNESS_FCC_CLAUDE_BIN=claude
HARNESS_FCC_CLAUDE_BIN_HOST=
# Host `gh` binary bind-mounted read-only (same pattern as the claude binary
# above). Not required for `git push` -- sandbox_sync.py rewrites the sandbox's
# SSH remote to a token-authenticated HTTPS one using GITHUB_PAT directly --
# but useful as a fallback / for `gh pr create` etc.
HARNESS_FCC_GH_BIN_HOST=
# Opt-in override for the FCC claude subprocess's CLAUDE_CONFIG_DIR. Left
# empty by default: this container already isolates Claude Code's own
# default config path (harness-claude-config volume mounted at /root/.claude
# -- see docker-compose.yml), which also keeps the operator's documented
# plugin-install workflow (README "Context Mode... plugin") pointed at the
# same place the real claude subprocess reads. Only set this if running
# harness-governor bare on a host (not via docker-compose), where nothing
# redirects /root/.claude away from the operator's real ~/.claude -- and if
# you do, never point it under ~/.fcc (bind-mounted read-only in-container
# for operator secrets; claude couldn't write its own session state there).
HARNESS_FCC_CLAUDE_CONFIG_DIR=
# --setting-sources passed to the FCC claude subprocess. Default (user,local)
# skips the repo's own project-level CLAUDE.md/AGENTS.md + project-level
# hooks/permissions (.claude/settings.json) -- that file is a coding-agent
# development contract, not instructions for a headless cognition turn, and
# dropping it is not a safety regression here: the repo is bind-mounted
# read-only in this container, so the destructive_git_guard hook this also
# drops has nothing left to protect that the mount doesn't already block.
# MCP tool access is unaffected either way (pre-approved via --mcp-config/
# --allowedTools argv, not settings.json). Set empty to fall back to Claude
# Code's normal default (all three scopes: user, project, local).
HARNESS_FCC_SETTING_SOURCES=user,local
# Absolute host path to repo root for workspace + volume mount (required when compose runs from a git worktree)
HARNESS_REPO_MOUNT=/mnt/scripts/Orion-Sapienform
# Orion-mode FCC MCP — secrets in ~/.fcc/.env (see config/fcc.env_example)
HARNESS_FCC_MCP_ENABLED=true
# FCC Claude spawns set ENABLE_TOOL_SEARCH=true via orion.fcc.context_budget.extend_fcc_subprocess_env
# (defers MCP schema load on custom ANTHROPIC_BASE_URL). Override only for debug: false | auto | auto:N
# Optional override when git remote is unavailable in workspace mount
ORION_GITHUB_OWNER=
ORION_GITHUB_REPO=
# Root in Docker skips --dangerously-skip-permissions without this; avoids "requires approval" dead-ends
HARNESS_FCC_SKIP_PERMISSIONS=true
# Must stay in lockstep with the active FCC/deep-cognition llama.cpp profile's ctx_size
# in config/llm_profiles.yaml (currently 131072 on the Circe monster-FCC profile).
HARNESS_FCC_MAX_CONTEXT_TOKENS=131072
HARNESS_FCC_FILE_READ_MAX_TOKENS=8192
HARNESS_FCC_AUTOCOMPACT_PCT_OVERRIDE=70
# Context pressure nudge when motor fill exceeds this percent of max context (default 70).
HARNESS_FCC_CONTEXT_PRESSURE_PCT=70
# MCP proxy truncates individual tool text payloads above this char count (default 12000).
ORION_FCC_MCP_TOOL_RESULT_MAX_CHARS=12000
HARNESS_AITOWN_ENABLED=true
# Semantic self-indexing (design: 2026-07-11 semantic self-indexing proposal).
# GitNexus code-graph MCP (gitnexus@1.6.9 pinned in the image). Requires a
# host-built index: run `gitnexus analyze --index-only --name orion` from the
# repo root on the host. Off by default; fail-open (FCC falls back to rg/Read).
HARNESS_FCC_GITNEXUS_ENABLED=true
# Context Mode MCP-only stage (context-mode@1.0.169 pinned in the image).
# Virtualizes bulk tool output outside the live context. Off by default.
HARNESS_FCC_CONTEXT_MODE_ENABLED=true
# Writable Context Mode storage root inside the container (Docker volume
# harness-context-mode; operational working data, not an Orion memory store).
HARNESS_FCC_CONTEXT_MODE_DIR=/var/lib/orion/context-mode
# Context Mode hook mode (Stage B): replaces the standalone context-mode MCP
# server with the Claude Code plugin (PreToolUse/PostToolUse/PreCompact/
# SessionStart/Stop hooks; session continuity across compaction). Requires the
# plugin installed in the harness-claude-config volume. When both this and
# HARNESS_FCC_CONTEXT_MODE_ENABLED are true, hook mode wins and the standalone
# server is skipped to avoid duplicate tool registration.
HARNESS_FCC_CONTEXT_MODE_HOOKS_ENABLED=true
# Bridge-network harness cannot use 127.0.0.1 from ~/.fcc; override Convex reachability here
HARNESS_AITOWN_CONVEX_URL=http://host.docker.internal:3210
# (D) embodiment: emit a deliberate approach intent on the turn correlation_id after a
# finalized relational turn (mind->sprite bridge). Default-off, fail-open.
EMBODIMENT_D_FINALIZE_ENABLED=false
