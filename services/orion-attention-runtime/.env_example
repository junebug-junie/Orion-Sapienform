PROJECT=orion-athena
SERVICE_NAME=orion-attention-runtime
SERVICE_VERSION=0.1.0
NODE_NAME=athena
# Bus-native SystemHealthV1 heartbeat (orion:system:health). This service otherwise has no
# bus connection -- always the real tailscale node address, never bus-core/localhost.
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10
POSTGRES_URI=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
ATTENTION_POLICY_PATH=/app/config/attention/field_attention_policy.v1.yaml
ATTENTION_POLL_INTERVAL_SEC=2.0
ENABLE_ATTENTION_RUNTIME=true
# ENABLE_TRANSPORT_ATTENTION_VISIBILITY removed 2026-07-30: capability
# attention (including capability:transport) was killed outright in the same
# patch that replaced hand-weighted node salience with Candidate A --
# select_capability_targets() always returns [] now, so the visibility
# toggle this key gated had nothing left to toggle. See orion/attention/
# field_attention/selectors.py's own docstring.
# Candidate A (precision-weighted salience). 2026-07-30 EWMA-baseline fix: bounds
# how many real NEW prediction-error rows (since the persisted per-target
# baseline's own cursor) are folded per node target, per tick -- a backlog cap,
# not a rolling-window size (see app/settings.py's own comment and
# orion/sentience_striving_program/README.md §12).
ATTENTION_PREDICTION_ERROR_HISTORY_LIMIT=200
ATTENTION_RUNTIME_PORT=8117
LOG_LEVEL=INFO
# Bounded retention for substrate_attention_frames (~43k rows/day once the
# field-digester idle tick is on). Newest row is always kept. 0 disables.
ATTENTION_FRAME_RETENTION_HOURS=72.0
ATTENTION_FRAME_PRUNE_INTERVAL_SEC=3600.0

# Health monitor: an edge-triggered check (attention_frame prune stall) that
# raises an orion-notify attention request only on a healthy->unhealthy
# transition -- never spams once per health-check tick.
ATTENTION_RUNTIME_HEALTH_CHECK_INTERVAL_SEC=900.0
ATTENTION_FRAME_STALL_MULTIPLIER=1.5
NOTIFY_BASE_URL=http://orion-athena-notify:7140
NOTIFY_API_TOKEN=

# Field-native goal-provenance producer (Sentience Striving Program sec6
# Objective 3, 2026-07-30) -- publishes FieldGoalProvenanceV1 to
# orion:memory:goals:proposed via this service's existing ORION_BUS_URL/
# ORION_BUS_ENABLED above (previously only fed the HeartbeatOnly chassis).
# See docs/superpowers/specs/2026-07-30-goal-provenance-and-decision-lattice-
# observability-design.md.
ORION_GOAL_PROVENANCE_PRODUCER_ENABLED=true
# Real, disclosed placeholder debounce (unmeasured) -- see design doc Part A
# Missing Question 2. Not a calibrated threshold.
ORION_GOAL_PROVENANCE_MIN_STREAK=3
CHANNEL_GOAL_PROPOSAL=orion:memory:goals:proposed
# Debug-tier per-tick streak telemetry (2026-08-11) -- publishes DominanceStreakTickV1 on
# every real tick (not just qualifying emissions) so ORION_GOAL_PROVENANCE_MIN_STREAK can be
# calibrated against the true streak-length distribution. Independently toggleable; meant to
# be temporary -- see orion/bus/channels.yaml's orion:debug:attention:streak_tick entry.
ORION_GOAL_PROVENANCE_STREAK_TICK_TELEMETRY_ENABLED=true
CHANNEL_GOAL_PROVENANCE_STREAK_TICK=orion:debug:attention:streak_tick
