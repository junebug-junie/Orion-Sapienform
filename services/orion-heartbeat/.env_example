SERVICE_NAME=orion-heartbeat
SERVICE_VERSION=0.1.0
NODE_NAME=
INSTANCE_ID=

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
ORION_HEALTH_CHANNEL=orion:system:health
HEARTBEAT_INTERVAL_SEC=10.0

# Existing, already-registered channel (orion/bus/channels.yaml) -- v0 is a
# second, additive, read-only consumer. No new channel is registered by this
# service.
CHANNEL_GRAMMAR_EVENT=orion:grammar:event

# How often the H1 (boundary/bulk entanglement) result is recomputed from the
# live substrate. Computation itself is cheap (~6ms); this just controls how
# fresh the debug HTTP surface's /h1 response is.
HEARTBEAT_H1_INTERVAL_SEC=30.0

# Fixed BASE seed for the N-trajectory ensemble's initial random MPS states
# (trajectory i uses HEARTBEAT_SUBSTRATE_SEED + i). v0 has no crash-safe
# snapshot/restore (see docs/superpowers/specs/2026-07-24-spark-field-
# holographic-lattice-design.md's "Explicit deferrals") -- a restart
# reinitializes from these same seeds rather than resuming prior state.
HEARTBEAT_SUBSTRATE_SEED=42

HEARTBEAT_HTTP_PORT=7251

# --- N-trajectory dissipation ensemble (2026-07-28) ---
# docs/superpowers/specs/2026-07-28-precision-weighted-attention-organ-and-
# heartbeat-discrimination-design.md. Defaults are sweep-derived
# (scripts/analysis/measure_heartbeat_ensemble_calibration.py), confirmed
# against both synthetic and real historical grammar_events replay.

# Number of independent trajectories in the dissipation ensemble. 8 measured
# at ~118ms/tick compute cost, comfortably under this system's real average
# tick interval with headroom for bursts -- not yet re-validated for how the
# estimate stabilizes as N increases (a starting default, not a converged
# optimum).
HEARTBEAT_N_TRAJECTORIES=8

# Fraction each relaxation-gate application contracts a site toward this
# trajectory's own seed-derived target.
HEARTBEAT_DECAY_GAMMA=0.2

# Base per-site decay probability before spread-gating scales it down when
# trajectories disagree (something still unresolved).
HEARTBEAT_BASE_DECAY_PROB=0.15

# How sharply cross-trajectory disagreement suppresses decay.
HEARTBEAT_DECAY_SPREAD_SENSITIVITY=4.0

# Two-site entangling reheat gate strength (rotation angle). Must stay
# two-site -- a one-site gate is provably incapable of moving entanglement
# entropy across any cut.
HEARTBEAT_REHEAT_STRENGTH=0.08

# Scales real live bus_synaptic activity into a per-bond reheat probability.
HEARTBEAT_REHEAT_PROB_SCALE=0.02

# Wall-clock cadence (seconds) for the decay/reheat dissipation loop --
# deliberately separate from message consumption so dissipation keeps
# running even when organs go quiet.
HEARTBEAT_DECAY_REHEAT_INTERVAL_SEC=2.0

# FalkorDB connection for the real bus_synaptic reheat driver -- same graph
# services/orion-substrate-runtime already reads (orion_bus_synapse), a
# second, additive, read-only consumer, no new graph/schema.
FALKORDB_URI=redis://orion-athena-falkordb:6379
FALKORDB_BUS_GRAPH=orion_bus_synapse

# Bound on the message-intake -> absorb queue -- decouples cheap message
# intake from the N-trajectory absorb() cost so a burst degrades to
# dropped-and-counted events rather than blocking the bus consumer loop.
HEARTBEAT_ABSORB_QUEUE_MAXSIZE=10000
