# orion-prediction -- forecasting, evaluation, and cause-and-effect estimates over Orion's telemetry.
# Spec: docs/superpowers/specs/2026-10-15-orion-prediction-service-design.md
# Apply services/orion-sql-db/manual_migration_prediction_v1.sql BEFORE the first start.
PROJECT=orion-athena
SERVICE_NAME=orion-prediction
SERVICE_VERSION=0.1.0
NODE_NAME=athena
LOG_LEVEL=INFO
PREDICTION_PORT=8132

ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10

# Same database as the telemetry it reads (orion_biometrics_summary, home_cooling_sample).
POSTGRES_URI=

# Series registry baked into the image from config/prediction/.
PREDICTION_SERIES_PATH=/app/config/prediction/series.v1.yaml

# --- kill switches ---
# Run the select -> issue -> score -> monitor loop. false = HTTP only (causal endpoints still answer).
PREDICTION_ENABLED=true
# Publish orion:prediction:forecast. false = store only.
PREDICTION_PUBLISH_ENABLED=true

PREDICTION_TICK_SEC=30
# A grain bucket counts as complete this long after it ends.
PREDICTION_SETTLE_SEC=60
# Re-run the backtest + per-horizon gate this often (~6-7 min of CPU for 40 windows x 6 models).
PREDICTION_SELECT_INTERVAL_SEC=21600
PREDICTION_BACKTEST_WINDOWS=40
PREDICTION_BACKTEST_STEP_MIN=180
