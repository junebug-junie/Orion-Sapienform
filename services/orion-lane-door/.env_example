# Lane door (leased-evals design Phase 2): a thin proxy in front of each model server.
# Spec: docs/superpowers/specs/2026-11-12-leased-evals-and-server-refusal-design.md
# Runbook (check, roll back, Phase 3): docs/runbooks/2026-11-14-lane-door.md
#
# Runs on circe (chat, agent, agent-gpu2, fast) and hecate (agent-deep), on the host network. Each door takes
# its lane's port once its engine answers on loopback (the engine's *_ENGINE_PUBLISH, 127.0.0.1:180xx by
# default in services/orion-llamacpp-host and services/orion-vllm-host). Nothing to set by hand: no key, no
# secret. The deploy copies this file to .env when .env is missing (scripts/pre_rebuild.sh).

# off = pure pass-through (no counting, no log); shadow = log and count, refuse nothing;
# enforce = refuse a model call that carries no lease id (401 lane_door_unleased); exempt reads still pass.
# Ships shadow: enforce is Juniper's call per lane, after 7 days of READY evidence
# (docs/runbooks/2026-11-14-lane-door.md, "Phase 3").
LANE_DOOR_MODE=shadow
# Per-lane override (empty = LANE_DOOR_MODE). Roll an enforcing lane back with =shadow (keeps the evidence);
# =off is a pure pass-through.
LANE_DOOR_MODE_CHAT=
LANE_DOOR_MODE_AGENT=
LANE_DOOR_MODE_AGENT_GPU2=
LANE_DOOR_MODE_FAST=
LANE_DOOR_MODE_AGENT_DEEP=

# Per-call JSON lines, one file per lane per UTC day: <dir>/<lane>-YYYY-MM-DD.jsonl. No prompt text.
LANE_DOOR_LOG_HOST_DIR=/mnt/telemetry/lane-door
LANE_DOOR_LOG_RETENTION_DAYS=30
LANE_DOOR_SUMMARY_INTERVAL_SEC=600
LANE_DOOR_CONNECT_TIMEOUT_SEC=5
# How often a waiting door re-checks its engine and its lane port.
LANE_DOOR_BIND_POLL_SEC=2
# On a stop (a door redeploy): how long calls in flight may finish (compose stop_grace_period is 120 s).
LANE_DOOR_DRAIN_SEC=100

# Lane ports: the ports the GPU pool already knows (config/gpu_pool.yaml roles). Unchanged.
LANE_DOOR_CHAT_PORT=8011
LANE_DOOR_AGENT_PORT=8015
LANE_DOOR_AGENT_GPU2_PORT=8016
LANE_DOOR_FAST_PORT=8013
LANE_DOOR_AGENT_DEEP_PORT=8021

# Engines on the host's loopback. Must equal the engines' *_ENGINE_PUBLISH defaults. The chat and agent
# llama.cpp rollbacks publish the same loopback port, so a rollback needs no change here.
LANE_DOOR_CHAT_UPSTREAM=127.0.0.1:18011
LANE_DOOR_AGENT_UPSTREAM=127.0.0.1:18015
LANE_DOOR_AGENT_GPU2_UPSTREAM=127.0.0.1:18016
LANE_DOOR_FAST_UPSTREAM=127.0.0.1:18013
LANE_DOOR_AGENT_DEEP_UPSTREAM=127.0.0.1:18021
