# Copy to .env and tune. See README.md for operator checklist.
# This service runs on circe ONLY -- it is the GPU pool's actuator there: on a GpuActuateV1 from the
# pool it runs a role's `launch` block (config/gpu_pool.yaml) through circe's own docker socket.
# It must never be deployed anywhere else: the whole point is being co-located with the docker
# daemon that owns those containers.

LOG_LEVEL=INFO
NODE_NAME=circe

ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
# Central bus, reachable from any node via tailscale -- CLAUDE.md mandate:
# always the tailscale node IP, never bus-core/redis/localhost.
ORION_BUS_URL=redis://100.92.216.81:6379/0
HEARTBEAT_INTERVAL_SEC=10

GPU_LANE_CONTROLLER_HOST_PORT=8090

# circe's own checkout path on the HOST filesystem (used by
# docker-compose.yml's bind mount, NOT read by the app itself) -- confirmed
# live at /mnt/scripts/Orion-Sapienform. Only change this if circe's
# checkout ever moves.
GPU_LANE_HOST_REPO_ROOT=/mnt/scripts/Orion-Sapienform

# GPU pool actuator: a card moves only on GpuActuateV1 (orion:gpu_pool:actuate:request), fenced by
# the pool's generation + launch_digest. Stage 5.6 deleted the gpu2 bridge (GPU2_ENABLED,
# GPU2_DIFFUSION_URL, GPU2_AGENT_URL, GPU2_MODEL_READY_TIMEOUT_SEC), the GPU1 flip and its
# GPU_LANE_CONTROLLER_TOKEN: a role without a `launch` block for this actuator is simply not actuated.
# This host's name under config/gpu_pool.yaml `actuators:`; requests for other actuators are ignored.
GPU_POOL_ACTUATOR_NAME=circe
# Persisted pool fence (last accepted generation + recent action results). Lives on the
# gpu-lane-controller-state named volume (docker-compose.yml) so a recreate cannot re-admit an old
# generation. Renamed from GPU2_POOL_FENCE_STATE_PATH in 5.6; keep the same file.
GPU_POOL_FENCE_STATE_PATH=/state/gpu2_pool_fence.json
# Max wait for a launch.drain role (diffusion) to finish in-flight work before it is stopped.
# Renamed from GPU2_DRAIN_TIMEOUT_SEC in 5.6; same meaning.
GPU_LANE_DRAIN_TIMEOUT_SEC=300
