SERVICE_NAME=self-study-enrichment
SERVICE_VERSION=0.1.0
# See root .env's own NODE_NAME value -- set explicitly, do not rely on a
# shell placeholder like "$(hostname)" (confirmed elsewhere in this repo
# that docker-compose does not shell-evaluate .env values).
SELF_STUDY_ENRICHMENT_NODE_NAME=athena

# Root .env already has PROJECT, NODE_NAME, ORION_BUS_URL -- leave
# ORION_BUS_URL commented out here to inherit it. If you must override:
# ALWAYS use redis://<tailscale-node-ip>:6379/0, per root CLAUDE.md.
#ORION_BUS_URL=redis://<tailscale-node-ip>:6379/0
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
HEARTBEAT_INTERVAL_SEC=10

CHANNEL_SELF_STUDY_ENRICHMENT_REQUESTED=orion:self_study:enrichment:requested

# Read-only mount of this repo's own real working tree -- evidence.py reads
# graphify-out/graph.json and per-cluster README.md from it. Host path is
# operator-specific; in-container path normally does not need overriding.
SELF_STUDY_ENRICHMENT_REPO_HOST_PATH=/mnt/scripts/Orion-Sapienform
SELF_STUDY_ENRICHMENT_REPO_PATH=/repo
SELF_STUDY_ENRICHMENT_GRAPH_JSON_PATH=/repo/graphify-out/graph.json

# ── Real Claude Code session credential -- NOT a separate Anthropic API
# key. This service authenticates its `claude -p` subprocess via a
# `claude setup-token` long-lived (1-year) OAuth token, same mechanism and
# rationale as orion-room-companion (see that service's README "FIXED
# 2026-08-18" section for the file-mount staleness bug this replaced).
# Never via ANTHROPIC_API_KEY (rejected design -- would open a second,
# pay-per-token billing relationship instead of reusing the existing
# subscription auth).
#
# To fill this in:
#   1. Run `claude setup-token` in a real terminal (not piped through an
#      agent -- complete the browser login yourself).
#   2. Paste the printed token as the value below.
# Do NOT paste the token into a chat with an agent. Left empty here on
# purpose -- the service fails fast at container startup if unset.
SELF_STUDY_ENRICHMENT_CLAUDE_OAUTH_TOKEN=
SELF_STUDY_ENRICHMENT_CLAUDE_CONFIG_DIR=/root/.claude
SELF_STUDY_ENRICHMENT_CLAUDE_BIN=claude
SELF_STUDY_ENRICHMENT_MODEL=claude-sonnet-5
SELF_STUDY_ENRICHMENT_EFFORT=medium
SELF_STUDY_ENRICHMENT_TIMEOUT_SEC=120
SELF_STUDY_ENRICHMENT_SETTING_SOURCES=user,local

# Content-hash-keyed cache dir (mirrors graphify-out/cache/semantic/'s shape,
# but lives on this service's own writable volume, not inside the read-only
# repo mount above -- never committed, per CLAUDE.md sec 2).
SELF_STUDY_ENRICHMENT_CACHE_DIR=/data/cache/self_study_enrichment

# Safety backstop: max real `claude -p` runs per UTC day. Ships ON by
# default (explicit product decision) but this ceiling caps real spend even
# from a burst of commits, including ones Orion's own autonomous coding
# loop might make.
SELF_STUDY_ENRICHMENT_MAX_PER_DAY=8
SELF_STUDY_ENRICHMENT_RATE_LIMIT_STATE_PATH=/data/state/self_study_enrichment_service_rate_limit.json
