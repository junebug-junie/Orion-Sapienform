# Copy to `.env` in this directory (same folder as `docker-compose.yml`).
# Keys match `app/settings.py` (Pydantic) and `docker-compose.yml` (subset + compose-only).
#
# Local:  uvicorn is usually run from `services/orion-mind`; settings load this file via path.
# Docker: `docker compose` reads `.env` for substitution; the service also receives the
#         `environment:` block below (defaults apply if a key is unset in `.env`).

# --- Docker Compose (host / container naming) --------------------------------
PROJECT=orion
# Host port published to your machine (left side of ports: mapping)
HOST_PORT=6611

# --- App & process (consumed by Pydantic `Settings` and uvicorn) ------------
SERVICE_NAME=orion-mind
SERVICE_VERSION=0.1.0
NODE_NAME=local-dev
LOG_LEVEL=INFO
# Port the API listens on inside the container and for local uvicorn
PORT=6611

# --- Mind engine defaults ----------------------------------------------------
MIND_SNAPSHOT_MAX_BYTES=512000
MIND_WALL_MS_DEFAULT=180000
MIND_N_LOOPS_DEFAULT=1
# Leave empty to use packaged `app/config/router_profiles.yaml`
MIND_ROUTER_PROFILES_PATH=

# --- Evidence pack bounds -----------------------------------------------------
MIND_EVIDENCE_MAX_CHARS=12000
MIND_EVIDENCE_MAX_MESSAGES=8
MIND_EVIDENCE_MAX_RECALL_FRAGMENTS=8
MIND_EVIDENCE_MAX_PROJECTION_ITEMS=16

# --- LLM synthesis (Qwen routes via LLM gateway) -----------------------------
# All three phases on metacog (circe 8012) as of 2026-09-07: `quick` (circe 8013)
# was saturated (8 inflight + up to 11 queued) and timing out Mind's 60s budget
# on ~97% of live chat turns. stance had already drifted off its `chat` code
# default onto the same saturated `quick` in the live .env, so it moved for the
# same reason as semantic, not away from `chat`. Background callers of metacog
# (memory-consolidation, vision-council, reverie, hub's concept classifier,
# orion-cortex-exec's daily metacog/journal draft) were retagged to
# metacog_background in the same patch so they yield to this live-turn traffic.
#
# metacog was confirmed idle (4/4 slots, zero real queued/overloaded events)
# at the moment of this patch -- a live point-in-time check, not a load test of
# 3 sequential Mind calls per turn stacked on top of that background traffic.
# If fallback_contract_only reappears, check `docker logs orion-llm-gateway`
# for queued/overloaded against metacog's upstream before assuming a code
# regression -- see MIND_SEMANTIC_MODEL_ROUTE's own comment in settings.py.
MIND_LLM_SYNTHESIS_ENABLED=false
MIND_SEMANTIC_MODEL_ROUTE=metacog
MIND_APPRAISAL_MODEL_ROUTE=metacog
MIND_STANCE_MODEL_ROUTE=metacog
# Juniper's live turns (utterance_origin=juniper; unmarked and Orion runs are not lifted) move
# every phase on `metacog` (system: shed under heat) onto this route (same class, interactive:
# never shed). Empty = rollback. Spec 2026-10-06-thermal-controller-redesign D4.
MIND_TURN_MODEL_ROUTE=metacog_turn
# Must stay below Orch ORION_MIND_TIMEOUT_SEC (e.g. 60 < 210) so Orch receives Mind before HTTP timeout.
MIND_LLM_TIMEOUT_SEC=60
MIND_LLM_MAX_TOKENS_SEMANTIC=2048
MIND_LLM_MAX_TOKENS_APPRAISAL=3072
MIND_LLM_MAX_TOKENS_STANCE=1536
MIND_LLM_THINKING_APPRAISAL=true
MIND_LLM_FAIL_OPEN_LEGACY=true
MIND_LLM_PHASE_SAFETY_MS=50
MIND_LLM_RETURN_LOGPROBS_SEMANTIC=true
# native_completion = aligned llama.cpp path (requires gateway LLM_LOGPROB_NATIVE_COMPLETION_ENABLED=true)
MIND_LLM_LOGPROB_PROBE_MODE=native_completion
# Flipped ON 2026-08-11, same "start collecting real post-outage data" call
# as EQUILIBRIUM_METACOG_INSIGHT_TRIGGER_ENABLE/FLOW_TRIGGER_ENABLE in
# services/orion-equilibrium-service/.env_example -- see that file's comment
# for the full context (11-day mesh outage meant no live window existed
# until now to judge whether these advisory triggers fire sensibly).
MIND_LLM_UNCERTAINTY_METACOG_ENABLED=true
MIND_METACOG_TRIGGER_CHANNEL=orion:equilibrium:metacog:trigger

# --- Bus → LLM gateway -------------------------------------------------------
MIND_LLM_USE_BUS=true
ORION_BUS_ENABLED=true
# Host-reachable Redis (Tailscale/LAN). Compose default redis://redis:6379 fails on host-network stacks.
ORION_BUS_URL=redis://100.92.216.81:6379/0
MIND_LLM_INTAKE_CHANNEL=orion:exec:request:LLMGatewayService
MIND_LLM_REPLY_PREFIX=orion:mind:llm:reply

# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health), independent bus
# connection from the LLM-gateway RPC bus fork above.
HEARTBEAT_INTERVAL_SEC=10

# RPC-health snapshot publish (orion:rpc_health:snapshot): every LLM call opens a short-lived
# bus to orion:exec:request:LLMGatewayService; each folds its outcome into a process sink
# that a long-lived bus publishes. Consumer-first: RPC_HEALTH_CHANNEL_LATENCY_ENABLED adds
# `channel_latency` to an extra="forbid" schema -- rebuild orion-signal-gateway +
# orion-equilibrium-service on PR #2312's build BEFORE deploying this service with it true.
# ALSO a hard prerequisite: orion-equilibrium-service must run PR #2310's build first. On any
# older build its legacy transport-metacog trigger reads EVERY service's pooled timeouts/p95
# (>=5s), and this service's calls are LLM-bound by design, so it would fire every cooldown.
RPC_HEALTH_PUBLISH_ENABLED=true
RPC_HEALTH_PUBLISH_INTERVAL_SEC=30
RPC_HEALTH_CHANNEL_LATENCY_ENABLED=true

# recall_signal_resolver.py's bus_synaptic series read (substrate_field_state).
# Same logical DB as orion-recall/orion-cortex-orch's RECALL_PG_DSN. Empty/unset
# degrades to the "not writing" render state, never a hard failure.
RECALL_TRANSPORT_PG_DSN=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
# Render gate for a bus_synaptic transport fragment in the evidence pack.
# Deliberately equal to orion-equilibrium-service's
# EQUILIBRIUM_METACOG_TRANSPORT_BUS_SYNAPTIC_ERROR_THRESHOLD, not the lattice
# policy's watch_at (0.25) -- see recall_signal_resolver.py.
RECALL_TRANSPORT_RENDER_GATE_THRESHOLD=0.15

# EWMA-derived transport-lane thresholds (bus_synaptic_pressure only). Derived
# values can only trigger EARLIER than transport_lattice_policy.v1.yaml's static
# thresholds (hard floor). Written by orion-substrate-runtime, read by hub +
# mind. Rollback: TRANSPORT_THRESHOLDS_DERIVED_ENABLED=false -> pure static YAML.
# Cold start: static applies until MIN_SAMPLES (2880 = 24h at the 30s tick).
# Keep identical across substrate-runtime, hub and mind.
TRANSPORT_THRESHOLDS_DERIVED_ENABLED=true
TRANSPORT_THRESHOLDS_FAST_HALF_LIFE_SEC=1800
TRANSPORT_THRESHOLDS_SLOW_HALF_LIFE_SEC=172800
TRANSPORT_THRESHOLDS_MIN_SAMPLES=2880
TRANSPORT_THRESHOLDS_K_WATCH=5.0
TRANSPORT_THRESHOLDS_K_STEP=2.0
TRANSPORT_THRESHOLDS_MAX_STATE_AGE_SEC=600
TRANSPORT_THRESHOLDS_STATE_KEY=orion:lattice:transport_thresholds:v1
# Comma-separated first names of people close to Juniper, matched as relational
# cues by the deterministic stance fallback (app/engine.py). Personal data:
# keep real names in the local .env only, never in this template.
ORION_MIND_RELATIONAL_NAMES=

# Orion Prime 2A (docs/superpowers/specs/2026-10-29-orion-prime-design.md; app/prime_loop.py):
# orion-mind keeps thinking between conversations. A CPU tick reads body + attention; when something
# changed and the body economy FUNDS a bid (family `prime`), one short thought runs on route `prime`
# (circe chat lane 0, background priority: Juniper's turn always goes first). Its one move: a
# question for curiosity's next investigate run (Hub's focus slot). PRIME_ENABLED=false stops the
# loop; run_mind is unaffected either way.
PRIME_ENABLED=true
PRIME_TICK_SEC=15
# Least time between thoughts; the price decides how often above it. 300 s = at most 12 thoughts an hour
# on Juniper's chat lane while E9 (chat latency under Prime load) is measured. Live 10-29: Temporal Self
# opened 215 arcs in the day and Tier 1 bids were funded 351/352, so the floor, not the price, sets the
# rate today.
PRIME_REFRACTORY_SEC=300
PRIME_SETTLE_INTERVAL_SEC=300
PRIME_LLM_ROUTE=prime
PRIME_BID_LANE=chat
PRIME_MAX_TOKENS=700
PRIME_LLM_TIMEOUT_SEC=60
# Narrator control: this share of questions is opened as an act but never sent.
PRIME_HOLDBACK_FRACTION=0.2
PRIME_DURABLE_RUNS_URL=http://orion-athena-durable-runs:8121
# Hub runs on athena's host network; this is athena's tailscale address.
PRIME_HUB_URL=http://100.92.216.81:8080
