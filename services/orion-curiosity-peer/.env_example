SERVICE_NAME=curiosity-peer
SERVICE_VERSION=0.1.0
# See root .env's own NODE_NAME value -- set explicitly, do not rely on a
# shell placeholder like "$(hostname)" (docker-compose does not shell-evaluate
# .env values).
CURIOSITY_PEER_NODE_NAME=athena

# Root .env already has PROJECT, NODE_NAME, ORION_BUS_URL -- leave
# ORION_BUS_URL commented out here to inherit it. If you must override:
# ALWAYS use redis://<tailscale-node-ip>:6379/0, per root CLAUDE.md / AGENTS.md.
# Never bus-core, never a bare "redis" hostname.
#ORION_BUS_URL=redis://<tailscale-node-ip>:6379/0
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
HEARTBEAT_INTERVAL_SEC=10

# ── Dual kill switch (service side) ────────────────────────────────────
# Armed on this host. Hub must also set HUB_CURIOSITY_CONTRACTOR_PEER_ENABLED=true
# or no HelpRequest is enqueued. Set false here to stop processing without
# undeploying. Typo alias CURIOUSITY_PEER_ENABLED is accepted by Settings.
CURIOSITY_PEER_ENABLED=true

# ── Cursor Agent CLI (desktop login) — lives HERE, not in orion-hub ────
# Auth is host `agent login` / `cursor-agent login` (auth.json under
# ~/.config/cursor), NOT CURSOR_API_KEY / cursor-sdk. Compose mounts the
# host install + config; point this at the versioned binary inside the
# share mount so the bash wrapper finds sibling node/index.js.
CURIOSITY_PEER_AGENT_BIN=/opt/cursor-agent/versions/2026.05.20-2b5dd59/cursor-agent

CURIOSITY_PEER_REPO_ROOT=/repo
CURIOSITY_PEER_MODEL=composer-2.5
# Consumer-first rollout; missing forecasts/graph acknowledgments then refuse hire.
CURIOSITY_PEER_EPISODES_ENABLED=false

# ── Contested Cursor budget (fail-closed) ─────────────────────────────
# Without a reading the peer refuses every hire (budget_unobserved).
# Operator asserts pool headroom when no first-party Cursor usage API
# exists yet. FILE (if set and readable) wins over STATE.
# STATE: clear | limited | unknown
# FILE: JSON {"state":"clear","observed_at":"2026-09-15T00:00:00Z"}
#       or a one-word plain text file: clear
CURIOSITY_PEER_CURSOR_BUDGET_STATE=
CURIOSITY_PEER_CURSOR_BUDGET_FILE=

# Repo bind uses ORION_HOST_REPO_ROOT from root .env (default
# /mnt/scripts/Orion-Sapienform). Do not use a relative host path.
# Worldview graph (PeerBrief dual-write). Leave blank until operator wires
# the same credentials used by Hub curiosity / ~/.fcc/.env.
# On docker bridge networks use the Falkor service hostname + 6379
# (e.g. orion-athena-falkordb), not Hub's host-mode 127.0.0.1:6380.
ORION_CURIOSITY_GRAPH_HOST=
ORION_CURIOSITY_GRAPH_PORT=
ORION_CURIOSITY_GRAPH_USER=
ORION_CURIOSITY_GRAPH_PASSWORD=
ORION_CURIOSITY_GRAPH_OWN=orion_worldview

CHANNEL_HELP_REQUEST=orion:curiosity:help:request
CHANNEL_PEER_BRIEF=orion:curiosity:peer:brief
CHANNEL_PEER_BRIEF_CONSUMED=orion:curiosity:peer:brief:consumed
CHANNEL_ROOM_CLAUDE_REQUEST=orion:room:claude:request
CHANNEL_ROOM_CLAUDE_UTTERANCE=orion:room:claude:utterance
