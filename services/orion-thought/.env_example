SERVICE_NAME=orion-thought
SERVICE_VERSION=0.1.0
NODE_NAME=athena
THOUGHT_PORT=7155

ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=false
ORION_BUS_URL=redis://100.92.216.81:6379/0
# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health).
HEARTBEAT_INTERVAL_SEC=10

CHANNEL_THOUGHT_REQUEST=orion:thought:request
CHANNEL_THOUGHT_ARTIFACT=orion:thought:artifact
CHANNEL_THOUGHT_RESULT_PREFIX=orion:thought:result:
CHANNEL_CORTEX_EXEC_REQUEST=orion:cortex:exec:request
CHANNEL_CORTEX_EXEC_RESULT_PREFIX=orion:exec:result
# Tripled 120 -> 360 (2026-08-26) after a real timeout, measured to the second.
#
# `stance_react` runs on the `chat` lane by design -- Qwen3.6-35B-A3B on
# circe-worker-1, a THINKING model -- and that placement is deliberate: a stance
# is a judgement about whether to engage at all, and it is worth the good model.
# The cost of that choice is that its latency scales with input, and 120s left
# no headroom for a large one.
#
# The incident: an unsolicited curiosity turn (an ~11 KB self-addressed prompt,
# ~47x the 101-token median stance completion) took 90s in the model and 32s in
# cortex-exec post-processing. Thought gave up at 120.006s; cortex-exec
# published the finished, correct answer 1.9s later. The turn surfaced to Hub as
# `turn_deferred` -- indistinguishable, at that layer, from Orion genuinely
# judging the moment wrong.
#
# 360 is chosen against the chain, not picked round: Hub's own outer wait on
# Thought is TIMEOUT_SEC=400 (services/orion-hub/.env_example), so this must
# stay UNDER 400 or Hub gives up first and the extra budget is unreachable.
# 360 leaves 40s of margin for the reply hop.
#
# NEXT CEILING, not fixed here: cortex-exec's own RPC to LLMGatewayService is
# capped at 120s, and the model leg above measured 90s. If a stance prompt ever
# pushes the model past 120s, that inner cap binds first and this key cannot
# help. Raise that one when it actually fires -- not pre-emptively.
STANCE_REACT_TIMEOUT_SEC=360

# Reverie: spontaneous-thought mode (Phase A). Default-off — read-only narration
# of the current winning coalition. Set true to enable the self-driven tick.
ORION_REVERIE_ENABLED=true
ORION_REVERIE_INTERVAL_SEC=90
ORION_REVERIE_MIN_SALIENCE=0.0
CHANNEL_REVERIE_THOUGHT=orion:reverie:thought

# Reverie semantic lift (v1). Requires substrate_turn_referent migration + referent rows.
ORION_REVERIE_SEMANTIC_LIFT_ENABLED=false
ORION_REVERIE_REFERENT_MAX_AGE_HOURS=24
CHANNEL_REVERIE_CORTEX_EXEC_REQUEST=orion:cortex:exec:request:background

# Reverie perception context. Default-off, read-only — feeds the most recent
# orion-vision-council narrative(s) (vision_events table) into the reverie
# prompt as ungrounded sensory context. Reverie is otherwise 100% blind to the
# camera. Does NOT widen evidence_refs grounding to vision ids. First unverified
# cut of Movement III in docs/superpowers/specs/2026-08-12-perception-frontier-
# design.md -- leave false until a live tick has been eyeballed for whether the
# BLIP-base narratives actually add anything worth narrating.
ORION_REVERIE_PERCEPTION_ENABLED=true
ORION_REVERIE_PERCEPTION_MAX_AGE_SEC=180
ORION_REVERIE_PERCEPTION_MAX_EVENTS=3

# Reverie expectation scoring (Movement III). Default-off — closes the loop
# between imagination and reality: when a narrated thought states a falsifiable
# `expectation` about the room (requires ORION_REVERIE_PERCEPTION_ENABLED, see
# above), this opens a checkable window on it, then later spends at most one
# bounded judge-LLM call per tick resolving the single most-overdue pending
# expectation against a fresh percept (confirmed/disconfirmed), or writes
# "unscored" with no LLM call when no fresh-enough percept exists. Never
# fabricates a verdict on stale/ambiguous evidence. Apply
# manual_migration_substrate_reverie_thought_expectation.sql before enabling.
# Enabled 2026-08-19 (Juniper direction). The migration is a hard prerequisite
# for orion-thought to start at all with this code -- expectation/
# expectation_checkable_by are written as real columns on every reverie
# thought, unconditionally, regardless of this flag.
ORION_REVERIE_EXPECTATION_SCORING_ENABLED=true
ORION_REVERIE_EXPECTATION_CHECK_WINDOW_SEC=1800

# Reverie chain (Phase C). Default-off — a train of thought that terminates on
# pressure discharge / step-cap, with a refractory cooldown per resolved theme.
ORION_REVERIE_CHAIN_ENABLED=true
ORION_REVERIE_CHAIN_MAX_STEPS=4
ORION_REVERIE_REFRACTORY_SEC=900
ORION_REVERIE_DRIFT_TEMP=0.7
CHANNEL_REVERIE_CHAIN=orion:reverie:chain

# Reverie grounding (Phase D). Default-off, read-only — ground thoughts in recent
# Layer 11 motifs + rung-4 episode summaries.
ORION_REVERIE_GROUND_CONSOLIDATION=true

# Compaction request (Phase E). Default-off, queue only — a settled chain queues
# a typed ask for the offline dream. Applied by nothing.
ORION_REVERIE_COMPACTION_REQUEST_ENABLED=true
CHANNEL_DREAM_COMPACTION_REQUEST=orion:dream:compaction-request

# Resonance tripwire (Phase H). Default-off, observation only — after each chain,
# scan recent chains for a theme re-igniting inside its refractory bound and emit
# a ResonanceAlertV1 (the automated ouroboros guard). Never mutates cognition.
ORION_REVERIE_RESONANCE_ALERT_ENABLED=true
CHANNEL_REVERIE_RESONANCE_ALERT=orion:reverie:resonance-alert
ORION_REVERIE_RESONANCE_WINDOW=200

# Resonance health monitor (Phase H+). Edge-triggered orion-notify paging when a
# theme's resonance is actually worsening (violation_count climbing across its
# last 2 persisted samples) -- not merely "an alert exists," since a stale
# historical burst can keep re-reporting the same old numbers for days as it
# ages out of the 200-row lookback window above. Surfaces in Hub's existing
# Pending Attention panel via orion-notify's POST /attention/request.
NOTIFY_BASE_URL=http://orion-athena-notify:7140
NOTIFY_API_TOKEN=

# Reverie: direct read of attention broadcast + reverie-table persistence
POSTGRES_URI=postgresql://postgres:postgres@${PROJECT}-sql-db:5432/conjourney

# Reverie VISUAL chain (Patch 2 of docs/superpowers/specs/2026-08-20-reverie-
# visual-chain-design.md). A second, parallel reverie chain: generate an
# image via orion-diffusion-host (circe), re-observe it via
# orion-vision-host's existing caption_frame task, persist both, and carry
# the caption forward as prior_description for the next run's prompt.
# Requires manual_migration_reverie_visual_chain.sql applied,
# orion-diffusion-host live on circe (services/orion-diffusion-host README),
# and this service's own docker-compose.yml volume mount for
# ORION_VISUAL_CHAIN_STORAGE_DIR (fixed alongside this flip -- without it,
# generated images silently vanish into the container's ephemeral
# filesystem instead of landing on the real host disk).
# Enabled 2026-08-25 (Juniper direction, live-verified: real file on disk,
# real reverie_visual_chain/reverie_visual_artifact rows, correct FK, honest
# null description rather than a fabricated caption on the placeholder seed
# prompt's abstract first images -- see visual_chain.py's DEFAULT_SEED_PROMPT
# for the known follow-up: sdxl-turbo's output for that seed prompt has not
# yet cleared orion-vision-host's caption sanitizer in 3/3 live ticks).
ORION_VISUAL_CHAIN_ENABLED=true
ORION_VISUAL_CHAIN_INTERVAL_SEC=600
ORION_DIFFUSION_HOST_BASE_URL=http://100.112.254.99:8014
# 120, not 30 -- real bug, caught live 2026-08-28 the same day
# orion-diffusion-host swapped to FLUX.1-schnell: FLUX's real generation
# (4 steps, CPU offload) measured 49-56s on the actual deployed hardware,
# well over the 30s this value was tuned to for sdxl-turbo's near-instant
# single step. Every tick timed out until this was raised.
ORION_VISUAL_CHAIN_DIFFUSION_TIMEOUT_SEC=120
ORION_VISUAL_CHAIN_STORAGE_DIR=/mnt/storage-lukewarm/orion/reverie-visual
# MUST match services/orion-hub/.env_example's REVERIE_VISUAL_STORAGE_DIR
# exactly -- Hub bind-mounts this same path read-only to serve these images
# in its Reverie tab. Nothing enforces the two staying in sync; if this path
# ever changes (disk migration, storage reorg), update both .env_example
# files and both live .envs in the same change, or Hub's image endpoint
# starts 404ing with "artifact file missing on disk" despite the DB rows
# and files still existing at the new path.
# Same literal athena-network hostname orion-vision-host's own
# VISION_PERCEPT_STORE_URL resolves -- both are athena-side services.
ORION_VISUAL_CHAIN_PERCEPT_STORE_URL=http://orion-athena-percept-store:8000/percepts
ORION_VISUAL_CHAIN_PERCEPT_STORE_TOKEN=
ORION_VISUAL_CHAIN_PERCEPT_UPLOAD_TIMEOUT_SEC=10
# Points at circe's dedicated Qwen2-VL lane (services/orion-vision-host/
# docker-compose.circe-qwen.yml), not the shared bare channel -- live-
# confirmed 2026-08-26 that athena's shared BLIP-base instance cannot
# produce a caption sanitize_caption accepts for a generated image (3/3
# real ticks came back uncaptioned before this move; described=true and a
# real, detailed caption on the first tick after).
CHANNEL_VISION_HOST_REQUEST=orion:exec:request:VisionHostService:circe-vl
CHANNEL_VISION_REPLY_PREFIX=orion:vision:reply
ORION_VISUAL_CHAIN_CAPTION_TIMEOUT_SEC=60
# Patch 3 context-seed tunables (store.py::load_latest_reverie_
# interpretation) -- were a bare module constant / unbounded before this.
# See app/settings.py's field comment for the full staleness/900s reasoning
# (canonical source -- don't restate it here, just point at it).
ORION_REVERIE_CONTEXT_CHAR_LIMIT=240
ORION_REVERIE_CONTEXT_MAX_AGE_SEC=900
# Patch 4 (design doc §15): live-caught 2026-08-27 -- prior_description
# continuity locked onto one visual attractor ("ancient Roman aqueduct")
# across 10+ runs / 100+ minutes, unmoved by Patch 3's context-seeding (a
# short abstract clause has nowhere near the prompt weight of a long,
# concrete continuity description). After this many CONSECUTIVE runs
# carrying continuity forward, the next run forces a reset -- drops
# prior_description from that run's prompt only, then continuity resumes
# normally. No off switch by design: 0 means reset every run.
ORION_VISUAL_CHAIN_CONTINUITY_MAX_RUNS=3
# Patch 5 (design doc §16): a second, richer context-seed -- self_study_
# analysis.py's four deterministic window-contrast analyses (concept
# induction, vision events, affective state, co-creation signals), real
# quantified self-observation rather than a bare narration sentence.
# store.py's _SAFE_SELF_STUDY_SOURCE_PREFIXES is the actual privacy
# boundary (an allowlist of only those four producers -- see that
# constant's own docstring for the real incident: a sibling
# source_kind='self_study' producer was confirmed live to quote sensitive
# personal content, and is deliberately excluded). 21600s (6h), not the
# reverie context-seed's 900s: these analyses fire on their own 6-72h
# window-contrast cadence, not a fast per-tick producer.
# 150, not 400 (Patch 5's original value) -- real bug, caught live
# 2026-08-28 (design doc §18): SDXL-turbo's text encoder truncates at 77
# tokens, silently. Self-study's dense, hyphen/underscore-heavy jargon
# alone at 400 chars tokenizes to 104 tokens with its framing prefix --
# over budget by itself, before prior_description or any other clause is
# even added. 150 chars keeps this clause around 47 tokens.
ORION_SELF_STUDY_CONTEXT_CHAR_LIMIT=150
ORION_SELF_STUDY_CONTEXT_MAX_AGE_SEC=21600
# Patch 6 (design doc §17): a third context-seed -- real shared-life
# content from the Recall system's memory_crystallizations table
# (status='active' rows only). Unlike self-study above, deliberately NOT
# content-filtered -- see store.load_latest_memory_crystallization's own
# docstring for why. 604800s (7 days), NOT self-study's 6h -- real bug,
# caught live 2026-08-28: 6h was wrongly copied from self-study and read
# empty on every tick, since a crystallized memory doesn't go stale on
# self-study's window-contrast clock. 7 days (not this fix's first-draft
# 3 days -- review caught that draft resting on a silently-narrowed
# 14-day query) covers all but one 10-day outlier from early August;
# every gap since 2026-08-11 has stayed under 2 days. See settings.py's
# own comment for the full reconciled numbers.
# 180, not 400 (Patch 6's original value) -- same real-token-budget
# reasoning as self-study's cap above (design doc §18). Crystallization
# summaries are closer to natural English (~4 chars/token vs self-study's
# ~3.8), so this cap sits slightly above self-study's.
ORION_MEMORY_CRYSTALLIZATION_CONTEXT_CHAR_LIMIT=180
ORION_MEMORY_CRYSTALLIZATION_CONTEXT_MAX_AGE_SEC=604800

# --- Attention salience trace publish gate ---
# 2026-07-31: chat-level/open-loop salience is GWT-coalition Borda
# rank-aggregation now (orion/substrate/attention/salience.py) -- there is
# only one formula, this flag no longer selects between two. Its real,
# kept purpose: gates whether reverie.py::run_reverie_once publishes/
# persists an AttentionSalienceTraceV1 row at all. ORION_ATTENTION_
# HABITUATION_ENABLED and ORION_ATTENTION_SALIENCE_WEIGHTS were removed
# (killed outright alongside SEED_WEIGHTS/LinearSalienceCombiner -- no
# combiner weights left to override, and habituation has no replacement).
ORION_ATTENTION_SALIENCE_V2_ENABLED=true
# Salience trace telemetry channel — emitted per reverie tick when this gate is on.
CHANNEL_ATTENTION_SALIENCE_TRACE=orion:attention:salience:trace

# --- Mind stance enrichment (unified turn; enabled) ---
# Run orion-mind before stance_react and inject an advisory self/attention
# coloring into the verb context. Fail-open, flag-gated.
# NOTE: This is a silent no-op unless orion-mind has MIND_LLM_SYNTHESIS_ENABLED=true
# (that key lives on the orion-mind service, not here) AND orion-thought can reach
# ORION_MIND_BASE_URL. Verify both operationally at rollout.
ORION_THOUGHT_MIND_ENRICHMENT_ENABLED=true
# 2026-07-28: use the compose service key ("mind"), not a directory/container-name
# guess -- see orion-cortex-orch/.env_example's ORION_MIND_BASE_URL comment for why.
ORION_MIND_BASE_URL=http://mind:6611
# Budget: orion-mind runs 3 sequential LLM phases (semantic → appraisal → stance),
# each capped by MIND_LLM_TIMEOUT_SEC (default 60s, on the orion-mind service).
# WALL_MS must stay >= ~3× that (180000) or synthesis is cut off mid-pipeline and
# Mind degrades to contract_only. TIMEOUT_SEC (HTTP read) must exceed WALL_MS/1000
# so Mind's own fail-open result is returned instead of the client aborting.
ORION_THOUGHT_MIND_TIMEOUT_SEC=210
ORION_THOUGHT_MIND_WALL_MS=180000
ORION_THOUGHT_MIND_ROUTER_PROFILE=default
ORION_THOUGHT_MIND_MAX_RESPONSE_BYTES=2000000
ORION_THOUGHT_MIND_ARTIFACT_PUBLISH_ENABLED=true
ORION_THOUGHT_MIND_COLORING_MAX_ITEMS=3
CHANNEL_MIND_ARTIFACT=orion:mind:artifact
# ORION_THOUGHT_MIND_DRIVE_STATE_FETCH_TIMEOUT_SEC removed 2026-07-30: the
# drive_audits-backed drive_state_compact facet it bounded was retired --
# write-never once DriveEngine (the table's only producer) was deleted.

# --- Reasoning activity projection (always-on consumer; harmless when idle) ---
# Consume per-call ReasoningCallV1 telemetry off the bus and materialize a
# rolling-window ReasoningActivityV1 for φ to read via
# GET /projections/reasoning_activity. MAX_CALLS caps the in-memory buffer so
# memory stays bounded regardless of producer rate.
CHANNEL_REASONING_CALL=orion:cognition:reasoning_call
REASONING_ACTIVITY_WINDOW_SEC=120
REASONING_ACTIVITY_MAX_CALLS=2000
