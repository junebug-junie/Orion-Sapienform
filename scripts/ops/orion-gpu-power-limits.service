# circe only. Installed by scripts/ops/gpu_power_limits.py install
# (runbook docs/runbooks/2026-10-29-circe-gpu-power-limits.md).
# Sets each card listed in config/gpu_power_limits.json to its target at boot; stopping the unit
# puts those cards back at their default limit and stops orion-gpu-power-limits.timer (PartOf), which
# otherwise re-checks every 5 minutes. A failed boot apply leaves this unit inactive, so ExecStop
# would not run: `gpu_power_limits.py uninstall` runs `remove` itself.
[Unit]
Description=Orion: hold circe's GPU power limits at config/gpu_power_limits.json
After=nvidia-persistenced.service local-fs.target remote-fs.target
Wants=nvidia-persistenced.service
RequiresMountsFor=/mnt/scripts

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/orion-gpu-power-limits apply
ExecStop=/usr/local/sbin/orion-gpu-power-limits remove

[Install]
WantedBy=multi-user.target
