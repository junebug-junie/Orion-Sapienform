# services/orion-ollama-host/.env_example

SERVICE_NAME=orion-ollama-host
SERVICE_VERSION=0.1.0
NODE_NAME=athena

# Bus-native SystemHealthV1 heartbeat cadence (orion:system:health), published on its own
# independent bus connection. See
# docs/superpowers/specs/2026-07-24-service-heartbeat-node-telemetry-design.md.
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
HEARTBEAT_INTERVAL_SEC=10

# Profiles
LLM_PROFILES_CONFIG_PATH=/app/config/llm_profiles.yaml
OLLAMA_PROFILE_NAME=
OLLAMA_MODEL_ID=llama3

# Port mapping
OLLAMA_HOST_PORT=11434
ORION_BUS_ENFORCE_CATALOG=true
