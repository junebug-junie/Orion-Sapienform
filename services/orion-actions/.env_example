# orion-actions (v1)
SERVICE_NAME=actions
SERVICE_VERSION=0.1.0
NODE_NAME=athena
LOG_LEVEL=INFO
ACTIONS_PORT=7160
ACTIONS_AUDIT_CHANNEL=orion:actions:audit

# Bus
ORION_BUS_URL=redis://100.92.216.81:6379/0
ORION_BUS_ENABLED=true
ORION_BUS_ENFORCE_CATALOG=true
# RPC-health snapshot publish (orion:rpc_health:snapshot) from the RPC bus fork
# (cortex-exec / cortex-orch / journal RPCs). Consumer-first: rebuild
# orion-signal-gateway and orion-equilibrium-service on PR #2312's build BEFORE this one
# (channel_latency is a new field on an extra="forbid" model).
# ALSO a hard prerequisite: orion-equilibrium-service must run PR #2310's build first. On any
# older build its legacy transport-metacog trigger reads EVERY service's pooled timeouts/p95
# (>=5s), and this service's calls are LLM-bound by design, so it would fire every cooldown.
RPC_HEALTH_PUBLISH_ENABLED=true
RPC_HEALTH_PUBLISH_INTERVAL_SEC=30
RPC_HEALTH_CHANNEL_LATENCY_ENABLED=true

# Subscriptions
ACTIONS_SUBSCRIBE_CHANNEL=orion:collapse:triage
ACTIONS_SUBSCRIBE_CHANNELS=orion:collapse:triage,orion:collapse:stored,orion:actions:trigger:daily_pulse.v1,orion:actions:trigger:daily_metacog.v1,orion:actions:trigger:journal.v1,orion:notify:persistence:request,orion:equilibrium:metacog:trigger,orion:world_pulse:run:result

# Cortex dispatch (skills / journal / daily — not Juniper collapse chat reply)
CORTEX_REQUEST_CHANNEL=orion:cortex:request
CORTEX_EXEC_REQUEST_CHANNEL=orion:cortex:exec:request
ACTIONS_EXEC_TIMEOUT_SECONDS=420

# Juniper Collapse Mirror → Hub live chat reply (not cortex verb)
ACTIONS_COLLAPSE_MIRROR_CHAT_REPLY_CHANNEL=orion:hub:collapse_mirror:chat_reply

# Notify actuation
NOTIFY_URL=http://orion-athena-notify:7140
NOTIFY_API_TOKEN=

# Action policy
ACTIONS_RECIPIENT_GROUP=juniper_primary
# Still used by journal/skills/other handlers — NOT used for Juniper collapse chat reply
ACTIONS_SESSION_ID=collapse_mirror
ACTIONS_DEDUPE_TTL_SECONDS=86400
ACTIONS_NOTIFY_DEDUPE_WINDOW_SECONDS=86400
ACTIONS_MAX_CONCURRENCY=2

# Recall (journal/skills paths — NOT used for Juniper collapse chat reply)
ACTIONS_RECALL_PROFILE=collapse_mirror.v1
# Scheduler-triggered daily journals: reflect-like recall + fusion filters (see journal.daily.grounded.v1.yaml)
ACTIONS_JOURNAL_SCHEDULER_RECALL_PROFILE=journal.daily.grounded.v1
# Metacog digest journals (mode=digest): defaults to same grounded profile as scheduler
ACTIONS_JOURNAL_METACOG_RECALL_PROFILE=journal.daily.metacog.grounded.v1
# Notify digest → journal (notify_summary): grounded + extra filters vs digest email boilerplate (journal.notify.grounded.v1.yaml)
ACTIONS_JOURNAL_NOTIFY_RECALL_PROFILE=journal.notify.grounded.v1
ACTIONS_JOURNAL_WORLD_PULSE_RECALL_PROFILE=journal.world_pulse.grounded.v1
ACTIONS_WORLD_PULSE_JOURNAL_ENABLED=true
ACTIONS_WORLD_PULSE_JOURNAL_ALLOW_DRY_RUN=false
ACTIONS_RECALL_TIMEOUT_SECONDS=60

# LLM
#
# Accepted routes: chat, quick, metacog, quick_background, agent -- defined once in
# `orion/llm/routes.py` (ACCEPTED_LLM_ROUTES) and shared with orion-cortex-exec. Anything else
# is NOT silently coerced: it logs `actions_llm_route_unrecognized` and sends no override, so
# the executor applies its own verb-based default.
#
# Until 2026-08-18 this service carried a private allow-list of {chat, quick, metacog} and
# rewrote everything else to `chat` with no log line -- so `ACTIONS_JOURNAL_LLM_ROUTE` below
# was set to `quick_background` by ROADMAP A3 and had NO effect: every journal compose went to
# circe's single-slot 131,072-token lane anyway. Config being set was not proof.
ACTIONS_LLM_ROUTE=metacog
ACTIONS_DAILY_LLM_ROUTE=metacog
# ROADMAP A3: Orion's journal is its own initiative and nobody waits on it, so it
# yields the contended `quick` lane. Was `chat_quick` (a legacy alias for `quick`).
# An EXPLICIT route here bypasses A3's automatic redirect by design -- a caller that
# names a lane is never second-guessed -- so this value has to say what it means.
ACTIONS_JOURNAL_LLM_ROUTE=quick_background
ACTIONS_LLM_TIMEOUT_SECONDS=200

# Daily schedule
ACTIONS_DAILY_TIMEZONE=America/Denver
ACTIONS_DAILY_RUN_ON_STARTUP=false
ACTIONS_DAILY_RUN_ONCE_DATE=
ACTIONS_DAILY_PULSE_ENABLED=true
ACTIONS_DAILY_PULSE_HOUR_LOCAL=8
ACTIONS_DAILY_PULSE_MINUTE_LOCAL=30
ACTIONS_WORLD_PULSE_ENABLED=true
ACTIONS_WORLD_PULSE_HOUR_LOCAL=6
ACTIONS_WORLD_PULSE_MINUTE_LOCAL=0
ACTIONS_WORLD_PULSE_RUN_DRY_RUN=false
WORLD_PULSE_BASE_URL=http://orion-world-pulse:8628
ACTIONS_DAILY_METACOG_ENABLED=true
ACTIONS_DAILY_METACOG_HOUR_LOCAL=20
ACTIONS_DAILY_METACOG_MINUTE_LOCAL=15
ACTIONS_DAILY_GOAL_ARCHIVE_ENABLED=false
ACTIONS_DAILY_GOAL_ARCHIVE_RUN_ON_STARTUP=true
ACTIONS_DAILY_GOAL_ARCHIVE_HOUR_LOCAL=3
ACTIONS_DAILY_GOAL_ARCHIVE_MINUTE_LOCAL=15
AUTONOMY_GOAL_ARCHIVE_BOOTSTRAP_MAX_ROUNDS=30
AUTONOMY_GOAL_ARCHIVE_SUBJECTS=orion,relationship
AUTONOMY_GOAL_RETENTION_DAYS=30
AUTONOMY_GOAL_MAX_ACTIVE_PER_SUBJECT=3
AUTONOMY_GOAL_ARCHIVE_MAX_UPDATES=200
AUTONOMY_GRAPH_QUERY_URL=http://orion-athena-fuseki:3030/orion/query
AUTONOMY_GRAPH_UPDATE_URL=http://orion-athena-fuseki:3030/orion/update
AUTONOMY_GRAPH_TIMEOUT_SEC=30
RDF_STORE_USER=admin
RDF_STORE_PASS=orion
ACTIONS_ASYNC_MESSAGES_ENABLED=true
ACTIONS_DAILY_ASYNC_MESSAGES_ENABLED=true
ACTIONS_DAILY_EMAIL_ENABLED=true
ACTIONS_PENDING_ATTENTION_ENABLED=true
ACTIONS_PRESERVE_GENERIC_NOTIFY_ENABLED=true

# Periodic skills scheduler
ACTIONS_SKILLS_SCHEDULER_ENABLED=true
ACTIONS_SKILLS_RUN_ON_STARTUP=false
ACTIONS_SKILLS_INTERVAL_SECONDS=600
ACTIONS_SKILLS_NOTIFY_ENABLED=true
ACTIONS_SKILLS_GPU_MEM_THRESHOLD=0.9
ACTIONS_SKILLS_BIOMETRICS_STABILITY_THRESHOLD=0.3
# When true (and ACTIONS_SKILLS_NOTIFY_ENABLED), periodic skills also run skills.docker.ps_status.v1; requires cortex-exec Docker access.
ACTIONS_SKILLS_DOCKER_HEALTH_ENABLED=true

# Hunter bus consumer concurrency. Default true, matching the pattern already
# established in orion-recall/orion-llm-gateway/orion-cortex-exec/
# orion-spark-introspector/orion-cortex-orch. False means the consumer directly
# awaits each handler to completion before reading the next message off ANY
# subscribed channel -- a single long-running RPC-bound handler (e.g. the
# daily_pulse_v1/journal-trigger startup catch-up jobs, each waiting up to 420s
# for a reply) blocks every other incoming message for its full duration.
ACTIONS_CONCURRENT_HANDLERS=true

# Journaling
ACTIONS_JOURNALING_ENABLED=true
ACTIONS_JOURNALING_DAILY_ENABLED=true
# Fold capability-absence episodes (a node gone dark, vision blind) into the daily
# journal seed. Adds no new journal entries; the key is omitted entirely on a day
# with no outage. Reads the orion-notify attention store over NOTIFY_URL.
ACTIONS_JOURNAL_CAPABILITY_GAPS_ENABLED=true
# Fold "things I could not name" (vision_unresolved rows for the journal's day)
# into the same daily seed, as a perception_gaps block. Same omit-when-empty
# rule. Reads POSTGRES_URI below; no DSN or no table = no block.
ACTIONS_JOURNAL_PERCEPTION_GAPS_ENABLED=true
# Walkway forecast + grade (walkway camera spec idea 7). Nightly at the time
# below (ACTIONS_DAILY_TIMEZONE): one entry grading today's walkway
# expectations, one forecasting tomorrow's. Writes nothing when the camera has
# seen nothing in 14 days or the tables are missing; says "I do not have
# enough days yet" when it has watched but no rhythm has MIN_SUPPORT_DAYS of
# support. Never emailed (orion/journaler/dispatch_registry.py).
ACTIONS_WALKWAY_FORECAST_ENABLED=true
ACTIONS_WALKWAY_FORECAST_HOUR_LOCAL=22
ACTIONS_WALKWAY_FORECAST_MINUTE_LOCAL=30
ACTIONS_WALKWAY_STREAM_ID=walkway
ACTIONS_WALKWAY_FORECAST_MIN_SUPPORT_DAYS=5
# Read-only use: perception gaps and the walkway journal read vision tables in
# conjourney. Empty disables both reads.
POSTGRES_URI=postgresql://postgres:postgres@orion-athena-sql-db:5432/conjourney
ACTIONS_JOURNALING_COOLDOWN_SECONDS=21600
ACTIONS_JOURNALING_COLLAPSE_DENSE_ONLY=true
ACTIONS_JOURNAL_SESSION_ID=orion_journal
ACTIONS_JOURNAL_AUTHOR=orion
ACTIONS_JOURNAL_WRITE_CHANNEL=orion:journal:write
ACTIONS_JOURNAL_CREATED_CHANNEL=orion:journal:created
ACTIONS_JOURNAL_POST_PERSIST_NOTIFY_ENABLED=true
# NOTE: ACTIONS_SCHEDULER_DAILY_JOURNAL_MESSAGES_ENABLED,
# ACTIONS_SCHEDULER_DAILY_JOURNAL_EMAIL_ENABLED, and
# ACTIONS_JOURNAL_POST_PERSIST_EMAIL_EXCLUDE_SOURCE_KINDS were retired 2026-07-13.
# Notification dispatch (email/in-app) for journal entries is now a single call site
# (_dispatch_journal_notifications, services/orion-actions/app/main.py) keyed on
# trigger_kind via orion.journaler.dispatch_registry.JOURNAL_DISPATCH_REGISTRY --
# see that module's docstring and services/orion-actions/README.md's dispatch
# registry section. The old town/embodiment email exclusion (a fragile CSV
# string-match on source_kind) is now a structural, typo-proof registry entry
# (JOURNAL_DISPATCH_REGISTRY["town_episode"].email_enabled=False).

# Workflow schedule persistence
ACTIONS_WORKFLOW_SCHEDULE_STORE_PATH=/data/orion-actions/workflow_schedules.json
# Daily built-in job cursors; empty = scheduler_cursors.json next to workflow schedule parent dir
ACTIONS_SCHEDULER_CURSOR_STORE_PATH=/data/orion-actions/scheduler_cursors.json
ACTIONS_WORKFLOW_SCHEDULE_CLAIM_BATCH_SIZE=10
# Bounded retry for a failing scheduled workflow. A failed dispatch retries the same
# due-slot at now + BACKOFF * 2^(attempt-1), up to MAX_DISPATCH_ATTEMPTS failures for
# that slot; after that the slot is abandoned to the next natural occurrence and the
# attention signal pages instead. Before this was bounded, one persistently failing
# schedule retried at scheduler-poll cadence (45s) and produced 343 failure
# notifications in a single day (2026-08-20, github_compactor_pass).
ACTIONS_WORKFLOW_SCHEDULE_MAX_DISPATCH_ATTEMPTS=3
ACTIONS_WORKFLOW_SCHEDULE_RETRY_BACKOFF_SECONDS=300
ACTIONS_WORKFLOW_ATTENTION_OVERDUE_MIN_SECONDS=3600
ACTIONS_WORKFLOW_ATTENTION_REMINDER_COOLDOWN_SECONDS=21600

# Self experiments dispatch (optional)
ACTIONS_SELF_EXPERIMENTS_ENABLED=true
ACTIONS_SELF_EXPERIMENTS_URL=http://orion-self-experiments:7172
ACTIONS_SELF_EXPERIMENTS_TIMEOUT_SECONDS=8

# synced from .env_example
PROJECT=orion-athena
NET=app-net

# synced from .env_example
CORTEX_EXEC_DAILY_REQUEST_CHANNEL=orion:cortex:exec:request:background
