# ───────────────────────────────────────────────
# Orion Kev (TypeSafe System One compatible)
# ───────────────────────────────────────────────
PROJECT=orion-athena
SERVICE_NAME=kev
SERVICE_VERSION=0.1.0

# Host port published for debugging (substrate uses Docker DNS on app-net).
KEV_HOST_PORT=8009

# Host nvidia-smi index. On Athena: 1 = Tesla T10 (whisper also uses 1 —
# verify VRAM headroom; P4 at 0 is vision-host and is not CUDA-capable for
# current PyTorch wheels).
KEV_GPU_DEVICE_ID=1

# Hugging Face hub cache on the host (weights persist across rebuilds).
KEV_HF_CACHE_HOST_DIR=/mnt/scripts/kev/.hf-cache

# Hub model id passed to kev.serve --run (image CMD default matches).
KEV_MODEL=jaredpalmer/kev-0.8b
