# postgres creds# postgres creds
POSTGRES_USER=cat
POSTGRES_PASSWORD=cat
POSTGRES_DB=conjourney

# Docker cgroup cap for orion-sql-db (prevents host freeze from runaway vacuum/TOAST).
POSTGRES_MEM_LIMIT=16g

# Postgres connection ceiling. The postgres:15 default is 100, and we silently grew
# into it: 97/100 in use on 2026-08-31 across 25 distinct clients, with connections
# actively being refused. Services see max_connections minus
# superuser_reserved_connections (3), so 300 here gives them 297.
# Changing this requires a FULL RESTART of orion-sql-db (postmaster-only setting).
POSTGRES_MAX_CONNECTIONS=300

# pgAdmin creds
PGADMIN_DEFAULT_EMAIL=orion@conjourney.net
PGADMIN_DEFAULT_PASSWORD=cats

# --- Port Configuration ---
POSTGRES_PORT=55432
PGADMIN_PORT=5050

# ensure does not point to storage_root/orion-athena; just storage_root/postgres_data........
VOLUMES_ORION_POSTGRES_PATH=${STORAGE_ROOT}/postgres_data:/var/lib/postgresql/data

ORION_BUS_ENFORCE_CATALOG=true
